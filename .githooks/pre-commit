#!/usr/bin/env bash
# Pre-commit gates. Activate once per clone:
#
#   git config core.hooksPath .githooks

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

# A removed theorem, lemma, def, abbrev, structure, inductive, class or named instance
# is declared elsewhere in the workspace after the commit, or has a row in
# scripts/deletion-ledger.tsv naming a successor declaration or a decision file.
bash scripts/deletion-gate.sh staged || exit 1

# A new definition of a lemma family listed in scripts/duplicate-decl-watch.txt is
# refused; import the existing one.
staged=$(git diff --cached --name-only --diff-filter=AM -- '*.lean')
bash scripts/duplicate-decl-guard.sh $staged || exit 1

# The gates against empty statements (text only, a few seconds), when Lean, a document
# that names headlines or a file of the gates is staged.
if git diff --cached --name-only \
     | grep -qE '^CatCryptCore/.*\.lean$|^README\.md$|^JoyOfCrypto\.md$|/MLKEM/QROM\.md$|^scripts/(unbounded-hardness-|headline-witness|test_headline_witness|gate-copies|shared-gates)'; then
  bash scripts/unbounded-hardness-ratchet.sh || exit 1
  bash scripts/headline-witness-gate.sh || exit 1
fi
if git diff --cached --name-only \
     | grep -qE '^scripts/(unbounded-hardness-|headline-witness|test_headline_witness|gate-copies|shared-gates)'; then
  bash scripts/gate-copies.sh || exit 1
  bash scripts/test_headline_witness_gate.sh || exit 1
fi

exit 0
