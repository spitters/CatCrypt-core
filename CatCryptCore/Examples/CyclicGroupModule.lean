module

public import CatCryptCore.Examples.CyclicGroupDDH
public import Mathlib.Data.ZMod.Basic

/-!
# A `ZMod p`-module with a generator as a cyclic group

A group of prime order `p` written additively is a `ZMod p`-module `M`; a generator
`g` makes `a ↦ a • g` a bijection `ZMod p → M`. `CyclicGroup.ofModule g hg` is the
`CyclicGroup` structure of `CatCryptCore.Examples.CyclicGroupDDH` on `M` with exponents
`ZMod p` and `pow a = a • g`, so that the DDH games `DDH_real` and `DDH_ideal` and the
advantage `DDH_Advantage` apply to schemes stated over such a module.

## Main results

* `CyclicGroup.ofModule` -- the cyclic group generated by `g`
* `ofModule_DDH_real_bind`, `ofModule_DDH_ideal_bind` -- the DDH games of
  `CyclicGroup.ofModule g hg` as samples of `ZMod p` and the triples
  `(a • g, b • g, (a * b) • g)` and `(a • g, b • g, c • g)`
-/

@[expose] public section

set_option autoImplicit false

namespace CatCryptCore.Examples.CyclicGroupDDH

open CatCrypt.Core CatCrypt.Prob

variable {p : ℕ} [Fact p.Prime] {M : Type} [AddCommGroup M] [Module (ZMod p) M]

/-- The cyclic group `M` generated by `g`, for a `ZMod p`-module `M` on which
    `a ↦ a • g` is a bijection: exponents `ZMod p`, `pow a = a • g`, exponent
    multiplication the product of `ZMod p`, and the group operation the addition
    of `M`. -/
noncomputable abbrev CyclicGroup.ofModule (g : M)
    (hg : Function.Bijective (fun a : ZMod p => a • g)) : CyclicGroup M where
  Exp := ZMod p
  finG := Fintype.ofBijective _ hg
  neG := ⟨0⟩
  finExp := inferInstance
  neExp := ⟨0⟩
  gen := g
  pow a := a • g
  mul := (· + ·)
  inv := Neg.neg
  expMul := (· * ·)
  expNeg := Neg.neg
  one := 0
  pow_comm a b := by
    show (a * b) • g = (b * a) • g
    rw [_root_.mul_comm]
  mul_assoc := add_assoc
  mul_comm := add_comm
  mul_inv := add_neg_cancel
  mul_one := add_zero
  pow_bij := hg

/-- The real DDH game of `CyclicGroup.ofModule g hg`, followed by `k`: uniform
    `a, b : ZMod p` and the triple `(a • g, b • g, (a * b) • g)`. -/
theorem ofModule_DDH_real_bind (g : M) (hg : Function.Bijective (fun a : ZMod p => a • g))
    {γ : Type} (k : M × M × M → SPComp γ) :
    (@DDH_real M (CyclicGroup.ofModule g hg)).bind k =
      SPComp.bind (SPComp.sample (ZMod p)) (fun a =>
        SPComp.bind (SPComp.sample (ZMod p)) (fun b => k (a • g, b • g, (a * b) • g))) := by
  simp only [DDH_real, SPComp.monad_bind_eq, SPComp.monad_pure_eq, SPComp.bind_assoc,
    SPComp.pure_bind]
  rfl

/-- The ideal DDH game of `CyclicGroup.ofModule g hg`, followed by `k`: uniform
    `a, b, c : ZMod p` and the triple `(a • g, b • g, c • g)`. -/
theorem ofModule_DDH_ideal_bind (g : M) (hg : Function.Bijective (fun a : ZMod p => a • g))
    {γ : Type} (k : M × M × M → SPComp γ) :
    (@DDH_ideal M (CyclicGroup.ofModule g hg)).bind k =
      SPComp.bind (SPComp.sample (ZMod p)) (fun a =>
        SPComp.bind (SPComp.sample (ZMod p)) (fun b =>
          SPComp.bind (SPComp.sample (ZMod p)) (fun c => k (a • g, b • g, c • g)))) := by
  simp only [DDH_ideal, SPComp.monad_bind_eq, SPComp.monad_pure_eq, SPComp.bind_assoc,
    SPComp.pure_bind]
  rfl

end CatCryptCore.Examples.CyclicGroupDDH
