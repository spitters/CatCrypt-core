module

public import CatCryptCore.Examples.OT
public import Mathlib.Algebra.Module.ZMod
public import Mathlib.Algebra.Field.ZMod

/-!
# Exponentiation of group elements over a cyclic group with an exponent ring

The algebra of `CyclicGroup.elemPow` (`x ^ a` for a group element `x` and an exponent `a`) over
`CyclicGroupRing`, and the concrete instance `CyclicGroupRing.ofModule` of a `ZMod q`-module
generated by one element, in which `x ^ a` is the scalar multiple `a • x`.

## Main definitions

* `CyclicGroupRing.ofModule` — the cyclic group with exponent ring of a `ZMod q`-module `M`
  (`q` prime) with a generator `g`: `pow a = a • g`, the group operation is addition.

## Main results

* `CyclicGroupRing.elemPow_add` — `x ^ (a + b) = x ^ a · x ^ b`.
* `CyclicGroupRing.elemPow_mul` — `x ^ (a b) = (x ^ a) ^ b`.
* `CyclicGroupRing.mul_elemPow` — `(x y) ^ a = x ^ a · y ^ a`.
* `CyclicGroupRing.elemPow_zero`, `CyclicGroupRing.one_elemPow` — `x ^ 0 = 1`, `1 ^ a = 1`.
* `CyclicGroupRing.elemPow_neg`, `CyclicGroupRing.inv_elemPow` — `x ^ (-a) = (x ^ a)⁻¹`,
  `(x⁻¹) ^ a = (x ^ a)⁻¹`.
* `CyclicGroupRing.elemPow_ofModule` — in `ofModule`, `x ^ a = a • x`.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Examples.OT

open CatCryptCore.Examples.CyclicGroupDDH

namespace CyclicGroupRing

section Algebra

variable {G : Type} [CGR : CyclicGroupRing G]

/-- `x ^ (a + b) = x ^ a · x ^ b`. -/
theorem elemPow_add (x : G) (a b : CGR.Exp) :
    CyclicGroup.elemPow x (CGR.expAdd a b) =
      CGR.mul (CyclicGroup.elemPow x a) (CyclicGroup.elemPow x b) := by
  obtain ⟨e, rfl⟩ := CGR.pow_bij.2 x
  rw [CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow, CGR.expMul_add,
    CGR.pow_add]

/-- `x ^ (a b) = (x ^ a) ^ b`. -/
theorem elemPow_mul (x : G) (a b : CGR.Exp) :
    CyclicGroup.elemPow x (CGR.expMul a b) =
      CyclicGroup.elemPow (CyclicGroup.elemPow x a) b := by
  obtain ⟨e, rfl⟩ := CGR.pow_bij.2 x
  rw [CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow, CGR.expMul_assoc]

/-- `(x y) ^ a = x ^ a · y ^ a`. -/
theorem mul_elemPow (x y : G) (a : CGR.Exp) :
    CyclicGroup.elemPow (CGR.mul x y) a =
      CGR.mul (CyclicGroup.elemPow x a) (CyclicGroup.elemPow y a) := by
  obtain ⟨e, rfl⟩ := CGR.pow_bij.2 x
  obtain ⟨f, rfl⟩ := CGR.pow_bij.2 y
  rw [← CGR.pow_add, CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow,
    expAdd_mul, CGR.pow_add]

/-- `x ^ 0 = 1`. -/
theorem elemPow_zero (x : G) : CyclicGroup.elemPow x CGR.expZero = CGR.one := by
  obtain ⟨e, rfl⟩ := CGR.pow_bij.2 x
  rw [CyclicGroup.elemPow_pow, expZero_mul, CGR.pow_zero]

/-- `1 ^ a = 1`. -/
theorem one_elemPow (a : CGR.Exp) : CyclicGroup.elemPow CGR.one a = CGR.one := by
  rw [← CGR.pow_zero, CyclicGroup.elemPow_pow, expMul_zero]

/-- `x ^ (-a) = (x ^ a)⁻¹`. -/
theorem elemPow_neg (x : G) (a : CGR.Exp) :
    CyclicGroup.elemPow x (CGR.expNeg a) = CGR.inv (CyclicGroup.elemPow x a) := by
  obtain ⟨e, rfl⟩ := CGR.pow_bij.2 x
  rw [CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow, expMul_neg, pow_neg]

/-- `(x⁻¹) ^ a = (x ^ a)⁻¹`. -/
theorem inv_elemPow (x : G) (a : CGR.Exp) :
    CyclicGroup.elemPow (CGR.inv x) a = CGR.inv (CyclicGroup.elemPow x a) := by
  obtain ⟨e, rfl⟩ := CGR.pow_bij.2 x
  rw [← pow_neg, CyclicGroup.elemPow_pow, CyclicGroup.elemPow_pow, neg_expMul, pow_neg]

end Algebra

section OfModule

variable (q : ℕ) [Fact q.Prime] (M : Type) [AddCommGroup M] [Module (ZMod q) M] [Fintype M]

/-- The cyclic group with exponent ring of a `ZMod q`-module `M` (`q` prime) generated by `g`:
exponents are `ZMod q`, `pow a = a • g`, the group operation is addition of `M`, and the
exponent operations are those of the field `ZMod q`. The hypothesis `hg` states that
`a ↦ a • g` is a bijection `ZMod q ≃ M`. -/
@[reducible] noncomputable def ofModule (g : M)
    (hg : Function.Bijective fun a : ZMod q => a • g) : CyclicGroupRing M where
  Exp := ZMod q
  finG := inferInstance
  neG := ⟨0⟩
  finExp := inferInstance
  neExp := ⟨0⟩
  gen := g
  pow a := a • g
  mul := (· + ·)
  inv := Neg.neg
  expMul := (· * ·)
  expNeg := Neg.neg
  one := 0
  pow_comm a b := by rw [mul_comm]
  mul_assoc := add_assoc
  mul_comm := add_comm
  mul_inv := add_neg_cancel
  mul_one := add_zero
  pow_bij := hg
  expAdd := (· + ·)
  expZero := 0
  pow_add a b := add_smul a b g
  pow_zero := zero_smul _ g
  expAdd_comm := add_comm
  expAdd_assoc := add_assoc
  expAdd_zero := add_zero
  expAdd_neg := add_neg_cancel
  expMul_comm' := mul_comm
  expMul_add := mul_add
  expMul_assoc := mul_assoc
  expMul_bij d hd := (mulLeft_bijective₀ d hd)

variable {q M}

/-- In `ofModule`, exponentiation of a group element is scalar multiplication:
`x ^ a = a • x`. -/
theorem elemPow_ofModule (g : M) (hg : Function.Bijective fun a : ZMod q => a • g)
    (x : M) (a : ZMod q) :
    let _ : CyclicGroupRing M := ofModule q M g hg
    CyclicGroup.elemPow (G := M) x (show CyclicGroup.Exp M from a) = a • x := by
  intro inst
  obtain ⟨e, rfl⟩ := hg.2 x
  have h := CyclicGroup.elemPow_pow (G := M) (show CyclicGroup.Exp M from e)
    (show CyclicGroup.Exp M from a)
  exact h.trans (by change (e * a) • g = a • e • g; rw [smul_smul, mul_comm])

end OfModule

end CyclicGroupRing

end CatCrypt.Examples.OT
