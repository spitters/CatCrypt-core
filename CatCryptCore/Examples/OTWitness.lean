module

public import CatCryptCore.Examples.CyclicGroupRingPow

/-!
# Witness of message independence of the oblivious-transfer encryption

`otEnc_message_independent` quantifies over a cyclic group with exponent ring, the exponents
`a`, `b`, `d` with `d ≠ a * b`, and two messages. The theorem here applies it in the group
`zmodTwoCGR`, the additive group of `ZMod 2` generated by `1`, at `a = b = 0`, `d = 1` and the
messages `0`, `1`.

## Main definitions

* `zmodTwoCGR` — `ZMod 2` as a cyclic group with exponent ring `ZMod 2` and generator `1`

## Main results

* `otEnc_message_independent_witness` — the encryptions of `0` and `1` are equal in distribution
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Examples.OT

/-- `ZMod 2` as a cyclic group with exponent ring `ZMod 2`, generated by `1`. -/
@[reducible] noncomputable def zmodTwoCGR : CyclicGroupRing (ZMod 2) :=
  CyclicGroupRing.ofModule 2 (ZMod 2) 1 (by
    simp only [smul_eq_mul, mul_one]
    exact Function.bijective_id)

/-- `otEnc_message_independent` in `zmodTwoCGR` at `a = b = 0`, `d = 1` and the messages `0`,
`1`. -/
theorem otEnc_message_independent_witness :
    @otEnc (ZMod 2) zmodTwoCGR (0 : ZMod 2) (0 : ZMod 2) (1 : ZMod 2) 0 =
      @otEnc (ZMod 2) zmodTwoCGR (0 : ZMod 2) (0 : ZMod 2) (1 : ZMod 2) 1 := by
  refine @otEnc_message_independent (ZMod 2) zmodTwoCGR _ _ _ 0 1 ?_
  change (1 : ZMod 2) + -((0 : ZMod 2) * 0) ≠ 0
  decide

end CatCrypt.Examples.OT
