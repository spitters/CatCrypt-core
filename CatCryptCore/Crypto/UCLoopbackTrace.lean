/-!
# Step equivalence of systems and the category of port types

A state map `f` from a system `R` to a system `I` on an invariant `Inv` (`Sys.StepMapOn`) sends
the initial state to the initial state, keeps `Inv` on the possible outcomes of every step, and
commutes with single steps from the states satisfying `Inv`. These are the hypotheses of
`realizes_zero_of_stepMap_on`, so a step map gives a realization at distance `0`
(`Sys.StepMapOn.realizes`).

Step maps are preserved by the bounded loopback for every fuel and cut-off map
(`Sys.loopback_stepMap_on`), by the cascade `Sys.seq` of two systems (the outputs of the first
are the events of the second), by the parallel composition `Sys.par` and by relabelling the
ports with `Sys.mapPorts`.

Step equivalence `Sys.StepEq` is the equivalence relation on bundled systems `SysObj E O`
generated by step maps. It is a congruence for `seq`, `par`, `mapPorts` and `loopback`, and
step-equivalent systems realize one another at distance `0` (`Sys.StepEq.realizes`). The
category `SysCat` has types of ports as objects and systems modulo step equivalence as
morphisms; composition is the cascade and the identity is the stateless forwarding system.

Stateful systems on the outer ports and on the wire:

* a system `g` on the outer events commutes with the loopback for every fuel
  (`Sys.loopback_seq_left`, tightening on the event side);
* a system `h` on the outer outputs commutes with the loopback when the fuel is adequate for `S`
  (`Sys.loopback_seq_right`, tightening on the output side);
* a system `g` on the wire slides from the outputs of `S` to its events when the fuel is
  adequate for the loopback with `g` on the events (`Sys.loopback_seq_slide`).

On the output side and on the wire the cut-off map fires before `h` or `g` would take its step
on one side only, so these two laws are stated under `Sys.ExitsWithin`.

## Main definitions

* `Sys.StepMapOn R I Inv f`: `f` is a step map from `R` to `I` on `Inv`.
* `Sys.seq S T`: the cascade of `S` and `T`.
* `Sys.StepEq`: step equivalence of bundled systems.
* `SysCat`: types of ports, with `Category SysCat`.

## Main results

* `Sys.StepMapOn.realizes`: a step map gives a realization at distance `0`.
* `Sys.loopback_stepMap_on`: step maps under the loopback.
* `Sys.loopback_seq_left`, `Sys.loopback_seq_right`: tightening by stateful systems.
* `Sys.loopback_seq_slide`: sliding a stateful system along the wire.
* `Sys.StepEq.realizes`: step-equivalent systems realize one another at distance `0`.
* `Sys.StepEq.seq`, `Sys.StepEq.par`, `Sys.StepEq.mapPorts`, `Sys.StepEq.loopback`:
  congruence.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.UCTransparent

open CatCrypt.Core CatCrypt.Prob CatCrypt.Crypto CatCrypt.Crypto.UCConcrete
open scoped ENNReal

/-- A possible outcome of a map is the image of a possible outcome. -/
theorem exists_of_isOutcome_map {α β : Type} {c : SPComp α} {h : α → β} {b : β}
    (hb : IsOutcome (SPComp.map h c) b) : ∃ a, IsOutcome c a ∧ h a = b := by
  obtain ⟨a, ha, hab⟩ := isOutcome_bind hb
  exact ⟨a, ha, isOutcome_pure hab⟩

namespace Sys

variable {τ υ ρ τ' υ' E O P E' O' EG OG X : Type}

/-! ## Step maps on an invariant -/

/-- The state map `f` is a step map from `R` to `I` on the invariant `Inv`: `Inv` holds
initially, `f` sends the initial state of `R` to that of `I`, every possible outcome of a step
from a state satisfying `Inv` is at a state satisfying `Inv`, and `f` commutes with the steps
from the states satisfying `Inv`. -/
structure StepMapOn (R : Sys τ E O) (I : Sys υ E O) (Inv : τ → Prop) (f : τ → υ) : Prop where
  /-- The invariant holds initially. -/
  init_inv : Inv R.init
  /-- The initial state is mapped to the initial state. -/
  init_map : f R.init = I.init
  /-- The invariant holds at the possible outcomes of every step from a state satisfying it. -/
  pres : ∀ t e, Inv t → ∀ q, IsOutcome (R.step t e) q → Inv q.1
  /-- The map commutes with the steps from the states satisfying the invariant. -/
  step : ∀ t e, Inv t → SPComp.map (fun p => (f p.1, p.2)) (R.step t e) = I.step (f t) e

namespace StepMapOn

/-- A step map on an invariant gives a realization at distance `0`. -/
theorem realizes {R : Sys τ E O} {I : Sys υ E O} {Inv : τ → Prop} {f : τ → υ}
    (h : StepMapOn R I Inv f) : Realizes R I (fun _ _ => 0) :=
  realizes_zero_of_stepMap_on R I Inv f h.init_inv h.init_map
    (fun t e ht => exists_bind_pure_of_isOutcome _ (fun q : τ × O => Inv q.1) (h.pres t e ht))
    h.step

/-- The identity is a step map from a system to itself. -/
theorem refl (R : Sys τ E O) : StepMapOn R R (fun _ => True) id where
  init_inv := trivial
  init_map := rfl
  pres _ _ _ _ _ := trivial
  step t e _ := by simp [SPComp.map]

end StepMapOn

/-! ## The loopback -/

/-- A step map on an invariant commutes with the activation of the loopback, and the invariant
holds at its possible outcomes. -/
theorem fbRun_stepMap_on {S : Sys τ (E ⊕ X) (O ⊕ X)} {S' : Sys υ (E ⊕ X) (O ⊕ X)}
    {Inv : τ → Prop} {f : τ → υ} (h : StepMapOn S S' Inv f) (cut : X → O) :
    ∀ (m : ℕ) (g : E ⊕ X) (t : τ), Inv t →
      (∀ p, IsOutcome (fbRun S cut m g t) p → Inv p.1) ∧
      SPComp.map (fun p => (f p.1, p.2)) (fbRun S cut m g t) = fbRun S' cut m g (f t) := by
  intro m
  induction m with
  | zero =>
    intro g t ht
    refine ⟨fun p hp => ?_, ?_⟩
    · simp only [fbRun] at hp
      obtain ⟨q, hq, hpq⟩ := isOutcome_bind hp
      have hq' := h.pres t g ht q hq
      rcases q with ⟨t', o | x⟩ <;> obtain rfl := isOutcome_pure hpq <;> exact hq'
    · simp only [fbRun, ← h.step t g ht, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
      congr 1; funext q; rcases q with ⟨t', o | x⟩ <;> simp
  | succ m ih =>
    intro g t ht
    refine ⟨fun p hp => ?_, ?_⟩
    · simp only [fbRun] at hp
      obtain ⟨q, hq, hpq⟩ := isOutcome_bind hp
      have hq' := h.pres t g ht q hq
      rcases q with ⟨t', o | x⟩
      · obtain rfl := isOutcome_pure hpq
        exact hq'
      · exact (ih (.inr x) t' hq').1 p hpq
    · simp only [fbRun, ← h.step t g ht, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
      refine bind_congr_isOutcome fun q hq => ?_
      have hq' := h.pres t g ht q hq
      rcases q with ⟨t', o | x⟩
      · simp
      · simpa [SPComp.map] using (ih (.inr x) t' hq').2

/-- **Step maps under feedback.** A step map `f` from `S` to `S'` on `Inv` gives the step map
`Prod.map id f` from the loopback of `S` to the loopback of `S'` on the states whose second
component satisfies `Inv`, for every fuel and cut-off map. -/
theorem loopback_stepMap_on {S : Sys τ (E ⊕ X) (O ⊕ X)} {S' : Sys υ (E ⊕ X) (O ⊕ X)}
    {Inv : τ → Prop} {f : τ → υ} (h : StepMapOn S S' Inv f) (n : ℕ) (cut : X → O) :
    StepMapOn (S.loopback n cut) (S'.loopback n cut) (fun u => Inv u.2) (Prod.map id f) where
  init_inv := h.init_inv
  init_map := by
    change ((), f S.init) = ((), S'.init)
    rw [h.init_map]
  pres u e hu q hq := by
    rw [loopback_step] at hq
    obtain ⟨p, hp, rfl⟩ := exists_of_isOutcome_map hq
    exact (fbRun_stepMap_on h cut n _ _ hu).1 p hp
  step u e hu := by
    rw [loopback_step, loopback_step, Prod.map_snd, ← (fbRun_stepMap_on h cut n _ _ hu).2]
    simp [SPComp.map_comp, Function.comp_def]

/-! ## The cascade -/

/-- The cascade of `S` and `T`: the event `e` is a step of `S`, whose output is the event of a
step of `T`, whose output is the output of the cascade. -/
noncomputable def seq (S : Sys τ E O) (T : Sys υ O P) : Sys (τ × υ) E P where
  init := (S.init, T.init)
  step s e := SPComp.bind (S.step s.1 e) fun q =>
    SPComp.map (fun r => ((q.1, r.1), r.2)) (T.step s.2 q.2)

/-- Unfolding lemma of `seq`: a step. -/
theorem seq_step (S : Sys τ E O) (T : Sys υ O P) (s : τ × υ) (e : E) :
    (S.seq T).step s e = SPComp.bind (S.step s.1 e) fun q =>
      SPComp.map (fun r => ((q.1, r.1), r.2)) (T.step s.2 q.2) :=
  rfl

/-- Step maps of the two components give a step map of the cascade. -/
theorem StepMapOn.seq {S : Sys τ E O} {S' : Sys τ' E O} {T : Sys υ O P} {T' : Sys υ' O P}
    {Inv : τ → Prop} {Inv' : υ → Prop} {f : τ → τ'} {g : υ → υ'}
    (hS : StepMapOn S S' Inv f) (hT : StepMapOn T T' Inv' g) :
    StepMapOn (S.seq T) (S'.seq T') (fun s => Inv s.1 ∧ Inv' s.2) (Prod.map f g) where
  init_inv := ⟨hS.init_inv, hT.init_inv⟩
  init_map := by
    change (f S.init, g T.init) = (S'.init, T'.init)
    rw [hS.init_map, hT.init_map]
  pres s e hs q hq := by
    rw [seq_step] at hq
    obtain ⟨a, ha, hqa⟩ := isOutcome_bind hq
    obtain ⟨r, hr, rfl⟩ := exists_of_isOutcome_map hqa
    exact ⟨hS.pres _ _ hs.1 a ha, hT.pres _ _ hs.2 r hr⟩
  step s e hs := by
    have hT' : ∀ x, T'.step (g s.2) x = SPComp.map (fun p => (g p.1, p.2)) (T.step s.2 x) :=
      fun x => (hT.step s.2 x hs.2).symm
    rw [seq_step, seq_step, Prod.map_fst, Prod.map_snd, ← hS.step _ _ hs.1]
    simp only [hT', SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
    rfl

/-- The left cascade with a stateful system `g` on the outer events commutes with the loopback,
for every fuel and cut-off map (tightening on the event side): the loopback of `g` beside the
forwarding of the wire, cascaded into `S`, is `g` cascaded into the loopback of `S`. -/
theorem loopback_seq_left {γ : Type} (g : Sys γ E' E) (S : Sys τ (E ⊕ X) (O ⊕ X)) (n : ℕ)
    (cut : X → O) :
    StepMapOn (((g.par (ofFun (id : X → X))).seq S).loopback n cut) (g.seq (S.loopback n cut))
      (fun _ => True) (fun u => (u.2.1.1, ((), u.2.2))) := by
  set L := (g.par (ofFun (id : X → X))).seq S with hL
  have hstepR : ∀ (x : X) (c : γ) (v : Unit) (t : τ),
      L.step ((c, v), t) (.inr x) =
        SPComp.map (fun r => (((c, v), r.1), r.2)) (S.step t (.inr x)) := by
    intro x c v t
    simp [hL, seq_step, ofFun, SPComp.map]
  have hrunR : ∀ (m : ℕ) (x : X) (c : γ) (v : Unit) (t : τ),
      fbRun L cut m (.inr x) ((c, v), t) =
        SPComp.map (fun p => (((c, v), p.1), p.2)) (fbRun S cut m (.inr x) t) := by
    intro m
    induction m with
    | zero =>
      intro x c v t
      simp only [fbRun, hstepR, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
      congr 1; funext q; rcases q with ⟨t', o | x'⟩ <;> simp
    | succ m ih =>
      intro x c v t
      simp only [fbRun, hstepR, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
      congr 1; funext q; rcases q with ⟨t', o | x'⟩
      · simp
      · simpa [SPComp.map] using ih x' c v t'
  have hrunL : ∀ (m : ℕ) (e : E') (c : γ) (v : Unit) (t : τ),
      fbRun L cut m (.inl e) ((c, v), t) =
        SPComp.bind (g.step c e) fun q =>
          SPComp.map (fun p => (((q.1, v), p.1), p.2)) (fbRun S cut m (.inl q.2) t) := by
    intro m e c v t
    cases m <;>
    · simp only [fbRun, hL, seq_step, par_step_inl, SPComp.map, SPComp.bind_assoc,
        SPComp.pure_bind]
      congr 1; funext q; congr 1; funext r; rcases r with ⟨t', o | x'⟩
      · simp
      · simp [← hL, hrunR, SPComp.map]
  refine
    { init_inv := trivial
      init_map := rfl
      pres := fun _ _ _ _ _ => trivial
      step := ?_ }
  rintro ⟨_, ⟨c, v⟩, t⟩ e -
  rw [loopback_step, seq_step]
  simp only [loopback_step, hrunL, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]

/-- With adequate fuel, the activation of the loopback of `S` cascaded into `h` beside the
forwarding of the wire is the activation of the loopback of `S` followed by a step of `h`. -/
theorem fbRun_seq_right {ρ O' : Type} (S : Sys τ (E ⊕ X) (O ⊕ X)) (h : Sys ρ O O')
    {P : τ → Prop} (cut : X → O) (cut' : X → O') :
    ∀ (j : ℕ) {m : ℕ} {ev : E ⊕ X} {t : τ} (c : ρ) (v : Unit), S.ExitsBy P j ev t → j ≤ m →
      fbRun (S.seq (h.par (ofFun (id : X → X)))) cut' m ev (t, (c, v)) =
        SPComp.bind (fbRun S cut m ev t) fun p =>
          SPComp.map (fun r => ((p.1, (r.1, v)), r.2)) (h.step c p.2) := by
  intro j
  induction j with
  | zero =>
    intro m ev t c v hj _
    cases m <;>
    · simp only [fbRun, seq_step, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
      refine bind_congr_isOutcome ?_
      rintro ⟨t', o | x⟩ hq
      · simp [SPComp.map]
      · exact False.elim (hj _ hq)
  | succ j ih =>
    intro m ev t c v hj hjm
    obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
    simp only [fbRun, seq_step, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
    refine bind_congr_isOutcome ?_
    rintro ⟨t', o | x⟩ hq
    · simp [SPComp.map]
    · have := ih (m := m) (ev := .inr x) (t := t') c v (hj _ hq) (by omega)
      simpa [ofFun, SPComp.map] using this

/-- **Tightening on the output side.** When fuel `k ≤ n` is adequate for `S` on an invariant
that holds initially, the loopback of `S` cascaded into a stateful system `h` beside the
forwarding of the wire is the loopback of `S` cascaded into `h`, whatever the cut-off maps. -/
theorem loopback_seq_right {ρ O' : Type} (S : Sys τ (E ⊕ X) (O ⊕ X)) (h : Sys ρ O O')
    (Inv : τ → Prop) {k n : ℕ} (hkn : k ≤ n) (cut : X → O) (cut' : X → O')
    (hinit : Inv S.init) (hex : S.ExitsWithin Inv k) :
    StepMapOn ((S.seq (h.par (ofFun (id : X → X)))).loopback n cut')
      ((S.loopback n cut).seq h) (fun u => Inv u.2.1) (fun u => (((), u.2.1), u.2.2.1)) where
  init_inv := hinit
  init_map := rfl
  pres := by
    rintro ⟨_, t, c, v⟩ e ht q hq
    rw [loopback_step, fbRun_seq_right S h cut cut' k c v (hex t ht e) hkn] at hq
    obtain ⟨p, hp, rfl⟩ := exists_of_isOutcome_map hq
    obtain ⟨a, ha, hpa⟩ := isOutcome_bind hp
    obtain ⟨r, -, rfl⟩ := exists_of_isOutcome_map hpa
    rw [fbRun_eq_of_exitsBy cut cut k (hex t ht e) hkn] at ha
    exact fbRun_isOutcome_of_exitsBy cut k (hex t ht e) a ha
  step := by
    rintro ⟨_, t, c, v⟩ e ht
    rw [loopback_step, seq_step, fbRun_seq_right S h cut cut' k c v (hex t ht e) hkn]
    simp only [loopback_step, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]

/-- The continuation of the loopback of `T` after the wire output `y`, with `m` further calls
allowed: `y` is the next event when a call is left, and is ended with `cut y` otherwise. -/
noncomputable def fbCont {σ Y : Type} (T : Sys σ (E ⊕ Y) (O ⊕ Y)) (cut : Y → O) :
    ℕ → Y → σ → SPComp (σ × O)
  | 0, y, s => SPComp.pure (s, cut y)
  | m + 1, y, s => fbRun T cut m (.inr y) s

/-- The activation of the loopback is a step followed by `fbCont` on a wire output. -/
theorem fbRun_eq_bind_fbCont {σ Y : Type} (T : Sys σ (E ⊕ Y) (O ⊕ Y)) (cut : Y → O) (m : ℕ)
    (ev : E ⊕ Y) (s : σ) :
    fbRun T cut m ev s = SPComp.bind (T.step s ev) fun q =>
      Sum.elim (fun o => SPComp.pure (q.1, o)) (fun y => fbCont T cut m y q.1) q.2 := by
  cases m <;> rfl

/-- Two families of continuations that unfold by the same recursion over the steps of `T` agree
after a step from which the loopback exits within `j ≤ m`, whatever their values at fuel `0`. -/
theorem bind_cont_congr_of_exitsBy {σ Y : Type} (T : Sys σ (E ⊕ Y) (O ⊕ Y)) {P : σ → Prop}
    (A B : ℕ → Y → σ → SPComp (σ × O))
    (hA : ∀ m y s, A (m + 1) y s = SPComp.bind (T.step s (.inr y)) fun q =>
      Sum.elim (fun o => SPComp.pure (q.1, o)) (fun y' => A m y' q.1) q.2)
    (hB : ∀ m y s, B (m + 1) y s = SPComp.bind (T.step s (.inr y)) fun q =>
      Sum.elim (fun o => SPComp.pure (q.1, o)) (fun y' => B m y' q.1) q.2) :
    ∀ (j : ℕ) {m : ℕ} {ev : E ⊕ Y} {s : σ}, T.ExitsBy P j ev s → j ≤ m →
      (SPComp.bind (T.step s ev) fun q =>
        Sum.elim (fun o => SPComp.pure (q.1, o)) (fun y => A m y q.1) q.2) =
      SPComp.bind (T.step s ev) fun q =>
        Sum.elim (fun o => SPComp.pure (q.1, o)) (fun y => B m y q.1) q.2 := by
  intro j
  induction j with
  | zero =>
    intro m ev s h _
    refine bind_congr_isOutcome ?_
    rintro ⟨s', o | y⟩ hq
    · rfl
    · exact False.elim (h _ hq)
  | succ j ih =>
    intro m ev s h hjm
    obtain ⟨m, rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
    refine bind_congr_isOutcome ?_
    rintro ⟨s', o | y⟩ hq
    · rfl
    · simp only [Sum.elim_inr]
      rw [hA, hB]
      exact ih (h _ hq) (by omega)

/-- **Sliding a stateful system along the wire.** For `S` on `(E ⊕ X, O ⊕ Y)` and a system `g`
from `Y` to `X`: when fuel `k ≤ n` is adequate, on an invariant that holds initially, for the
loopback along `Y` of `g` placed before `S`, the loopback along `X` of `g` placed after `S` is
that loopback, whatever the cut-off maps. The state map swaps the states of `S` and `g`. -/
theorem loopback_seq_slide {γ Y : Type} (S : Sys τ (E ⊕ X) (O ⊕ Y)) (g : Sys γ Y X)
    (Inv : (Unit × γ) × τ → Prop) {k n : ℕ} (hkn : k ≤ n) (cutL : X → O) (cutR : Y → O)
    (hinit : Inv (((ofFun (id : E → E)).par g).seq S).init)
    (hex : (((ofFun (id : E → E)).par g).seq S).ExitsWithin Inv k) :
    StepMapOn ((S.seq ((ofFun (id : O → O)).par g)).loopback n cutL)
      ((((ofFun (id : E → E)).par g).seq S).loopback n cutR) (fun u => Inv u.2.swap)
      (Prod.map id Prod.swap) := by
  set SL := S.seq ((ofFun (id : O → O)).par g) with hSL
  set SR := ((ofFun (id : E → E)).par g).seq S with hSR
  let LC : ℕ → Y → (Unit × γ) × τ → SPComp (((Unit × γ) × τ) × O) := fun m y s' =>
    SPComp.map (fun p => (p.1.swap, p.2)) (SPComp.bind (g.step s'.1.2 y) fun q2 =>
      fbCont SL cutL m q2.2 (s'.2, (s'.1.1, q2.1)))
  have hLC : ∀ m y s', LC (m + 1) y s' = SPComp.bind (SR.step s' (.inr y)) fun q =>
      Sum.elim (fun o => SPComp.pure (q.1, o)) (fun y' => LC m y' q.1) q.2 := by
    rintro m y ⟨⟨w, c⟩, t⟩
    simp only [LC, fbCont.eq_2, fbRun_eq_bind_fbCont _ cutL m, hSL, hSR, seq_step,
      par_step_inr, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
    congr 1; funext a; congr 1; funext q; rcases q with ⟨t', o | y'⟩
    · simp [ofFun]
    · simp [SPComp.map]
  have hI1 : ∀ t w c e,
      SPComp.map (fun p => (p.1.swap, p.2)) (fbRun SL cutL n (.inl e) (t, (w, c))) =
        SPComp.bind (SR.step ((w, c), t) (.inl e)) fun q =>
        Sum.elim (fun o => SPComp.pure (q.1, o)) (fun y => LC n y q.1) q.2 := by
    intro t w c e
    simp only [LC, fbRun_eq_bind_fbCont _ cutL n, hSL, hSR, seq_step, par_step_inl, ofFun,
      SPComp.map, SPComp.bind_assoc, SPComp.pure_bind]
    congr 1; funext q; rcases q with ⟨t', o | y'⟩
    · simp
    · simp [SPComp.map]
  have hrun : ∀ t w c e, Inv ((w, c), t) →
      SPComp.map (fun p => (p.1.swap, p.2)) (fbRun SL cutL n (.inl e) (t, (w, c))) =
        fbRun SR cutR n (.inl e) ((w, c), t) := by
    intro t w c e ht
    rw [hI1, fbRun_eq_bind_fbCont SR]
    exact bind_cont_congr_of_exitsBy SR LC (fbCont SR cutR) hLC
      (fun m y s => fbRun_eq_bind_fbCont SR cutR m (.inr y) s) k (hex _ ht e) hkn
  have hstep : ∀ u e, Inv u.2.swap →
      SPComp.map (fun p => (Prod.map id Prod.swap p.1, p.2)) (SL.loopback n cutL |>.step u e) =
        (SR.loopback n cutR).step (Prod.map id Prod.swap u) e := by
    rintro ⟨u, t, w, c⟩ e ht
    rw [loopback_step, loopback_step]
    change _ = SPComp.map _ (fbRun SR cutR n (.inl e) ((w, c), t))
    rw [← hrun t w c e ht]
    simp [SPComp.map_comp, Function.comp_def]
  refine
    { init_inv := hinit
      init_map := rfl
      pres := ?_
      step := hstep }
  rintro ⟨u, t, w, c⟩ e ht q hq
  have hq' := isOutcome_map (fun p => (Prod.map id Prod.swap p.1, p.2)) hq
  rw [hstep _ e ht, loopback_step] at hq'
  obtain ⟨p, hp, hpq⟩ := exists_of_isOutcome_map hq'
  change IsOutcome (fbRun SR cutR n (.inl e) ((w, c), t)) p at hp
  change Inv ((w, c), t) at ht
  rw [fbRun_eq_of_exitsBy cutR cutR k (hex _ ht e) hkn] at hp
  have := fbRun_isOutcome_of_exitsBy cutR k (hex _ ht e) p hp
  grind

/-! ## Parallel composition and relabelling -/

/-- Step maps of the two components give a step map of their parallel composition. -/
theorem StepMapOn.par {S : Sys τ E O} {S' : Sys τ' E O} {T : Sys υ E' O'}
    {T' : Sys υ' E' O'} {Inv : τ → Prop} {Inv' : υ → Prop} {f : τ → τ'} {g : υ → υ'}
    (hS : StepMapOn S S' Inv f) (hT : StepMapOn T T' Inv' g) :
    StepMapOn (S.par T) (S'.par T') (fun s => Inv s.1 ∧ Inv' s.2) (Prod.map f g) where
  init_inv := ⟨hS.init_inv, hT.init_inv⟩
  init_map := by
    change (f S.init, g T.init) = (S'.init, T'.init)
    rw [hS.init_map, hT.init_map]
  pres s e hs q hq := by
    rcases e with e | e
    · rw [par_step_inl] at hq
      obtain ⟨r, hr, rfl⟩ := exists_of_isOutcome_map hq
      exact ⟨hS.pres _ _ hs.1 r hr, hs.2⟩
    · rw [par_step_inr] at hq
      obtain ⟨r, hr, rfl⟩ := exists_of_isOutcome_map hq
      exact ⟨hs.1, hT.pres _ _ hs.2 r hr⟩
  step s e hs := by
    rcases e with e | e
    · rw [par_step_inl, par_step_inl, Prod.map_fst, ← hS.step _ _ hs.1]
      simp [SPComp.map_comp, Function.comp_def]
    · rw [par_step_inr, par_step_inr, Prod.map_snd, ← hT.step _ _ hs.2]
      simp [SPComp.map_comp, Function.comp_def]

/-- A step map gives a step map of the relabelled systems. -/
theorem StepMapOn.mapPorts {S : Sys τ EG OG} {S' : Sys τ' EG OG} {Inv : τ → Prop}
    {f : τ → τ'} (h : StepMapOn S S' Inv f) (fe : E → EG) (fo : OG → O) :
    StepMapOn (S.mapPorts fe fo) (S'.mapPorts fe fo) Inv f where
  init_inv := h.init_inv
  init_map := h.init_map
  pres t e ht q hq := by
    rw [mapPorts_step] at hq
    obtain ⟨r, hr, rfl⟩ := exists_of_isOutcome_map hq
    exact h.pres _ _ ht r hr
  step t e ht := by
    rw [mapPorts_step, mapPorts_step, ← h.step _ _ ht]
    simp [SPComp.map_comp, Function.comp_def]

/-! ## Step equivalence -/

/-- `A` and `B` are related by a step map on an invariant. -/
def StepRel (A B : SysObj E O) : Prop :=
  ∃ (Inv : A.St → Prop) (f : A.St → B.St), StepMapOn A.sys B.sys Inv f

/-- Step equivalence: the equivalence relation generated by step maps on invariants. -/
def StepEq : SysObj E O → SysObj E O → Prop :=
  Relation.EqvGen StepRel

/-- A step map on an invariant gives step equivalence. -/
theorem StepMapOn.stepEq {R : Sys τ E O} {I : Sys υ E O} {Inv : τ → Prop} {f : τ → υ}
    (h : StepMapOn R I Inv f) : StepEq ⟨τ, R⟩ ⟨υ, I⟩ :=
  Relation.EqvGen.rel _ _ ⟨Inv, f, h⟩

/-- **Step-equivalent systems realize one another at distance `0`.** -/
theorem StepEq.realizes {A B : SysObj E O} (h : StepEq A B) :
    Realizes A.sys B.sys (fun _ _ => 0) ∧ Realizes B.sys A.sys (fun _ _ => 0) := by
  induction h with
  | rel A B h =>
    obtain ⟨Inv, f, h⟩ := h
    exact ⟨h.realizes, fun ζ => (h.realizes ζ).symm⟩
  | refl A => exact ⟨fun _ => DistC.refl _, fun _ => DistC.refl _⟩
  | symm A B _ ih => exact ⟨ih.2, ih.1⟩
  | trans A B C _ _ ih₁ ih₂ =>
    exact ⟨fun ζ => ((ih₁.1 ζ).triangle (ih₂.1 ζ)).mono fun _ => by simp,
      fun ζ => ((ih₂.2 ζ).triangle (ih₁.2 ζ)).mono fun _ => by simp⟩

/-- A map of bundled systems that sends step maps to step maps preserves step equivalence. -/
theorem StepEq.map {E₁ O₁ E₂ O₂ : Type} (F : SysObj E₁ O₁ → SysObj E₂ O₂)
    (hF : ∀ A B, StepRel A B → StepRel (F A) (F B)) {A B : SysObj E₁ O₁} (h : StepEq A B) :
    StepEq (F A) (F B) := by
  induction h with
  | rel A B h => exact Relation.EqvGen.rel _ _ (hF A B h)
  | refl A => exact Relation.EqvGen.refl _
  | symm A B _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans A B C _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

end Sys

namespace SysObj

open Sys

variable {E O P E' O' EG OG X : Type}

/-- The cascade of bundled systems. -/
noncomputable def seq (A : SysObj E O) (B : SysObj O P) : SysObj E P :=
  ⟨A.St × B.St, A.sys.seq B.sys⟩

/-- The parallel composition of bundled systems. -/
noncomputable def par (A : SysObj E O) (B : SysObj E' O') : SysObj (E ⊕ E') (O ⊕ O') :=
  ⟨A.St × B.St, A.sys.par B.sys⟩

/-- A bundled system on relabelled ports. -/
noncomputable def mapPorts (A : SysObj EG OG) (fe : E → EG) (fo : OG → O) : SysObj E O :=
  ⟨A.St, A.sys.mapPorts fe fo⟩

/-- The loopback of a bundled system. -/
noncomputable def loopback (A : SysObj (E ⊕ X) (O ⊕ X)) (n : ℕ) (cut : X → O) : SysObj E O :=
  ⟨Unit × A.St, A.sys.loopback n cut⟩

/-- The stateless forwarding system. -/
noncomputable def idSys (E : Type) : SysObj E E :=
  ⟨Unit, ofFun id⟩

end SysObj

namespace Sys

variable {E O P E' O' EG OG X : Type}

/-- Step equivalence is a congruence for the cascade. -/
theorem StepEq.seq {A A' : SysObj E O} {B B' : SysObj O P} (hA : StepEq A A')
    (hB : StepEq B B') : StepEq (A.seq B) (A'.seq B') := by
  refine Relation.EqvGen.trans _ (A'.seq B) _ ?_ ?_
  · exact StepEq.map (fun A => A.seq B)
      (fun _ _ ⟨_, _, h⟩ => ⟨_, _, h.seq (StepMapOn.refl B.sys)⟩) hA
  · exact StepEq.map (fun B => A'.seq B)
      (fun _ _ ⟨_, _, h⟩ => ⟨_, _, (StepMapOn.refl A'.sys).seq h⟩) hB

/-- Step equivalence is a congruence for the parallel composition. -/
theorem StepEq.par {A A' : SysObj E O} {B B' : SysObj E' O'} (hA : StepEq A A')
    (hB : StepEq B B') : StepEq (A.par B) (A'.par B') := by
  refine Relation.EqvGen.trans _ (A'.par B) _ ?_ ?_
  · exact StepEq.map (fun A => A.par B)
      (fun _ _ ⟨_, _, h⟩ => ⟨_, _, h.par (StepMapOn.refl B.sys)⟩) hA
  · exact StepEq.map (fun B => A'.par B)
      (fun _ _ ⟨_, _, h⟩ => ⟨_, _, (StepMapOn.refl A'.sys).par h⟩) hB

/-- Step equivalence is a congruence for relabelling the ports. -/
theorem StepEq.mapPorts {A A' : SysObj EG OG} (h : StepEq A A') (fe : E → EG) (fo : OG → O) :
    StepEq (A.mapPorts fe fo) (A'.mapPorts fe fo) :=
  StepEq.map (fun A => A.mapPorts fe fo) (fun _ _ ⟨_, _, h⟩ => ⟨_, _, h.mapPorts fe fo⟩) h

/-- Step equivalence is a congruence for the loopback, for every fuel and cut-off map. -/
theorem StepEq.loopback {A A' : SysObj (E ⊕ X) (O ⊕ X)} (h : StepEq A A') (n : ℕ)
    (cut : X → O) : StepEq (A.loopback n cut) (A'.loopback n cut) :=
  StepEq.map (fun A => A.loopback n cut)
    (fun _ _ ⟨_, _, h⟩ => ⟨_, _, loopback_stepMap_on h n cut⟩) h

/-! ## Unit and associativity laws of the cascade -/

/-- The forwarding system cascaded before `S`: `Prod.snd` is a step map to `S`. -/
theorem StepMapOn.id_seq {τ : Type} (S : Sys τ E O) :
    StepMapOn ((ofFun id).seq S) S (fun _ => True) Prod.snd where
  init_inv := trivial
  init_map := rfl
  pres _ _ _ _ _ := trivial
  step s e _ := by
    simp [seq_step, ofFun, SPComp.map]

/-- The forwarding system cascaded after `S`: `Prod.fst` is a step map to `S`. -/
theorem StepMapOn.seq_id {τ : Type} (S : Sys τ E O) :
    StepMapOn (S.seq (ofFun id)) S (fun _ => True) Prod.fst where
  init_inv := trivial
  init_map := rfl
  pres _ _ _ _ _ := trivial
  step s e _ := by
    simp [seq_step, ofFun, SPComp.map]

/-- Reassociation of the states is a step map between the two cascades of three systems. -/
theorem StepMapOn.seq_assoc {τ υ ρ Q : Type} (S : Sys τ E O) (T : Sys υ O P)
    (U : Sys ρ P Q) :
    StepMapOn ((S.seq T).seq U) (S.seq (T.seq U)) (fun _ => True)
      (fun s => (s.1.1, (s.1.2, s.2))) where
  init_inv := trivial
  init_map := rfl
  pres _ _ _ _ _ := trivial
  step s e _ := by
    simp [seq_step, SPComp.map]

/-- The forwarding system cascaded before `A` is step equivalent to `A`. -/
theorem StepEq.id_seq (A : SysObj E O) : StepEq ((SysObj.idSys E).seq A) A :=
  (StepMapOn.id_seq A.sys).stepEq

/-- The forwarding system cascaded after `A` is step equivalent to `A`. -/
theorem StepEq.seq_id (A : SysObj E O) : StepEq (A.seq (SysObj.idSys O)) A :=
  (StepMapOn.seq_id A.sys).stepEq

/-- The cascade is associative up to step equivalence. -/
theorem StepEq.seq_assoc {Q : Type} (A : SysObj E O) (B : SysObj O P) (C : SysObj P Q) :
    StepEq ((A.seq B).seq C) (A.seq (B.seq C)) :=
  (StepMapOn.seq_assoc A.sys B.sys C.sys).stepEq

end Sys

/-! ## The category of port types -/

/-- Step equivalence as a setoid on bundled systems. -/
instance SysObj.stepSetoid (E O : Type) : Setoid (SysObj E O) :=
  ⟨Sys.StepEq, Relation.EqvGen.is_equivalence _⟩

/-- A type of ports. -/
structure SysCat : Type 1 where
  /-- The ports. -/
  P : Type

open CategoryTheory in
/-- The category of port types: a morphism from `X` to `Y` is a system with events `X.P` and
outputs `Y.P` modulo step equivalence; composition is the cascade and the identity is the
forwarding system. -/
noncomputable instance SysCat.category : Category.{1} SysCat where
  Hom X Y := Quotient (SysObj.stepSetoid X.P Y.P)
  id X := ⟦SysObj.idSys X.P⟧
  comp := Quotient.map₂ SysObj.seq fun _ _ h₁ _ _ h₂ => Sys.StepEq.seq h₁ h₂
  id_comp := by
    rintro X Y ⟨A⟩
    exact Quotient.sound (Sys.StepEq.id_seq A)
  comp_id := by
    rintro X Y ⟨A⟩
    exact Quotient.sound (Sys.StepEq.seq_id A)
  assoc := by
    rintro W X Y Z ⟨A⟩ ⟨B⟩ ⟨C⟩
    exact Quotient.sound (Sys.StepEq.seq_assoc A B C)

end CatCrypt.Crypto.UCTransparent
