module

public import CatCryptCore.Tactics.DeriveCsimp
public import CatCryptCore.Tactics.StdCosts

/-!
# Unique values read from an oracle log

A straight-line extractor reads values from the entries of the challenger's tables: the value
of the unique entry at a point, the unique preimage of a digest, the unique seed of a leaf
commitment. Each is the unique `a` such that `g x = some a` for an entry `x` of the log, where
`g : E → Option α` reads a candidate from an entry, and `none` when there is no such `a` or more
than one. The definitions below state this value by classical choice; `@[csimp]` theorems,
generated by `derive_csimp`, replace them by searches, so that an extractor written with them is
computable and its cost is derived.

* `logUnique g L` — over a list `L` of entries. The search `logUniqueSearch` takes the first
  value read from `L` (`List.findSome?`) and checks that no entry reads another value
  (`List.any`): two passes, linear in the length of `L` (`logUnique.timedCost_le`).
* `finUnique g s` — over a finite set `s`, for candidates read from an enumerated finite type
  (the seeds of a leaf map). The search `finUniqueSearch` folds the values read from `s` in the
  commutative monoid `UniqAcc α` (no value, one value, conflicting values) by `Finset.sum`,
  so that it is well defined on the quotient; one pass over `s` (`finUnique.timedCost_le`).

Both equal the classical choice of the unique `a` of a predicate `p` whose witnesses are exactly
the values read (`logUnique_eq_choose`, `finUnique_eq_choose`).

## Main definitions

* `logUnique`, `logUniqueSearch` — the unique value read from a list, and its search
* `UniqAcc` — the monoid of unique-value accumulation
* `finUnique`, `finUniqueSearch` — the unique value read from a finite set, and its search

## Main results

* `logUniqueSearch_eq`, `finUniqueSearch_eq` — the searches compute the classical definitions
* `logUnique_eq_choose`, `finUnique_eq_choose` — the classical choice of a unique witness
* `logUnique.timedCost_le`, `finUnique.timedCost_le` — linear time bounds
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.FiatShamirROM

variable {E α : Type}

/-! ## Over a list -/

open Classical in
/-- **The unique value read from the log `L`**: the `a` with `g x = some a` for some entry
`x ∈ L`, when there is exactly one, chosen classically, and `none` otherwise. -/
noncomputable def logUnique [DecidableEq α] (g : E → Option α) (L : List E) : Option α :=
  if h : ∃! a, ∃ x ∈ L, g x = some a then some h.exists.choose else none

/-- The entry `x` reads a value other than `a`. -/
def readsOther [DecidableEq α] (g : E → Option α) (a : α) (x : E) : Bool :=
  match g x with
  | some b => if b = a then false else true
  | none => false

/-- The search for the unique value read from `L`: the first value read, when no entry reads
another one. -/
def logUniqueSearch [DecidableEq α] (g : E → Option α) (L : List E) : Option α :=
  match L.findSome? g with
  | none => none
  | some a => if L.any (readsOther g a) then none else some a

theorem logUnique_eq_some [DecidableEq α] {g : E → Option α} {L : List E} {a : α}
    (ha : ∃ x ∈ L, g x = some a) (hu : ∀ x ∈ L, ∀ b, g x = some b → b = a) :
    logUnique g L = some a := by
  have h : ∃! a, ∃ x ∈ L, g x = some a :=
    ⟨a, ha, fun b ⟨x, hx, hb⟩ => hu x hx b hb⟩
  rw [logUnique, dite_eq_left_of_eq_true (eq_true h)]
  obtain ⟨x, hx, hb⟩ := h.exists.choose_spec
  exact congrArg some (hu x hx _ hb)

theorem logUnique_eq_none [DecidableEq α] {g : E → Option α} {L : List E}
    (h : ¬ ∃! a, ∃ x ∈ L, g x = some a) : logUnique g L = none := by
  rw [logUnique, dite_eq_right_of_eq_false (eq_false h)]

/-- The search computes the unique value read from the log. -/
theorem logUniqueSearch_eq [DecidableEq α] (g : E → Option α) (L : List E) :
    logUniqueSearch g L = logUnique g L := by
  unfold logUniqueSearch
  cases hf : L.findSome? g with
  | none =>
    dsimp only
    rw [List.findSome?_eq_none_iff] at hf
    refine (logUnique_eq_none ?_).symm
    rintro ⟨a, ⟨x, hx, hxa⟩, _⟩
    simp [hf x hx] at hxa
  | some a =>
    obtain ⟨x, hx, hxa⟩ := List.exists_of_findSome?_eq_some hf
    by_cases hany : L.any (readsOther g a) = true
    · dsimp only
      simp only [hany, ↓reduceIte]
      obtain ⟨y, hy, hyo⟩ := List.any_eq_true.1 hany
      refine (logUnique_eq_none ?_).symm
      rintro ⟨c, _, hc⟩
      unfold readsOther at hyo
      split at hyo
      · next b hb =>
        split at hyo
        · simp at hyo
        · next hba =>
          exact hba ((hc b ⟨y, hy, hb⟩).trans (hc a ⟨x, hx, hxa⟩).symm)
      · simp at hyo
    · dsimp only
      simp only [hany]
      refine (logUnique_eq_some ⟨x, hx, hxa⟩ fun y hy b hb => ?_).symm
      have hno : readsOther g a y = false := by
        simp only [Bool.not_eq_true, List.any_eq_false] at hany
        simpa using hany y hy
      unfold readsOther at hno
      rw [hb] at hno
      by_contra hba
      simp [hba] at hno

derive_csimp logUnique via eq logUniqueSearch_eq

/-- **Unique value read from a log, as the classical choice of a unique witness**: for a
predicate `p` whose witnesses are the values read from `L`. -/
theorem logUnique_eq_choose [DecidableEq α] (g : E → Option α) (L : List E) (p : α → Prop)
    (hp : ∀ a, p a ↔ ∃ x ∈ L, g x = some a) :
    logUnique g L =
      (by classical exact if h : ∃! a, p a then some h.exists.choose else none) := by
  have hpe : p = fun a => ∃ x ∈ L, g x = some a := funext fun a => propext (hp a)
  subst hpe
  rfl

/-- **Time of the search over a log**: two passes over `L`, each entry read at cost at most
`k`. -/
theorem logUnique.timedCost_le [DecidableEq α] (g : E → Option α) (gCost : E → ℕ) {k : ℕ}
    (hg : ∀ x, gCost x ≤ k) (L : List E) :
    logUnique.timedCost g gCost L ≤ (2 * k + 13) * L.length + 7 := by
  unfold logUnique.timedCost logUnique.csimpImpl.timedCost
  have h1 := List.findSome?.timedCost_le g gCost hg L
  have hp : ∀ x, 2 + (1 + gCost x + (match g x with | some _ => 1 | none => 0)) ≤ k + 4 :=
    fun x => by have := hg x; split <;> omega
  have h2 : ∀ a, List.any.timedCost L (readsOther g a) (fun x => 2 + (1 + gCost x +
      (match g x with | some _ => 1 | none => 0))) ≤ (k + 4 + 5) * L.length + 1 :=
    fun a => List.any.timedCost_le L _ _ hp
  have he : (k + 4) * L.length + (k + 4 + 5) * L.length = (2 * k + 13) * L.length := by ring
  split
  · omega
  · next a _ => have := h2 a; omega

/-! ## Over a finite set -/

/-- **The accumulator of a unique value**: no value read, one value `a`, or two distinct
values. -/
inductive UniqAcc (α : Type) where
  /-- No value read. -/
  | none
  /-- Every value read is `a`. -/
  | one (a : α)
  /-- Two distinct values read. -/
  | many

namespace UniqAcc

instance : Zero (UniqAcc α) := ⟨.none⟩

variable [DecidableEq α]

/-- The combination of two accumulators. -/
def add : UniqAcc α → UniqAcc α → UniqAcc α
  | .none, u => u
  | .one a, .none => .one a
  | .one a, .one b => if a = b then .one a else .many
  | .one _, .many => .many
  | .many, _ => .many

instance : Add (UniqAcc α) := ⟨add⟩

omit [DecidableEq α] in
/-- Unfolding lemma of the zero of `UniqAcc α`. -/
theorem zero_def : (0 : UniqAcc α) = .none := rfl

/-- Unfolding lemma of the addition of `UniqAcc α`. -/
theorem add_def (u v : UniqAcc α) : u + v = add u v := rfl

instance : AddCommMonoid (UniqAcc α) where
  add_assoc a b c := by
    simp only [add_def]
    cases a <;> cases b <;> cases c <;> simp only [add] <;> split_ifs <;> grind [add]
  zero_add a := by cases a <;> rfl
  add_zero a := by cases a <;> rfl
  add_comm a b := by
    simp only [add_def]
    cases a <;> cases b <;> simp only [add]
    all_goals grind
  nsmul := nsmulRec

/-- The accumulator of one optional value. -/
def ofOpt : Option α → UniqAcc α
  | some a => .one a
  | Option.none => .none

/-- The unique value of an accumulator. -/
def get : UniqAcc α → Option α
  | .one a => some a
  | _ => Option.none

end UniqAcc

/-- The accumulated values read from `L` characterize the values read: none, or one value `a`
that every entry reading a value reads. -/
theorem UniqAcc.sum_map_ofOpt [DecidableEq α] (g : E → Option α) (L : List E) :
    ((L.map fun x => UniqAcc.ofOpt (g x)).sum = .none ↔ ∀ x ∈ L, g x = Option.none) ∧
    ∀ a, ((L.map fun x => UniqAcc.ofOpt (g x)).sum = .one a ↔
      (∃ x ∈ L, g x = some a) ∧ ∀ x ∈ L, ∀ b, g x = some b → b = a) := by
  induction L with
  | nil => simp [UniqAcc.zero_def]
  | cons y L ih =>
    simp only [List.map_cons, List.sum_cons, List.mem_cons, forall_eq_or_imp, exists_eq_or_imp]
    generalize (L.map fun x => UniqAcc.ofOpt (g x)).sum = S at ih ⊢
    obtain ⟨ih0, ih1⟩ := ih
    cases hy : g y <;> cases S <;>
      simp only [UniqAcc.ofOpt, UniqAcc.add_def, UniqAcc.add, reduceCtorEq,
        false_iff] at ih0 ih1 ⊢ <;> try grind
    refine ⟨fun h => h.1, fun a ⟨_, _, hu⟩ => ?_⟩
    obtain ⟨w, hw, hgw⟩ : ∃ w ∈ L, g w ≠ Option.none := by
      by_contra hn
      exact ih0 fun x hx => by_contra fun hx' => hn ⟨x, hx, hx'⟩
    obtain ⟨b, hb⟩ := Option.ne_none_iff_exists'.1 hgw
    exact ih1 a ⟨⟨w, hw, (hu w hw b hb) ▸ hb⟩, hu⟩

/-- The unique value of the accumulated values read from `L` is the unique value read from
`L`. -/
theorem UniqAcc.get_sum_map_ofOpt [DecidableEq α] (g : E → Option α) (L : List E) :
    ((L.map fun x => UniqAcc.ofOpt (g x)).sum).get = logUnique g L := by
  obtain ⟨h0, h1⟩ := UniqAcc.sum_map_ofOpt g L
  generalize (L.map fun x => UniqAcc.ofOpt (g x)).sum = S at h0 h1 ⊢
  cases S with
  | none =>
    refine (logUnique_eq_none ?_).symm
    rintro ⟨a, ⟨x, hx, hxa⟩, _⟩
    simp [h0.1 rfl x hx] at hxa
  | one a =>
    obtain ⟨ha, hu⟩ := (h1 a).1 rfl
    exact (logUnique_eq_some ha hu).symm
  | many =>
    refine (logUnique_eq_none ?_).symm
    rintro ⟨a, ha, hu⟩
    have := (h1 a).2 ⟨ha, fun x hx b hb => hu b ⟨x, hx, hb⟩⟩
    cases this

open Classical in
/-- **The unique value read from the finite set `s`**: the `a` with `g x = some a` for some
`x ∈ s`, when there is exactly one, chosen classically, and `none` otherwise. -/
noncomputable def finUnique {β : Type} [DecidableEq α] (g : β → Option α) (s : Finset β) :
    Option α :=
  if h : ∃! a, ∃ x ∈ s, g x = some a then some h.exists.choose else none

/-- The search for the unique value read from `s`: the values read, accumulated in
`UniqAcc α`. -/
def finUniqueSearch {β : Type} [DecidableEq α] (g : β → Option α) (s : Finset β) : Option α :=
  (∑ x ∈ s, UniqAcc.ofOpt (g x)).get

/-- The search computes the unique value read from the finite set. -/
theorem finUniqueSearch_eq {β : Type} [DecidableEq α] (g : β → Option α) (s : Finset β) :
    finUniqueSearch g s = finUnique g s := by
  have hs : finUnique g s = logUnique g s.toList := by
    rw [logUnique_eq_choose g s.toList (fun a => ∃ x ∈ s, g x = some a) (by simp)]
    rfl
  have hsum : ∑ x ∈ s, UniqAcc.ofOpt (g x) = (s.toList.map fun x => UniqAcc.ofOpt (g x)).sum :=
    (Finset.sum_map_toList s _).symm
  rw [hs, finUniqueSearch, hsum, UniqAcc.get_sum_map_ofOpt]

derive_csimp finUnique via eq finUniqueSearch_eq

/-- **Unique value read from a finite set, as the classical choice of a unique witness**: for
a predicate `p` whose witnesses are the values read from `s`. -/
theorem finUnique_eq_choose {β : Type} [DecidableEq α] (g : β → Option α) (s : Finset β)
    (p : α → Prop) (hp : ∀ a, p a ↔ ∃ x ∈ s, g x = some a) :
    finUnique g s =
      (by classical exact if h : ∃! a, p a then some h.exists.choose else none) := by
  have hpe : p = fun a => ∃ x ∈ s, g x = some a := funext fun a => propext (hp a)
  subst hpe
  rfl

/-- **Time of the search over a finite set**: one pass over `s`, each element read at cost at
most `k`. -/
theorem finUnique.timedCost_le {β : Type} [DecidableEq α] (g : β → Option α)
    (gCost : β → ℕ) {k : ℕ} (hg : ∀ x, gCost x ≤ k) (s : Finset β) :
    finUnique.timedCost g gCost s ≤ (k + 4) * s.card + 4 := by
  unfold finUnique.timedCost finUnique.csimpImpl.timedCost
  have h := Finset.sum.timedCost_le s (fun x => UniqAcc.ofOpt (g x))
    (fun x => 1 + (1 + gCost x + 1)) (k := k + 3) fun x => by have := hg x; omega
  rw [show k + 3 + 1 = k + 4 by omega] at h
  omega

end CatCrypt.Crypto.FiatShamirROM
