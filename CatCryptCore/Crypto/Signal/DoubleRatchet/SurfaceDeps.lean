/-- A byte array read as a vector of `n` bytes: entry `i` truncated to a byte, `0` past the end.
The decoding is total and inverts `vecToArrayInt` (`decodeVec_vecToArrayInt`). -/
def decodeVec (n : ℕ) (a : Array Int) : Vector UInt8 n :=
  Vector.ofFn fun i => (a.getD i 0).toNat.toUInt8

/-- A byte array read as a 32-byte key. -/
abbrev decodeKey (a : Array Int) : Vector UInt8 32 := decodeVec 32 a

/-- `decodeVec` is a left inverse of `vecToArrayInt`: decoding the encoding of a vector returns
the vector. -/
theorem decodeVec_vecToArrayInt {n : ℕ} (v : Vector UInt8 n) :
    decodeVec n (vecToArrayInt v) = v := by
  ext i hi
  simp [decodeVec, vecToArrayInt]

/-- `decodeKey` is a left inverse of `vecToArrayInt`. -/
theorem decodeKey_vecToArrayInt (v : Vector UInt8 32) : decodeKey (vecToArrayInt v) = v :=
  decodeVec_vecToArrayInt v

/-! ## The libcrux primitives of the double ratchet -/

/-- The HMAC message of the chain-step seed `c`: the single byte `c`. -/
def ckConst (c : UInt8) : Vector UInt8 1 := Vector.replicate 1 c

/-- The seed `Hax.repeat_ 1 1` of the extraction decodes to `ckConst 1`. -/
theorem decodeVec_ck_const_one : decodeVec 1 (Doubleratchet.ck_const 1) = ckConst 1 := by
  decide

/-- The seed `Hax.repeat_ 2 1` of the extraction decodes to `ckConst 2`. -/
theorem decodeVec_ck_const_two : decodeVec 1 (Doubleratchet.ck_const 2) = ckConst 2 := by
  decide

/-- Libcrux-backed chain step: the message key `HMAC(ck, ckConst 1)` and the next chain key
`HMAC(ck, ckConst 2)`. -/
noncomputable def libcrux_prg : PRGDef (Vector UInt8 32) where
  stretch := fun ck => (hmac_sha256_1 ck (ckConst 1), hmac_sha256_1 ck (ckConst 2))

/-- The libcrux-backed symmetric ratchet: the chain step `libcrux_prg` and XOR encryption under
the message key. -/
noncomputable def libcrux_fsaeadConfig :
    Signal.FSAEAD.FSAEADConfig (Vector UInt8 32) :=
  ⟨libcrux_prg, wxorEnc⟩

/-- The XOR AEAD of the model: encryption is the XOR of the key and the plaintext and
decryption the XOR of the key and the ciphertext, whatever the associated data `AD`. -/
noncomputable def libcruxAEAD (AD : Type) :
    Assumptions.AEADDef (Vector UInt8 32) (Vector UInt8 32) AD :=
  ⟨fun k m _ => CryptoWord.wxor k m, fun k c _ => some (CryptoWord.wxor k c)⟩

/-- The HKDF info string `"WhisperRatchet"` of the root step. -/
def rootInfo : Vector UInt8 14 :=
  ⟨#[87, 104, 105, 115, 112, 101, 114, 82, 97, 116, 99, 104, 101, 116], rfl⟩

/-- The first 32 bytes of a 64-byte output. -/
def lo64 (o : Vector UInt8 64) : Vector UInt8 32 :=
  Vector.ofFn fun i => o[i.val]'(by omega)

/-- The last 32 bytes of a 64-byte output. -/
def hi64 (o : Vector UInt8 64) : Vector UInt8 32 :=
  Vector.ofFn fun i => o[32 + i.val]'(by omega)

/-- The libcrux root step on bytes: `HKDF-Extract(rk, dh)` expanded to 64 bytes under
`rootInfo`, split into the next root key and the chain key. -/
noncomputable def libcruxKdfRk (rk dh : Vector UInt8 32) : Vector UInt8 32 × Vector UInt8 32 :=
  let o := hkdf_expand_64 (hkdf_extract_32 rk dh) rootInfo
  (lo64 o, hi64 o)

/-- The libcrux root step of the model: `libcruxKdfRk` at the encoding `encG` of the
Diffie–Hellman output. -/
noncomputable def libcruxRootKdf {G : Type} (encG : G → Vector UInt8 32) (rk : Vector UInt8 32)
    (I : G) : Vector UInt8 32 × Vector UInt8 32 :=
  libcruxKdfRk rk (encG I)

/-- The XOR of the decoded 32-byte key and the first 32 entries of the text, encoded back as a
32-entry array: the encryption and decryption of `doubleratchetDepsOf`. -/
noncomputable def xorBytes (k m : Array Int) : Array Int :=
  vecToArrayInt (CryptoWord.wxor (decodeKey k) (decodeKey m))

/-- The info string `KDF_RK_INFO` of the extraction decodes to `rootInfo`. -/
theorem decodeVec_kdf_rk_info : decodeVec 14 Doubleratchet.KDF_RK_INFO = rootInfo := by
  decide

/-- The invariant of the loop of `split64` over the array `x` after `i` iterations: both halves
have 32 entries, the first `i` of which are copied from `x`. -/
def SplitInv (x : Array Int) (i : Int) (p : Array Int × Array Int) : Prop :=
  p.1.size = 32 ∧ p.2.size = 32 ∧ ∀ k : ℕ, k < 32 →
    p.1[k]? = some (if (k : Int) < i then x.getD k 0 else 0) ∧
    p.2[k]? = some (if (k : Int) < i then x.getD (32 + k) 0 else 0)

/-- The loop of `split64` starts at the invariant with no entries copied. -/
theorem splitInv_zero (x : Array Int) : SplitInv x 0 (Hax.repeat_ 0 32, Hax.repeat_ 0 32) := by
  refine ⟨by simp [Hax.repeat_], by simp [Hax.repeat_], fun k hk => ?_⟩
  have e : ∀ n : Int, (Hax.repeat_ (0 : Int) n)[k]? = if k < n.toNat then some 0 else none := by
    intro n
    simp [Hax.repeat_, Array.getElem?_replicate]
  have hn : ¬ (k : Int) < 0 := by omega
  rw [e]
  simp [hk, hn]

/-- An iteration of the loop of `split64` at an index `i < 32` keeps the invariant, when `x` has
`64` entries. -/
theorem splitInv_step (x : Array Int) (hx : x.size = 64) (i : Int) (p : Array Int × Array Int)
    (h0 : 0 ≤ i) (h32 : i < 32) (h : SplitInv x i p) :
    SplitInv x (i + 1) (Hax.array_update p.1 i (Hax.index x i),
      Hax.array_update p.2 i (Hax.index x (Hax.add 32 i))) := by
  obtain ⟨s1, s2, hp⟩ := h
  refine ⟨by rw [Hax.size_array_update_eq]; exact s1,
    by rw [Hax.size_array_update_eq]; exact s2, fun k hk => ?_⟩
  obtain ⟨h1, h2⟩ := hp k hk
  have hxi : Hax.index x i = x.getD i.toNat 0 := by
    rw [Hax.index_eq_getElem (by omega)]
    simp [Array.getD, show i.toNat < x.size by omega]
  have hxj : Hax.index x (Hax.add 32 i) = x.getD (32 + i.toNat) 0 := by
    have : (Hax.add 32 i).toNat = 32 + i.toNat := by simp only [Hax.add]; omega
    rw [Hax.index_eq_getElem (by omega)]
    simp [Array.getD, this, show 32 + i.toNat < x.size by omega]
  rw [hxi, hxj]
  unfold Hax.array_update
  rw [dite_eq_left (by omega), dite_eq_left (by omega)]
  by_cases hki : k = i.toNat
  · subst hki
    simp only [Array.getElem?_set_self]
    grind
  · grind

/-- `split64` of the encoding of a 64-byte vector is the pair of the encodings of its halves. -/
theorem split64_vecToArrayInt (o : Vector UInt8 64) :
    Doubleratchet.split64 (vecToArrayInt o) =
      (vecToArrayInt (lo64 o), vecToArrayInt (hi64 o)) := by
  unfold Doubleratchet.split64
  have hx : (vecToArrayInt o).size = 64 := by simp [vecToArrayInt]
  have h := Hax.foldRange_induct (P := SplitInv (vecToArrayInt o))
    (lo := 0) (hi := 32)
    (f := fun i p => (Hax.array_update p.1 i (Hax.index (vecToArrayInt o) i),
      Hax.array_update p.2 i (Hax.index (vecToArrayInt o) (Hax.add 32 i))))
    (init := (Hax.repeat_ 0 32, Hax.repeat_ 0 32)) (by norm_num) (splitInv_zero _)
    fun i p h0 h32 hp => splitInv_step _ hx i p h0 h32 hp
  obtain ⟨hs1, hs2, hk⟩ := h
  dsimp only
  refine Prod.ext (Array.ext ?_ ?_) (Array.ext ?_ ?_)
  · simpa [vecToArrayInt, lo64] using hs1
  · intro i hi1 hi2
    have h1 := (hk i (by simpa [vecToArrayInt, lo64] using hi2)).1
    rw [Array.getElem?_eq_getElem hi1] at h1
    simp [vecToArrayInt, lo64] at h1 hi2 ⊢
    grind
  · simpa [vecToArrayInt, hi64] using hs2
  · intro i hi1 hi2
    have h1 := (hk i (by simpa [vecToArrayInt, hi64] using hi2)).2
    rw [Array.getElem?_eq_getElem hi1] at h1
    simp [vecToArrayInt, hi64] at h1 hi2 ⊢
    grind

/-! ## Extraction instance -/

/-- The phantom type of the primitives of the extraction at the X25519 function `sm`. -/
structure DrPrims (_sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32) : Type where
  /-- The only value. -/
  mk ::
  deriving Inhabited

/-- The primitives of the extraction on byte arrays at the X25519 function `sm`:
`hmac_sha256_1`, `hkdf_extract_32`, `hkdf_expand_64` and `sm` of the decoded arguments, encoded
back by `vecToArrayInt`; `aead_encrypt` is `xorBytes` of the key and the text and `aead_decrypt`
is `some` of `xorBytes` at the plaintext length `32`, whatever the associated data. -/
@[reducible] noncomputable def doubleratchetDepsOf
    (sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32) :
    Doubleratchet.DoubleRatchetDeps (DrPrims sm) where
  hmac_sha256 k m := vecToArrayInt (hmac_sha256_1 (decodeKey k) (decodeVec 1 m))
  hkdf_extract s i := vecToArrayInt (hkdf_extract_32 (decodeKey s) (decodeKey i))
  hkdf_expand_64 p i := vecToArrayInt (hkdf_expand_64 (decodeKey p) (decodeVec 14 i))
  x25519 sk pk := vecToArrayInt (sm (decodeKey sk) (decodeKey pk))
  aead_encrypt k m _ _ := xorBytes k m
  aead_decrypt k c _ _ := some (xorBytes k c, 32)

/-- The primitives of the extraction at `sm`, as the instance of `DrPrims sm`. -/
noncomputable instance (sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32) :
    Doubleratchet.DoubleRatchetDeps (DrPrims sm) :=
  doubleratchetDepsOf sm

/-- The primitives of the extraction with the libcrux X25519. -/
abbrev DrLibcrux : Type := DrPrims x25519_scalarmult

open CatCrypt.Crypto.KeyAgreement.X25519 in
/-- The primitives of the extraction with the X25519 function of the RFC 7748 specification. -/
abbrev DrSpec : Type := DrPrims Spec.x25519_spec

/-- The ghost record of the typestate FSM (the trait `DoubleRatchetGhost` of the crate's module
`typestate_fsm`): the ghost state is the ordered trace of actions, and `event tag step` appends
the kind `2`, the tag, the payload length and the payload `#[step]`. -/
def doubleratchetGhostRecord (kind : Int) (ghost : Array Int) (tag : Int)
    (payload : Array Int) : Array Int :=
  ghost ++ #[kind, tag, payload.size] ++ payload

/-- The ghost trace of the crate as an instance of `DoubleRatchetGhost`. -/
instance : Doubleratchet.DoubleRatchetGhost (Array Int) where
  event ghost tag step := doubleratchetGhostRecord 2 ghost tag #[step]

/-- `vecToArrayInt` carries the primitives of `doubleratchetDepsOf sm` to those of the Signal
double ratchet over the subgroup `G25519 B` at the root step `libcruxRootKdf encU`, the chain
PRG `libcrux_prg` and the XOR AEAD `libcruxAEAD`, at the plaintext length `32`, under the RFC 7748
correctness `X25519HomOf sm bp B` of the X25519 function `sm`: a secret key `(sk, b)` is encoded
by the bytes of `sk` and has the exponent `signedE (sk, b)`, group elements are encoded by
`encU`; the associated data are encoded by `encAD` and the headers by `encH`, which the XOR AEAD
ignores. -/
theorem drHomOf {B : Curve25519Point} [Fact (addOrderOf B = curve25519SubgroupOrder)]
    {sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32}
    {bp : Vector UInt8 32 → Vector UInt8 32} (hH : X25519HomOf sm bp B)
    {A : Type} (encAD : A → Array Int)
    (encH : ((G25519 B × ℕ) × ℕ) → Doubleratchet.MessageHeader_T) :
    ExtractedCorrespondence.DrHom (DrPrims sm) (G25519 B)
      (hkdfRoot (libcruxRootKdf encU))
      (Signal.FSAEAD.toPRG libcrux_fsaeadConfig) (libcruxAEAD (A × ((G25519 B × ℕ) × ℕ))) 32
      vecToArrayInt (vecToArrayInt ∘ encU) (vecToArrayInt ∘ Prod.fst) signedE vecToArrayInt
      vecToArrayInt vecToArrayInt vecToArrayInt encAD encH := by
  let _ : Doubleratchet.DoubleRatchetDeps (DrPrims sm) := doubleratchetDepsOf sm
  exact {
    dh_eq := fun s T => by
      simp only [Doubleratchet.x25519, Function.comp_apply, decodeKey_vecToArrayInt,
        hH.scalarmult_elemPow s.1 s.2 T]
    root_eq := fun rk I => by
      simp only [Doubleratchet.hkdf_expand_64, Doubleratchet.hkdf_extract,
        decodeKey_vecToArrayInt, Function.comp_apply, hkdfRoot, libcruxRootKdf, libcruxKdfRk]
      rw [decodeVec_kdf_rk_info, split64_vecToArrayInt]
    msg_key_eq := fun s => by
      simp only [Doubleratchet.hmac_sha256, decodeKey_vecToArrayInt,
        decodeVec_ck_const_one, Signal.FSAEAD.toPRG, libcrux_fsaeadConfig, libcrux_prg,
        PRGDef.core]
    chain_key_eq := fun s => by
      simp only [Doubleratchet.hmac_sha256, decodeKey_vecToArrayInt,
        decodeVec_ck_const_two, Signal.FSAEAD.toPRG, libcrux_fsaeadConfig, libcrux_prg,
        PRGDef.core]
    aead_eq := fun k m a h => by
      simp only [Doubleratchet.aead_encrypt, xorBytes, decodeKey_vecToArrayInt, libcruxAEAD]
    aead_dec_eq := fun k c a h => by
      simp only [Doubleratchet.aead_decrypt, xorBytes, decodeKey_vecToArrayInt, libcruxAEAD,
        Option.map_some] }

/-- `drHomOf` at the libcrux X25519 under `X25519Hom B`. -/
theorem defaultDrHom {B : Curve25519Point} [Fact (addOrderOf B = curve25519SubgroupOrder)]
    (hH : X25519Hom B) {A : Type} (encAD : A → Array Int)
    (encH : ((G25519 B × ℕ) × ℕ) → Doubleratchet.MessageHeader_T) :
    ExtractedCorrespondence.DrHom DrLibcrux (G25519 B)
      (hkdfRoot (libcruxRootKdf encU))
      (Signal.FSAEAD.toPRG libcrux_fsaeadConfig) (libcruxAEAD (A × ((G25519 B × ℕ) × ℕ))) 32
      vecToArrayInt (vecToArrayInt ∘ encU) (vecToArrayInt ∘ Prod.fst) signedE vecToArrayInt
      vecToArrayInt vecToArrayInt vecToArrayInt encAD encH :=
  drHomOf hH encAD encH

/-! ## Forward secrecy and post-compromise security of the store-free abstraction -/

section Corrupt

open ExtractedCorrespondence ExtractedScheme

variable (B : Curve25519Point) [Fact (addOrderOf B = curve25519SubgroupOrder)]

/-- The extracted double ratchet at `DrPrims sm` as a secure-messaging scheme: `drExtractedSM`
with the plaintext length `32`, root keys, chain keys, words, ciphertexts and associated data
encoded by `vecToArrayInt`, group elements of `G25519 B` by `vecToArrayInt ∘ encU`, and secret
keys `(sk, b)` drawn uniformly, encoded by the bytes of `sk` and with the exponent
`signedE (sk, b)`; the associated data of a message is the message. -/
noncomputable abbrev signalDRSMOf (sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32) :
    SMScheme Doubleratchet.RatchetState_T (Array Int) (Vector UInt8 32 × Bool) (Vector UInt8 32)
      (Array Int) DrLeak :=
  drExtractedSM (DrPrims sm) (Vector UInt8 32) (G := G25519 B) (Ct := Vector UInt8 32)
    (A := Vector UInt8 32) 32 vecToArrayInt (vecToArrayInt ∘ encU) (vecToArrayInt ∘ Prod.fst)
    signedE vecToArrayInt vecToArrayInt vecToArrayInt id

/-- The extracted double ratchet at the libcrux X25519 as a secure-messaging scheme. -/
noncomputable abbrev signalDRLibcruxSM :
    SMScheme Doubleratchet.RatchetState_T (Array Int) (Vector UInt8 32 × Bool) (Vector UInt8 32)
      (Array Int) DrLeak :=
  signalDRSMOf B x25519_scalarmult

open CatCrypt.Crypto.KeyAgreement.X25519 in
/-- The extracted double ratchet at the X25519 function `Spec.x25519_spec` of the RFC 7748
specification as a secure-messaging scheme. -/
noncomputable abbrev signalDRSpecSM :
    SMScheme Doubleratchet.RatchetState_T (Array Int) (Vector UInt8 32 × Bool) (Vector UInt8 32)
      (Array Int) DrLeak :=
  signalDRSMOf B Spec.x25519_spec

/-- The encoding of the corruption answers of the ACD construction with headers at the libcrux
encodings. -/
noncomputable abbrev signalDRLibcruxLeak :
    SMHdrSt (G25519 B × (Vector UInt8 32 × Bool)) (Vector UInt8 32) (Vector UInt8 32)
      (G25519 B) → DrLeak :=
  drEncLeak vecToArrayInt (vecToArrayInt ∘ encU) (vecToArrayInt ∘ Prod.fst) signedE
    vecToArrayInt

/-- The root KDF of the libcrux double ratchet over `G25519 B`. -/
noncomputable abbrev signalDRRoot :
    Assumptions.PRGDef (Vector UInt8 32 × G25519 B) (Vector UInt8 32 × Vector UInt8 32) :=
  hkdfRoot (libcruxRootKdf encU)

/-- The chain PRG of the libcrux double ratchet. -/
noncomputable abbrev signalDRPRG :
    Assumptions.PRGDef (Vector UInt8 32) (Vector UInt8 32 × Vector UInt8 32) :=
  Signal.FSAEAD.toPRG libcrux_fsaeadConfig

/-- The XOR scheme that stands in place of the AEAD of the double ratchet over `G25519 B`, at the
associated data of the key agreement and the header, which it ignores. -/
noncomputable abbrev signalDRAEAD :
    Assumptions.AEADDef (Vector UInt8 32) (Vector UInt8 32)
      (Vector UInt8 32 × ((G25519 B × ℕ) × ℕ)) :=
  libcruxAEAD _

/-- **Forward secrecy and post-compromise security of the store-free abstraction of the extracted
Signal double ratchet at an X25519 function**, for corruptions that return the key material
`drExpose`. For the session functions of `doubleratchet-hax` at `DrPrims sm` (libcrux
HMAC-SHA256 and HKDF-SHA256, the X25519 function `sm`, XOR encryption), under the RFC 7748
correctness `X25519HomOf sm bp B` of `sm` on the subgroup `G25519 B`, with `2 ≤ ΔFS`,
`2 ≤ ΔPCS` and for an adversary `A` whose interactions ask at most `q` queries, the advantage
in the corruption game over `signalDRSMOf B sm` is at most the bound of
`drExtracted_corruptAdvantage_le`, each CKA term replaced by the DDH advantage in `G25519 B` of
`ckaCorruptDDHRedOf signedE ΔFS ΔPCS` plus `4 Δ25519` for the distance of the signed clamped
scalars of the secret keys to uniform exponents. The theorem is
`drExtracted_corruptAdvantage_le` at `drHomOf`, with the CKA terms bounded by
`dhCKAOf_corrupt_advantage_le` at `signedClampCert`. -/
theorem signalDR_extracted_corrupt_advantage_le_of_hom
    {sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32}
    {bp : Vector UInt8 32 → Vector UInt8 32} (hH : X25519HomOf sm bp B) {ΔFS ΔPCS : ℕ}
    (hFS : 2 ≤ ΔFS) (hPCS : 2 ≤ ΔPCS)
    (A : SMSchemeAdv (Array Int) (Vector UInt8 32) (Array Int) DrLeak) (q : ℕ)
    (hA : ∀ t T, (A.play t T).IsQueryBound q) :
    (signalDRSMOf B sm).corruptAdvantage ΔFS ΔPCS A ≤
      ∑ b : Bool, (DDH_Advantage (G25519 B) (ckaCorruptDDHRedOf (G := G25519 B) signedE ΔFS ΔPCS
          (smcCKARed (signalDRRoot B) (signalDRPRG) (signalDRAEAD B) b
            ((A.comap (vecToArrayInt ∘ encU) vecToArrayInt (signalDRLibcruxLeak B)).toHdr
              (drHdrAD id)))) + 4 * Δ25519) +
        ∑ b : Bool, PRFPRNG_Advantage (signalDRRoot B)
          (smcRootRed (dhCKAOf (G25519 B) signedE) (signalDRRoot B) (signalDRPRG)
            (signalDRAEAD B) ΔFS ΔPCS b (dhInitPOf (G25519 B) signedE)
            ((A.comap (vecToArrayInt ∘ encU) vecToArrayInt (signalDRLibcruxLeak B)).toHdr
              (drHdrAD id))) +
        (∑ i ∈ Finset.range q, Assumptions.PRG_Advantage (signalDRPRG) (fsCorrPRGRed (signalDRPRG)
            (signalDRAEAD B) false i (smcFSRed (dhCKAOf (G25519 B) signedE) (signalDRRoot B)
              (signalDRPRG) (signalDRAEAD B) ΔFS ΔPCS (dhInitPOf (G25519 B) signedE)
              ((A.comap (vecToArrayInt ∘ encU) vecToArrayInt (signalDRLibcruxLeak B)).toHdr
                (drHdrAD id)))) +
          ∑ i ∈ Finset.range q, Assumptions.PRG_Advantage (signalDRPRG) (fsCorrPRGRed (signalDRPRG)
            (signalDRAEAD B) true i (smcFSRed (dhCKAOf (G25519 B) signedE) (signalDRRoot B)
              (signalDRPRG) (signalDRAEAD B) ΔFS ΔPCS (dhInitPOf (G25519 B) signedE)
              ((A.comap (vecToArrayInt ∘ encU) vecToArrayInt (signalDRLibcruxLeak B)).toHdr
                (drHdrAD id)))) +
          Assumptions.AEAD_CCA_Advantage (signalDRAEAD B)
            (fsCorrAEADRed (signalDRPRG) (signalDRAEAD B)
              (smcFSRed (dhCKAOf (G25519 B) signedE) (signalDRRoot B) (signalDRPRG)
                (signalDRAEAD B) ΔFS ΔPCS (dhInitPOf (G25519 B) signedE)
                ((A.comap (vecToArrayInt ∘ encU) vecToArrayInt (signalDRLibcruxLeak B)).toHdr
                  (drHdrAD id))))) := by
  refine (drExtracted_corruptAdvantage_le (DrPrims sm)
    (drHomOf hH vecToArrayInt (drEncH (vecToArrayInt ∘ encU))) hFS
    (le_trans (by norm_num) hPCS) A q hA).trans ?_
  have hδ : signedClampCert.δ = Δ25519 := rfl
  have h := dhCKAOf_corrupt_advantage_le (G := G25519 B) signedE signedClampCert rfl rfl hFS hPCS
  rw [hδ] at h
  gcongr with b
  exact h _

