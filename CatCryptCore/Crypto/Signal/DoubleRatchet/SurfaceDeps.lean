/-- **The passive extracted Signal double ratchet with XOR encryption as a concrete game bound.**
Under `X25519Hom B`, for passive adversaries `A` asking at most `q` queries, the real game
`smAdaptiveGame (signalDRLibcruxSM B) 2 2 false A` and the ideal game
`smAdaptiveGame (signalDRLibcruxSM B) 2 2 true A`, whose challenge ciphertext is drawn by
`idealCt`, are distinguished by every post-processing `D` of the output bit with advantage at
most `signalDRPassiveBound B q A`, the bound of `signalDR_extracted_adaptive_advantage_le`. -/
instance signalDRLibcrux_passive_gameAdvBoundC (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] [hH : Fact (X25519Hom B)] (q : ℕ) :
    GameAdvBoundC (fun A : DrPassiveAdv q => smAdaptiveGame (signalDRLibcruxSM B) 2 2 false A.1)
      (fun A => smAdaptiveGame (signalDRLibcruxSM B) 2 2 true A.1)
      (fun A _ => signalDRPassiveBound B q A.1) :=
  ⟨fun A D => by
    obtain ⟨p₀, hp₀⟩ := signalDRSMOf_adaptiveGame_eq_liftPMF B x25519_scalarmult 2 2 false A.1
    obtain ⟨p₁, hp₁⟩ := signalDRSMOf_adaptiveGame_eq_liftPMF B x25519_scalarmult 2 2 true A.1
    have h := PRPPRF.advantageA_liftPMF_le p₀ p₁ D
    rw [← hp₀, ← hp₁] at h
    exact h.trans (signalDR_extracted_adaptive_advantage_le B hH.out le_rfl le_rfl A.1 A.2.2)⟩

