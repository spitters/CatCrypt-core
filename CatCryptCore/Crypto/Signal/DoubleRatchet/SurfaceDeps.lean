/-! ## The passive game as a concrete game bound -/

section PassiveGame

open ExtractedCorrespondence ExtractedScheme UCConcrete

/-- Adversaries of the game with an adaptive challenge epoch over the extracted double ratchet
that ask no corruption query (`smNoCorrupt`) and whose interactions ask at most `q` queries. -/
def DrPassiveAdv (q : ℕ) : Type 1 :=
  {A : Array Int → OracleAdv (SMQuery (Vector UInt8 32))
      (SMSchemeAns (Array Int) (Array Int) DrLeak) Bool //
    (∀ T, (A T).MayOnlyCall smNoCorrupt) ∧ ∀ T, (A T).IsQueryBound q}

/-- The bound of `signalDR_extracted_adaptive_advantage_le_of_hom` at the delays `2`, `2` for the
adversary `A` asking at most `q` queries: the sum over the epochs `e ≤ q` of the DDH, PRF-PRNG and
FS-AEAD terms at the guessing reduction of the wrapper adversary `smHdrAdaptive (drHdrAD id)` of
`A` with its answers encoded, plus `(q + 1) * 8 * Δ25519`. -/
noncomputable def signalDRPassiveBound (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] (q : ℕ)
    (A : Array Int → OracleAdv (SMQuery (Vector UInt8 32))
      (SMSchemeAns (Array Int) (Array Int) DrLeak) Bool) : ℝ≥0∞ :=
  ∑ e ∈ Finset.range (q + 1), (∑ b : Bool, DDH_Advantage (G25519 B)
        (ckaCorruptDDHRedOf (G := G25519 B) signedE 2 2
          (smcCKARed (signalDRRoot B) (signalDRPRG) (signalDRAEAD B) b
            (smGuessAdv 2 2 (smHdrAdaptive (drHdrAD id)
              fun T => (A ((vecToArrayInt ∘ encU) T)).mapQueryAnswer id
                (SMSchemeAns.map (vecToArrayInt ∘ encU) vecToArrayInt
                  (signalDRLibcruxLeak B))) e))) +
    ∑ b : Bool, PRFPRNG_Advantage (signalDRRoot B)
      (smcRootRed (dhCKAOf (G25519 B) signedE) (signalDRRoot B) (signalDRPRG)
        (signalDRAEAD B) 2 2 b (dhInitPOf (G25519 B) signedE)
        (smGuessAdv 2 2 (smHdrAdaptive (drHdrAD id)
          fun T => (A ((vecToArrayInt ∘ encU) T)).mapQueryAnswer id
            (SMSchemeAns.map (vecToArrayInt ∘ encU) vecToArrayInt
              (signalDRLibcruxLeak B))) e)) +
    FSAEAD_Corrupt_Advantage (signalDRPRG) (signalDRAEAD B)
      (smcFSRed (dhCKAOf (G25519 B) signedE) (signalDRRoot B) (signalDRPRG)
        (signalDRAEAD B) 2 2 (dhInitPOf (G25519 B) signedE)
        (smGuessAdv 2 2 (smHdrAdaptive (drHdrAD id)
          fun T => (A ((vecToArrayInt ∘ encU) T)).mapQueryAnswer id
            (SMSchemeAns.map (vecToArrayInt ∘ encU) vecToArrayInt
              (signalDRLibcruxLeak B))) e))) +
    (q + 1) * 8 * Δ25519

/-- The initialisation of the extracted double ratchet at an X25519 function `sm` is a lifted
distribution. -/
theorem signalDRSMOf_init_eq_liftPMF (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)]
    (sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32) :
    ∃ ι, (signalDRSMOf B sm).init = liftPMF ι := by
  simp only [drExtractedSM, sample_eq_liftPMF, liftPMF_pure, liftPMF_bind_liftPMF]
  exact ⟨_, rfl⟩

/-- The adaptive game over `signalDRSMOf B sm` is a lifted distribution on `Bool`. -/
theorem signalDRSMOf_adaptiveGame_eq_liftPMF (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)]
    (sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32) (ΔFS ΔPCS : ℕ) (ideal : Bool)
    (A : Array Int → OracleAdv (SMQuery (Vector UInt8 32))
      (SMSchemeAns (Array Int) (Array Int) DrLeak) Bool) :
    ∃ p, smAdaptiveGame (signalDRSMOf B sm) ΔFS ΔPCS ideal A = liftPMF p := by
  obtain ⟨ι, hι⟩ := signalDRSMOf_init_eq_liftPMF B sm
  exact ⟨_, smAdaptiveGame_eq_liftPMF _ hι ΔFS ΔPCS ideal A⟩

/-- The real game of the passive extracted double ratchet at the libcrux X25519,
`smAdaptiveGame (signalDRLibcruxSM B) 2 2 false`, is heap-independent. -/
instance signalDRLibcrux_passiveReal_pure (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] (q : ℕ) :
    PureGame fun A : DrPassiveAdv q => smAdaptiveGame (signalDRLibcruxSM B) 2 2 false A.1 :=
  ⟨fun A => by
    obtain ⟨p, hp⟩ := signalDRSMOf_adaptiveGame_eq_liftPMF B x25519_scalarmult 2 2 false A.1
