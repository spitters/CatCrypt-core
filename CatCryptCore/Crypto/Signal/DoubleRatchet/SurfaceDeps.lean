/-! ### Games of a fixed passive adversary, indexed by `Unit` -/

/-- The real game of the passive adversary `A` over the extracted double ratchet at the libcrux
X25519: `smAdaptiveGame (signalDRLibcruxSM B) 2 2 false A`. -/
noncomputable def signalDRLibcruxPassiveReal (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] {q : ℕ} (A : DrPassiveAdv q) :
    SPComp Bool :=
  smAdaptiveGame (signalDRLibcruxSM B) 2 2 false A.1

/-- The ideal game of the passive adversary `A` over the extracted double ratchet at the libcrux
X25519: `smAdaptiveGame (signalDRLibcruxSM B) 2 2 true A`, whose challenge ciphertext is drawn by
`idealCt`. -/
noncomputable def signalDRLibcruxPassiveIdeal (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] {q : ℕ} (A : DrPassiveAdv q) :
    SPComp Bool :=
  smAdaptiveGame (signalDRLibcruxSM B) 2 2 true A.1

/-- `signalDRLibcruxPassiveReal B A` is heap-independent. -/
instance signalDRLibcruxPassiveReal_pure (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] {q : ℕ} (A : DrPassiveAdv q) :
    PureGame fun _ : Unit => signalDRLibcruxPassiveReal B A :=
  ⟨fun _ => (signalDRLibcrux_passiveReal_pure B q).isPure A⟩

/-- `signalDRLibcruxPassiveIdeal B A` is heap-independent. -/
instance signalDRLibcruxPassiveIdeal_pure (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] {q : ℕ} (A : DrPassiveAdv q) :
    PureGame fun _ : Unit => signalDRLibcruxPassiveIdeal B A :=
  ⟨fun _ => (signalDRLibcrux_passiveIdeal_pure B q).isPure A⟩

/-- **The passive extracted Signal double ratchet with XOR encryption at a fixed adversary as a
concrete game bound.** Under `X25519Hom B`, for a passive adversary `A` asking at most `q`
queries, every post-processing `D` of the output bit distinguishes
`signalDRLibcruxPassiveReal B A` from `signalDRLibcruxPassiveIdeal B A` with advantage at most
`signalDRPassiveBound B q A`. -/
instance signalDRLibcruxPassive_gameAdvBoundC (B : Curve25519Point)
    [Fact (addOrderOf B = curve25519SubgroupOrder)] [Fact (X25519Hom B)] {q : ℕ}
    (A : DrPassiveAdv q) :
    GameAdvBoundC (fun _ : Unit => signalDRLibcruxPassiveReal B A)
      (fun _ => signalDRLibcruxPassiveIdeal B A) (fun _ _ => signalDRPassiveBound B q A.1) :=
  ⟨fun _ D => (signalDRLibcrux_passive_gameAdvBoundC B q).bound_le A D⟩

