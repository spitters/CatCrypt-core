/-! ## Unfolding lemmas -/

/-- The chain step `libcrux_prg` at the chain key `ck` is the pair of the message key
`HMAC(ck, ckConst 1)` and the next chain key `HMAC(ck, ckConst 2)`; the unfolding lemma of
`libcrux_prg`. -/
theorem libcrux_prg_stretch (ck : Vector UInt8 32) :
    libcrux_prg.stretch ck = (hmac_sha256_1 ck (ckConst 1), hmac_sha256_1 ck (ckConst 2)) :=
  rfl

