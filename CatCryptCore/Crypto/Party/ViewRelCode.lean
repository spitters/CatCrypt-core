module

public import CatCryptCore.Container.CodeRel
public import CatCryptCore.Crypto.Party.Derived
public import CatCryptCore.Crypto.Party.ProgECost
public import CatCryptCore.Relational.Rules

/-!
# Information flow of party programs as a heterogeneous lift along a code relation

The information-flow relation `ProgE.ViewRel V RA p p'` of party programs for a public view `V`
is the heterogeneous lift `Code.HRel (ProgECost.viewCodeRel V) RA` at the code images
`ProgECost.equivCode p` and `ProgECost.equivCode p'`. The code relation `viewCodeRel V` relates
the code of `ProgE` (generated by `derive_free_sig ProgE (namespace := ProgECost) (code := true)`
in `CatCryptCore.Crypto.Party.ProgECost`) to itself: the directions of `recv` (the events) by
`V.ev`, the field of `send` (the output) by `V.out`, and every other field and direction by
equality.

The pRHL judgment `rHoare` with a heap invariant `I` is a relational lifting of `SPComp` to
itself (`rHoareRelLift I`), so that `HFreeRel.liftM_rel` applies to handlers into `SPComp`.

## Main definitions

* `ProgECost.viewCodeRel` — the code relation of a public view;
* `rHoareRelLift` — the relational lifting of `SPComp` by `rHoare` with a heap invariant.

## Main results

* `ProgECost.equivCode_ret`, `ProgECost.equivCode_recv`, `ProgECost.equivCode_send`,
  `ProgECost.equivCode_opN`, `ProgECost.equivCode_fail` — the code image of each constructor;
* `ProgECost.equivCode_bind` — the code image carries `ProgE.bind` to `FreeM.bind`;
* `ProgECost.viewRel_iff_hRel` — `ViewRel V RA` is the lift along `viewCodeRel V`.

Search words: information flow, public view, noninterference, unwinding, relational lift,
heterogeneous relation, code relation, party language, program tree, pRHL, relational lifting,
relational handler.
-/

set_option autoImplicit false

@[expose] public section

namespace CatCrypt.Crypto.Party

open PFunctor CatCrypt.Container CatCrypt.Core CatCrypt.Relational CatCrypt.Crypto.UCTransparent

namespace ProgECost

variable {Q E O α β : Type}

/-! ## The code image of each constructor -/

/-- The code image of a return is a leaf. -/
theorem equivCode_ret (a : α) : equivCode (.ret a : ProgE Q E O α) = FreeM.pure a := rfl

/-- The code image of a receive is a node at the first operation, continued at each event. -/
theorem equivCode_recv (k : E → ProgE Q E O α) :
    equivCode (.recv k) = FreeM.liftBind (P := (code Q E O).interp) (Sum.inl ⟨⟩)
      fun e : E => equivCode (k e) := rfl

/-- The code image of a send is a node at the second operation with the output as its field. -/
theorem equivCode_send (o : O) (p : ProgE Q E O α) :
    equivCode (.send o p) = FreeM.liftBind (P := (code Q E O).interp)
      (Sum.inr (Sum.inl ⟨⟨o⟩, ⟨⟩⟩)) fun _ => equivCode p := rfl

/-- The code image of an effect operation is a node at the third operation with the operation
as its field, continued at each outcome. -/
theorem equivCode_opN (q : Q) (k : ℕ → ProgE Q E O α) :
    equivCode (.opN q k) = FreeM.liftBind (P := (code Q E O).interp)
      (Sum.inr (Sum.inr (Sum.inl ⟨⟨q⟩, ⟨⟩⟩))) fun n : ℕ => equivCode (k n) := rfl

/-- The code image of a failure is a node at the fourth operation, without directions. -/
theorem equivCode_fail :
    equivCode (.fail : ProgE Q E O α) = FreeM.liftBind (P := (code Q E O).interp)
      (Sum.inr (Sum.inr (Sum.inr ⟨⟩))) fun d : PEmpty => d.elim :=
  congrArg (FreeM.liftBind _) (funext fun d => nomatch d)

/-- The code image carries the bind of party programs to the bind of the free monad. -/
theorem equivCode_bind (p : ProgE Q E O α) (f : α → ProgE Q E O β) :
    equivCode (p.bind f) = (equivCode p).bind fun a => equivCode (f a) := by
  induction p with
  | ret a => rfl
  | recv k ih => simp only [ProgE.bind, equivCode_recv, ih]; rfl
  | send o p ih => simp only [ProgE.bind, equivCode_send, ih]; rfl
  | opN q k ih => simp only [ProgE.bind, equivCode_opN, ih]; rfl
  | fail =>
    rw [ProgE.bind, equivCode_fail, equivCode_fail]
    exact congrArg _ (funext fun d => nomatch d)

/-! ## The code relation of a public view -/

/-- The code relation of the public view `V` on the code of `ProgE`: the events at a receive
related by `V.ev`, the outputs of a send by `V.out`, and the effect operations, the outcomes and
the remaining directions by equality. -/
def viewCodeRel (V : PubView E O) : CodeRel (code Q E O) (code Q E O) :=
  .cons (.dir V.ev) <| .cons (.field (fun o o' => V.out o.down o'.down) fun _ _ _ => .dir (· = ·))
    <| .cons (.field (· = ·) fun _ _ _ => .dir (· = ·)) <| .cons (.dir (· = ·)) .nil

/-- **Information flow as a heterogeneous lift.** Two party programs are related by
`ViewRel V RA` exactly when their code images are related by the lift of `RA` along the code
relation of `V`. -/
theorem viewRel_iff_hRel (V : PubView E O) (RA : α → α → Prop) (p p' : ProgE Q E O α) :
    ProgE.ViewRel V RA p p' ↔ Code.HRel (viewCodeRel V) RA (equivCode p) (equivCode p') := by
  constructor
  · intro h
    induction h with
    | ret h => exact .pure h
    | recv _ ih =>
      rw [equivCode_recv, equivCode_recv]
      exact .liftBind trivial fun e e' he => ih e e' he
    | send ho _ ih =>
      rw [equivCode_send, equivCode_send]
      exact .liftBind ⟨ho, trivial⟩ fun _ _ _ => ih
    | opN q _ ih =>
      rw [equivCode_opN, equivCode_opN]
      exact .liftBind ⟨rfl, trivial⟩ fun n n' hn => by
        obtain rfl : n = n' := hn rfl
        exact ih n
    | fail =>
      rw [equivCode_fail]
      exact .liftBind trivial fun d => nomatch d
  · intro h
    induction p generalizing p' with
    | ret a =>
      cases p' with
      | ret a' => exact .ret (hFreeRel_pure_iff.1 h)
      | _ =>
        simp only [equivCode_recv, equivCode_send, equivCode_opN, equivCode_fail] at h
        exact absurd h not_hFreeRel_pure_liftBind
    | recv k ih =>
      cases p' with
      | recv k' =>
        have h := hFreeRel_liftBind_iff.1 h
        exact .recv fun e e' he => ih e _ (h.2 e e' he)
      | ret => exact absurd h not_hFreeRel_liftBind_pure
      | _ =>
        simp only [equivCode_recv, equivCode_send, equivCode_opN, equivCode_fail] at h
        exact absurd (hFreeRel_liftBind_iff.1 h).1 fun h => h
    | send o p ih =>
      cases p' with
      | send o' p' =>
        obtain ⟨⟨ho, -⟩, hk⟩ := hFreeRel_liftBind_iff.1 h
        exact .send ho (ih _ (hk ⟨⟩ ⟨⟩ fun _ => rfl))
      | ret => exact absurd h not_hFreeRel_liftBind_pure
      | _ =>
        simp only [equivCode_recv, equivCode_send, equivCode_opN, equivCode_fail] at h
        exact absurd (hFreeRel_liftBind_iff.1 h).1 fun h => h
    | opN q k ih =>
      cases p' with
      | opN q' k' =>
        obtain ⟨⟨hq, -⟩, hk⟩ := hFreeRel_liftBind_iff.1 h
        cases hq
        exact .opN q fun n => ih n _ (hk n n fun _ => rfl)
      | ret => exact absurd h not_hFreeRel_liftBind_pure
      | _ =>
        simp only [equivCode_recv, equivCode_send, equivCode_opN, equivCode_fail] at h
        exact absurd (hFreeRel_liftBind_iff.1 h).1 fun h => h
    | fail =>
      cases p' with
      | fail => exact .fail
      | ret => exact absurd h not_hFreeRel_liftBind_pure
      | _ =>
        simp only [equivCode_recv, equivCode_send, equivCode_opN, equivCode_fail] at h
        exact absurd (hFreeRel_liftBind_iff.1 h).1 fun h => h

/-- `ViewRel.bind` from `HFreeRel.bind` through `viewRel_iff_hRel` and `equivCode_bind`. -/
example (V : PubView E O) {RA : α → α → Prop} {RB : β → β → Prop} {p p' : ProgE Q E O α}
    {f f' : α → ProgE Q E O β} (hp : ProgE.ViewRel V RA p p')
    (hf : ∀ a a', RA a a' → ProgE.ViewRel V RB (f a) (f' a')) :
    ProgE.ViewRel V RB (p.bind f) (p'.bind f') := by
  rw [viewRel_iff_hRel, equivCode_bind, equivCode_bind]
  exact HFreeRel.bind ((viewRel_iff_hRel V RA p p').1 hp) fun a a' h =>
    (viewRel_iff_hRel V RB _ _).1 (hf a a' h)

end ProgECost

/-! ## The relational lifting of `SPComp` by `rHoare` -/

/-- The relational lifting of `SPComp` to itself by the pRHL judgment with the heap invariant
`I`: `c` and `c'` are related along `R` when, from heaps related by `I`, they couple to results
related by `R` and final heaps related by `I`. -/
noncomputable def rHoareRelLift (I : RPre) : RelLift SPComp SPComp where
  rel R c c' := rHoare I c c' fun a h b h' => R a b ∧ I h h'
  rel_pure hab := rHoare_ret fun _ _ hI => ⟨hab, hI⟩
  rel_bind hc hf := rHoare_bind hc fun a b h₁ h₂ hh => hf a b hh.1 h₁ h₂ hh.2

end CatCrypt.Crypto.Party

end
