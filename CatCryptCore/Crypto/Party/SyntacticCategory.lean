module

public import CatCryptCore.Crypto.Party.Category

/-!
# The syntactic traced symmetric monoidal category of party programs

The category `Party.PartyCat` identifies two wiring diagrams of party programs when their
denotations are step-equivalent. The syntactic party category `SynPartyCat` identifies them
only modulo program equations: it is the syntactic category
`CatCrypt.Category.TracedTerm.Syn PartyAx` of wiring diagrams over the party generators
(programs and their loops) modulo the traced symmetric monoidal congruence generated by the
program equations `PartyAx`. It is a traced symmetric monoidal category by construction.

The program equations are: the parallel composition `ProgE.par p q` of two programs is the
tensor of the two programs; the forwarding party of the identity is the identity; forwarding
parties compose. The monad laws of `ProgE` hold as equalities of programs, so they hold in the
syntactic category without an equation (`SynPartyCat.ofProg_bind_ret`,
`SynPartyCat.ofProg_bind_assoc`). Associativity and symmetry of the parallel composition are
theorems of the syntactic category (`SynPartyCat.ofProg_par_assoc`,
`SynPartyCat.ofProg_par_comm`).

The parallel composition equation holds for the denotation only up to step equivalence of
systems (`Prog.toSys_par`, `QProg.toQRSys_par`); step equivalence is the equality of morphisms
of `SysCat` and `QSysCat R`, so the soundness theorems `partyAx_sound` and `qPartyAx_sound`
use these step equivalences. The denotations `SynPartyCat.toSys` and `QSynPartyCat.toQRSys`
are strict traced symmetric monoidal functors (the instances and map lemmas of
`TracedTerm.Syn.functor`), and they factor through the semantic categories by the quotient
functors `Syn.toDiag`.

Search words: party language, syntactic category, program equations, free traced monoidal
category, soundness, compositionality.

## Main definitions

* `Party.Syn.toDiag g hAx`: the quotient functor from a syntactic category onto the category
  of wiring diagrams modulo equality of denotations.
* `Party.PartyAx`, `Party.SynPartyCat`, `Party.SynPartyCat.toSys`: classical party programs
  modulo program equations and their denotation in `SysCat`.
* `Party.QPartyAx`, `Party.QSynPartyCat R`, `Party.QSynPartyCat.toQRSys`: quantum party
  programs modulo program equations and their denotation in `QSysCat R`.

## Main results

* `Party.partyAx_sound`, `Party.qPartyAx_sound`: the program equations are sound.
* `Party.SynPartyCat.ofProg_par`, `Party.QSynPartyCat.ofProg_par`: parallel composition is the
  tensor product.
* `Party.SynPartyCat.ofProg_par_assoc`, `Party.SynPartyCat.ofProg_par_comm`: associativity and
  symmetry of parallel composition.
* `Party.SynPartyCat.ofLoop_forward_id`, `Party.SynPartyCat.ofLoop_forward_comp`: forwarding
  parties.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.Party

open CategoryTheory MonoidalCategory CatCrypt.Category

universe u v w

/-! ## The quotient functor onto the semantic category -/

namespace Syn

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [SymmetricCategory C]
  [TracedCategory C] {Gen : C → C → Type w}
  {Ax : ∀ {X Y : C}, TracedTerm.WTerm Gen X Y → TracedTerm.WTerm Gen X Y → Prop}
  (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y)) (hAx : TracedTerm.WTerm.Sound g Ax)

/-- The quotient functor from the syntactic category onto the category of wiring diagrams
modulo equality of denotations: a class of terms is sent to the class of any representative. -/
def toDiag : TracedTerm.Syn Ax ⥤ Diag g where
  obj X := ⟨X.obj⟩
  map f := Quotient.map id (fun _ _ h => TracedTerm.WTerm.PEq.sound g hAx h) f
  map_id _ := rfl
  map_comp := by
    rintro X Y Z ⟨t⟩ ⟨t'⟩
    rfl

/-- The denotation of the syntactic category factors through the quotient functor. -/
theorem toDiag_map_functor {X Y : TracedTerm.Syn Ax} (f : X ⟶ Y) :
    (Diag.functor g).map ((toDiag g hAx).map f) = (TracedTerm.Syn.functor g hAx).map f := by
  induction f using Quotient.inductionOn
  rfl

end Syn

/-! ## Classical party programs -/

section Classical

open CatCrypt.Core CatCrypt.Crypto.UCTransparent
open CatCrypt.Category.TracedTerm (Term WTerm Syn)

/-- **The program equations** of classical party programs: the parallel composition of two
programs is their tensor, the forwarding party of the identity is the identity, and forwarding
parties compose. -/
inductive PartyAx : ∀ {X Y : SysCat}, WTerm PartyGen X Y → WTerm PartyGen X Y → Prop where
  /-- The parallel composition is the tensor. -/
  | par {E O E' O' α β : Type} (p : Prog E O α) (q : Prog E' O' β) :
      PartyAx
        (WTerm.ofGen (X := (⟨E ⊕ E'⟩ : SysCat)) (Y := (⟨O ⊕ O'⟩ : SysCat))
          (PartyGen.prog (ProgE.par p q)))
        (Term.tensor (X := (⟨E⟩ : SysCat)) (Y := (⟨O⟩ : SysCat)) (X' := (⟨E'⟩ : SysCat))
          (Y' := (⟨O'⟩ : SysCat)) (WTerm.ofGen (PartyGen.prog p)) (WTerm.ofGen (PartyGen.prog q)))
  /-- The forwarding party of the identity is the identity. -/
  | forward_id (E : Type) :
      PartyAx
        (WTerm.ofGen (X := (⟨E⟩ : SysCat)) (Y := (⟨E⟩ : SysCat))
          (PartyGen.loop (fun _ => Prog.forward id) ()))
        (.id _)
  /-- Forwarding parties compose. -/
  | forward_comp {E F G : Type} (f : E → F) (h : F → G) :
      PartyAx
        (Term.seq
          (WTerm.ofGen (X := (⟨E⟩ : SysCat)) (Y := (⟨F⟩ : SysCat))
            (PartyGen.loop (fun _ => Prog.forward f) ()))
          (WTerm.ofGen (Y := (⟨G⟩ : SysCat)) (PartyGen.loop (fun _ => Prog.forward h) ())))
        (WTerm.ofGen (PartyGen.loop (fun _ => Prog.forward (h ∘ f)) ()))

/-- The loop of the forwarding party for `f` denotes the morphism of `f`. -/
theorem partyGen_den_forward {X Y : SysCat} (f : X.P → Y.P) :
    PartyGen.den (X := X) (Y := Y) (.loop (fun _ => Prog.forward f) ()) = SysCat.homOfFun f :=
  Quotient.sound (Prog.forward_stepEq f)

/-- **Soundness of the program equations** for the denotation in `SysCat`; the parallel
composition equation holds up to step equivalence (`Prog.toSys_par`). -/
theorem partyAx_sound : WTerm.Sound (C := SysCat) (fun {X Y} => @PartyGen.den X Y) PartyAx := by
  intro X Y t t' h
  cases h with
  | par p q => exact Quotient.sound (Prog.toSys_par p q)
  | forward_id E => exact partyGen_den_forward (X := ⟨E⟩) (Y := ⟨E⟩) id
  | @forward_comp E F G f h =>
    exact (congrArg₂ (· ≫ ·) (partyGen_den_forward (X := ⟨E⟩) (Y := ⟨F⟩) f)
      (partyGen_den_forward (X := ⟨F⟩) (Y := ⟨G⟩) h)).trans
        ((SysCat.homOfFun_comp _ _).trans
          (partyGen_den_forward (X := ⟨E⟩) (Y := ⟨G⟩) (h ∘ f)).symm)

/-- **The syntactic category of party programs**: wiring diagrams of party programs and their
loops modulo the traced symmetric monoidal congruence generated by the program equations. -/
abbrev SynPartyCat : Type 1 :=
  Syn (C := SysCat) (Gen := PartyGen) PartyAx

namespace SynPartyCat

variable {E O E' O' E'' O'' α β γ σ : Type}

/-- **The denotation of party programs** as a strict traced symmetric monoidal functor out of
the syntactic category. -/
noncomputable abbrev toSys : SynPartyCat ⥤ SysCat :=
  TracedTerm.Syn.functor (fun {X Y} => @PartyGen.den X Y) partyAx_sound

/-- The object of the ports `E`. -/
abbrev port (E : Type) : SynPartyCat :=
  ⟨⟨E⟩⟩

/-- The morphism of a party program. -/
noncomputable def ofProg (p : Prog E O α) : port E ⟶ port O :=
  ⟦WTerm.ofGen (.prog p)⟧

/-- The morphism of the loop of a party program. -/
noncomputable def ofLoop (body : σ → Prog E O σ) (s₀ : σ) : port E ⟶ port O :=
  ⟦WTerm.ofGen (.loop body s₀)⟧

/-- Unfolding lemma of `toSys` at a program. -/
@[simp] theorem toSys_map_ofProg (p : Prog E O α) :
    toSys.map (ofProg p) = ⟦⟨_, Prog.toSys p⟩⟧ :=
  rfl

/-- Unfolding lemma of `toSys` at a loop. -/
@[simp] theorem toSys_map_ofLoop (body : σ → Prog E O σ) (s₀ : σ) :
    toSys.map (ofLoop body s₀) = ⟦⟨_, Prog.loopSys body s₀⟩⟧ :=
  rfl

/-- **The parallel composition of programs is the tensor product**, by a program equation. -/
theorem ofProg_par (p : Prog E O α) (q : Prog E' O' β) :
    ofProg (ProgE.par p q) = ofProg p ⊗ₘ ofProg q :=
  Quotient.sound (.ax (.par p q))

/-- The right unit law of the program monad holds in the syntactic category. -/
theorem ofProg_bind_ret (p : Prog E O α) : ofProg (ProgE.bind p ProgE.ret) = ofProg p := by
  rw [ProgE.bind_ret]

/-- The associativity law of the program monad holds in the syntactic category. -/
theorem ofProg_bind_assoc (p : Prog E O α) (f : α → Prog E O β) (h : β → Prog E O γ) :
    ofProg (ProgE.bind (ProgE.bind p f) h) =
      ofProg (ProgE.bind p fun a => ProgE.bind (f a) h) := by
  rw [ProgE.bind_assoc]

/-- **Associativity of parallel composition**: the parallel composition of three programs,
bracketed either way, agrees up to the associators. -/
theorem ofProg_par_assoc (p : Prog E O α) (q : Prog E' O' β) (r : Prog E'' O'' γ) :
    ofProg (ProgE.par (ProgE.par p q) r) ≫ (α_ (port O) (port O') (port O'')).hom =
      (α_ (port E) (port E') (port E'')).hom ≫ ofProg (ProgE.par p (ProgE.par q r)) := by
  rw [ofProg_par, ofProg_par, ofProg_par, ofProg_par]
  exact associator_naturality _ _ _

/-- **Symmetry of parallel composition**: exchanging the two programs is conjugation by the
symmetry. -/
theorem ofProg_par_comm (p : Prog E O α) (q : Prog E' O' β) :
    ofProg (ProgE.par p q) ≫ (β_ (port O) (port O')).hom =
      (β_ (port E) (port E')).hom ≫ ofProg (ProgE.par q p) := by
  rw [ofProg_par, ofProg_par]
  exact BraidedCategory.braiding_naturality _ _

/-- The forwarding party of the identity is the identity, by a program equation. -/
theorem ofLoop_forward_id (E : Type) :
    ofLoop (fun _ => Prog.forward (id : E → E)) () = 𝟙 (port E) :=
  Quotient.sound (.ax (.forward_id E))

/-- Forwarding parties compose, by a program equation. -/
theorem ofLoop_forward_comp {F G : Type} (f : E → F) (h : F → G) :
    ofLoop (fun _ => Prog.forward f) () ≫ ofLoop (fun _ => Prog.forward h) () =
      ofLoop (fun _ => Prog.forward (h ∘ f)) () :=
  Quotient.sound (.ax (.forward_comp f h))

end SynPartyCat

end Classical

/-! ## Quantum party programs -/

section Quantum

open CatCrypt.Quantum.ReactiveUC
open CatCrypt.Category.TracedTerm (Term WTerm Syn)

variable (R : Type) [Fintype R]

/-- **The program equations** of quantum party programs: the parallel composition of two
programs is their tensor. -/
inductive QPartyAx :
    ∀ {X Y : QSysCat R}, WTerm (QPartyGen R) X Y → WTerm (QPartyGen R) X Y → Prop where
  /-- The parallel composition is the tensor. -/
  | par {E O E' O' α β : Type} (p : QProg R E O α) (q : QProg R E' O' β) :
      QPartyAx
        (WTerm.ofGen (X := (⟨E ⊕ E'⟩ : QSysCat R)) (Y := (⟨O ⊕ O'⟩ : QSysCat R))
          (QPartyGen.prog (ProgE.par p q)))
        (Term.tensor (X := (⟨E⟩ : QSysCat R)) (Y := (⟨O⟩ : QSysCat R))
          (X' := (⟨E'⟩ : QSysCat R)) (Y' := (⟨O'⟩ : QSysCat R))
          (WTerm.ofGen (QPartyGen.prog p)) (WTerm.ofGen (QPartyGen.prog q)))

variable {R}

/-- **Soundness of the program equations** for the denotation in `QSysCat R`; the parallel
composition equation holds up to step equivalence (`QProg.toQRSys_par`). -/
theorem qPartyAx_sound :
    WTerm.Sound (C := QSysCat R) (fun {X Y} => @QPartyGen.den R _ X Y) (QPartyAx R) := by
  intro X Y t t' h
  cases h with
  | par p q => exact Quotient.sound (QProg.toQRSys_par p q)

variable (R) in
/-- **The syntactic category of quantum party programs** on the register `R`: wiring diagrams
of quantum party programs and their loops modulo the traced symmetric monoidal congruence
generated by the program equations. -/
abbrev QSynPartyCat : Type 1 :=
  Syn (C := QSysCat R) (Gen := QPartyGen R) (QPartyAx R)

namespace QSynPartyCat

variable {E O E' O' α β σ : Type}

variable (R) in
/-- **The denotation of quantum party programs** as a strict traced symmetric monoidal functor
out of the syntactic category. -/
noncomputable abbrev toQRSys : QSynPartyCat R ⥤ QSysCat R :=
  TracedTerm.Syn.functor (fun {X Y} => @QPartyGen.den R _ X Y) qPartyAx_sound

variable (R) in
/-- The object of the ports `E`. -/
abbrev port (E : Type) : QSynPartyCat R :=
  ⟨⟨E⟩⟩

/-- The morphism of a quantum party program. -/
noncomputable def ofProg (p : QProg R E O α) : port R E ⟶ port R O :=
  ⟦WTerm.ofGen (.prog p)⟧

/-- The morphism of the loop of a quantum party program. -/
noncomputable def ofLoop (body : σ → QProg R E O σ) (s₀ : σ) : port R E ⟶ port R O :=
  ⟦WTerm.ofGen (.loop body s₀)⟧

/-- Unfolding lemma of `toQRSys` at a program. -/
@[simp] theorem toQRSys_map_ofProg (p : QProg R E O α) :
    (toQRSys R).map (ofProg p) = ⟦⟨_, QProg.toQRSys p⟩⟧ :=
  rfl

/-- **The parallel composition of quantum programs is the tensor product**, by a program
equation. -/
theorem ofProg_par (p : QProg R E O α) (q : QProg R E' O' β) :
    ofProg (ProgE.par p q) = ofProg p ⊗ₘ ofProg q :=
  Quotient.sound (.ax (.par p q))

end QSynPartyCat

end Quantum

end CatCrypt.Crypto.Party
