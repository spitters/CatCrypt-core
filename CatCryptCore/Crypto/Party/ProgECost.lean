module

public import CatCryptCore.Container.CodeCost
public import CatCryptCore.Crypto.Party.LoopTimed
import CatCryptCore.Tactics.DeriveFreeSig

/-!
# The time bound of party programs as a cost fold

The signature of party programs `ProgE Q E O` is generated by `derive_free_sig`, with its code.
A weight `w : Q → ℕ` of the effect operations gives the charge `ProgECost.Op.weight w` on the
generated operations: one unit for a receive and a send, `w q` for the operation `q`, nothing
for a failure. The time bound `ProgE.Bound w p t P` is the bound `t` on the cost fold of this
charge at the free-monad image of `p`, together with the invariant `P` on its returns
(`ProgECost.bound_iff_cost`). At the weight `ProgE.weightT ι` of a costed program, the cost
fold bounds the step time of an activation in costed trees (`ProgECost.stepTime_actT_le_cost`).

Search words: party language, time bound, cost fold, charge, code, free monad, complexity.

## Main definitions

* `ProgECost.Op.weight` — the charge of a weight on the operations of `ProgE`;
* `ProgECost.codeCharge` — the same charge on the positions of the code of `ProgE`.

## Main results

* `ProgECost.bound_iff_cost` — `ProgE.Bound` is the cost bound with the demonic invariant;
* `ProgECost.cost_equivCode`, `ProgECost.bound_iff_cost_code` — the same cost fold at the code
  of `ProgE`;
* `ProgECost.stepTime_actT_le_cost` — the step time of an activation is at most the cost fold.
-/

set_option autoImplicit false

@[expose] public section

namespace CatCrypt.Crypto.Party

open PFunctor PFunctor.FreeM CatCrypt.Container CatCrypt.Core

derive_free_sig ProgE (namespace := ProgECost) (code := true)

namespace ProgECost

variable {Q E O α : Type}

/-- The charge of the weight `w` on the operations of `ProgE`: one unit for a receive and a
send, `w q` for the operation `q`, and nothing for a failure. -/
def Op.weight (w : Q → ℕ) : ProgECost.Op Q E O → ℕ
  | .recv => 1
  | .send _ => 1
  | .opN q => w q
  | .fail => 0

/-- The charge of the weight `w` on the positions of the code of `ProgE`. -/
def codeCharge (w : Q → ℕ) (a : (Code.interp (ProgECost.code Q E O)).A) : ℕ :=
  Op.weight w ((ProgECost.sigEquivCode Q E O).equivA.symm a)

/-- `ProgE.Bound w p t P` is the bound `t` on the cost fold of the weight `w` together with the
invariant `P` on the returns. -/
theorem bound_iff_cost (w : Q → ℕ) (p : ProgE Q E O α) (t : ℕ) (P : α → Prop) :
    ProgE.Bound w p t P ↔
      cost (Op.weight w) (ProgECost.toFreeM p) ≤ t ∧
        wpFold (OpSpec.demonic _) (ProgECost.toFreeM p) P := by
  induction p generalizing t with
  | ret a => exact ⟨fun h => ⟨zero_le, h⟩, fun h => h.2⟩
  | recv k ih =>
    change _ ↔ (1 : ℕ∞) + ⨆ e, cost (Op.weight w) (ProgECost.toFreeM (k e)) ≤ t ∧
      ∀ e, wpFold (OpSpec.demonic _) (ProgECost.toFreeM (k e)) P
    erw [natCast_add_le_natCast_iff, iSup_le_iff]
    simp only [ProgE.Bound, ih]
    grind
  | send o p ih =>
    change _ ↔ (1 : ℕ∞) + ⨆ _ : PUnit, cost (Op.weight w) (ProgECost.toFreeM p) ≤ t ∧
      ∀ _ : PUnit, wpFold (OpSpec.demonic _) (ProgECost.toFreeM p) P
    erw [natCast_add_le_natCast_iff, iSup_le_iff]
    simp only [ProgE.Bound, ih, forall_const, and_assoc]
  | opN q k ih =>
    change _ ↔ ((w q : ℕ) : ℕ∞) + ⨆ n, cost (Op.weight w) (ProgECost.toFreeM (k n)) ≤ t ∧
      ∀ n, wpFold (OpSpec.demonic _) (ProgECost.toFreeM (k n)) P
    erw [natCast_add_le_natCast_iff, iSup_le_iff]
    simp only [ProgE.Bound, ih]
    grind
  | fail =>
    refine ⟨fun _ => ⟨?_, fun d => nomatch d⟩, fun _ => trivial⟩
    erw [cost_liftBind]
    simp only [Op.weight, Nat.cast_zero, zero_add, iSup_le_iff]
    exact fun d => nomatch d

/-- The cost fold of `codeCharge w` at the code of `ProgE` is the cost fold of `Op.weight w` at
the generated signature. -/
theorem cost_equivCode (w : Q → ℕ) (p : ProgE Q E O α) :
    cost (codeCharge w) (ProgECost.equivCode p) = cost (Op.weight w) (ProgECost.toFreeM p) := by
  rw [ProgECost.equivCode, Equiv.trans_apply, cost_freeMCongr_toLensEquiv]
  congr 1
  funext o
  simp [codeCharge]

/-- `ProgE.Bound w p t P` is the bound `t` on the cost fold of `codeCharge w` at the code of
`ProgE`, together with the invariant `P` on the returns. -/
theorem bound_iff_cost_code (w : Q → ℕ) (p : ProgE Q E O α) (t : ℕ) (P : α → Prop) :
    ProgE.Bound w p t P ↔
      cost (codeCharge w) (ProgECost.equivCode p) ≤ t ∧
        wpFold (OpSpec.demonic _) (ProgECost.toFreeM p) P := by
  rw [cost_equivCode]
  exact bound_iff_cost w p t P

/-- The step time of an activation in costed trees is at most the cost fold of the weight
`weightT ι`. -/
theorem stepTime_actT_le_cost (ι : Q → ℕ × SPTree.Timed ℕ) (p : ProgE (Costed Q) E O α)
    (e : E) (t : ℕ) (h : cost (Op.weight (ProgE.weightT ι)) (ProgECost.toFreeM p) ≤ t) :
    SPTree.Timed.stepTime (ProgE.actT ι p e) ≤ t := by
  have hb : ProgE.Bound (ProgE.weightT ι) p t fun _ => True :=
    (bound_iff_cost _ p t _).2 ⟨h, wpFold_demonic_true _⟩
  have := ProgE.awaitT_time (R := fun _ => True) (D := 0) ι e (fun o q => (0, .ret (q, o)))
    (fun _ => (0, .fail)) (fun _ => (0, .fail))
    (fun _ _ _ _ _ => ⟨by simp only [SPTree.Timed.stepTime, SPTree.Timed.time_ret, le_refl],
      trivial⟩)
    (fun _ _ => ⟨by simp only [ProgE.stepTime_fail, le_refl], trivial⟩)
    (fun _ _ => ⟨by simp only [ProgE.stepTime_fail, le_refl], trivial⟩) p t le_rfl hb
  exact this.1

end ProgECost

end CatCrypt.Crypto.Party
