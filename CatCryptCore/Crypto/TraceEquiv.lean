/-!
# Trace equivalence of reactive systems

A reactive system `S : Sys τ E O` answers each activation by a step
`S.step t e : SPComp (τ × O)`, which reads and writes the heap. An environment (`Strat`) chooses
each event and the heap before the step, and observes the output and the heap after it. An
activation therefore maps an input `(e, h) : E × Heap` to an output `(o, h') : O × Heap`, and a
history is a finite list of such input/output pairs (`IOHist`).

`Sys.histProb S hs` is the probability that `S`, from its initial state, answers the inputs of
the history `hs` with its outputs: the probability of the outputs given the inputs. Two systems are
*trace equivalent* (`Sys.TraceEq`) when these probabilities agree on every history. This is the
trace equivalence of resources of Lochbihler, Sefidgar, Basin and Maurer (CSF 2019, §V;
`trace_callee` in the AFP entry `Constructive_Cryptography`), which compares the conditional
output distributions after each history: since `histProb S (hs ++ [(x, y)])` is
`histProb S hs` times the conditional probability of the output `y` at the input `x` after `hs`,
equal joint probabilities are the same as equal conditional distributions after every history of
positive probability.

## Main results

* `Sys.traceEq_iff_realizes_zero`: two systems are trace equivalent exactly when each realizes
  the other at bound `0` against every environment and distinguisher (CSF 2019, Thm. 2,
  `distinguish_trace_eq`). One direction computes the view of every environment from the history
  probabilities (`Sys.tsum_mul_view_apply`); the other replays a history (`replay`) and accepts
  when every output and heap agrees with it (`Sys.prTrue_replay`).
* `Sys.TraceEq.seq`: the cascade of lossless systems preserves trace equivalence.

Step-equivalent systems (`StepEq`, generated by state maps that commute with steps) have equal
views and are therefore trace equivalent (`Sys.TraceEq.view_eq` with
`UCLoopbackObservation.realizes_zero_iff_view_eq`). The converse does not hold in general: a
system that samples a coin at its first activation and outputs it later, and one that samples the
coin when it outputs it, are trace equivalent, while their states carry different information and
are not related by maps that commute with single steps.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.UCTransparent

open CatCrypt.Core CatCrypt.Prob CatCrypt.Crypto CatCrypt.Crypto.UCConcrete
open scoped ENNReal

variable {τ υ ζ E O : Type}

/-- A finite history of activations: each entry is an input (event and heap before the step) and
an output (output and heap after the step). -/
abbrev IOHist (E O : Type) := List ((E × Heap) × (O × Heap))

namespace Sys

/-- The probability that `S`, from the state `t`, answers the inputs of `hs` with its outputs. -/
noncomputable def accept (S : Sys τ E O) : τ → IOHist E O → ℝ≥0∞
  | _, [] => 1
  | t, ((e, h), (o, h')) :: hs => ∑' t', S.step t e h (some ((t', o), h')) * accept S t' hs

/-- The probability of the history `hs` under `S`: the probability that `S` answers the inputs
of `hs` with its outputs from its initial state. -/
noncomputable def histProb (S : Sys τ E O) (hs : IOHist E O) : ℝ≥0∞ :=
  accept S S.init hs

/-- Trace equivalence: every history has the same probability under `R` and under `I`. -/
def TraceEq (R : Sys τ E O) (I : Sys υ E O) : Prop :=
  ∀ hs : IOHist E O, histProb R hs = histProb I hs

/-- Unfolding lemma of `accept` on a nonempty history, for an entry given by its components. -/
theorem accept_cons (S : Sys τ E O) (t : τ) (x : E × Heap) (y : O × Heap) (hs : IOHist E O) :
    S.accept t ((x, y) :: hs) = ∑' t', S.step t x.1 x.2 (some ((t', y.1), y.2)) * S.accept t' hs :=
  rfl

end Sys

/-! ## Evaluating runs -/

/-- Weight of a bind at a `some` value. -/
private theorem sdistr_bind_apply_some {α β : Type} (d : SDistr α) (g : α → SDistr β) (x : β) :
    (d.bind g) (some x) = ∑' a, d (some a) * (g a) (some x) := by
  simp only [SDistr.bind, PMF.bind_apply, SDistr.tsum_option_eq_add, SDistr.fail,
    PMF.pure_apply, reduceCtorEq, ite_false, mul_zero, zero_add]

/-- The view of `n + 1` activations at a final configuration, as a sum over the event chosen,
the step of the system and the observation. -/
theorem view_loop_succ_apply (S : Sys τ E O) (Z : Strat ζ E O) (n : ℕ) (z : ζ) (t : τ)
    (h : Heap) (x : ζ × Heap) :
    SPComp.map Prod.fst (loop S (fun _ => false) Z (n + 1) (z, t, false)) h (some x) =
      ∑' a : (ζ × E) × Heap, Z.next z h (some a) *
        ∑' p : (τ × O) × Heap, S.step t a.1.2 a.2 (some p) *
          ∑' q : ζ × Heap, Z.obs a.1.1 p.1.2 p.2 (some q) *
            SPComp.map Prod.fst (loop S (fun _ => false) Z n (q.1, p.1.1, false)) q.2
              (some x) := by
  simp only [loop, SPComp.map, SPComp.bind_assoc, Bool.or_false]
  simp only [SPComp.bind_def, sdistr_bind_apply_some]

/-- A sum over `(τ × O) × Heap` as an outer sum over the output and heap and an inner sum over
the state. -/
private theorem tsum_state_out (f : (τ × O) × Heap → ℝ≥0∞) :
    ∑' p, f p = ∑' (oh : O × Heap) (t : τ), f ((t, oh.1), oh.2) := by
  let e : (O × Heap) × τ ≃ (τ × O) × Heap :=
    { toFun := fun x => ((x.2, x.1.1), x.1.2)
      invFun := fun p => ((p.1.2, p.2), p.1.1)
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  rw [← e.tsum_eq]
  exact ENNReal.tsum_prod (f := fun (oh : O × Heap) (t : τ) => f ((t, oh.1), oh.2))

/-! ## The view is determined by the history probabilities -/

/-- The view functional: the probability of the final configuration `x` of `n` activations of
`Z` from `(z, h)`, against a system whose weighted history probabilities are `M`. It does not
mention the system. -/
noncomputable def viewOf (Z : Strat ζ E O) : ℕ → ζ → Heap → ζ × Heap →
    (IOHist E O → ℝ≥0∞) → ℝ≥0∞
  | 0, z, h, x, M => M [] * (SDistr.pure (z, h) : SDistr (ζ × Heap)) (some x)
  | n + 1, z, h, x, M =>
    ∑' a : (ζ × E) × Heap, Z.next z h (some a) *
      ∑' oh : O × Heap, ∑' q : ζ × Heap, Z.obs a.1.1 oh.1 oh.2 (some q) *
        viewOf Z n q.1 q.2 x (fun hs => M (((a.1.2, a.2), oh) :: hs))

/-- **The view of a weighted state is a function of its history probabilities.** For weights `μ`
on the states of `S`, the `μ`-weighted view of `n` activations is `viewOf` of the
`μ`-weighted history probabilities. -/
theorem Sys.tsum_mul_view_apply (S : Sys τ E O) (Z : Strat ζ E O) (n : ℕ) :
    ∀ (μ : τ → ℝ≥0∞) (z : ζ) (h : Heap) (x : ζ × Heap),
      ∑' t, μ t * SPComp.map Prod.fst (loop S (fun _ => false) Z n (z, t, false)) h (some x) =
        viewOf Z n z h x (fun hs => ∑' t, μ t * S.accept t hs) := by
  have hswap : ∀ {α β : Type} (c : α → ℝ≥0∞) (g : α → β → ℝ≥0∞),
      ∑' a, c a * ∑' b, g a b = ∑' b, ∑' a, c a * g a b := fun c g => by
    simp_rw [← ENNReal.tsum_mul_left]; exact ENNReal.tsum_comm
  induction n with
  | zero =>
    intro μ z h x
    simp only [viewOf, Sys.accept, mul_one, loop, SPComp.map_pure]
    rw [ENNReal.tsum_mul_right]
    rfl
  | succ n ih =>
    intro μ z h x
    simp only [view_loop_succ_apply, viewOf]
    rw [hswap]
    refine tsum_congr fun a => ?_
    simp_rw [mul_left_comm (μ _) (Z.next z h (some a)), ENNReal.tsum_mul_left]
    congr 1
    rw [hswap, tsum_state_out]
    refine tsum_congr fun oh => ?_
    have hM : (fun hs => ∑' t, μ t * S.accept t (((a.1.2, a.2), oh) :: hs)) =
        fun hs => ∑' t', (∑' t, μ t * S.step t a.1.2 a.2 (some ((t', oh.1), oh.2))) *
          S.accept t' hs := funext fun hs => by
      simp only [Sys.accept_cons]
      rw [hswap]
      simp_rw [← ENNReal.tsum_mul_right, mul_assoc]
    rw [hM]
    simp_rw [← ih]
    simp_rw [← ENNReal.tsum_mul_right, ← ENNReal.tsum_mul_left]
    conv_rhs => rw [ENNReal.tsum_comm]
    refine tsum_congr fun t => ?_
    conv_rhs => rw [ENNReal.tsum_comm]
    exact tsum_congr fun t₁ => tsum_congr fun q => by ring

/-- The view of `Z` against `S` is `viewOf` of the history probabilities of `S`. -/
theorem Sys.view_apply (S : Sys τ E O) (Z : Strat ζ E O) (h : Heap) (x : ζ × Heap) :
    view S Z h (some x) = viewOf Z Z.rounds Z.init h x S.histProb := by
  classical
  have hδ : ∀ g : τ → ℝ≥0∞, ∑' t, (if t = S.init then 1 else 0) * g t = g S.init := fun g => by
    rw [tsum_eq_single S.init fun t ht => by simp [ht]]
    simp
  have := S.tsum_mul_view_apply Z Z.rounds (fun t => if t = S.init then 1 else 0) Z.init h x
  simp only [hδ] at this
  exact this

/-- Trace-equivalent systems have equal views. -/
theorem Sys.TraceEq.view_eq {R : Sys τ E O} {I : Sys υ E O} (hRI : Sys.TraceEq R I)
    (Z : Strat ζ E O) : view R Z = view I Z := by
  funext h
  refine SDistr.eq_of_some_eq fun x => ?_
  rw [Sys.view_apply, Sys.view_apply, show R.histProb = I.histProb from funext hRI]

/-! ## Replaying a history -/

/-- The environment that replays the history `hs`: at each activation it sets the heap and
chooses the event of the next entry, and on the output it clears its flag unless the output and
the heap agree with that entry. The event `d` is chosen once the history is exhausted. -/
noncomputable def replay (d : E) (hs : IOHist E O) : Strat (IOHist E O × Bool) E O :=
  open Classical in
  { rounds := hs.length
    init := (hs, true)
    next := fun c => match c.1 with
      | [] => fun h => SDistr.pure ((c, d), h)
      | ((e, hin), _) :: _ => fun _ => SDistr.pure ((c, e), hin)
    obs := fun c o => match c.1 with
      | [] => SPComp.pure c
      | (_, (o', hout)) :: rest =>
        fun h => SDistr.pure ((rest, c.2 && decide (o = o' ∧ h = hout)), h)
    next_noFail := fun c h => by
      rcases c with ⟨_ | ⟨⟨⟨e, hin⟩, _⟩, _⟩, b⟩ <;> simp [SDistr.pure, PMF.pure_apply]
    obs_noFail := fun c o h => by
      rcases c with ⟨_ | ⟨⟨_, ⟨o', hout⟩⟩, _⟩, b⟩ <;>
        simp [SPComp.pure, SDistr.pure, PMF.pure_apply] }

/-- Unfolding lemma of `replay`: the event chosen on a nonempty remaining history. -/
theorem replay_next_cons (d : E) (hs : IOHist E O) (e : E) (hin : Heap) (y : O × Heap)
    (rest : IOHist E O) (b : Bool) :
    (replay d hs).next (((e, hin), y) :: rest, b) =
      fun _ => SDistr.pure (((((e, hin), y) :: rest, b), e), hin) := rfl

open Classical in
/-- Unfolding lemma of `replay`: the observation on a nonempty remaining history. -/
theorem replay_obs_cons (d : E) (hs : IOHist E O) (x : E × Heap) (o' : O) (hout : Heap)
    (rest : IOHist E O) (b : Bool) (o : O) :
    (replay d hs).obs ((x, (o', hout)) :: rest, b) o =
      fun h => SDistr.pure ((rest, b && decide (o = o' ∧ h = hout)), h) := rfl

/-- Summing against a point mass evaluates at its point. -/
private theorem tsum_sdistr_pure_mul {α : Type} (y : α) (f : α → ℝ≥0∞) :
    ∑' a, (SDistr.pure y) (some a) * f a = f y := by
  rw [tsum_eq_single y fun a ha => by simp [SDistr.pure, PMF.pure_apply, ha]]
  simp [SDistr.pure, PMF.pure_apply]

/-- The flag of the replay of `hs`, run from a suffix `rest` with flag `b`, against a system with
history weights `M`: it is kept with weight `M rest` when `b` holds. -/
theorem viewOf_replay (d : E) (hs : IOHist E O) :
    ∀ (rest : IOHist E O) (b : Bool) (h : Heap) (M : IOHist E O → ℝ≥0∞),
      ∑' x : (IOHist E O × Bool) × Heap,
          viewOf (replay d hs) rest.length (rest, b) h x M * (if x.1.2 then 1 else 0) =
        if b then M rest else 0 := by
  intro rest
  induction rest with
  | nil =>
    intro b h M
    simp only [List.length_nil, viewOf, mul_assoc]
    rw [ENNReal.tsum_mul_left, tsum_sdistr_pure_mul]
    cases b <;> simp
  | cons a rest ih =>
    intro b h M
    obtain ⟨⟨e, hin⟩, ⟨o', hout⟩⟩ := a
    simp only [List.length_cons, viewOf, replay_next_cons, replay_obs_cons, tsum_sdistr_pure_mul]
    simp_rw [← ENNReal.tsum_mul_right]
    rw [ENNReal.tsum_comm]
    simp_rw [ih]
    cases b
    · simp
    · rw [tsum_eq_single (o', hout) fun oh hne => by
        simp only [Bool.true_and, decide_eq_true_eq, ite_eq_right_iff]
        exact fun hoh => absurd (Prod.ext hoh.1 hoh.2) hne]
      simp

/-- The distinguisher that returns the flag of `replay`. -/
noncomputable def replayFlag (c : IOHist E O × Bool) : SPComp Bool := SPComp.pure c.2

/-- **The replay accepts with the probability of the history.** Against `S`, the replay of `hs`
keeps its flag with probability `histProb S hs`, from every initial heap. -/
theorem Sys.prTrue_replay (S : Sys τ E O) (d : E) (hs : IOHist E O) (h₀ : Heap) :
    prTrue (SPComp.bind (view S (replay d hs)) replayFlag) h₀ = S.histProb hs := by
  rw [prTrue_bind_eq_weighted, SDistr.tsum_option_eq_add]
  simp only [mul_zero, zero_add, replayFlag, prTrue_pure, Sys.view_apply]
  exact viewOf_replay d hs hs true h₀ S.histProb

/-! ## Completeness -/

/-- **Trace equivalence is indistinguishability** (CSF 2019, Thm. 2). Two systems are trace
equivalent exactly when `R` realizes `I` at bound `0`: no environment with any distinguisher
separates them. -/
theorem Sys.traceEq_iff_realizes_zero {R : Sys τ E O} {I : Sys υ E O} :
    Sys.TraceEq R I ↔ Realizes R I (fun _ _ => 0) := by
  constructor
  · intro hRI ζ Z
    simp [Env.gap, hRI.view_eq Z.input]
  · intro h hs
    cases hs with
    | nil => rfl
    | cons a rest =>
      have hZ : Env.gap (view R) (view I) ⟨replay a.1.1 (a :: rest), Heap.empty, replayFlag⟩
          ≤ 0 := h _ _
      have hR := R.prTrue_replay a.1.1 (a :: rest) Heap.empty
      have hI := I.prTrue_replay a.1.1 (a :: rest) Heap.empty
      rw [← hR, ← hI]
      exact le_antisymm (tsub_eq_zero_iff_le.mp (nonpos_iff_eq_zero.mp (le_sup_left.trans hZ)))
        (tsub_eq_zero_iff_le.mp (nonpos_iff_eq_zero.mp (le_sup_right.trans hZ)))

/-! ## The cascade -/

/-- **The cascade preserves trace equivalence.** For lossless `Y` and `X'`, trace equivalence of
`X` with `X'` and of `Y` with `Y'` gives trace equivalence of the cascades. -/
theorem Sys.TraceEq.seq {τ' υ' P : Type} {X : Sys τ E O} {X' : Sys τ' E O} {Y : Sys υ O P}
    {Y' : Sys υ' O P} (hY : ∀ u o, SPComp.NoFail (Y.step u o))
    (hX' : ∀ t e, SPComp.NoFail (X'.step t e)) (hX : Sys.TraceEq X X')
    (hY' : Sys.TraceEq Y Y') : Sys.TraceEq (X.seq Y) (X'.seq Y') := by
  rw [Sys.traceEq_iff_realizes_zero] at hX hY' ⊢
  intro ζ Z
  exact (realizes_seq_const hY hX' hX hY' ζ Z).trans (by simp)

end CatCrypt.Crypto.UCTransparent
