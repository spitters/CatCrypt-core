/-!
# The prime-order subgroup of Curve25519 and the signed clamped exponent

For a point `B` of Curve25519 of additive order `ℓ = 2^252 + δ₀` (the order of the RFC 7748
base point), the subgroup `G25519 B` generated by `B` is a `CyclicGroup` with exponents
`ZMod ℓ`, `g^e = e • B`. A point is encoded by `encU` as the 32 little-endian bytes of its
u-coordinate (the identity as `0`); the encoding identifies `T` and `T⁻¹`.

An X25519 secret key `sk` of 32 bytes acts through `clampE sk`, its RFC 7748 clamped scalar
modulo `ℓ`. Clamping a uniform byte string gives `8 t` with `t` uniform on `[2^251, 2^252)`;
with an independent uniform sign, `±t` misses only the `2δ₀ + 1` residues outside `(δ₀, 2^252)`
and puts mass at least `2^-252 > 1/ℓ` on each other residue. Hence the law `signedClamp` of
`±clampE sk` is at total variation distance at most `Δ25519 = (2δ₀ + 1)/ℓ ≤ 2^-126` from the
uniform distribution on `ZMod ℓ`.

## Main definitions

* `G25519 B`, `instCyclicGroupG25519` — the subgroup generated by `B` as a cyclic group
* `uCoord`, `encU` — the u-coordinate of a point and its 32-byte encoding
* `natOfLeBytes`, `clampE` — a byte string as a number and its clamped scalar modulo `ℓ`
* `signedE`, `signedClamp` — the signed clamped exponent and its law
* `Δ25519`, `signedClampCert` — the statistical bound and the sampler certificate

## Main results

* `encU_inv` — `encU T⁻¹ = encU T`
* `encU_eq_iff` — `encU T = encU T' ↔ T = T' ∨ T = -T'`
* `clampScalar_eq` — `clampScalar n = 8 * (2^251 + n / 8 % 2^251)` for `n < 2^256`
* `tvDist_signedClamp_le` — `tvDist signedClamp (SDistr.uniform (ZMod ℓ)) ≤ Δ25519`
* `Δ25519_le` — `Δ25519 ≤ 2^-126`
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.ECC

open CatCrypt.Core CatCrypt.Prob CatCrypt.NonUniform CatCrypt.Crypto
open CatCryptCore.Examples.CyclicGroupDDH
open scoped ENNReal

/-- The order `ℓ` of the prime-order subgroup is prime. -/
instance factCurve25519SubgroupOrder : Fact (Nat.Prime curve25519SubgroupOrder) :=
  ⟨curve25519SubgroupOrder_prime⟩

theorem curve25519SubgroupOrder_eq :
    curve25519SubgroupOrder = 2 ^ 252 + 27742317777372353535851937790883648493 := rfl

/-! ## The subgroup generated by a point of order `ℓ` -/

section Subgroup

/-- The subgroup of Curve25519 generated by `B`. -/
abbrev G25519 (B : Curve25519Point) : Type := AddSubgroup.zmultiples B

variable {B : Curve25519Point}

/-- The multiple `e • B` of the generator, for an exponent `e` modulo `ℓ`. -/
def g25519Pow (e : ZMod curve25519SubgroupOrder) : G25519 B :=
  ⟨e.val • B, nsmul_mem (AddSubgroup.mem_zmultiples B) _⟩

@[simp] theorem g25519Pow_coe (e : ZMod curve25519SubgroupOrder) :
    ((g25519Pow e : G25519 B) : Curve25519Point) = e.val • B := rfl

variable [hB : Fact (addOrderOf B = curve25519SubgroupOrder)]

/-- A multiple `n • B` is the multiple by the residue of `n` modulo `ℓ`. -/
theorem nsmul_eq_val_cast_nsmul (n : ℕ) :
    n • B = (n : ZMod curve25519SubgroupOrder).val • B := by
  rw [ZMod.val_natCast, ← hB.out, mod_addOrderOf_nsmul]

theorem g25519Pow_injective : Function.Injective (g25519Pow (B := B)) := by
  intro e e' h
  have h' : e.val • B = e'.val • B := congrArg Subtype.val h
  refine ZMod.val_injective _ (nsmul_injOn_Iio_addOrderOf ?_ ?_ h')
  · simp only [Set.mem_Iio, hB.out]; exact ZMod.val_lt e
  · simp only [Set.mem_Iio, hB.out]; exact ZMod.val_lt e'

theorem g25519Pow_surjective : Function.Surjective (g25519Pow (B := B)) := by
  rintro ⟨x, hx⟩
  obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.1 hx
  refine ⟨(k : ZMod curve25519SubgroupOrder), Subtype.ext ?_⟩
  rw [g25519Pow_coe, ← natCast_zsmul, ZMod.val_intCast, ← hB.out, mod_addOrderOf_zsmul]

/-- The multiple of a sum of exponents is the sum of the multiples. -/
theorem g25519Pow_add (a b : ZMod curve25519SubgroupOrder) :
    (g25519Pow (a + b) : G25519 B) = g25519Pow a + g25519Pow b := by
  refine Subtype.ext ?_
  simp only [g25519Pow_coe, AddSubgroup.coe_add, ← add_nsmul]
  rw [nsmul_eq_val_cast_nsmul (a.val + b.val)]
  simp

/-- The multiple of a negated exponent is the negated multiple. -/
theorem g25519Pow_neg (a : ZMod curve25519SubgroupOrder) :
    (g25519Pow (-a) : G25519 B) = -g25519Pow a :=
  eq_neg_of_add_eq_zero_left (by
    rw [← g25519Pow_add, neg_add_cancel]
    exact Subtype.ext (by simp))

/-- The multiple of a product of exponents is an iterated multiple. -/
theorem g25519Pow_mul (a b : ZMod curve25519SubgroupOrder) :
    (g25519Pow (a * b) : G25519 B) = a.val • g25519Pow b := by
  refine Subtype.ext ?_
  simp only [g25519Pow_coe, AddSubgroup.coe_nsmul, ← mul_nsmul']
  rw [nsmul_eq_val_cast_nsmul (a.val * b.val)]
  simp

/-- The prime-order subgroup generated by `B` as a cyclic group with exponents `ZMod ℓ`. -/
noncomputable instance instCyclicGroupG25519 : CyclicGroup (G25519 B) where
  Exp := ZMod curve25519SubgroupOrder
  finG := by classical exact Fintype.ofSurjective g25519Pow g25519Pow_surjective
  neG := ⟨0⟩
  finExp := inferInstance
  neExp := ⟨0⟩
  gen := g25519Pow 1
  pow := g25519Pow
  mul := (· + ·)
  inv := Neg.neg
  expMul := (· * ·)
  expNeg := Neg.neg
  one := 0
  pow_comm a b := by rw [mul_comm]
  mul_assoc := add_assoc
  mul_comm := add_comm
  mul_inv := add_neg_cancel
  mul_one := add_zero
  pow_bij := ⟨g25519Pow_injective, g25519Pow_surjective⟩

/-! ## The u-coordinate encoding -/

/-- The u-coordinate of a point of Curve25519, `X / Z` of its projective x-coordinate; the
identity has u-coordinate `0`. -/
noncomputable def uCoord (P : Curve25519Point) : Fp25519 :=
  (curve25519_MontyCurveGroup.xProj P).1 * (curve25519_MontyCurveGroup.xProj P).2⁻¹

/-- A point and its negative have the same u-coordinate. -/
theorem uCoord_neg (P : Curve25519Point) : uCoord (-P) = uCoord P := by
  rw [uCoord, uCoord, curve25519_xProj_neg]

/-- The 32 little-endian bytes of a number below `2^256`. -/
def leBytesOfNat (n : ℕ) : Vector UInt8 32 :=
  Vector.ofFn fun i => UInt8.ofNat (n / 256 ^ i.val)

/-- The RFC 7748 encoding of a point of the subgroup: the little-endian bytes of its
u-coordinate. -/
noncomputable def encU (T : G25519 B) : Vector UInt8 32 :=
  leBytesOfNat (uCoord (T : Curve25519Point)).val

omit hB in
/-- The encoding identifies a point and its inverse. -/
theorem encU_neg (T : G25519 B) : encU (-T) = encU T := by
  rw [encU, encU, AddSubgroup.coe_neg, uCoord_neg]

/-- The encoding identifies a point and its inverse in the cyclic group. -/
theorem encU_inv (T : G25519 B) : encU T⁻¹ = encU T :=
  encU_neg T

/-- The encoding of `g^(-e)` is the encoding of `g^e`. -/
theorem encU_pow_neg (e : ZMod curve25519SubgroupOrder) :
    encU (g25519Pow (-e) : G25519 B) = encU (g25519Pow e : G25519 B) := by
  rw [g25519Pow_neg, encU_neg]

end Subgroup

/-! ## Byte strings and the clamped scalar -/

/-- A byte string read as a little-endian number. -/
def natOfLeBytes (v : Vector UInt8 32) : ℕ := ∑ i : Fin 32, v[i].toNat * 256 ^ i.val

/-- Byte strings of length 32 are the numbers below `256^32`, little-endian. -/
def bytesEquiv : Vector UInt8 32 ≃ Fin (256 ^ 32) :=
  (({ toFun := fun v i => v[i]
      invFun := fun f => Vector.ofFn f
      left_inv := fun v => by ext i hi; simp
      right_inv := fun f => by funext i; simp } : Vector UInt8 32 ≃ (Fin 32 → UInt8)).trans
    (Equiv.piCongrRight fun _ =>
      ({ toFun := UInt8.toFin, invFun := UInt8.ofFin, left_inv := UInt8.ofFin_toFin
         right_inv := UInt8.toFin_ofFin } : UInt8 ≃ Fin 256))).trans finPiFinEquiv

theorem bytesEquiv_val (v : Vector UInt8 32) : (bytesEquiv v).val = natOfLeBytes v := by
  simp [bytesEquiv, natOfLeBytes]
  rfl

theorem natOfLeBytes_lt (v : Vector UInt8 32) : natOfLeBytes v < 2 ^ 256 := by
  rw [← bytesEquiv_val]; exact lt_of_lt_of_eq (bytesEquiv v).isLt (by norm_num)

theorem natOfLeBytes_bytesEquiv_symm (m : Fin (256 ^ 32)) :
    natOfLeBytes (bytesEquiv.symm m) = m.val := by
  rw [← bytesEquiv_val, Equiv.apply_symm_apply]

theorem card_bytes : Fintype.card (Vector UInt8 32) = 2 ^ 256 := by
  rw [Fintype.card_congr bytesEquiv]; simp

/-! ## The encoding determines a point up to sign -/

section Injective

variable {B : Curve25519Point} [hB : Fact (addOrderOf B = curve25519SubgroupOrder)]

/-- Reading back the little-endian bytes of `n` gives `n` modulo `2^256`. -/
theorem natOfLeBytes_leBytesOfNat (n : ℕ) : natOfLeBytes (leBytesOfNat n) = n % 2 ^ 256 := by
  have key : ∀ k : ℕ, ∑ i : Fin k, n / 256 ^ i.val % 256 * 256 ^ i.val = n % 256 ^ k := by
    intro k
    induction k with
    | zero => simp [Nat.mod_one]
    | succ k ih =>
      rw [Fin.sum_univ_castSucc, pow_succ, Nat.mod_mul]
      simp only [Fin.val_castSucc, Fin.val_last, ih]
      ring
  rw [show (2 : ℕ) ^ 256 = 256 ^ 32 by norm_num, ← key 32]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp [leBytesOfNat]

/-- The little-endian bytes of numbers below `2^256` determine them. -/
theorem leBytesOfNat_inj {n m : ℕ} (hn : n < 2 ^ 256) (hm : m < 2 ^ 256)
    (h : leBytesOfNat n = leBytesOfNat m) : n = m := by
  have := congrArg natOfLeBytes h
  rwa [natOfLeBytes_leBytesOfNat, natOfLeBytes_leBytesOfNat, Nat.mod_eq_of_lt hn,
    Nat.mod_eq_of_lt hm] at this

/-- The identity has u-coordinate `0`. -/
theorem uCoord_zero : uCoord 0 = 0 := by
  rw [uCoord, curve25519_xProj_eq, show (0 : Curve25519Point) = .zero from rfl, xProjW_zero]
  simp

theorem two_ne_zero_zmod : (2 : ZMod curve25519SubgroupOrder) ≠ 0 := by
  have h := curve25519SubgroupOrder_eq
  rw [show (2 : ZMod curve25519SubgroupOrder) = ((2 : ℕ) : ZMod _) by norm_cast, Ne,
    ZMod.natCast_eq_zero_iff]
  intro hd
  have := Nat.le_of_dvd (by norm_num) hd
  omega

/-- The subgroup has no point of order two. -/
theorem eq_zero_of_add_self (T : G25519 B) (hT : T + T = 0) : T = 0 := by
  obtain ⟨e, rfl⟩ := g25519Pow_surjective T
  rw [← g25519Pow_add, ← two_mul] at hT
  have h0 : (g25519Pow (2 * e) : G25519 B) = g25519Pow 0 := hT.trans (Subtype.ext (by simp))
  have := g25519Pow_injective h0
  rcases mul_eq_zero.1 this with h | h
  · exact absurd h two_ne_zero_zmod
  · rw [h]; exact Subtype.ext (by simp)

/-- A point of the subgroup with u-coordinate `0` is the identity. -/
theorem eq_zero_of_uCoord_eq_zero (T : G25519 B) (hT : uCoord (T : Curve25519Point) = 0) :
    T = 0 := by
  obtain ⟨P, hP⟩ := T
  obtain (_ | @⟨x, y, h⟩) := P
  · rfl
  refine eq_zero_of_add_self _ (Subtype.ext ?_)
  rw [AddSubgroup.coe_add, AddSubgroup.coe_zero]
  apply curve25519_double_eq_zero_of_xProj_fst_zero
  simpa [uCoord, curve25519_xProj_eq, xProjW_some] using hT

/-- Points of the subgroup with the same u-coordinate are equal or inverse. -/
theorem eq_or_eq_neg_of_uCoord_eq (T T' : G25519 B)
    (h : uCoord (T : Curve25519Point) = uCoord (T' : Curve25519Point)) : T = T' ∨ T = -T' := by
  by_cases h0 : uCoord (T : Curve25519Point) = 0
  · left
    rw [eq_zero_of_uCoord_eq_zero T h0, eq_zero_of_uCoord_eq_zero T' (h ▸ h0)]
  obtain ⟨P, hP⟩ := T
  obtain ⟨Q, hQ⟩ := T'
  obtain (_ | @⟨x, y, hxy⟩) := P
  · exact absurd uCoord_zero h0
  obtain (_ | @⟨x', y', hxy'⟩) := Q
  · exact absurd (h.trans uCoord_zero) h0
  simp only [uCoord, curve25519_xProj_eq, xProjW_some, inv_one, mul_one] at h
  rcases WeierstrassCurve.Affine.Y_eq_of_X_eq hxy.1 hxy'.1 h with hy | hy
  · left; subst h; subst hy; rfl
  · right
    refine Subtype.ext ?_
    rw [AddSubgroup.coe_neg, WeierstrassCurve.Affine.Point.neg_some]
    simp only [h, hy]

/-- A u-coordinate is below `2^256`. -/
theorem uCoord_val_lt (P : Curve25519Point) : (uCoord P).val < 2 ^ 256 :=
  lt_of_lt_of_le (ZMod.val_lt _) (by unfold curve25519Prime; omega)

/-- The encodings of two points of the subgroup agree exactly when the points are equal or
inverse. -/
theorem encU_eq_iff (T T' : G25519 B) : encU T = encU T' ↔ T = T' ∨ T = -T' := by
  refine ⟨fun h => eq_or_eq_neg_of_uCoord_eq T T' (ZMod.val_injective _
    (leBytesOfNat_inj (uCoord_val_lt _) (uCoord_val_lt _) h)), ?_⟩
  rintro (rfl | rfl)
  · rfl
  · exact encU_neg T'

end Injective

/-- Clamping clears the three low bits and the top bit and sets bit 254: below `2^256`,
`clampScalar n = 8 * (2^251 + n / 8 % 2^251)`. -/
theorem clampScalar_eq (n : ℕ) (hn : n < 2 ^ 256) :
    clampScalar n = 8 * (2 ^ 251 + n / 8 % 2 ^ 251) := by
  have h1 : (2 : ℕ) ^ 256 - 1 - 7 = (2 ^ 253 - 1) <<< 3 := by norm_num [Nat.shiftLeft_eq]
  have h2 : (2 : ℕ) ^ 256 - 1 - 2 ^ 255 = 2 ^ 255 - 1 := by norm_num
  have h3 : 8 * (2 ^ 251 + n / 8 % 2 ^ 251) = (2 ^ 251 * 1 ||| (n >>> 3) % 2 ^ 251) <<< 3 := by
    rw [← Nat.two_pow_add_eq_or_of_lt (Nat.mod_lt _ (by positivity)), Nat.shiftLeft_eq,
      Nat.shiftRight_eq_div_pow]; ring
  unfold clampScalar
  simp only
  rw [h1, h2, h3]
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_or, Nat.testBit_and, Nat.testBit_shiftLeft, Nat.testBit_two_pow_sub_one,
    Nat.testBit_two_pow, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight, mul_one]
  have hbig : ∀ j, 256 ≤ j → n.testBit j = false := fun j hj =>
    Nat.testBit_lt_two_pow (lt_of_lt_of_le hn (Nat.pow_le_pow_right two_pos hj))
  rcases Nat.lt_or_ge i 3 with h | h
  · simp [show ¬ i ≥ 3 by omega, show ¬ 254 = i by omega]
  rw [show 3 + (i - 3) = i by omega]
  rcases Nat.lt_or_ge i 254 with h' | h'
  · simp [h, show i - 3 < 253 by omega, show i < 255 by omega, show ¬ 254 = i by omega,
      show ¬ 251 = i - 3 by omega, show i - 3 < 251 by omega]
  rcases (show i = 254 ∨ i = 255 ∨ 256 ≤ i by omega) with rfl | rfl | h''
  · simp
  · simp
  · simp [hbig i h'', show ¬ 254 = i by omega, show ¬ 251 = i - 3 by omega,
      show ¬ i - 3 < 251 by omega]

/-- The clamped scalar of an X25519 secret key, modulo `ℓ`. -/
def clampE (sk : Vector UInt8 32) : ZMod curve25519SubgroupOrder :=
  (clampScalar (natOfLeBytes sk) : ZMod curve25519SubgroupOrder)

/-- The clamped scalar with a sign. -/
def signedE (p : Vector UInt8 32 × Bool) : ZMod curve25519SubgroupOrder :=
  if p.2 then clampE p.1 else -clampE p.1

/-- The law of the signed clamped scalar of a uniform key with a uniform sign. -/
noncomputable def signedClamp : SDistr (ZMod curve25519SubgroupOrder) :=
  (SDistr.uniform (Vector UInt8 32 × Bool)).bind fun p => SDistr.pure (signedE p)

/-- A draw from `signedClamp` is a uniform key and a uniform sign. -/
theorem sampleFrom_signedClamp_bind {β : Type} (k : ZMod curve25519SubgroupOrder → SPComp β) :
    (sampleFrom signedClamp).bind k = (SPComp.sample (Vector UInt8 32)).bind fun sk =>
      (SPComp.sample Bool).bind fun b => k (signedE (sk, b)) := by
  rw [signedClamp, ← sampleFrom_bind_sampleFrom, ← SDistr.uniform_nested_eq_prod,
    ← sampleFrom_bind_sampleFrom]
  simp only [SPComp.bind_assoc, ← sampleFrom_bind_sampleFrom, sampleFrom_pure,
    SPComp.pure_bind, sampleFrom_uniform]

/-! ## The distance of the signed clamped scalar to uniform -/

/-- `δ₀ = ℓ - 2^252`. -/
def clampDelta : ℕ := curve25519SubgroupOrder - 2 ^ 252

theorem clampDelta_eq : clampDelta = 27742317777372353535851937790883648493 := by
  have := curve25519SubgroupOrder_eq
  unfold clampDelta
  omega

/-- The signed clamped scalar divided by `8`: `±t` with `t = 2^251 + n / 8 % 2^251`. -/
def signedT (p : Vector UInt8 32 × Bool) : ZMod curve25519SubgroupOrder :=
  if p.2 then ((2 ^ 251 + natOfLeBytes p.1 / 8 % 2 ^ 251 : ℕ) : ZMod curve25519SubgroupOrder)
  else -((2 ^ 251 + natOfLeBytes p.1 / 8 % 2 ^ 251 : ℕ) : ZMod curve25519SubgroupOrder)

theorem signedE_eq (p : Vector UInt8 32 × Bool) : signedE p = 8 * signedT p := by
  unfold signedE signedT clampE
  rw [clampScalar_eq _ (natOfLeBytes_lt _)]
  split <;> push_cast <;> ring

/-- The law of `signedT`. -/
noncomputable def signedTLaw : SDistr (ZMod curve25519SubgroupOrder) :=
  (SDistr.uniform (Vector UInt8 32 × Bool)).bind fun p => SDistr.pure (signedT p)

theorem signedClamp_eq :
    signedClamp = signedTLaw.bind fun y => SDistr.pure (8 * y) := by
  simp only [signedClamp, signedTLaw, SDistr.bind_assoc, SDistr.pure_bind, signedE_eq]

/-- The byte strings `clampPreimage t j`, `j < 32`, have `t = 2^251 + n / 8 % 2^251`. -/
def clampPreimage (t : ℕ) (j : Fin 32) : Vector UInt8 32 :=
  bytesEquiv.symm ⟨j.val % 8 + 8 * ((t - 2 ^ 251) % 2 ^ 251) + 2 ^ 254 * (j.val / 8), by
    have := j.isLt
    have := Nat.mod_lt (t - 2 ^ 251) (show 0 < 2 ^ 251 by positivity)
    rw [show (256 : ℕ) ^ 32 = 2 ^ 256 by norm_num]
    omega⟩

theorem natOfLeBytes_clampPreimage (t : ℕ) (j : Fin 32) :
    natOfLeBytes (clampPreimage t j) =
      j.val % 8 + 8 * ((t - 2 ^ 251) % 2 ^ 251) + 2 ^ 254 * (j.val / 8) :=
  natOfLeBytes_bytesEquiv_symm _

theorem clampPreimage_spec (t : ℕ) (ht : 2 ^ 251 ≤ t) (ht' : t < 2 ^ 252) (j : Fin 32) :
    2 ^ 251 + natOfLeBytes (clampPreimage t j) / 8 % 2 ^ 251 = t := by
  rw [natOfLeBytes_clampPreimage]
  have := j.isLt
  norm_num at ht ht' ⊢
  omega

theorem clampPreimage_injective (t : ℕ) : Function.Injective (clampPreimage t) := by
  intro j j' h
  have h' := congrArg natOfLeBytes h
  rw [natOfLeBytes_clampPreimage, natOfLeBytes_clampPreimage] at h'
  have := j.isLt; have := j'.isLt
  exact Fin.ext (by omega)

/-- A residue strictly between `δ₀` and `2^252` is the value of `signedT` at 32 or more
pairs. -/
theorem card_signedT_ge (y : ZMod curve25519SubgroupOrder) (hy : clampDelta < y.val)
    (hy' : y.val < 2 ^ 252) :
    32 ≤ (Finset.univ.filter fun p => signedT p = y).card := by
  obtain ⟨t, b, ht, ht', hb⟩ : ∃ t : ℕ, ∃ b : Bool, 2 ^ 251 ≤ t ∧ t < 2 ^ 252 ∧
      (if b then ((t : ℕ) : ZMod curve25519SubgroupOrder) else -(t : ZMod _)) = y := by
    have hℓ := curve25519SubgroupOrder_eq
    rw [clampDelta_eq] at hy
    rcases Nat.lt_or_ge y.val (2 ^ 251) with h | h
    · refine ⟨curve25519SubgroupOrder - y.val, false, ?_, ?_, ?_⟩
      · omega
      · omega
      · simp only [Bool.false_eq_true, ↓reduceIte]
        rw [Nat.cast_sub (ZMod.val_lt y).le, ZMod.natCast_self, ZMod.natCast_zmod_val]
        ring
    · exact ⟨y.val, true, h, hy', by simp⟩
  have hmem : ∀ j, signedT (clampPreimage t j, b) = y := fun j => by
    unfold signedT
    rw [clampPreimage_spec t ht ht' j]
    exact hb
  have h32 : Fintype.card (Fin 32) ≤
      Fintype.card {p : Vector UInt8 32 × Bool // signedT p = y} :=
    Fintype.card_le_of_injective (fun j => ⟨(clampPreimage t j, b), hmem j⟩) fun j j' h =>
      clampPreimage_injective t (Prod.ext_iff.1 (congrArg Subtype.val h)).1
  rw [Fintype.card_fin, Fintype.card_subtype] at h32
  exact h32

/-- A residue strictly between `δ₀` and `2^252` has mass at least `1/ℓ` under `signedTLaw`. -/
theorem signedTLaw_ge (y : ZMod curve25519SubgroupOrder) (hy : clampDelta < y.val)
    (hy' : y.val < 2 ^ 252) : (curve25519SubgroupOrder : ℝ≥0∞)⁻¹ ≤ signedTLaw (some y) := by
  rw [signedTLaw, SDistr.uniform_bind_pure_apply, Fintype.card_prod, card_bytes,
    Fintype.card_bool]
  have hℓ := curve25519SubgroupOrder_eq
  calc (curve25519SubgroupOrder : ℝ≥0∞)⁻¹
      = 32 / (32 * (curve25519SubgroupOrder : ℝ≥0∞)) := by
        rw [show (32 : ℝ≥0∞) / (32 * curve25519SubgroupOrder) =
          32 * 1 / (32 * curve25519SubgroupOrder) by rw [mul_one],
          ENNReal.mul_div_mul_left _ _ (by norm_num) (by norm_num), one_div]
    _ ≤ 32 / ((2 ^ 256 * 2 : ℕ) : ℝ≥0∞) := by
        gcongr
        exact_mod_cast (show 2 ^ 256 * 2 ≤ 32 * curve25519SubgroupOrder by omega)
    _ = 32 * ((2 ^ 256 * 2 : ℕ) : ℝ≥0∞)⁻¹ := div_eq_mul_inv _ _
    _ ≤ _ := by gcongr; exact_mod_cast card_signedT_ge y hy hy'

/-- The residues outside `(δ₀, 2^252)`, which `signedT` misses. -/
def ClampBad (y : ZMod curve25519SubgroupOrder) : Prop :=
  y.val ≤ clampDelta ∨ 2 ^ 252 ≤ y.val

instance : DecidablePred ClampBad := fun y => by unfold ClampBad; infer_instance

/-- The statistical distance of the signed clamped scalar to uniform, `(2δ₀ + 1)/ℓ`. -/
noncomputable def Δ25519 : ℝ≥0∞ :=
  ((2 * clampDelta + 1 : ℕ) : ℝ≥0∞) / curve25519SubgroupOrder

/-- The position of a residue outside `(δ₀, 2^252)` among those residues. -/
def clampBadIndex (n : ℕ) : ℕ :=
  if n ≤ clampDelta then n else n - 2 ^ 252 + clampDelta + 1

theorem card_clampBad : Fintype.card {y // ClampBad y} ≤ 2 * clampDelta + 1 := by
  have hℓ := curve25519SubgroupOrder_eq
  have hδ := clampDelta_eq
  let g : {y // ClampBad y} → Fin (2 * clampDelta + 1) := fun y =>
    ⟨clampBadIndex y.1.val, by
      have := ZMod.val_lt y.1
      have := y.2
      unfold ClampBad at this
      unfold clampBadIndex
      split <;> omega⟩
  have hg : Function.Injective g := by
    rintro ⟨y, hy⟩ ⟨y', hy'⟩ h
    have h' : clampBadIndex y.val = clampBadIndex y'.val := congrArg Fin.val h
    have := ZMod.val_lt y
    have := ZMod.val_lt y'
    unfold ClampBad at hy hy'
    unfold clampBadIndex at h'
    clear h
    apply Subtype.ext
    show y = y'
    apply ZMod.val_injective
    split at h' <;> split at h' <;> omega
  exact (Fintype.card_le_of_injective g hg).trans_eq (Fintype.card_fin _)

theorem tsum_indicator_uniform_le :
    ∑' x, (Option.some '' {y | ClampBad y}).indicator
      (SDistr.uniform (ZMod curve25519SubgroupOrder)) x ≤ Δ25519 := by
  rw [SDistr.tsum_option_eq_add, Set.indicator_of_notMem (by simp), zero_add]
  simp_rw [Set.indicator_image (Option.some_injective _)]
  rw [tsum_fintype]
  simp only [Function.comp_def, SDistr.uniform_apply_some, ZMod.card, Set.indicator_apply,
    Set.mem_ofPred_eq]
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, nsmul_eq_mul, Δ25519,
    div_eq_mul_inv]
  gcongr
  rw [← Fintype.card_subtype]
  exact card_clampBad

theorem tvDist_signedTLaw_le :
    tvDist signedTLaw (SDistr.uniform (ZMod curve25519SubgroupOrder)) ≤ Δ25519 := by
  refine (tvDist_le_of_le_off _ _ (Option.some '' {y | ClampBad y}) ?_).trans
    tsum_indicator_uniform_le
  rintro (_ | y) hx
  · rw [SDistr.uniform_apply_none]; exact zero_le
  · rw [SDistr.uniform_apply_some, ZMod.card]
    have hy : ¬ ClampBad y := fun h => hx ⟨y, h, rfl⟩
    simp only [ClampBad, not_or, not_le] at hy
    exact signedTLaw_ge y hy.1 hy.2

theorem eight_ne_zero_zmod : (8 : ZMod curve25519SubgroupOrder) ≠ 0 := by
  have h := curve25519SubgroupOrder_eq
  rw [show (8 : ZMod curve25519SubgroupOrder) = ((8 : ℕ) : ZMod _) by norm_cast, Ne,
    ZMod.natCast_eq_zero_iff]
  intro hd
  have := Nat.le_of_dvd (by norm_num) hd
  omega

/-- **The signed clamped scalar is close to uniform**: at total variation distance at most
`Δ25519` from the uniform distribution on `ZMod ℓ`. -/
theorem tvDist_signedClamp_le :
    tvDist signedClamp (SDistr.uniform (ZMod curve25519SubgroupOrder)) ≤ Δ25519 := by
  rw [signedClamp_eq, ← SDistr.uniform_bind_bij (Equiv.mulLeft₀ 8 eight_ne_zero_zmod)]
  exact (tvDist_bind_le _ _ _).trans tvDist_signedTLaw_le

/-- `Δ25519 ≤ 2^-126`. -/
theorem Δ25519_le : Δ25519 ≤ (2 ^ 126 : ℝ≥0∞)⁻¹ := by
  have hℓ := curve25519SubgroupOrder_eq
  have hδ := clampDelta_eq
  have h0 : ((2 * clampDelta + 1 : ℕ) : ℝ≥0∞) ≠ 0 := by simp
  calc Δ25519 ≤ ((2 * clampDelta + 1 : ℕ) : ℝ≥0∞) /
        (((2 * clampDelta + 1) * 2 ^ 126 : ℕ)) := by
        unfold Δ25519
        gcongr
        exact_mod_cast (show (2 * clampDelta + 1) * 2 ^ 126 ≤ curve25519SubgroupOrder by omega)
    _ = (2 ^ 126 : ℝ≥0∞)⁻¹ := by
        rw [Nat.cast_mul, ← mul_one ((2 * clampDelta + 1 : ℕ) : ℝ≥0∞), mul_assoc,
          ENNReal.mul_div_mul_left _ _ h0 (ENNReal.natCast_ne_top _), one_mul, one_div]
        norm_num

/-- **The sampler certificate of the signed clamped scalar**: the law `signedClamp` against
the uniform distribution on `ZMod ℓ`, with bound `Δ25519`. -/
noncomputable def signedClampCert : SamplerCert (ZMod curve25519SubgroupOrder) where
  μ := signedClamp
  ν := SDistr.uniform _
  δ := Δ25519
  mass_μ := mass_bind_of_mass_one SDistr.mass_uniform fun _ => SDistr.mass_pure _
  mass_ν := SDistr.mass_uniform
  tv_le := tvDist_signedClamp_le

end CatCrypt.Crypto.ECC
