module

public import CatCryptCore.Crypto.Libcrux.Bridge_X25519Group
public import CatCryptCore.Crypto.PAKE.DHExtractKit

/-!
# The prime-order subgroup of Curve25519 as a Diffie–Hellman group, and the decoding of peer keys

For a point `B` of Curve25519 of additive order `ℓ`, `g25519DHGroup B` is the subgroup
`G25519 B` as a `DHGroup` with scalars `ZMod ℓ`: the public value of `e` is `g25519Pow e = e • B`,
exponentiation is `exp T s = s.val • T`, and the group operation is the addition of points. With
the instance `SampleableType (G25519 B)`, the squares stated over a `DHGroup` apply to it.

**Decoding of peer keys.** A public key received from a peer is a string of 32 bytes chosen by the
adversary. `decodeU B u` is a point of the subgroup whose encoding `encU` is `u`, and `none`
exactly when `u` encodes no point of the subgroup (`decodeU_eq_none_iff`), as for the u-coordinate
of a point of the quadratic twist or of a point of the curve outside the subgroup, and for a
string whose number is at least `2^255 - 19`. The input check `subgroupCheckU B u` accepts
exactly the strings that decode (`subgroupCheckU_iff`); it is the specification of the check that
the X3DH crate applies to every peer public key. An accepted string determines its point up to
sign (`decodeU_encU`), and the encoding identifies the two signs of an exponentiation
(`encU_exp_neg`). Under `X25519Hom B`, X25519 with the secret `sk` on an accepted string is the
encoding of the exponentiation of the decoded point by the clamped scalar `clampE sk`
(`X25519Hom.scalarmult_of_decodeU`), and the public key of `sk` is the encoding of the public
value of `clampE sk` (`X25519Hom.base_eq_pub`). Every Diffie–Hellman value computed on an accepted
string is thus the encoding of a value of the group model.

## Main definitions

* `g25519DHGroup B`: the subgroup generated by `B` as a `DHGroup`.
* `decodeU B`, `subgroupCheckU B`: the decoding of 32 bytes as a point of the subgroup and the
  input check.

## Main results

* `g25519DHGroup_exp_natCast`: exponentiation by the cast of a natural number is its multiple.
* `encU_exp_neg`: `encU (exp (-T) s) = encU (exp T s)`.
* `encU_of_decodeU`, `decodeU_eq_none_iff`, `decodeU_encU`: the decoding inverts the encoding up
  to sign, and fails exactly on the strings that encode no point of the subgroup.
* `subgroupCheckU_iff`, `subgroupCheckU_encU`: the check accepts exactly the encodings of the
  points of the subgroup.
* `X25519Hom.base_eq_pub`, `X25519Hom.scalarmult_encU_exp`, `X25519Hom.scalarmult_of_decodeU`:
  X25519 as the operations of `g25519DHGroup B` on accepted strings.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.ECC

open CatCrypt.Crypto CatCrypt.Crypto.PAKE.DHExtract
open CatCrypt.Crypto.Libcrux.Bridge_X25519Group (nsmul_g25519Pow)

variable (B : Curve25519Point)

/-! ## The decoding of peer keys -/

open Classical in
/-- **The decoding of a peer public key**: a point of the subgroup generated by `B` whose
encoding is the string `u`, or `none` when `u` encodes no point of the subgroup. -/
noncomputable def decodeU (u : Vector UInt8 32) : Option (G25519 B) :=
  if h : ∃ T : G25519 B, encU T = u then some h.choose else none

/-- **The input check of a peer public key**: the string `u` decodes to a point of the subgroup
generated by `B`. -/
noncomputable def subgroupCheckU (u : Vector UInt8 32) : Bool := (decodeU B u).isSome

variable {B}

/-- A decoded point encodes the decoded string. -/
theorem encU_of_decodeU {u : Vector UInt8 32} {T : G25519 B} (h : decodeU B u = some T) :
    encU T = u := by
  unfold decodeU at h
  split at h
  · rename_i hu
    rw [← Option.some.inj h]
    exact hu.choose_spec
  · exact absurd h (by simp)

/-- The decoding fails exactly on the strings that encode no point of the subgroup. -/
theorem decodeU_eq_none_iff (u : Vector UInt8 32) :
    decodeU B u = none ↔ ∀ T : G25519 B, encU T ≠ u := by
  unfold decodeU
  split
  · rename_i hu
    simp only [reduceCtorEq, false_iff, not_forall, not_not]
    exact hu
  · rename_i hu
    simp only [true_iff]
    exact fun T hT => hu ⟨T, hT⟩

/-- The check accepts exactly the encodings of the points of the subgroup. -/
theorem subgroupCheckU_iff (u : Vector UInt8 32) :
    subgroupCheckU B u = true ↔ ∃ T : G25519 B, encU T = u := by
  rw [subgroupCheckU, Option.isSome_iff_ne_none, Ne, decodeU_eq_none_iff]
  simp only [ne_eq, not_forall, not_not]

/-- The check accepts the encoding of every point of the subgroup. -/
theorem subgroupCheckU_encU (T : G25519 B) : subgroupCheckU B (encU T) = true :=
  (subgroupCheckU_iff _).2 ⟨T, rfl⟩

variable [Fact (addOrderOf B = curve25519SubgroupOrder)]

/-- **The decoding inverts the encoding up to sign.** -/
theorem decodeU_encU (T : G25519 B) :
    decodeU B (encU T) = some T ∨ decodeU B (encU T) = some (-T) := by
  obtain ⟨T', hT'⟩ := Option.isSome_iff_exists.1 ((subgroupCheckU_iff (B := B) _).2 ⟨T, rfl⟩)
  rcases (encU_eq_iff T' T).1 (encU_of_decodeU hT') with rfl | rfl
  · exact Or.inl hT'
  · exact Or.inr hT'

/-! ## The subgroup as a Diffie–Hellman group -/

variable (B) in
/-- **The subgroup generated by `B` as a Diffie–Hellman group**: scalars `ZMod ℓ`, the public value
`g25519Pow e = e • B`, exponentiation `exp T s = s.val • T` and the addition of points. -/
noncomputable def g25519DHGroup : DHGroup (ZMod curve25519SubgroupOrder) (G25519 B) where
  pub := Equiv.ofBijective _
    (⟨g25519Pow_injective, g25519Pow_surjective⟩ : Function.Bijective (g25519Pow (B := B)))
  exp T s := s.val • T
  exp_pub a b := by
    show b.val • g25519Pow a = g25519Pow (a * b)
    rw [← g25519Pow_mul, mul_comm]
  mul := (· + ·)
  mul_pub a b := (g25519Pow_add a b).symm

/-- Unfolding lemma of the public value of `g25519DHGroup B`. -/
@[simp] theorem g25519DHGroup_pub (e : ZMod curve25519SubgroupOrder) :
    (g25519DHGroup B).pub e = g25519Pow e := rfl

/-- Unfolding lemma of the exponentiation of `g25519DHGroup B`. -/
@[simp] theorem g25519DHGroup_exp (T : G25519 B) (s : ZMod curve25519SubgroupOrder) :
    (g25519DHGroup B).exp T s = s.val • T := rfl

/-- Exponentiation by the cast of a natural number `n` is the multiple `n • T`. -/
theorem g25519DHGroup_exp_natCast (T : G25519 B) (n : ℕ) :
    (g25519DHGroup B).exp T (n : ZMod curve25519SubgroupOrder) = n • T := by
  obtain ⟨e, rfl⟩ := g25519Pow_surjective T
  rw [g25519DHGroup_exp, nsmul_g25519Pow, nsmul_g25519Pow, ZMod.natCast_zmod_val]

/-- The encoding identifies the exponentiations of a point and of its inverse. -/
theorem encU_exp_neg (T : G25519 B) (s : ZMod curve25519SubgroupOrder) :
    encU ((g25519DHGroup B).exp (-T) s) = encU ((g25519DHGroup B).exp T s) := by
  rw [g25519DHGroup_exp, g25519DHGroup_exp, smul_neg, encU_neg]

/-- The subgroup generated by `B` is a finite type with decidable equality, sampled uniformly. -/
noncomputable instance instSampleableTypeG25519 : SampleableType (G25519 B) where
  fintype := Fintype.ofSurjective g25519Pow g25519Pow_surjective
  nonempty := ⟨0⟩
  deceq := inferInstance
  inhabited := ⟨0⟩

end CatCrypt.Crypto.ECC

/-! ## X25519 as the operations of the group -/

namespace CatCrypt.Crypto.Libcrux.Bridge_X25519Group.X25519Hom

open CatCrypt.Crypto.ECC CatCrypt.Crypto.Libcrux.Extraction.Libcrux_specs

variable {B : Curve25519Point} [Fact (addOrderOf B = curve25519SubgroupOrder)] (h : X25519Hom B)
include h

/-- The public key of `sk` is the encoding of the public value of its clamped scalar in
`g25519DHGroup B`. -/
theorem base_eq_pub (sk : Vector UInt8 32) :
    x25519_base sk = encU ((g25519DHGroup B).pub (clampE sk)) := by
  rw [g25519DHGroup_pub, h.base_eq]

/-- X25519 with the secret `sk` on the encoding of a point `T` of the subgroup is the encoding of
the exponentiation of `T` by the clamped scalar of `sk` in `g25519DHGroup B`. -/
theorem scalarmult_encU_exp (sk : Vector UInt8 32) (T : G25519 B) :
    x25519_scalarmult sk (encU T) = encU ((g25519DHGroup B).exp T (clampE sk)) := by
  rw [h.scalarmult, clampE_eq, g25519DHGroup_exp_natCast]

/-- **X25519 on an accepted peer key.** On a string `u` that decodes to the point `T`, X25519 with
the secret `sk` is the encoding of the exponentiation of `T` by the clamped scalar of `sk` in
`g25519DHGroup B`. -/
theorem scalarmult_of_decodeU {u : Vector UInt8 32} {T : G25519 B} (hd : decodeU B u = some T)
    (sk : Vector UInt8 32) :
    x25519_scalarmult sk u = encU ((g25519DHGroup B).exp T (clampE sk)) := by
  rw [← encU_of_decodeU hd, h.scalarmult_encU_exp]

end CatCrypt.Crypto.Libcrux.Bridge_X25519Group.X25519Hom
