module

public import CatCryptCore.Crypto.Libcrux.Bridge_X25519
public import CatCryptCore.Crypto.KeyAgreement.Curve25519Subgroup

/-!
# X25519 as exponentiation in the prime-order subgroup of Curve25519

The libcrux X25519 functions `x25519_scalarmult` and `x25519_base` are opaque constants. Their
RFC 7748 correctness on the subgroup `G25519 B` generated by a point `B` of order `ℓ` is the
hypothesis `X25519Hom B`: on the encoding `encU T` of a point of the subgroup, X25519 with the
secret key `sk` returns the encoding of `clampScalar (natOfLeBytes sk) • T`, and `x25519_base sk`
is the encoding of `clampScalar (natOfLeBytes sk) • B`. It is a correctness property, not a
hardness assumption, and holds for the RFC 7748 base point (`u = 9`).

Under `X25519Hom B`, X25519 is exponentiation by `clampE sk` in the cyclic group `G25519 B`,
commutativity `X25519Commutes` follows, and the public key of `concreteDDH_X25519` is the encoded
group element `g^e` with `e` drawn from `signedClamp`: the sign is not seen by the encoding.

## Main definitions

* `X25519Hom B` — X25519 on encoded points of `G25519 B` is scalar multiplication

## Main results

* `X25519Hom.scalarmult_pow`, `X25519Hom.base_eq` — X25519 as exponentiation by `clampE`
* `X25519Hom.shared_eq` — `x25519_scalarmult a (x25519_base b) = encU (g^(clampE a · clampE b))`
* `x25519Commutes_of_hom` — `X25519Hom B → X25519Commutes`
* `concreteDDH_X25519_keygen_snd` — `concreteDDH_X25519.keygen.map Prod.snd =
  (sampleFrom signedClamp).map (encU ∘ pow)`
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.Libcrux.Bridge_X25519Group

open CatCrypt.Core CatCrypt.Prob CatCrypt.NonUniform CatCrypt.Crypto CatCrypt.Crypto.ECC
open CatCrypt.Crypto.Assumptions
open CatCrypt.Crypto.Libcrux.Extraction.Libcrux_specs
open CatCrypt.Crypto.Libcrux.Bridge_X25519
open scoped ENNReal

variable {B : Curve25519Point}

/-- **RFC 7748 correctness of X25519 on the subgroup generated by `B`**: on the encoding of a
point `T` of the subgroup, X25519 with the key `sk` returns the encoding of `n • T` for the
clamped scalar `n` of `sk`, and the base-point function returns the encoding of `n • B`. -/
structure X25519Hom (B : Curve25519Point) : Prop where
  /-- Scalar multiplication of an encoded point of the subgroup. -/
  scalarmult : ∀ (sk : Vector UInt8 32) (T : G25519 B),
    x25519_scalarmult sk (encU T) = encU (clampScalar (natOfLeBytes sk) • T)
  /-- Scalar multiplication of the generator. -/
  base : ∀ sk : Vector UInt8 32,
    x25519_base sk = encU (clampScalar (natOfLeBytes sk) • (⟨B, AddSubgroup.mem_zmultiples B⟩ :
      G25519 B))

variable [hB : Fact (addOrderOf B = curve25519SubgroupOrder)]

/-- A natural multiple of `g^e` is `g^(n·e)`. -/
theorem nsmul_g25519Pow (n : ℕ) (e : ZMod curve25519SubgroupOrder) :
    n • (g25519Pow e : G25519 B) = g25519Pow ((n : ZMod curve25519SubgroupOrder) * e) := by
  refine Subtype.ext ?_
  simp only [AddSubgroup.coe_nsmul, g25519Pow_coe, ← mul_nsmul']
  rw [nsmul_eq_val_cast_nsmul (B := B) (n * e.val)]
  simp

omit hB in
/-- The generator is `g^1`. -/
theorem gen_eq_g25519Pow_one :
    (⟨B, AddSubgroup.mem_zmultiples B⟩ : G25519 B) = g25519Pow 1 := by
  refine Subtype.ext ?_
  rw [g25519Pow_coe, ZMod.val_one, one_nsmul]

omit hB in
/-- The clamped scalar modulo `ℓ` is the cast of the clamped scalar. -/
theorem clampE_eq (sk : Vector UInt8 32) :
    clampE sk = (clampScalar (natOfLeBytes sk) : ZMod curve25519SubgroupOrder) := rfl

namespace X25519Hom

variable (h : X25519Hom B)
include h

/-- X25519 on `encU (g^e)` is `encU (g^(clampE sk · e))`. -/
theorem scalarmult_pow (sk : Vector UInt8 32) (e : ZMod curve25519SubgroupOrder) :
    x25519_scalarmult sk (encU (g25519Pow e : G25519 B)) =
      encU (g25519Pow (clampE sk * e) : G25519 B) := by
  rw [h.scalarmult, nsmul_g25519Pow, clampE_eq]

/-- The public key of `sk` is `encU (g^(clampE sk))`. -/
theorem base_eq (sk : Vector UInt8 32) :
    x25519_base sk = encU (g25519Pow (clampE sk) : G25519 B) := by
  rw [h.base, gen_eq_g25519Pow_one, nsmul_g25519Pow, mul_one, clampE_eq]

/-- The shared value of two keys is `encU (g^(clampE a · clampE b))`. -/
theorem shared_eq (a b : Vector UInt8 32) :
    x25519_scalarmult a (x25519_base b) =
      encU (g25519Pow (clampE a * clampE b) : G25519 B) := by
  rw [h.base_eq, h.scalarmult_pow]

end X25519Hom

/-- RFC 7748 correctness on a subgroup gives the commutativity of X25519 on public keys. -/
theorem x25519Commutes_of_hom (h : X25519Hom B) : X25519Commutes := fun a b => by
  rw [h.shared_eq, h.shared_eq, mul_comm]

/-- The encoding of `g^(±e)` is the encoding of `g^e`. -/
theorem encU_pow_signedE (sk : Vector UInt8 32) (b : Bool) :
    encU (g25519Pow (signedE (sk, b)) : G25519 B) = encU (g25519Pow (clampE sk) : G25519 B) := by
  cases b
  · exact encU_pow_neg _
  · rfl

/-- **Key generation of `concreteDDH_X25519` realized in the subgroup**: under `X25519Hom B`,
the public key is the encoding of `g^e` with `e` drawn from `signedClamp`. -/
theorem concreteDDH_X25519_keygen_snd (h : X25519Hom B) :
    concreteDDH_X25519.keygen.map Prod.snd =
      (sampleFrom signedClamp).map (encU ∘ (g25519Pow (B := B))) := by
  rw [SPComp.map, SPComp.map, sampleFrom_signedClamp_bind]
  simp only [concreteDDH_X25519, SPComp.bind_assoc, SPComp.pure_bind, Function.comp_apply,
    encU_pow_signedE, h.base_eq]
  congr 1
  funext sk
  exact (dead_sampleFrom SDistr.mass_uniform _).symm

end CatCrypt.Crypto.Libcrux.Bridge_X25519Group
