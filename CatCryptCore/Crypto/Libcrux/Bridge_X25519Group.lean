module

public import CatCryptCore.Crypto.Libcrux.Bridge_X25519
public import CatCryptCore.Crypto.KeyAgreement.Curve25519Subgroup
public import CatCryptCore.Crypto.KeyAgreement.Curve25519BasePoint
public import CatCryptCore.Crypto.Assumptions.DDHSampled

/-!
# X25519 as exponentiation in the prime-order subgroup of Curve25519

An X25519 function on 32-byte strings is a scalar multiplication `sm` and a base-point function
`bp`. Their RFC 7748 correctness on the subgroup `G25519 B` generated by a point `B` of order `ℓ`
is `X25519HomOf sm bp B`: on the encoding `encU T` of a point of the subgroup, `sm` with the
secret key `sk` returns the encoding of `clampScalar (natOfLeBytes sk) • T`, and `bp sk` is the
encoding of `clampScalar (natOfLeBytes sk) • B`. It is a correctness property, not a hardness
assumption. The functions `Spec.x25519_spec` and `Spec.x25519_base_spec` of the RFC 7748
specification satisfy it at every point with u-coordinate `9` (`X25519HomOf.spec`, from
`x25519_spec_encU` and `x25519_base_spec_encU`), in particular at the base point `B9`
(`X25519HomOf.spec_B9`). For the opaque libcrux functions `x25519_scalarmult` and `x25519_base`
it is the hypothesis `X25519Hom B`.

Under `X25519HomOf sm bp B`, `sm` is exponentiation by `clampE sk` in the cyclic group
`G25519 B`, commutativity `X25519CommutesOf sm bp` follows, and the public key of the DDH record
`x25519DDHOf sm bp` is the encoded group element `g^e` with `e` drawn from `signedClamp`: the
sign is not seen by the encoding. Each theorem over `x25519DDHOf sm bp` has its instance at
`concreteDDH_X25519` under `X25519Hom B`, with the statement of the libcrux functions.

## Main definitions

* `X25519HomOf sm bp B` — the functions `sm`, `bp` on encoded points of `G25519 B` are scalar
  multiplication
* `X25519Hom B` — `X25519HomOf` at the libcrux functions

## Main results

* `X25519HomOf.spec`, `X25519HomOf.spec_B9` — the specification functions satisfy
  `X25519HomOf` at a point with u-coordinate `9`, and at `B9`
* `x25519DDHOf_keygen_bind_discard`, `x25519DDHOf_keygen_dh_comm` — the key generation
  `(sk, bp sk)` discarded is the identity, and DH commutativity over it under
  `X25519CommutesOf sm bp`; `concreteDDH_X25519_keygen_bind_discard`,
  `concreteDDH_X25519_keygen_dh_comm` at libcrux
* `X25519HomOf.scalarmult_pow`, `X25519HomOf.base_eq` — X25519 as exponentiation by `clampE`
* `X25519HomOf.shared_eq` — `sm a (bp b) = encU (g^(clampE a · clampE b))`
* `X25519HomOf.scalarmult_elemPow` — `sm sk (encU T) = encU (T ^ signedE (sk, b))`
* `x25519CommutesOf_of_hom`, `x25519Commutes_of_hom` — `X25519HomOf sm bp B →
  X25519CommutesOf sm bp`, and `X25519Hom B → X25519Commutes`
* `x25519DDHOf_keygen_snd`, `concreteDDH_X25519_keygen_snd` — `(x25519DDHOf sm bp).keygen.map
  Prod.snd = (sampleFrom signedClamp).map (encU ∘ pow)`
* `ddhSampled_realizes_x25519DDHOf`, `ddhSampled_realizes_X25519` — the views of the DDH games
  of `x25519DDHOf sm bp`, the ideal value drawn by key generation, are the DDH games of
  `G25519 B` at `signedClamp`, encoded by `encU3`
* `DDH_AdvantageK_x25519DDHOf_le`, `DDH_AdvantageK_X25519_le` — `DDH_AdvantageK (x25519DDHOf sm
  bp) A ≤ DDH_Advantage (G25519 B) (encodedRed encU3 A) + 5 * Δ25519`

The reduction `encodedRed encU3 A` encodes the three group elements and runs `A`; its time
certificate is that of `encodedRed`, instantiated in `Bridge_X25519GroupTimed`.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.Libcrux.Bridge_X25519Group

open CatCrypt.Core CatCrypt.Prob CatCrypt.NonUniform CatCrypt.Crypto CatCrypt.Crypto.ECC
open CatCrypt.Crypto.Assumptions
open CatCrypt.Crypto.Libcrux.Extraction.Libcrux_specs
open CatCrypt.Crypto.Libcrux.Bridge_X25519
open CatCryptCore.Examples.CyclicGroupDDH
open scoped ENNReal

/-! ## The X25519 functions on the subgroup -/

variable {B : Curve25519Point}
variable {sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32}
  {bp : Vector UInt8 32 → Vector UInt8 32}

/-- **RFC 7748 correctness of X25519 functions on the subgroup generated by `B`**: on the
encoding of a point `T` of the subgroup, the scalar multiplication `sm` with the key `sk`
returns the encoding of `n • T` for the clamped scalar `n` of `sk`, and the base-point function
`bp` returns the encoding of `n • B`. -/
structure X25519HomOf (sm : Vector UInt8 32 → Vector UInt8 32 → Vector UInt8 32)
    (bp : Vector UInt8 32 → Vector UInt8 32) (B : Curve25519Point) : Prop where
  /-- Scalar multiplication of an encoded point of the subgroup. -/
  scalarmult : ∀ (sk : Vector UInt8 32) (T : G25519 B),
    sm sk (encU T) = encU (clampScalar (natOfLeBytes sk) • T)
  /-- Scalar multiplication of the generator. -/
  base : ∀ sk : Vector UInt8 32,
    bp sk = encU (clampScalar (natOfLeBytes sk) • (⟨B, AddSubgroup.mem_zmultiples B⟩ :
      G25519 B))

/-- **RFC 7748 correctness of the libcrux X25519 on the subgroup generated by `B`**:
`X25519HomOf` at `x25519_scalarmult` and `x25519_base`. -/
abbrev X25519Hom (B : Curve25519Point) : Prop :=
  X25519HomOf x25519_scalarmult x25519_base B

open CatCrypt.Crypto.KeyAgreement.X25519 in
/-- **The specification functions on the subgroup**: at a point `B` with u-coordinate `9`,
`Spec.x25519_spec` and `Spec.x25519_base_spec` are clamped scalar multiplication on the encoded
points of `G25519 B` (`x25519_spec_encU`, `x25519_base_spec_encU`). -/
theorem X25519HomOf.spec (hB : uCoord B = 9) :
    X25519HomOf Spec.x25519_spec Spec.x25519_base_spec B where
  scalarmult := x25519_spec_encU
  base := x25519_base_spec_encU hB

open CatCrypt.Crypto.KeyAgreement.X25519 in
/-- **The specification functions on the subgroup generated by `B9`**, the base point of
RFC 7748 (`x25519_spec_encU`, `x25519_base_spec_B9`). -/
theorem X25519HomOf.spec_B9 : X25519HomOf Spec.x25519_spec Spec.x25519_base_spec B9 where
  scalarmult := x25519_spec_encU
  base := x25519_base_spec_B9

/-! ## Key generation of `x25519DDHOf` -/

/-- Discarding the result of the key generation of `x25519DDHOf sm bp` is the identity. -/
theorem x25519DDHOf_keygen_bind_discard {β : Type} (rest : SPComp β) :
    SPComp.bind (x25519DDHOf sm bp).keygen (fun _ => rest) = rest := by
  simp only [SPComp.bind_assoc, SPComp.pure_bind]
  funext h
  simp only [SPComp.bind, SPComp.sample]
  rw [SDistr.bind_assoc]
  simp only [SDistr.pure_bind]
  exact SDistr.uniform_bind_const (rest h)

/-- Discarding the result of the key generation of `concreteDDH_X25519` is the identity. -/
theorem concreteDDH_X25519_keygen_bind_discard {β : Type} (rest : SPComp β) :
    SPComp.bind concreteDDH_X25519.keygen (fun _ => rest) = rest :=
  x25519DDHOf_keygen_bind_discard rest

/-- DH commutativity over the key generation of `x25519DDHOf sm bp`, from
`X25519CommutesOf sm bp`: `sm sk₁ pk₂` and `sm sk₂ pk₁` may be exchanged for two generated key
pairs. -/
theorem x25519DDHOf_keygen_dh_comm (hX : X25519CommutesOf sm bp) {α : Type}
    (f : (Vector UInt8 32 × Vector UInt8 32) → (Vector UInt8 32 × Vector UInt8 32) →
      Vector UInt8 32 → SPComp α) :
    ((x25519DDHOf sm bp).keygen.bind fun p₁ =>
        (x25519DDHOf sm bp).keygen.bind fun p₂ => f p₁ p₂ (sm p₁.1 p₂.2)) =
      ((x25519DDHOf sm bp).keygen.bind fun p₁ =>
        (x25519DDHOf sm bp).keygen.bind fun p₂ => f p₁ p₂ (sm p₂.1 p₁.2)) := by
  have hc : ∀ a b : Vector UInt8 32, sm a (bp b) = sm b (bp a) := hX
  simp only [SPComp.bind_assoc, SPComp.pure_bind, hc]

/-- DH commutativity over the key generation of `concreteDDH_X25519`, from `X25519Commutes`:
`X25519(sk₁, pk₂)` and `X25519(sk₂, pk₁)` may be exchanged for two generated key pairs. -/
theorem concreteDDH_X25519_keygen_dh_comm (hX : X25519Commutes) {α : Type}
    (f : (Vector UInt8 32 × Vector UInt8 32) → (Vector UInt8 32 × Vector UInt8 32) →
      Vector UInt8 32 → SPComp α) :
    (concreteDDH_X25519.keygen.bind fun p₁ => concreteDDH_X25519.keygen.bind fun p₂ =>
        f p₁ p₂ (x25519_scalarmult p₁.1 p₂.2)) =
      (concreteDDH_X25519.keygen.bind fun p₁ => concreteDDH_X25519.keygen.bind fun p₂ =>
        f p₁ p₂ (x25519_scalarmult p₂.1 p₁.2)) :=
  x25519DDHOf_keygen_dh_comm hX f

variable [hB : Fact (addOrderOf B = curve25519SubgroupOrder)]

/-- A natural multiple of `g^e` is `g^(n·e)`. -/
theorem nsmul_g25519Pow (n : ℕ) (e : ZMod curve25519SubgroupOrder) :
    n • (g25519Pow e : G25519 B) = g25519Pow ((n : ZMod curve25519SubgroupOrder) * e) := by
  refine Subtype.ext ?_
  simp only [AddSubgroup.coe_nsmul, g25519Pow_coe, ← mul_nsmul']
  rw [nsmul_eq_val_cast_nsmul (B := B) (n * e.val)]
  simp

omit hB in
/-- The generator is `g^1`. -/
theorem gen_eq_g25519Pow_one :
    (⟨B, AddSubgroup.mem_zmultiples B⟩ : G25519 B) = g25519Pow 1 := by
  refine Subtype.ext ?_
  rw [g25519Pow_coe, ZMod.val_one, one_nsmul]

omit hB in
/-- The clamped scalar modulo `ℓ` is the cast of the clamped scalar. -/
theorem clampE_eq (sk : Vector UInt8 32) :
    clampE sk = (clampScalar (natOfLeBytes sk) : ZMod curve25519SubgroupOrder) := rfl

namespace X25519HomOf

variable (h : X25519HomOf sm bp B)
include h

/-- `sm` on `encU (g^e)` is `encU (g^(clampE sk · e))`. -/
theorem scalarmult_pow (sk : Vector UInt8 32) (e : ZMod curve25519SubgroupOrder) :
    sm sk (encU (g25519Pow e : G25519 B)) = encU (g25519Pow (clampE sk * e) : G25519 B) := by
  rw [h.scalarmult, nsmul_g25519Pow, clampE_eq]

/-- The public key of `sk` is `encU (g^(clampE sk))`. -/
theorem base_eq (sk : Vector UInt8 32) :
    bp sk = encU (g25519Pow (clampE sk) : G25519 B) := by
  rw [h.base, gen_eq_g25519Pow_one, nsmul_g25519Pow, mul_one, clampE_eq]

/-- The shared value of two keys is `encU (g^(clampE a · clampE b))`. -/
theorem shared_eq (a b : Vector UInt8 32) :
    sm a (bp b) = encU (g25519Pow (clampE a * clampE b) : G25519 B) := by
  rw [h.base_eq, h.scalarmult_pow]

end X25519HomOf

/-- RFC 7748 correctness on a subgroup gives the commutativity of `sm` on the public keys of
`bp`. -/
theorem x25519CommutesOf_of_hom (h : X25519HomOf sm bp B) : X25519CommutesOf sm bp :=
  fun a b => by rw [h.shared_eq, h.shared_eq, mul_comm]

/-- RFC 7748 correctness on a subgroup gives the commutativity of X25519 on public keys. -/
theorem x25519Commutes_of_hom (h : X25519Hom B) : X25519Commutes :=
  x25519CommutesOf_of_hom h

/-- The encoding of `g^(±e)` is the encoding of `g^e`. -/
theorem encU_pow_signedE (sk : Vector UInt8 32) (b : Bool) :
    encU (g25519Pow (signedE (sk, b)) : G25519 B) = encU (g25519Pow (clampE sk) : G25519 B) := by
  cases b
  · exact encU_pow_neg _
  · rfl

/-- **Key generation of `x25519DDHOf sm bp` realized in the subgroup**: under
`X25519HomOf sm bp B`, the public key is the encoding of `g^e` with `e` drawn from
`signedClamp`. -/
theorem x25519DDHOf_keygen_snd (h : X25519HomOf sm bp B) :
    (x25519DDHOf sm bp).keygen.map Prod.snd =
      (sampleFrom signedClamp).map (encU ∘ (g25519Pow (B := B))) := by
  rw [SPComp.map, SPComp.map, sampleFrom_signedClamp_bind]
  simp only [SPComp.bind_assoc, SPComp.pure_bind, Function.comp_apply,
    encU_pow_signedE, h.base_eq]
  congr 1
  funext sk
  exact (dead_sampleFrom SDistr.mass_uniform _).symm

/-- **Key generation of `concreteDDH_X25519` realized in the subgroup**: under `X25519Hom B`,
the public key is the encoding of `g^e` with `e` drawn from `signedClamp`. -/
theorem concreteDDH_X25519_keygen_snd (h : X25519Hom B) :
    concreteDDH_X25519.keygen.map Prod.snd =
      (sampleFrom signedClamp).map (encU ∘ (g25519Pow (B := B))) :=
  x25519DDHOf_keygen_snd h

/-! ## The DDH games of `x25519DDHOf` in the subgroup -/

/-- Exponentiation in `G25519 B` is `g25519Pow`. -/
theorem cyclicGroup_pow_eq (e : ZMod curve25519SubgroupOrder) :
    (CyclicGroup.pow e : G25519 B) = g25519Pow e := rfl

/-- Exponent multiplication in `G25519 B` is multiplication in `ZMod ℓ`. -/
theorem cyclicGroup_expMul_eq (a b : ZMod curve25519SubgroupOrder) :
    (CyclicGroup.expMul (G := G25519 B) a b) = a * b := rfl

/-- **X25519 as exponentiation by the signed clamped scalar**: under `X25519HomOf sm bp B`,
`sm` with the key `sk` on the encoding of `T` is the encoding of `T ^ signedE (sk, b)`, for
either sign `b`. -/
theorem X25519HomOf.scalarmult_elemPow (h : X25519HomOf sm bp B) (sk : Vector UInt8 32)
    (b : Bool) (T : G25519 B) :
    sm sk (encU T) = encU (CyclicGroup.elemPow T (signedE (sk, b))) := by
  obtain ⟨e, rfl⟩ := g25519Pow_surjective (B := B) T
  rw [h.scalarmult_pow, ← cyclicGroup_pow_eq e, CyclicGroup.elemPow_pow, cyclicGroup_pow_eq,
    cyclicGroup_expMul_eq]
  cases b
  · simp only [signedE, Bool.false_eq_true, ↓reduceIte, mul_neg, encU_pow_neg, mul_comm]
  · simp only [signedE, ↓reduceIte, mul_comm]

/-- A draw of an exponent of `G25519 B` from `signedClamp` is a uniform key and a uniform
sign. -/
theorem sampleFrom_signedClamp_bind_exp {β : Type} (k : CyclicGroup.Exp (G25519 B) → SPComp β) :
    (sampleFrom (α := CyclicGroup.Exp (G25519 B)) signedClamp).bind k =
      (SPComp.sample (Vector UInt8 32)).bind fun sk =>
        (SPComp.sample Bool).bind fun b => k (signedE (sk, b)) :=
  sampleFrom_signedClamp_bind k

/-- The encoding of a triple of group elements, componentwise. -/
noncomputable def encU3 (t : DDHTriple (G25519 B)) :
    Vector UInt8 32 × Vector UInt8 32 × Vector UInt8 32 :=
  (encU t.1, encU t.2.1, encU t.2.2)

/-- The encoding of `g^(±a · ±b)` is the encoding of `g^(a · b)`. -/
theorem encU_pow_signedE_mul (sk₁ sk₂ : Vector UInt8 32) (b₁ b₂ : Bool) :
    encU (g25519Pow (signedE (sk₁, b₁) * signedE (sk₂, b₂)) : G25519 B) =
      encU (g25519Pow (clampE sk₁ * clampE sk₂) : G25519 B) := by
  cases b₁ <;> cases b₂ <;>
    simp [signedE, encU_pow_neg]

/-- A uniform sign drawn and not used is dropped. -/
theorem sample_bool_bind_const {β : Type} (k : SPComp β) :
    (SPComp.sample Bool).bind (fun _ => k) = k :=
  dead_sampleFrom SDistr.mass_uniform k

/-- **The DDH games of `x25519DDHOf sm bp` realized in the subgroup**: under
`X25519HomOf sm bp B`, the real view and the view with the ideal value drawn by key generation
are the DDH games of `G25519 B` with exponents drawn from `signedClamp`, encoded by `encU3`. -/
theorem ddhSampled_realizes_x25519DDHOf (h : X25519HomOf sm bp B) :
    SampledRealizes (DDH_ViewReal (x25519DDHOf sm bp)) (DDH_ViewIdealK (x25519DDHOf sm bp))
      (ddhSampled (G25519 B)) signedClamp encU3 where
  real := by
    simp only [DDH_ViewReal, SampledGame.realAt, ddhSampled, sampleFrom_replicateFin_succ_bind,
      sampleFrom_replicateFin_zero_bind, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind,
      sampleFrom_signedClamp_bind_exp, encU3, Fin.cons_zero, Fin.cons_one,
      cyclicGroup_pow_eq, cyclicGroup_expMul_eq, encU_pow_signedE, encU_pow_signedE_mul,
      h.base_eq, h.scalarmult_pow, sample_bool_bind_const]
  ideal := by
    have h2 : ∀ x y z : CyclicGroup.Exp (G25519 B),
        (Fin.cons x (Fin.cons y (Fin.cons z Fin.elim0)) : Fin 3 → _) 2 = z := fun _ _ _ => rfl
    simp only [DDH_ViewIdealK, h2, SampledGame.idealAt, ddhSampled,
      sampleFrom_replicateFin_succ_bind, sampleFrom_replicateFin_zero_bind, SPComp.map,
      SPComp.bind_assoc, SPComp.pure_bind, sampleFrom_signedClamp_bind_exp,
      encU3, Fin.cons_zero, Fin.cons_one, cyclicGroup_pow_eq, encU_pow_signedE, h.base_eq,
      sample_bool_bind_const]

/-- **The DDH games of `concreteDDH_X25519` realized in the subgroup**: under `X25519Hom B`, the
real view and the view with the ideal value drawn by key generation are the DDH games of
`G25519 B` with exponents drawn from `signedClamp`, encoded by `encU3`. -/
theorem ddhSampled_realizes_X25519 (h : X25519Hom B) :
    SampledRealizes (DDH_ViewReal concreteDDH_X25519) (DDH_ViewIdealK concreteDDH_X25519)
      (ddhSampled (G25519 B)) signedClamp encU3 :=
  ddhSampled_realizes_x25519DDHOf h

/-- **DDH at the bytes of X25519 functions from DDH in the prime-order subgroup**: under
`X25519HomOf sm bp B`, the DDH advantage at `x25519DDHOf sm bp`, with the ideal value drawn by
key generation, is at most the DDH advantage in `G25519 B` of the reduction
`encodedRed encU3 A`, plus `Δ25519` for each of the five exponent draws. -/
theorem DDH_AdvantageK_x25519DDHOf_le (h : X25519HomOf sm bp B)
    (A : DDH_Adversary (Vector UInt8 32)) :
    DDH_AdvantageK (x25519DDHOf sm bp) A ≤
      CatCryptCore.Examples.CyclicGroupDDH.DDH_Advantage (G25519 B)
        (encodedRed encU3 fun t => A t.1 t.2.1 t.2.2) + 5 * Δ25519 := by
  rw [DDH_AdvantageK_eq_advantageA, DDH_Advantage_eq_advAt]
  have hR := advantageA_le_of_realizes (ddhSampled (G25519 B)) signedClampCert encU3
    (ddhSampled_realizes_x25519DDHOf h) fun t => A t.1 t.2.1 t.2.2
  norm_num [ddhSampled] at hR
  exact hR

/-- **DDH at X25519 bytes from DDH in the prime-order subgroup**: under `X25519Hom B`, the DDH
advantage at `concreteDDH_X25519`, with the ideal value drawn by key generation, is at most the
DDH advantage in `G25519 B` of the reduction `encodedRed encU3 A`, plus `Δ25519` for each of
the five exponent draws. -/
theorem DDH_AdvantageK_X25519_le (h : X25519Hom B) (A : DDH_Adversary (Vector UInt8 32)) :
    DDH_AdvantageK concreteDDH_X25519 A ≤
      CatCryptCore.Examples.CyclicGroupDDH.DDH_Advantage (G25519 B)
        (encodedRed encU3 fun t => A t.1 t.2.1 t.2.2) + 5 * Δ25519 :=
  DDH_AdvantageK_x25519DDHOf_le h A

end CatCrypt.Crypto.Libcrux.Bridge_X25519Group
