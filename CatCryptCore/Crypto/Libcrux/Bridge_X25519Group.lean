module

public import CatCryptCore.Crypto.Libcrux.Bridge_X25519
public import CatCryptCore.Crypto.KeyAgreement.Curve25519Subgroup
public import CatCryptCore.Crypto.Assumptions.DDHSampled

/-!
# X25519 as exponentiation in the prime-order subgroup of Curve25519

The libcrux X25519 functions `x25519_scalarmult` and `x25519_base` are opaque constants. Their
RFC 7748 correctness on the subgroup `G25519 B` generated by a point `B` of order `ℓ` is the
hypothesis `X25519Hom B`: on the encoding `encU T` of a point of the subgroup, X25519 with the
secret key `sk` returns the encoding of `clampScalar (natOfLeBytes sk) • T`, and `x25519_base sk`
is the encoding of `clampScalar (natOfLeBytes sk) • B`. It is a correctness property, not a
hardness assumption, and holds for the RFC 7748 base point (`u = 9`).

Under `X25519Hom B`, X25519 is exponentiation by `clampE sk` in the cyclic group `G25519 B`,
commutativity `X25519Commutes` follows, and the public key of `concreteDDH_X25519` is the encoded
group element `g^e` with `e` drawn from `signedClamp`: the sign is not seen by the encoding.

## Main definitions

* `X25519Hom B` — X25519 on encoded points of `G25519 B` is scalar multiplication

## Main results

* `X25519Hom.scalarmult_pow`, `X25519Hom.base_eq` — X25519 as exponentiation by `clampE`
* `X25519Hom.shared_eq` — `x25519_scalarmult a (x25519_base b) = encU (g^(clampE a · clampE b))`
* `X25519Hom.scalarmult_elemPow` — `x25519_scalarmult sk (encU T) = encU (T ^ signedE (sk, b))`
* `x25519Commutes_of_hom` — `X25519Hom B → X25519Commutes`
* `concreteDDH_X25519_keygen_snd` — `concreteDDH_X25519.keygen.map Prod.snd =
  (sampleFrom signedClamp).map (encU ∘ pow)`
* `ddhSampled_realizes_X25519` — the views of the DDH games of `concreteDDH_X25519`, the ideal
  value drawn by key generation, are the DDH games of `G25519 B` at `signedClamp`, encoded by
  `encU3`
* `DDH_AdvantageK_X25519_le` — `DDH_AdvantageK concreteDDH_X25519 A ≤
  DDH_Advantage (G25519 B) (encodedRed encU3 A) + 5 * Δ25519`

The reduction `encodedRed encU3 A` encodes the three group elements and runs `A`; its time
certificate is that of `encodedRed`, instantiated in `Bridge_X25519GroupTimed`.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Crypto.Libcrux.Bridge_X25519Group

open CatCrypt.Core CatCrypt.Prob CatCrypt.NonUniform CatCrypt.Crypto CatCrypt.Crypto.ECC
open CatCrypt.Crypto.Assumptions
open CatCrypt.Crypto.Libcrux.Extraction.Libcrux_specs
open CatCrypt.Crypto.Libcrux.Bridge_X25519
open CatCryptCore.Examples.CyclicGroupDDH
open scoped ENNReal

variable {B : Curve25519Point}

/-- **RFC 7748 correctness of X25519 on the subgroup generated by `B`**: on the encoding of a
point `T` of the subgroup, X25519 with the key `sk` returns the encoding of `n • T` for the
clamped scalar `n` of `sk`, and the base-point function returns the encoding of `n • B`. -/
structure X25519Hom (B : Curve25519Point) : Prop where
  /-- Scalar multiplication of an encoded point of the subgroup. -/
  scalarmult : ∀ (sk : Vector UInt8 32) (T : G25519 B),
    x25519_scalarmult sk (encU T) = encU (clampScalar (natOfLeBytes sk) • T)
  /-- Scalar multiplication of the generator. -/
  base : ∀ sk : Vector UInt8 32,
    x25519_base sk = encU (clampScalar (natOfLeBytes sk) • (⟨B, AddSubgroup.mem_zmultiples B⟩ :
      G25519 B))

variable [hB : Fact (addOrderOf B = curve25519SubgroupOrder)]

/-- A natural multiple of `g^e` is `g^(n·e)`. -/
theorem nsmul_g25519Pow (n : ℕ) (e : ZMod curve25519SubgroupOrder) :
    n • (g25519Pow e : G25519 B) = g25519Pow ((n : ZMod curve25519SubgroupOrder) * e) := by
  refine Subtype.ext ?_
  simp only [AddSubgroup.coe_nsmul, g25519Pow_coe, ← mul_nsmul']
  rw [nsmul_eq_val_cast_nsmul (B := B) (n * e.val)]
  simp

omit hB in
/-- The generator is `g^1`. -/
theorem gen_eq_g25519Pow_one :
    (⟨B, AddSubgroup.mem_zmultiples B⟩ : G25519 B) = g25519Pow 1 := by
  refine Subtype.ext ?_
  rw [g25519Pow_coe, ZMod.val_one, one_nsmul]

omit hB in
/-- The clamped scalar modulo `ℓ` is the cast of the clamped scalar. -/
theorem clampE_eq (sk : Vector UInt8 32) :
    clampE sk = (clampScalar (natOfLeBytes sk) : ZMod curve25519SubgroupOrder) := rfl

namespace X25519Hom

variable (h : X25519Hom B)
include h

/-- X25519 on `encU (g^e)` is `encU (g^(clampE sk · e))`. -/
theorem scalarmult_pow (sk : Vector UInt8 32) (e : ZMod curve25519SubgroupOrder) :
    x25519_scalarmult sk (encU (g25519Pow e : G25519 B)) =
      encU (g25519Pow (clampE sk * e) : G25519 B) := by
  rw [h.scalarmult, nsmul_g25519Pow, clampE_eq]

/-- The public key of `sk` is `encU (g^(clampE sk))`. -/
theorem base_eq (sk : Vector UInt8 32) :
    x25519_base sk = encU (g25519Pow (clampE sk) : G25519 B) := by
  rw [h.base, gen_eq_g25519Pow_one, nsmul_g25519Pow, mul_one, clampE_eq]

/-- The shared value of two keys is `encU (g^(clampE a · clampE b))`. -/
theorem shared_eq (a b : Vector UInt8 32) :
    x25519_scalarmult a (x25519_base b) =
      encU (g25519Pow (clampE a * clampE b) : G25519 B) := by
  rw [h.base_eq, h.scalarmult_pow]

end X25519Hom

/-- RFC 7748 correctness on a subgroup gives the commutativity of X25519 on public keys. -/
theorem x25519Commutes_of_hom (h : X25519Hom B) : X25519Commutes := fun a b => by
  rw [h.shared_eq, h.shared_eq, mul_comm]

/-- The encoding of `g^(±e)` is the encoding of `g^e`. -/
theorem encU_pow_signedE (sk : Vector UInt8 32) (b : Bool) :
    encU (g25519Pow (signedE (sk, b)) : G25519 B) = encU (g25519Pow (clampE sk) : G25519 B) := by
  cases b
  · exact encU_pow_neg _
  · rfl

/-- **Key generation of `concreteDDH_X25519` realized in the subgroup**: under `X25519Hom B`,
the public key is the encoding of `g^e` with `e` drawn from `signedClamp`. -/
theorem concreteDDH_X25519_keygen_snd (h : X25519Hom B) :
    concreteDDH_X25519.keygen.map Prod.snd =
      (sampleFrom signedClamp).map (encU ∘ (g25519Pow (B := B))) := by
  rw [SPComp.map, SPComp.map, sampleFrom_signedClamp_bind]
  simp only [concreteDDH_X25519, SPComp.bind_assoc, SPComp.pure_bind, Function.comp_apply,
    encU_pow_signedE, h.base_eq]
  congr 1
  funext sk
  exact (dead_sampleFrom SDistr.mass_uniform _).symm

/-! ## The DDH games of `concreteDDH_X25519` in the subgroup -/

/-- Exponentiation in `G25519 B` is `g25519Pow`. -/
theorem cyclicGroup_pow_eq (e : ZMod curve25519SubgroupOrder) :
    (CyclicGroup.pow e : G25519 B) = g25519Pow e := rfl

/-- Exponent multiplication in `G25519 B` is multiplication in `ZMod ℓ`. -/
theorem cyclicGroup_expMul_eq (a b : ZMod curve25519SubgroupOrder) :
    (CyclicGroup.expMul (G := G25519 B) a b) = a * b := rfl

/-- **X25519 as exponentiation by the signed clamped scalar**: under `X25519Hom B`, X25519 with
the key `sk` on the encoding of `T` is the encoding of `T ^ signedE (sk, b)`, for either sign
`b`. -/
theorem X25519Hom.scalarmult_elemPow (h : X25519Hom B) (sk : Vector UInt8 32) (b : Bool)
    (T : G25519 B) :
    x25519_scalarmult sk (encU T) = encU (CyclicGroup.elemPow T (signedE (sk, b))) := by
  obtain ⟨e, rfl⟩ := g25519Pow_surjective (B := B) T
  rw [h.scalarmult_pow, ← cyclicGroup_pow_eq e, CyclicGroup.elemPow_pow, cyclicGroup_pow_eq,
    cyclicGroup_expMul_eq]
  cases b
  · simp only [signedE, Bool.false_eq_true, ↓reduceIte, mul_neg, encU_pow_neg, mul_comm]
  · simp only [signedE, ↓reduceIte, mul_comm]

/-- A draw of an exponent of `G25519 B` from `signedClamp` is a uniform key and a uniform
sign. -/
theorem sampleFrom_signedClamp_bind_exp {β : Type} (k : CyclicGroup.Exp (G25519 B) → SPComp β) :
    (sampleFrom (α := CyclicGroup.Exp (G25519 B)) signedClamp).bind k =
      (SPComp.sample (Vector UInt8 32)).bind fun sk =>
        (SPComp.sample Bool).bind fun b => k (signedE (sk, b)) :=
  sampleFrom_signedClamp_bind k

/-- The encoding of a triple of group elements, componentwise. -/
noncomputable def encU3 (t : DDHTriple (G25519 B)) :
    Vector UInt8 32 × Vector UInt8 32 × Vector UInt8 32 :=
  (encU t.1, encU t.2.1, encU t.2.2)

/-- The encoding of `g^(±a · ±b)` is the encoding of `g^(a · b)`. -/
theorem encU_pow_signedE_mul (sk₁ sk₂ : Vector UInt8 32) (b₁ b₂ : Bool) :
    encU (g25519Pow (signedE (sk₁, b₁) * signedE (sk₂, b₂)) : G25519 B) =
      encU (g25519Pow (clampE sk₁ * clampE sk₂) : G25519 B) := by
  cases b₁ <;> cases b₂ <;>
    simp [signedE, encU_pow_neg]

/-- A uniform sign drawn and not used is dropped. -/
theorem sample_bool_bind_const {β : Type} (k : SPComp β) :
    (SPComp.sample Bool).bind (fun _ => k) = k :=
  dead_sampleFrom SDistr.mass_uniform k

/-- **The DDH games of `concreteDDH_X25519` realized in the subgroup**: under `X25519Hom B`, the
real view and the view with the ideal value drawn by key generation are the DDH games of
`G25519 B` with exponents drawn from `signedClamp`, encoded by `encU3`. -/
theorem ddhSampled_realizes_X25519 (h : X25519Hom B) :
    Realizes (DDH_ViewReal concreteDDH_X25519) (DDH_ViewIdealK concreteDDH_X25519)
      (ddhSampled (G25519 B)) signedClamp encU3 where
  real := by
    simp only [DDH_ViewReal, SampledGame.realAt, ddhSampled, sampleFrom_replicateFin_succ_bind,
      sampleFrom_replicateFin_zero_bind, SPComp.map, SPComp.bind_assoc, SPComp.pure_bind,
      sampleFrom_signedClamp_bind_exp, concreteDDH_X25519, encU3, Fin.cons_zero, Fin.cons_one,
      cyclicGroup_pow_eq, cyclicGroup_expMul_eq, encU_pow_signedE, encU_pow_signedE_mul,
      h.base_eq, h.scalarmult_pow, sample_bool_bind_const]
  ideal := by
    have h2 : ∀ x y z : CyclicGroup.Exp (G25519 B),
        (Fin.cons x (Fin.cons y (Fin.cons z Fin.elim0)) : Fin 3 → _) 2 = z := fun _ _ _ => rfl
    simp only [DDH_ViewIdealK, h2, SampledGame.idealAt, ddhSampled,
      sampleFrom_replicateFin_succ_bind, sampleFrom_replicateFin_zero_bind, SPComp.map,
      SPComp.bind_assoc, SPComp.pure_bind, sampleFrom_signedClamp_bind_exp, concreteDDH_X25519,
      encU3, Fin.cons_zero, Fin.cons_one, cyclicGroup_pow_eq, encU_pow_signedE, h.base_eq,
      sample_bool_bind_const]

/-- **DDH at X25519 bytes from DDH in the prime-order subgroup**: under `X25519Hom B`, the DDH
advantage at `concreteDDH_X25519`, with the ideal value drawn by key generation, is at most the
DDH advantage in `G25519 B` of the reduction `encodedRed encU3 A`, plus `Δ25519` for each of
the five exponent draws. -/
theorem DDH_AdvantageK_X25519_le (h : X25519Hom B) (A : DDH_Adversary (Vector UInt8 32)) :
    DDH_AdvantageK concreteDDH_X25519 A ≤
      CatCryptCore.Examples.CyclicGroupDDH.DDH_Advantage (G25519 B)
        (encodedRed encU3 fun t => A t.1 t.2.1 t.2.2) + 5 * Δ25519 := by
  rw [DDH_AdvantageK_eq_advantageA, DDH_Advantage_eq_advAt]
  have hR := advantageA_le_of_realizes (ddhSampled (G25519 B)) signedClampCert encU3
    (ddhSampled_realizes_X25519 h) fun t => A t.1 t.2.1 t.2.2
  norm_num [ddhSampled] at hR
  exact hR

end CatCrypt.Crypto.Libcrux.Bridge_X25519Group
