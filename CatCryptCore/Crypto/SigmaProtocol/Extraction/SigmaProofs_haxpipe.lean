  bytes

def push_bytes32 (out : Array (Int)) (bytes : Array (Int)) : Array (Int) :=
  let extended := (out : Array (Int))
  Hax.foldRange (0 : Int) (32 : Int) extended fun i extended =>
    (Hax.push extended (Hax.index bytes i) : Array (Int))

