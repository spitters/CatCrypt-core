module

public import Mathlib.Order.Setoid.Basic

/-!
# Difunctional relations and corelations on a sum

A relation `r : α → β → Prop` is *difunctional* (Riguet) when `r a b`, `r a' b` and `r a' b'`
give `r a b'`, that is `r ∘ r˘ ∘ r ⊆ r`. A relation `r` generates an equivalence relation on
`α ⊕ β`, the equivalence closure of the pairs `(inl a, inr b)` with `r a b`; an equivalence
relation `E` on `α ⊕ β` restricts to the relation `fun a b => E (inl a) (inr b)`. These two maps
form a Galois connection between relations from `α` to `β` and equivalence relations on `α ⊕ β`.
Its closure on relations is the difunctional closure, whose fixed points are the difunctional
relations; its kernel on equivalence relations has as fixed points the equivalence relations
generated by their pairs across the sum.

## Main definitions

* `Difunctional r` — `r a b → r a' b → r a' b' → r a b'`
* `Relation.DifClosure r` — `a` and `b` are joined by an alternating path of `r`-steps
* `Relation.Cross r` — the relation on `α ⊕ β` with the pairs `(inl a, inr b)` with `r a b`
* `Relation.across E` — the restriction `fun a b => E (inl a) (inr b)` of a relation on `α ⊕ β`
* `Relation.corel r` — the equivalence relation on `α ⊕ β` generated by `Cross r`
* `CrossGenerated E` — `E` lies below the equivalence closure of its pairs across the sum

## Main results

* `Relation.gc_corel_across` — the Galois connection `corel ⊣ across`
* `Relation.eqvGen_cross_le_iff` — the same connection for an equivalence relation given by
  `Equivalence`
* `Relation.eqvGen_cross_inl_inr_iff` — `across (corel r)` is the difunctional closure of `r`
* `Relation.across_corel_iff_difunctional` — fixed points on relations are the difunctional ones
* `Relation.crossGenerated_iff_corel_across_eq` — fixed points on equivalence relations are the
  cross-generated ones
* `difunctional_graph` — the graph of a function is difunctional

## References

* J. Riguet, *Relations binaires, fermetures, correspondances de Galois*, Bull. Soc. Math. France
  76 (1948) 114–155.
* R. Backhouse, J. N. Oliveira, *On difunctions*, 2023.
-/

@[expose] public section

set_option autoImplicit false

universe u v

variable {α : Type u} {β : Type v}

/-- A relation is difunctional when `r a b`, `r a' b` and `r a' b'` give `r a b'` (Riguet). -/
def Difunctional (r : α → β → Prop) : Prop :=
  ∀ ⦃a a' : α⦄ ⦃b b' : β⦄, r a b → r a' b → r a' b' → r a b'

/-- The converse of a difunctional relation is difunctional. -/
theorem Difunctional.flip {r : α → β → Prop} (h : Difunctional r) : Difunctional (flip r) :=
  fun _ _ _ _ h1 h2 h3 => h h3 h2 h1

/-- The graph of a function is difunctional. -/
theorem difunctional_graph {γ : Type*} (g : γ → β) : Difunctional fun a b => g a = b := by
  intro a a' b b' h1 h2 h3
  grind

/-- The converse of the graph of a function is difunctional. -/
theorem difunctional_graph_flip {γ : Type*} (g : γ → β) : Difunctional fun b a => g a = b :=
  (difunctional_graph g).flip

namespace Relation

/-- Two elements of `α` are adjacent when they are related to a common element of `β`. -/
def Adj (r : α → β → Prop) (a a' : α) : Prop :=
  ∃ b, r a b ∧ r a' b

/-- The difunctional closure: `a` and `b` are joined by an alternating path of `r`-steps
`a ~ a₁ ~ ⋯ ~ aₙ` through common `r`-images, followed by `r aₙ b`. -/
def DifClosure (r : α → β → Prop) (a : α) (b : β) : Prop :=
  ∃ a', ReflTransGen (Adj r) a a' ∧ r a' b

/-- Paths of adjacent elements are symmetric. -/
theorem reflTransGen_adj_symm {r : α → β → Prop} {a a' : α} (h : ReflTransGen (Adj r) a a') :
    ReflTransGen (Adj r) a' a := by
  induction h with
  | refl => exact ReflTransGen.refl
  | tail _ hcd ih =>
    obtain ⟨b, h1, h2⟩ := hcd
    exact ReflTransGen.head ⟨b, h2, h1⟩ ih

/-- A relation lies below its difunctional closure. -/
theorem le_difClosure {r : α → β → Prop} {a : α} {b : β} (h : r a b) : DifClosure r a b :=
  ⟨a, ReflTransGen.refl, h⟩

/-- A path of adjacent elements extends the difunctional closure. -/
theorem DifClosure.head {r : α → β → Prop} {a a' : α} {b : β} (h : ReflTransGen (Adj r) a a')
    (h' : DifClosure r a' b) : DifClosure r a b := by
  obtain ⟨c, hc, hr⟩ := h'
  exact ⟨c, h.trans hc, hr⟩

/-- Two elements with a common image under the difunctional closure are joined by a path. -/
theorem reflTransGen_adj_of_difClosure {r : α → β → Prop} {a a' : α} {b : β}
    (h : DifClosure r a b) (h' : DifClosure r a' b) : ReflTransGen (Adj r) a a' := by
  obtain ⟨c, hc, hr⟩ := h
  obtain ⟨c', hc', hr'⟩ := h'
  exact (hc.tail ⟨b, hr, hr'⟩).trans (reflTransGen_adj_symm hc')

/-- The difunctional closure is difunctional. -/
theorem difunctional_difClosure (r : α → β → Prop) : Difunctional (DifClosure r) := by
  intro a a' b b' h1 h2 h3
  exact DifClosure.head ((reflTransGen_adj_of_difClosure h1 h2)) h3

/-- The difunctional closure is the least difunctional relation containing `r`. -/
theorem difClosure_le {r s : α → β → Prop} (hs : Difunctional s) (hrs : ∀ a b, r a b → s a b)
    {a : α} {b : β} (h : DifClosure r a b) : s a b := by
  obtain ⟨c, hc, hr⟩ := h
  induction hc using ReflTransGen.head_induction_on with
  | refl => exact hrs _ _ hr
  | head hadj _ ih =>
    obtain ⟨b', h1, h2⟩ := hadj
    exact hs (hrs _ _ h1) (hrs _ _ h2) ih

/-- A relation is difunctional exactly when it contains its difunctional closure. -/
theorem difunctional_iff_difClosure_le {r : α → β → Prop} :
    Difunctional r ↔ ∀ a b, DifClosure r a b → r a b := by
  constructor
  · intro h a b hab
    exact difClosure_le h (fun _ _ => id) hab
  · intro h a a' b b' h1 h2 h3
    exact h _ _ ⟨a', ReflTransGen.single ⟨b, h1, h2⟩, h3⟩

/-- The pairs `(inl a, inr b)` with `r a b`, as a relation on `α ⊕ β`. -/
def Cross (r : α → β → Prop) : α ⊕ β → α ⊕ β → Prop
  | .inl a, .inr b => r a b
  | _, _ => False

/-- The relation across the sum: `a` and `b` related when `inl a` and `inr b` are. -/
def across (E : α ⊕ β → α ⊕ β → Prop) (a : α) (b : β) : Prop :=
  E (.inl a) (.inr b)

/-- The corelation generated by a relation: the equivalence closure of its cross pairs. -/
def corel (r : α → β → Prop) : Setoid (α ⊕ β) :=
  EqvGen.setoid (Cross r)

/-- `Cross` and `across` form a Galois connection on relations. -/
theorem gc_cross_across :
    GaloisConnection (Cross : (α → β → Prop) → α ⊕ β → α ⊕ β → Prop) across := by
  intro r E
  constructor
  · intro h a b hab
    exact h (.inl a) (.inr b) hab
  · intro h x y hxy
    rcases x with a | b <;> rcases y with a' | b'
    · exact (hxy : False).elim
    · exact h a b' hxy
    · exact (hxy : False).elim
    · exact (hxy : False).elim

/-- **The comparison Galois connection**: the corelation generated by a relation is below an
equivalence relation `E` exactly when the relation is below the restriction of `E` across the
sum. -/
theorem gc_corel_across :
    GaloisConnection (corel : (α → β → Prop) → Setoid (α ⊕ β)) (fun E => across E) :=
  gc_cross_across.compose Setoid.gi.gc

/-- The comparison Galois connection, for an equivalence relation given by `Equivalence`. -/
theorem eqvGen_cross_le_iff {r : α → β → Prop} {E : α ⊕ β → α ⊕ β → Prop}
    (hE : Equivalence E) :
    (∀ x y, EqvGen (Cross r) x y → E x y) ↔ ∀ a b, r a b → E (.inl a) (.inr b) := by
  constructor
  · intro h a b hab
    exact h _ _ (EqvGen.rel (Sum.inl a) (Sum.inr b) hab)
  · intro h x y hxy
    exact Setoid.le_def.1
      (Setoid.eqvGen_le (s := ⟨E, hE⟩) fun x y hc => (gc_cross_across r E).2 h x y hc) hxy

/-- The membership in the equivalence closure of the cross pairs, by anchors in `α`. -/
private def Anchor (r : α → β → Prop) : α ⊕ β → α → Prop
  | .inl a, a₀ => ReflTransGen (Adj r) a₀ a
  | .inr b, a₀ => DifClosure r a₀ b

private theorem anchor_adj {r : α → β → Prop} {x : α ⊕ β} {a₀ a₁ : α}
    (h₀ : Anchor r x a₀) (h₁ : Anchor r x a₁) : ReflTransGen (Adj r) a₀ a₁ := by
  cases x with
  | inl a => exact h₀.trans (reflTransGen_adj_symm h₁)
  | inr b => exact reflTransGen_adj_of_difClosure h₀ h₁

private theorem anchor_head {r : α → β → Prop} {x : α ⊕ β} {a₀ a₁ : α}
    (h : ReflTransGen (Adj r) a₀ a₁) (h₁ : Anchor r x a₁) : Anchor r x a₀ := by
  cases x with
  | inl a => exact h.trans h₁
  | inr b => exact DifClosure.head h h₁

/-- The equivalence relation of two equal elements or two elements with a common anchor. -/
private def Linked (r : α → β → Prop) (x y : α ⊕ β) : Prop :=
  x = y ∨ ∃ a₀, Anchor r x a₀ ∧ Anchor r y a₀

private theorem linked_equivalence (r : α → β → Prop) : Equivalence (Linked r) where
  refl _ := .inl rfl
  symm := by
    rintro x y (h | ⟨a₀, h₁, h₂⟩)
    · exact .inl h.symm
    · exact .inr ⟨a₀, h₂, h₁⟩
  trans := by
    rintro x y z (rfl | ⟨a₀, hx, hy⟩) (rfl | ⟨a₁, hy', hz⟩)
    · exact .inl rfl
    · exact .inr ⟨a₁, hy', hz⟩
    · exact .inr ⟨a₀, hx, hy⟩
    · exact .inr ⟨a₀, hx, anchor_head (anchor_adj hy hy') hz⟩

private theorem eqvGen_cross_of_reflTransGen {r : α → β → Prop} {a a' : α}
    (h : ReflTransGen (Adj r) a a') : EqvGen (Cross r) (.inl a) (.inl a') := by
  induction h with
  | refl => exact EqvGen.refl _
  | tail _ hadj ih =>
    obtain ⟨b, h1, h2⟩ := hadj
    exact ih.trans _ _ _ ((EqvGen.rel _ (.inr b) h1).trans _ _ _
      (EqvGen.symm _ _ (EqvGen.rel (Sum.inl _) (Sum.inr b) h2)))

/-- The restriction across the sum of the corelation generated by `r` is the difunctional
closure of `r`. -/
theorem eqvGen_cross_inl_inr_iff {r : α → β → Prop} {a : α} {b : β} :
    EqvGen (Cross r) (.inl a) (.inr b) ↔ DifClosure r a b := by
  constructor
  · intro h
    have hle : ∀ x y, EqvGen (Cross r) x y → Linked r x y :=
      (eqvGen_cross_le_iff (linked_equivalence r)).2 fun a b hab =>
        .inr ⟨a, ReflTransGen.refl, le_difClosure hab⟩
    rcases hle _ _ h with h | ⟨a₀, h₁, h₂⟩
    · cases h
    · exact DifClosure.head (reflTransGen_adj_symm h₁) h₂
  · rintro ⟨a', hp, hr⟩
    exact (eqvGen_cross_of_reflTransGen hp).trans _ _ _ (EqvGen.rel _ _ hr)

/-- `across (corel r)` is the difunctional closure of `r`. -/
theorem across_corel_iff {r : α → β → Prop} {a : α} {b : β} :
    across (corel r) a b ↔ DifClosure r a b :=
  eqvGen_cross_inl_inr_iff

/-- The fixed points of the closure on relations are the difunctional relations. -/
theorem across_corel_iff_difunctional {r : α → β → Prop} :
    (∀ a b, across (corel r) a b ↔ r a b) ↔ Difunctional r := by
  rw [difunctional_iff_difClosure_le]
  constructor
  · intro h a b hab
    exact (h a b).1 (across_corel_iff.2 hab)
  · intro h a b
    exact ⟨fun hab => h a b (across_corel_iff.1 hab),
      fun hab => across_corel_iff.2 (le_difClosure hab)⟩

/-- The restriction of an equivalence relation across the sum is difunctional. -/
theorem difunctional_across (E : Setoid (α ⊕ β)) : Difunctional (across E) := by
  intro a a' b b' h1 h2 h3
  exact E.trans' (E.trans' h1 (E.symm' h2)) h3

end Relation

open Relation in
/-- An equivalence relation on `α ⊕ β` is cross-generated when it lies below the equivalence
closure of its pairs across the sum. -/
def CrossGenerated (E : α ⊕ β → α ⊕ β → Prop) : Prop :=
  ∀ x y, E x y → EqvGen (Cross (across E)) x y

namespace Relation

/-- The fixed points of the kernel on equivalence relations are the cross-generated ones. -/
theorem crossGenerated_iff_corel_across_eq (E : Setoid (α ⊕ β)) :
    CrossGenerated E ↔ corel (across E) = E := by
  constructor
  · intro h
    refine le_antisymm (gc_corel_across.l_u_le E) ?_
    intro x y hxy
    exact h x y hxy
  · intro h x y hxy
    rw [← h] at hxy
    exact hxy

/-- The corelation generated by a relation is cross-generated. -/
theorem crossGenerated_corel (r : α → β → Prop) : CrossGenerated (corel r) := by
  intro x y h
  have h1 : Cross r ≤ Cross (across (corel r)) :=
    gc_cross_across.monotone_l (gc_corel_across.le_u_l r)
  exact Setoid.le_def.1 (Setoid.eqvGen_mono fun x y hx => h1 x y hx) h

end Relation
