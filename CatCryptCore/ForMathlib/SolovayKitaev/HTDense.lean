/-!
# Density of the Clifford+T group in `SU(2)`

The Hadamard gate and the `T` gate, normalised to determinant one as `hSU = i H` and
`tSU = e^{-iπ/8} T`, generate a dense subgroup of `SU(2)`; consequently, for every `ε₀ > 0`
the words of bounded length over `{hSU, tSU, hSU⁻¹, tSU⁻¹}` form an `ε₀`-cover of `SU(2)`.
This is the base case of the Solovay–Kitaev theorem for the Clifford+T gate set.

The proof works with the diagonal circle `diagSU φ = diag (e^{-iφ}, e^{iφ})` and the
top-left modulus `topSq x = |x₀₀|²`.

* The element `uHT = tSU · (hSU tSU hSU⁻¹)` has trace `1 + √2 / 2 = 2 cos β`, and `β / 2π` is
  irrational by Niven's theorem (`2 cos (qπ)` is an algebraic integer for rational `q`, while
  `(2 cos β - 1)² = 1 / 2`).
* `uHT` is conjugate to `diagSU β`, so in the conjugated frame the closed group contains all
  of `diagSU`, by the density of `ℤ β + 2π ℤ` in `ℝ`.
* Conjugating `diagSU φ` by an element `x` gives `topSq = cos² φ + (1 - 2 topSq x)² sin² φ`;
  iterating this from an element outside the normaliser of the circle reaches `topSq = 1 / 2`,
  then every value in `[0, 1]`, and an Euler decomposition `V = diagSU φ · z · diagSU ψ`
  finishes.

## Main results

* `SolovayKitaev.closure_closure_HT` — the closure of the group generated by `hSU` and `tSU`
  is all of `SU(2)`.
* `SolovayKitaev.exists_isCover_HT` — words of bounded length form an `ε₀`-cover of `SU(2)`.

## References

* C. M. Dawson, M. A. Nielsen, *The Solovay–Kitaev algorithm*, Quantum Inf. Comput. 6 (2006).
* P. O. Boykin, T. Mor, M. Pulver, V. Roychowdhury, F. Vatan, *On universal and fault-tolerant
  quantum computing*, FOCS 1999.
-/

@[expose] public section

set_option autoImplicit false

open Complex Matrix
open scoped Matrix.Norms.L2Operator

namespace SolovayKitaev

/-! ### Elements of `SU(2)` from their first row -/

private lemma exp_ofReal_mul_I (x : ℝ) :
    exp (x * I) = (Real.cos x : ℂ) + (Real.sin x : ℂ) * I := by
  rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]

private lemma exp_neg_ofReal_mul_I (x : ℝ) :
    exp (-(x * I)) = (Real.cos x : ℂ) - (Real.sin x : ℂ) * I := by
  rw [← neg_mul, ← Complex.ofReal_neg, exp_ofReal_mul_I, Real.cos_neg, Real.sin_neg]
  push_cast
  ring

/-- The matrix `[[a, b], [-b̄, ā]]` with `|a|² + |b|² = 1` lies in `SU(2)`. -/
theorem mk_mem_specialUnitaryGroup {a b : ℂ} (h : normSq a + normSq b = 1) :
    !![a, b; -(starRingEnd ℂ) b, (starRingEnd ℂ) a] ∈ specialUnitaryGroup (Fin 2) ℂ := by
  have ha := Complex.mul_conj a
  have hb := Complex.mul_conj b
  have hh : (normSq a : ℂ) + normSq b = 1 := by exact_mod_cast h
  rw [mem_specialUnitaryGroup_iff, Matrix.mem_unitaryGroup_iff]
  refine ⟨?_, ?_⟩
  · ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two, Matrix.star_apply] <;>
      grind
  · simp [Matrix.det_fin_two]
    grind

/-- The squared moduli of the first row of an element of `SU(2)` sum to one. -/
theorem normSq_row (x : SU2) :
    normSq ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 0) +
      normSq ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 1) = 1 := by
  have h := congrFun (congrFun
    (Matrix.mem_unitaryGroup_iff.mp (Matrix.mem_specialUnitaryGroup_iff.mp x.2).1) 0) 0
  simp only [Matrix.mul_apply, Fin.sum_univ_two, Matrix.star_apply, Matrix.one_apply_eq,
    Complex.star_def, Complex.mul_conj] at h
  exact_mod_cast h

/-- The second row of an element of `SU(2)` is `(-b̄, ā)` for the first row `(a, b)`. -/
theorem su2_entries (x : SU2) :
    (x : Matrix (Fin 2) (Fin 2) ℂ) 1 1 = (starRingEnd ℂ) ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 0) ∧
    (x : Matrix (Fin 2) (Fin 2) ℂ) 1 0 =
      -(starRingEnd ℂ) ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 1) := by
  have hdet : (x : Matrix (Fin 2) (Fin 2) ℂ).det = 1 :=
    (Matrix.mem_specialUnitaryGroup_iff.mp x.2).2
  have hsu : star (x : Matrix (Fin 2) (Fin 2) ℂ) * (x : Matrix (Fin 2) (Fin 2) ℂ) = 1 :=
    Matrix.mem_unitaryGroup_iff'.mp (Matrix.mem_specialUnitaryGroup_iff.mp x.2).1
  have hadj : star (x : Matrix (Fin 2) (Fin 2) ℂ) = (x : Matrix (Fin 2) (Fin 2) ℂ).adjugate := by
    calc star (x : Matrix (Fin 2) (Fin 2) ℂ)
        = star (x : Matrix (Fin 2) (Fin 2) ℂ) *
            ((x : Matrix (Fin 2) (Fin 2) ℂ) * (x : Matrix (Fin 2) (Fin 2) ℂ).adjugate) := by
          rw [Matrix.mul_adjugate, hdet, one_smul, Matrix.mul_one]
      _ = _ := by rw [← Matrix.mul_assoc, hsu, Matrix.one_mul]
  have e00 := congrFun (congrFun hadj 0) 0
  have e10 := congrFun (congrFun hadj 0) 1
  simp only [Matrix.star_apply, Matrix.adjugate_fin_two, Matrix.of_apply, Matrix.cons_val',
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one, Complex.star_def] at e00 e10
  refine ⟨e00.symm, ?_⟩
  have := congrArg (starRingEnd ℂ) e10
  simpa using this

/-- Two elements of `SU(2)` with the same first row are equal. -/
theorem ext_of_row {x y : SU2}
    (h0 : (x : Matrix (Fin 2) (Fin 2) ℂ) 0 0 = (y : Matrix (Fin 2) (Fin 2) ℂ) 0 0)
    (h1 : (x : Matrix (Fin 2) (Fin 2) ℂ) 0 1 = (y : Matrix (Fin 2) (Fin 2) ℂ) 0 1) : x = y := by
  obtain ⟨ex1, ex2⟩ := su2_entries x
  obtain ⟨ey1, ey2⟩ := su2_entries y
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [h0, h1, ex1, ex2, ey1, ey2]

/-! ### Topology of `SU(2)` -/

/-- `SU(2)` with the subspace topology of the matrices is a topological group. -/
instance : IsTopologicalGroup SU2 where
  continuous_mul := by
    apply Continuous.subtype_mk
    exact (continuous_subtype_val.comp continuous_fst).mul
      (continuous_subtype_val.comp continuous_snd)
  continuous_inv := continuous_subtype_val.star.subtype_mk _

/-- `SU(2)` is compact: it is closed and bounded in the operator norm. -/
instance : CompactSpace SU2 := by
  have : ProperSpace (Matrix (Fin 2) (Fin 2) ℂ) := FiniteDimensional.proper_rclike ℂ _
  refine isCompact_iff_compactSpace.mp (Metric.isCompact_of_isClosed_isBounded ?_ ?_)
  · have e : (specialUnitaryGroup (Fin 2) ℂ : Set (Matrix (Fin 2) (Fin 2) ℂ)) =
        {A | star A * A = 1} ∩ {A | A * star A = 1} ∩ {A | A.det = 1} := by
      ext A
      simp only [SetLike.mem_coe, Set.mem_inter_iff, Set.mem_ofPred_eq,
        mem_specialUnitaryGroup_iff, Matrix.mem_unitaryGroup_iff]
      exact ⟨fun h => ⟨⟨_root_.mul_eq_one_comm.mp h.1, h.1⟩, h.2⟩, fun h => ⟨h.1.2, h.2⟩⟩
    rw [e]
    refine ((isClosed_eq ?_ continuous_const).inter (isClosed_eq ?_ continuous_const)).inter
      (isClosed_eq ?_ continuous_const)
    · exact continuous_star.mul continuous_id
    · exact continuous_id.mul continuous_star
    · exact continuous_id.matrix_det
  · refine (Metric.isBounded_closedBall (x := 0) (r := 1)).subset fun A hA => ?_
    simp only [Metric.mem_closedBall, dist_zero_right]
    exact (CStarRing.norm_of_mem_unitary (mem_specialUnitaryGroup_iff.mp hA).1).le

/-! ### The diagonal circle -/

/-- The diagonal matrix `diag (e^{-iφ}, e^{iφ})`. -/
noncomputable def diagMat (φ : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  !![exp (-(φ * I)), 0; 0, exp (φ * I)]

/-- The diagonal matrix `diag (e^{-iφ}, e^{iφ})` lies in `SU(2)`. -/
theorem diagMat_mem (φ : ℝ) : diagMat φ ∈ specialUnitaryGroup (Fin 2) ℂ := by
  have e : diagMat φ = !![exp (-(φ * I)), 0; -(starRingEnd ℂ) 0,
      (starRingEnd ℂ) (exp (-(φ * I)))] := by
    rw [← Complex.exp_conj]
    simp [diagMat]
  rw [e]
  apply mk_mem_specialUnitaryGroup
  rw [← neg_mul, ← Complex.ofReal_neg, Complex.normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I]
  simp

/-- The diagonal element `diag (e^{-iφ}, e^{iφ})` of `SU(2)`. -/
noncomputable def diagSU (φ : ℝ) : SU2 := ⟨diagMat φ, diagMat_mem φ⟩

/-- Unfolding lemma: the matrix of `diagSU φ` is `diagMat φ`. -/
theorem coe_diagSU (φ : ℝ) : (diagSU φ : Matrix (Fin 2) (Fin 2) ℂ) = diagMat φ := rfl

/-- The diagonal circle is a homomorphism from `ℝ`. -/
theorem diagSU_add (a b : ℝ) : diagSU (a + b) = diagSU a * diagSU b := by
  apply ext_of_row
  · simp [coe_diagSU, diagMat, Matrix.mul_apply, Fin.sum_univ_two, ← Complex.exp_add]
    ring_nf
  · simp [coe_diagSU, diagMat, Matrix.mul_apply, Fin.sum_univ_two]

/-- The point `0` of the diagonal circle is the identity. -/
theorem diagSU_zero : diagSU 0 = 1 := by
  apply ext_of_row <;> simp [coe_diagSU, diagMat]

/-- The point `-a` of the diagonal circle is the inverse of the point `a`. -/
theorem diagSU_neg (a : ℝ) : diagSU (-a) = (diagSU a)⁻¹ := by
  rw [eq_inv_iff_mul_eq_one, ← diagSU_add, neg_add_cancel, diagSU_zero]

/-- The diagonal circle has period `2π`. -/
theorem diagSU_two_pi : diagSU (2 * Real.pi) = 1 := by
  apply ext_of_row
  · simp [coe_diagSU, diagMat, Complex.exp_neg, Complex.exp_two_pi_mul_I]
  · simp [coe_diagSU, diagMat]

/-- The diagonal circle is continuous. -/
theorem continuous_diagSU : Continuous diagSU := by
  apply Continuous.subtype_mk
  refine continuous_pi fun i => continuous_pi fun j => ?_
  fin_cases i <;> fin_cases j <;>
    (simp only [diagMat, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one, Fin.zero_eta, Fin.isValue, Fin.mk_one]
     fun_prop)

/-- A closed subgroup containing `diagSU β` with `β / 2π` irrational contains the whole
diagonal circle. -/
theorem diagSU_mem_of_irrational {K : Subgroup SU2} (hK : IsClosed (K : Set SU2)) {β : ℝ}
    (hβ : Irrational (β / (2 * Real.pi))) (h : diagSU β ∈ K) (φ : ℝ) : diagSU φ ∈ K := by
  let P : AddSubgroup ℝ :=
    { carrier := {x | diagSU x ∈ K}
      add_mem' := fun {a b} ha hb => by
        simpa only [Set.mem_ofPred_eq, diagSU_add] using K.mul_mem ha hb
      zero_mem' := by simp [diagSU_zero, K.one_mem]
      neg_mem' := fun {a} ha => by
        simpa only [Set.mem_ofPred_eq, diagSU_neg] using K.inv_mem ha }
  have hle : AddSubgroup.closure {β, 2 * Real.pi} ≤ P := by
    rw [AddSubgroup.closure_le]
    intro x hx
    rcases hx with rfl | rfl
    · exact h
    · change diagSU (2 * Real.pi) ∈ K
      rw [diagSU_two_pi]
      exact K.one_mem
  have hd : Dense (P : Set ℝ) := (dense_addSubgroupClosure_pair_iff.2 hβ).mono hle
  have hc : IsClosed (P : Set ℝ) := hK.preimage continuous_diagSU
  have hu : (P : Set ℝ) = Set.univ := by rw [← hc.closure_eq]; exact hd.closure_eq
  have hφ : φ ∈ (P : Set ℝ) := hu ▸ Set.mem_univ φ
  exact hφ

/-! ### The top-left modulus and its orbit -/

/-- The squared modulus `|x₀₀|²` of the top-left entry of `x ∈ SU(2)`. -/
noncomputable def topSq (x : SU2) : ℝ := normSq ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 0)

/-- `topSq` is nonnegative. -/
theorem topSq_nonneg (x : SU2) : 0 ≤ topSq x := normSq_nonneg _

/-- `topSq` is at most one. -/
theorem topSq_le_one (x : SU2) : topSq x ≤ 1 := by
  have := normSq_row x
  have := normSq_nonneg ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 1)
  unfold topSq
  linarith

/-- Conjugating the diagonal circle: `|(x D_φ x⁻¹)₀₀|² = cos² φ + (1 - 2|x₀₀|²)² sin² φ`. -/
theorem topSq_conj_diagSU (x : SU2) (φ : ℝ) :
    topSq (x * diagSU φ * x⁻¹) =
      Real.cos φ ^ 2 + (1 - 2 * topSq x) ^ 2 * Real.sin φ ^ 2 := by
  have hrow := normSq_row x
  have h1 := Complex.mul_conj ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 0)
  have h2 := Complex.mul_conj ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 1)
  have hc1 := exp_ofReal_mul_I φ
  have hc2 := exp_neg_ofReal_mul_I φ
  have hentry : ((x * diagSU φ * x⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) 0 0 =
      (Real.cos φ : ℂ) + (((1 - 2 * topSq x) * Real.sin φ : ℝ) : ℂ) * I := by
    change ((x : Matrix (Fin 2) (Fin 2) ℂ) * diagMat φ * star (x : Matrix (Fin 2) (Fin 2) ℂ)) 0 0
      = _
    simp only [Matrix.mul_apply, Fin.sum_univ_two, diagMat, Matrix.star_apply, Complex.star_def]
    simp [topSq]
    have hr : (normSq ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 0) : ℂ) +
        normSq ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 1) = 1 := by exact_mod_cast hrow
    simp only [Complex.ofReal_cos, Complex.ofReal_sin] at hc1 hc2
    linear_combination cexp (-(↑φ * I)) * h1 + cexp (↑φ * I) * h2 +
      (normSq ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 0) : ℂ) * hc2 +
      (normSq ((x : Matrix (Fin 2) (Fin 2) ℂ) 0 1) : ℂ) * hc1 +
      (Complex.cos φ + Complex.sin φ * I) * hr
  rw [topSq, hentry, Complex.normSq_add_mul_I]
  ring

/-- From `x ∈ K` with `c = 1 - 2 |x₀₀|²` and `c² < 1`, a subgroup containing the diagonal
circle reaches every value of `topSq` in `[c², 1]`. -/
theorem exists_topSq_eq {K : Subgroup SU2} (hD : ∀ φ, diagSU φ ∈ K) {x : SU2} (hx : x ∈ K)
    (hlt : (1 - 2 * topSq x) ^ 2 < 1) {v : ℝ} (hv0 : (1 - 2 * topSq x) ^ 2 ≤ v) (hv1 : v ≤ 1) :
    ∃ y ∈ K, topSq y = v := by
  set c := (1 - 2 * topSq x) ^ 2 with hc
  have hpos : 0 < 1 - c := by linarith
  set w := (1 - v) / (1 - c) with hw
  have hw0 : 0 ≤ w := div_nonneg (by linarith) hpos.le
  have hw1 : w ≤ 1 := (div_le_one hpos).2 (by linarith)
  refine ⟨x * diagSU (Real.arcsin (Real.sqrt w)) * x⁻¹,
    K.mul_mem (K.mul_mem hx (hD _)) (K.inv_mem hx), ?_⟩
  have hs : Real.sin (Real.arcsin (Real.sqrt w)) = Real.sqrt w :=
    Real.sin_arcsin (by linarith [Real.sqrt_nonneg w]) (Real.sqrt_le_one.mpr hw1)
  rw [topSq_conj_diagSU, Real.cos_sq', hs, Real.sq_sqrt hw0, ← hc, hw]
  field_simp
  ring

/-- From an element off the normaliser of the circle, the circle-containing subgroup reaches
`topSq = 1 / 2`. -/
theorem exists_topSq_half {K : Subgroup SU2} (hD : ∀ φ, diagSU φ ∈ K) {x : SU2} (hx : x ∈ K)
    (h0 : 0 < topSq x) (h1 : topSq x < 1) : ∃ y ∈ K, topSq y = 1 / 2 := by
  have key : ∀ n : ℕ, ∀ x ∈ K, 0 < topSq x * (1 - topSq x) →
      1 / 8 ≤ 2 ^ n * (topSq x * (1 - topSq x)) → ∃ y ∈ K, topSq y = 1 / 2 := by
    intro n
    induction n with
    | zero =>
      intro x hx hq hn
      simp only [pow_zero, one_mul] at hn
      exact exists_topSq_eq hD hx (by nlinarith) (by nlinarith) (by norm_num)
    | succ n ih =>
      intro x hx hq hn
      by_cases hb : 1 / 8 ≤ topSq x * (1 - topSq x)
      · exact exists_topSq_eq hD hx (by nlinarith) (by nlinarith) (by norm_num)
      · push Not at hb
        obtain ⟨y, hy, hyv⟩ :=
          exists_topSq_eq hD hx (v := (1 - 2 * topSq x) ^ 2) (by nlinarith) le_rfl (by nlinarith)
        have hq' : 2 * (topSq x * (1 - topSq x)) ≤ topSq y * (1 - topSq y) := by
          rw [hyv]
          nlinarith
        refine ih y hy ?_ ?_
        · rw [hyv]
          nlinarith
        · rw [pow_succ] at hn
          nlinarith [pow_pos (two_pos : (0 : ℝ) < 2) n]
  have hq : 0 < topSq x * (1 - topSq x) := mul_pos h0 (by linarith)
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (1 / (8 * (topSq x * (1 - topSq x))))
    (by norm_num : (1 : ℝ) < 2)
  refine key n x hx hq ?_
  rw [div_lt_iff₀ (by positivity)] at hn
  nlinarith

private lemma diagMat_mul_mul_apply_00 (φ ψ : ℝ) (M : Matrix (Fin 2) (Fin 2) ℂ) :
    (diagMat φ * M * diagMat ψ) 0 0 = exp (-(φ * I)) * M 0 0 * exp (-(ψ * I)) := by
  simp [diagMat, Matrix.mul_apply, Fin.sum_univ_two, Matrix.vecMul, dotProduct]

private lemma diagMat_mul_mul_apply_01 (φ ψ : ℝ) (M : Matrix (Fin 2) (Fin 2) ℂ) :
    (diagMat φ * M * diagMat ψ) 0 1 = exp (-(φ * I)) * M 0 1 * exp (ψ * I) := by
  simp [diagMat, Matrix.mul_apply, Fin.sum_univ_two, Matrix.vecMul, dotProduct]

/-- **Euler decomposition.** If `|z₀₀| = |V₀₀|` then `V = diagSU φ · z · diagSU ψ`. -/
theorem exists_diag_mul_diag {V z : SU2} (h : topSq z = topSq V) :
    ∃ φ ψ : ℝ, V = diagSU φ * z * diagSU ψ := by
  have phase : ∀ a b : ℂ, ‖a‖ = ‖b‖ → exp (((arg a - arg b : ℝ) : ℂ) * I) * b = a := by
    intro a b hab
    calc exp (((arg a - arg b : ℝ) : ℂ) * I) * b
        = exp (((arg a - arg b : ℝ) : ℂ) * I) * (‖b‖ * exp (arg b * I)) := by
          rw [Complex.norm_mul_exp_arg_mul_I]
      _ = ‖a‖ * exp (arg a * I) := by
          rw [hab, mul_left_comm, ← Complex.exp_add]
          congr 2
          push_cast
          ring
      _ = a := Complex.norm_mul_exp_arg_mul_I a
  have hn0 : ‖(V : Matrix (Fin 2) (Fin 2) ℂ) 0 0‖ = ‖(z : Matrix (Fin 2) (Fin 2) ℂ) 0 0‖ := by
    unfold topSq at h
    rw [Complex.normSq_eq_norm_sq, Complex.normSq_eq_norm_sq] at h
    exact ((sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h).symm
  have hn1 : ‖(V : Matrix (Fin 2) (Fin 2) ℂ) 0 1‖ = ‖(z : Matrix (Fin 2) (Fin 2) ℂ) 0 1‖ := by
    have hV := normSq_row V
    have hz := normSq_row z
    unfold topSq at h
    have h' : normSq ((V : Matrix (Fin 2) (Fin 2) ℂ) 0 1) =
        normSq ((z : Matrix (Fin 2) (Fin 2) ℂ) 0 1) := by linarith
    rw [Complex.normSq_eq_norm_sq, Complex.normSq_eq_norm_sq] at h'
    exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).mp h'
  set A := arg ((V : Matrix (Fin 2) (Fin 2) ℂ) 0 0) - arg ((z : Matrix (Fin 2) (Fin 2) ℂ) 0 0)
    with hA
  set B := arg ((V : Matrix (Fin 2) (Fin 2) ℂ) 0 1) - arg ((z : Matrix (Fin 2) (Fin 2) ℂ) 0 1)
    with hB
  have e0 := phase _ _ hn0
  have e1 := phase _ _ hn1
  rw [← hA] at e0
  rw [← hB] at e1
  refine ⟨-(A + B) / 2, (B - A) / 2, ext_of_row ?_ ?_⟩
  · change _ = (diagMat _ * (z : Matrix (Fin 2) (Fin 2) ℂ) * diagMat _) 0 0
    rw [diagMat_mul_mul_apply_00, ← e0]
    have k : cexp (-(((-(A + B) / 2 : ℝ) : ℂ) * I)) * cexp (-((((B - A) / 2 : ℝ) : ℂ) * I)) =
        cexp (↑A * I) := by
      rw [← Complex.exp_add]
      push_cast
      ring_nf
    linear_combination (-((z : Matrix (Fin 2) (Fin 2) ℂ) 0 0)) * k
  · change _ = (diagMat _ * (z : Matrix (Fin 2) (Fin 2) ℂ) * diagMat _) 0 1
    rw [diagMat_mul_mul_apply_01, ← e1]
    have k : cexp (-(((-(A + B) / 2 : ℝ) : ℂ) * I)) * cexp ((((B - A) / 2 : ℝ) : ℂ) * I) =
        cexp (↑B * I) := by
      rw [← Complex.exp_add]
      push_cast
      ring_nf
    linear_combination (-((z : Matrix (Fin 2) (Fin 2) ℂ) 0 1)) * k

/-- A subgroup containing the diagonal circle and an element `x` with `0 < |x₀₀| < 1` is all
of `SU(2)`. -/
theorem eq_top_of_diagSU_mem {K : Subgroup SU2} (hD : ∀ φ, diagSU φ ∈ K) {x : SU2}
    (hx : x ∈ K) (h0 : 0 < topSq x) (h1 : topSq x < 1) : K = ⊤ := by
  obtain ⟨y, hy, hy2⟩ := exists_topSq_half hD hx h0 h1
  rw [eq_top_iff]
  intro V _
  obtain ⟨z, hz, hzV⟩ := exists_topSq_eq hD hy (v := topSq V) (by rw [hy2]; norm_num)
    (by rw [hy2]; norm_num; exact topSq_nonneg V) (topSq_le_one V)
  obtain ⟨φ, ψ, rfl⟩ := exists_diag_mul_diag hzV
  exact K.mul_mem (K.mul_mem (hD φ) hz) (hD ψ)

/-- An element with `|x₀₀| ∈ {0, 1}` normalises the diagonal circle. -/
theorem conj_diagSU_of_topSq {x : SU2} (hx : topSq x = 0 ∨ topSq x = 1) (β : ℝ) :
    x * diagSU β * x⁻¹ = diagSU β ∨ x * diagSU β * x⁻¹ = diagSU (-β) := by
  have hrow := normSq_row x
  rcases hx with h | h
  · right
    have h00 : (x : Matrix (Fin 2) (Fin 2) ℂ) 0 0 = 0 := Complex.normSq_eq_zero.mp h
    have hc : x * diagSU β = diagSU (-β) * x := by
      apply ext_of_row
      · change ((x : Matrix (Fin 2) (Fin 2) ℂ) * diagMat β) 0 0 =
          (diagMat (-β) * (x : Matrix (Fin 2) (Fin 2) ℂ)) 0 0
        simp [Matrix.mul_apply, Fin.sum_univ_two, diagMat, h00]
      · change ((x : Matrix (Fin 2) (Fin 2) ℂ) * diagMat β) 0 1 =
          (diagMat (-β) * (x : Matrix (Fin 2) (Fin 2) ℂ)) 0 1
        simp [Matrix.mul_apply, Fin.sum_univ_two, diagMat]
        ring
    rw [hc, mul_inv_cancel_right]
  · left
    have h01 : (x : Matrix (Fin 2) (Fin 2) ℂ) 0 1 = 0 :=
      Complex.normSq_eq_zero.mp (by unfold topSq at h; linarith)
    have hc : x * diagSU β = diagSU β * x := by
      apply ext_of_row
      · change ((x : Matrix (Fin 2) (Fin 2) ℂ) * diagMat β) 0 0 =
          (diagMat β * (x : Matrix (Fin 2) (Fin 2) ℂ)) 0 0
        simp [Matrix.mul_apply, Fin.sum_univ_two, diagMat]
        ring
      · change ((x : Matrix (Fin 2) (Fin 2) ℂ) * diagMat β) 0 1 =
          (diagMat β * (x : Matrix (Fin 2) (Fin 2) ℂ)) 0 1
        simp [Matrix.mul_apply, Fin.sum_univ_two, diagMat, h01]
    rw [hc, mul_inv_cancel_right]

/-! ### The gates -/

/-- The Hadamard matrix `H = (1 / √2) [[1, 1], [1, -1]]`. -/
noncomputable def hadamard : Matrix (Fin 2) (Fin 2) ℂ :=
  (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) • !![1, 1; 1, -1]

/-- The `T` gate `diag (1, e^{iπ/4})`. -/
noncomputable def tGate : Matrix (Fin 2) (Fin 2) ℂ :=
  !![1, 0; 0, exp (((Real.pi / 4 : ℝ) : ℂ) * I)]

private lemma hadamard_smul_eq :
    I • hadamard = !![I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ), I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ);
      -(starRingEnd ℂ) (I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ)),
      (starRingEnd ℂ) (I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ))] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hadamard]

private lemma tGate_smul_eq :
    exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) • tGate = diagMat (Real.pi / 8) := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [tGate, diagMat, ← Complex.exp_add]
  · ring_nf

/-- The scaled Hadamard matrix `i H` lies in `SU(2)`. -/
theorem hSU_mem : I • hadamard ∈ specialUnitaryGroup (Fin 2) ℂ := by
  rw [hadamard_smul_eq]
  apply mk_mem_specialUnitaryGroup
  norm_num

/-- The Hadamard gate normalised to determinant one, `hSU = i H ∈ SU(2)`. -/
noncomputable def hSU : SU2 := ⟨I • hadamard, hSU_mem⟩

/-- The `T` gate normalised to determinant one, `tSU = e^{-iπ/8} T ∈ SU(2)`. -/
noncomputable def tSU : SU2 :=
  ⟨exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) • tGate, by rw [tGate_smul_eq]; exact diagMat_mem _⟩

/-- Unfolding lemma: the matrix of `hSU` is `i H`. -/
theorem coe_hSU : (hSU : Matrix (Fin 2) (Fin 2) ℂ) = I • hadamard := rfl

/-- Unfolding lemma: the matrix of `tSU` is `e^{-iπ/8} T`. -/
theorem coe_tSU :
    (tSU : Matrix (Fin 2) (Fin 2) ℂ) = exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) • tGate :=
  rfl

private lemma coe_hSU_eq : (hSU : Matrix (Fin 2) (Fin 2) ℂ) =
    !![I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ), I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ);
      I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ), -(I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ))] := by
  rw [coe_hSU, hadamard_smul_eq]
  simp

private lemma star_coe_hSU_eq : star (hSU : Matrix (Fin 2) (Fin 2) ℂ) =
    !![-(I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ)), -(I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ));
      -(I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ)), I * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ)] := by
  rw [coe_hSU_eq]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.star_apply]

/-- `tSU` is the point `π / 8` of the diagonal circle. -/
theorem tSU_eq_diagSU : tSU = diagSU (Real.pi / 8) := Subtype.ext tGate_smul_eq

/-- The product `uHT = tSU · (hSU tSU hSU⁻¹)`, a rotation by an irrational multiple of `π`. -/
noncomputable def uHT : SU2 := tSU * (hSU * tSU * hSU⁻¹)

/-- The half-angle `β = arccos ((2 + √2) / 4)` of `uHT`. -/
noncomputable def betaHT : ℝ := Real.arccos ((2 + Real.sqrt 2) / 4)

private lemma uHT_scalars :
    exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) * exp (((Real.pi / 8 : ℝ) : ℂ) * I) = 1 ∧
    (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) * (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) = 1 / 2 := by
  refine ⟨?_, ?_⟩
  · rw [← Complex.exp_add]
    simp
  · rw [← Complex.ofReal_mul, ← mul_inv, Real.mul_self_sqrt (by norm_num)]
    push_cast
    ring

private lemma coe_uHT : (uHT : Matrix (Fin 2) (Fin 2) ℂ) =
    !![(exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) ^ 2 + 1) / 2,
      (exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) ^ 2 - 1) / 2;
      (1 - exp (((Real.pi / 8 : ℝ) : ℂ) * I) ^ 2) / 2,
      (1 + exp (((Real.pi / 8 : ℝ) : ℂ) * I) ^ 2) / 2] := by
  obtain ⟨hp, hr⟩ := uHT_scalars
  have hH := coe_hSU_eq
  have hHi := star_coe_hSU_eq
  have hT : (tSU : Matrix (Fin 2) (Fin 2) ℂ) =
      !![exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)), 0; 0, exp (((Real.pi / 8 : ℝ) : ℂ) * I)] :=
    tGate_smul_eq
  change (tSU : Matrix (Fin 2) (Fin 2) ℂ) * ((hSU : Matrix (Fin 2) (Fin 2) ℂ) *
    (tSU : Matrix (Fin 2) (Fin 2) ℂ) * star (hSU : Matrix (Fin 2) (Fin 2) ℂ)) = _
  rw [hHi, hH, hT]
  generalize exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) = a at hp ⊢
  generalize exp (((Real.pi / 8 : ℝ) : ℂ) * I) = b at hp ⊢
  generalize (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) = r at hr ⊢
  simp only [Matrix.mul_fin_two]
  ext i j
  fin_cases i <;> fin_cases j <;> simp <;> grind [Complex.I_sq]

private lemma uHT_sq_scalars :
    exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) ^ 2 =
      ((Real.sqrt 2 / 2 : ℝ) : ℂ) - ((Real.sqrt 2 / 2 : ℝ) : ℂ) * I ∧
    exp (((Real.pi / 8 : ℝ) : ℂ) * I) ^ 2 =
      ((Real.sqrt 2 / 2 : ℝ) : ℂ) + ((Real.sqrt 2 / 2 : ℝ) : ℂ) * I := by
  have e : ∀ z : ℂ, exp z ^ 2 = exp (2 * z) := fun z => by rw [sq, ← Complex.exp_add, two_mul]
  refine ⟨?_, ?_⟩
  · rw [e, show 2 * -(((Real.pi / 8 : ℝ) : ℂ) * I) = -(((Real.pi / 4 : ℝ) : ℂ) * I) by
      push_cast; ring, exp_neg_ofReal_mul_I, Real.cos_pi_div_four, Real.sin_pi_div_four]
  · rw [e, show 2 * (((Real.pi / 8 : ℝ) : ℂ) * I) = ((Real.pi / 4 : ℝ) : ℂ) * I by
      push_cast; ring, exp_ofReal_mul_I, Real.cos_pi_div_four, Real.sin_pi_div_four]

private lemma sqrt_two_ne_two : Real.sqrt 2 ≠ 2 := by
  intro h
  have := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  rw [h] at this
  norm_num at this

/-- `uHT` and `diagSU betaHT` have the same trace `1 + √2 / 2`. -/
theorem trace_uHT_eq :
    trace (uHT : Matrix (Fin 2) (Fin 2) ℂ) = trace (diagSU betaHT : Matrix (Fin 2) (Fin 2) ℂ) := by
  obtain ⟨h1, h2⟩ := uHT_sq_scalars
  have hs0 := Real.sqrt_nonneg 2
  have hs2 := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  have hcos : Real.cos betaHT = (2 + Real.sqrt 2) / 4 :=
    Real.cos_arccos (by linarith) (by nlinarith)
  rw [coe_uHT, coe_diagSU, Matrix.trace_fin_two, Matrix.trace_fin_two]
  simp only [diagMat, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.cons_val_fin_one]
  rw [h1, h2, exp_neg_ofReal_mul_I betaHT, exp_ofReal_mul_I betaHT, hcos]
  push_cast
  ring

/-- `hSU` conjugates `uHT` neither to itself nor to its inverse. -/
theorem hSU_conj_uHT_ne :
    hSU * uHT * hSU⁻¹ ≠ uHT ∧ hSU * uHT * hSU⁻¹ ≠ uHT⁻¹ := by
  obtain ⟨hp, hr⟩ := uHT_scalars
  obtain ⟨h1, h2⟩ := uHT_sq_scalars
  have hrow : ((hSU * uHT * hSU⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) 0 0 =
        (exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) ^ 2 + 1) / 2 ∧
      ((hSU * uHT * hSU⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) 0 1 =
        (1 - exp (((Real.pi / 8 : ℝ) : ℂ) * I) ^ 2) / 2 := by
    change ((hSU : Matrix (Fin 2) (Fin 2) ℂ) * (uHT : Matrix (Fin 2) (Fin 2) ℂ) *
      star (hSU : Matrix (Fin 2) (Fin 2) ℂ)) 0 0 = _ ∧
      ((hSU : Matrix (Fin 2) (Fin 2) ℂ) * (uHT : Matrix (Fin 2) (Fin 2) ℂ) *
      star (hSU : Matrix (Fin 2) (Fin 2) ℂ)) 0 1 = _
    rw [star_coe_hSU_eq, coe_hSU_eq, coe_uHT]
    generalize exp (-(((Real.pi / 8 : ℝ) : ℂ) * I)) = a at hp ⊢
    generalize exp (((Real.pi / 8 : ℝ) : ℂ) * I) = b at hp ⊢
    generalize (((Real.sqrt 2)⁻¹ : ℝ) : ℂ) = r at hr ⊢
    simp only [Matrix.mul_fin_two, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one]
    constructor <;> grind [Complex.I_sq]
  have hs : (Real.sqrt 2 : ℂ) ≠ 2 := by exact_mod_cast sqrt_two_ne_two
  have hs0 : (Real.sqrt 2 : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_pos.mpr (show (0 : ℝ) < 2 by norm_num)).ne'
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have e := congrArg (fun g : SU2 => (g : Matrix (Fin 2) (Fin 2) ℂ) 0 1) h
    simp only [hrow.2, coe_uHT, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one] at e
    apply hs
    rw [h1, h2] at e
    push_cast at e
    linear_combination -2 * e
  · have e := congrArg (fun g : SU2 => (g : Matrix (Fin 2) (Fin 2) ℂ) 0 0) h
    have hinv : ((uHT⁻¹ : SU2) : Matrix (Fin 2) (Fin 2) ℂ) 0 0 =
        (uHT : Matrix (Fin 2) (Fin 2) ℂ) 1 1 := by
      rw [(su2_entries uHT).1]
      rfl
    simp only [hrow.1, hinv, coe_uHT, Matrix.of_apply, Matrix.cons_val',
      Matrix.cons_val_one, Matrix.cons_val_fin_one] at e
    apply hs0
    rw [h1, h2] at e
    push_cast at e
    linear_combination (2 * I) * e + (Real.sqrt 2 : ℂ) * Complex.I_sq

/-- **Niven step.** `β / 2π` is irrational for the half-angle `β` of `uHT`. -/
theorem irrational_betaHT : Irrational (betaHT / (2 * Real.pi)) := by
  rintro ⟨q, hq⟩
  have hs0 := Real.sqrt_nonneg 2
  have hs2 := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  have hcos : Real.cos betaHT = (2 + Real.sqrt 2) / 4 :=
    Real.cos_arccos (by linarith) (by nlinarith)
  have hpi := Real.pi_pos
  have hβ : betaHT = ((2 * q : ℚ) : ℝ) * Real.pi := by
    rw [show betaHT = betaHT / (2 * Real.pi) * (2 * Real.pi) by field_simp, ← hq]
    push_cast
    ring
  have hI := Real.isIntegral_two_mul_cos_rat_mul_pi (2 * q)
  rw [← hβ, hcos] at hI
  have hI2 : IsIntegral ℤ ((2 * ((2 + Real.sqrt 2) / 4) - 1) ^ 2) :=
    (hI.sub isIntegral_one).pow 2
  have e : (2 * ((2 + Real.sqrt 2) / 4) - 1) ^ 2 = algebraMap ℚ ℝ (1 / 2) := by
    rw [show (2 * ((2 + Real.sqrt 2) / 4) - 1) ^ 2 = Real.sqrt 2 ^ 2 / 4 by ring, hs2]
    norm_num
  rw [e, isIntegral_algebraMap_iff] at hI2
  obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hI2
  have hy' : ((2 * y : ℤ) : ℚ) = 1 := by
    push_cast
    rw [show (y : ℚ) = algebraMap ℤ ℚ y from rfl, hy]
    norm_num
  have : 2 * y = 1 := by exact_mod_cast hy'
  omega

/-! ### Density and covers -/

/-- **Density of Clifford+T.** The closure of the group generated by `hSU` and `tSU` is all
of `SU(2)`. -/
theorem closure_closure_HT :
    (Subgroup.closure ({hSU, tSU} : Set SU2)).topologicalClosure = ⊤ := by
  set K := (Subgroup.closure ({hSU, tSU} : Set SU2)).topologicalClosure with hKdef
  have hK : IsClosed (K : Set SU2) := Subgroup.isClosed_topologicalClosure _
  have hH : hSU ∈ K := Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (by simp))
  have hT : tSU ∈ K := Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (by simp))
  have hU : uHT ∈ K := K.mul_mem hT (K.mul_mem (K.mul_mem hH hT) (K.inv_mem hH))
  obtain ⟨S, hS⟩ := exists_conj_of_trace_eq trace_uHT_eq
  rw [star_eq_inv] at hS
  let K' : Subgroup SU2 := K.comap (MulAut.conj S⁻¹).toMonoidHom
  have mem_K' : ∀ y, y ∈ K' ↔ S⁻¹ * y * S ∈ K := by
    intro y
    simp [K']
  have hK' : IsClosed (K' : Set SU2) := by
    have e : (K' : Set SU2) = (fun y => S⁻¹ * y * S) ⁻¹' (K : Set SU2) := by
      ext y
      exact mem_K' y
    rw [e]
    exact hK.preimage (by fun_prop)
  have hβ' : diagSU betaHT ∈ K' := by
    rw [mem_K', hS]
    simpa [mul_assoc] using hU
  have hD := diagSU_mem_of_irrational hK' irrational_betaHT hβ'
  have hx : S * hSU * S⁻¹ ∈ K' := by
    rw [mem_K']
    simpa [mul_assoc] using hH
  have hx01 : 0 < topSq (S * hSU * S⁻¹) ∧ topSq (S * hSU * S⁻¹) < 1 := by
    by_contra hcon
    have hcase : topSq (S * hSU * S⁻¹) = 0 ∨ topSq (S * hSU * S⁻¹) = 1 := by
      by_cases h0 : topSq (S * hSU * S⁻¹) = 0
      · exact Or.inl h0
      · right
        by_contra h1
        exact hcon ⟨lt_of_le_of_ne (topSq_nonneg _) (Ne.symm h0),
          lt_of_le_of_ne (topSq_le_one _) h1⟩
    have e1 : S * hSU * S⁻¹ * (S * uHT * S⁻¹) * (S * hSU * S⁻¹)⁻¹ =
        S * (hSU * uHT * hSU⁻¹) * S⁻¹ := by group
    rcases conj_diagSU_of_topSq hcase betaHT with hc | hc
    · rw [hS, e1] at hc
      exact hSU_conj_uHT_ne.1 (mul_left_cancel (mul_right_cancel hc))
    · rw [diagSU_neg, hS, e1] at hc
      have e2 : (S * uHT * S⁻¹)⁻¹ = S * uHT⁻¹ * S⁻¹ := by group
      rw [e2] at hc
      exact hSU_conj_uHT_ne.2 (mul_left_cancel (mul_right_cancel hc))
  have htop : K' = ⊤ := eq_top_of_diagSU_mem hD hx hx01.1 hx01.2
  rw [eq_top_iff]
  intro V _
  have hV : S * V * S⁻¹ ∈ K' := htop ▸ Subgroup.mem_top _
  rw [mem_K'] at hV
  simpa [mul_assoc] using hV

/-- The letters `hSU, tSU, hSU⁻¹, tSU⁻¹` of the Clifford+T alphabet. -/
noncomputable def htLetter : Fin 4 → SU2 := ![hSU, tSU, hSU⁻¹, tSU⁻¹]

/-- The inverse letter: `0 ↔ 2`, `1 ↔ 3`. -/
def htInvLetter : Fin 4 → Fin 4 := ![2, 3, 0, 1]

/-- The evaluation of a word over the Clifford+T alphabet; it is `wordEval htLetter` in the
convention of the Solovay–Kitaev recursion. -/
noncomputable def htWord (w : List (Fin 4)) : SU2 := (w.map htLetter).prod

/-- `htInvLetter` names the inverse letter. -/
theorem htLetter_inv (i : Fin 4) : htLetter (htInvLetter i) = (htLetter i)⁻¹ := by
  fin_cases i <;> simp [htLetter, htInvLetter]

/-- The reversed word of inverse letters evaluates to the inverse. -/
theorem htWord_inv (w : List (Fin 4)) : htWord (w.reverse.map htInvLetter) = (htWord w)⁻¹ := by
  induction w with
  | nil => simp [htWord]
  | cons a w ih =>
    simp only [htWord, List.reverse_cons, List.map_append, List.prod_append, List.map_cons,
      List.map_nil, List.prod_cons, List.prod_nil, mul_one] at ih ⊢
    rw [ih, htLetter_inv, _root_.mul_inv_rev]

/-- Every element of the group generated by `hSU` and `tSU` is the evaluation of a word. -/
theorem closure_subset_range_htWord :
    (Subgroup.closure ({hSU, tSU} : Set SU2) : Set SU2) ⊆ Set.range htWord := by
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    rcases hy with rfl | rfl
    · exact ⟨[0], by simp [htWord, htLetter]⟩
    · exact ⟨[1], by simp [htWord, htLetter]⟩
  | one => exact ⟨[], by simp [htWord]⟩
  | mul y z _ _ hy hz =>
    obtain ⟨w, rfl⟩ := hy
    obtain ⟨v, rfl⟩ := hz
    exact ⟨w ++ v, by simp [htWord]⟩
  | inv y _ hy =>
    obtain ⟨w, rfl⟩ := hy
    exact ⟨w.reverse.map htInvLetter, htWord_inv w⟩

/-- The word evaluations over the Clifford+T alphabet are dense in `SU(2)`. -/
theorem denseRange_htWord : DenseRange htWord := by
  have h := congrArg (fun H : Subgroup SU2 => (H : Set SU2)) closure_closure_HT
  simp only [Subgroup.topologicalClosure_coe, Subgroup.coe_top] at h
  exact dense_iff_closure_eq.2
    (Set.eq_univ_of_univ_subset (h ▸ closure_mono closure_subset_range_htWord))

/-- **Clifford+T covers.** For every `ε₀ > 0` there is `L₀` such that the words of length at most
`L₀` over `{hSU, tSU, hSU⁻¹, tSU⁻¹}` form an `ε₀`-cover of `SU(2)`. -/
theorem exists_isCover_HT (ε₀ : NNReal) (hε : 0 < ε₀) :
    ∃ L₀ : ℕ, Metric.IsCover ε₀ Set.univ
      {U : SU2 | ∃ w : List (Fin 4), w.length ≤ L₀ ∧ htWord w = U} := by
  have hcov : (Set.univ : Set SU2) ⊆ ⋃ w : List (Fin 4), Metric.ball (htWord w) ε₀ := by
    intro x _
    obtain ⟨w, hw⟩ := denseRange_htWord.exists_dist_lt x (by exact_mod_cast hε)
    exact Set.mem_iUnion.2 ⟨w, by rw [Metric.mem_ball]; exact hw⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover _ (fun _ => Metric.isOpen_ball) hcov
  refine ⟨t.sup List.length, ?_⟩
  rw [Metric.isCover_iff_subset_iUnion_closedBall]
  intro x _
  obtain ⟨w, hw, hx⟩ : ∃ w ∈ t, x ∈ Metric.ball (htWord w) ε₀ := by
    simpa using ht (Set.mem_univ x)
  exact Set.mem_biUnion ⟨w, Finset.le_sup hw, rfl⟩ (Metric.ball_subset_closedBall hx)

end SolovayKitaev
