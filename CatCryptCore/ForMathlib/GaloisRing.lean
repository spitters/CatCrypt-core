module

public import Mathlib.FieldTheory.Finite.GaloisField
public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.RingTheory.AdjoinRoot

/-!
# The Galois ring `GR(2^k, d)`

For `k d ≥ 1`, the Galois ring `GR(2^k, d)` is the quotient `(ℤ / 2^k)[X] / (f)` by a monic
polynomial `f` of degree `d` whose reduction modulo `2` is irreducible. It is a local ring of
characteristic `2^k` with `2^(k d)` elements, maximal ideal `(2)` and residue field
`GF(2^d)` (Wan, *Lectures on Finite Fields and Galois Rings*, ch. 14; McDonald,
*Finite Rings with Identity*, ch. XVI).

The modulus is a monic lift of the minimal polynomial over `ZMod 2` of a primitive element
`GaloisRing.gen d` of `GaloisField 2 d`, so the residue map sends the adjoined root to
`GaloisRing.gen d`.

## Main definitions

* `GaloisRing k d`: the ring `AdjoinRoot (GaloisRing.modulus k d)` over `ZMod (2 ^ k)`.
* `GaloisRing.residue`: the residue map `GaloisRing k d →+* GaloisField 2 d`.

## Main results

* `GaloisRing.card_eq`: `Fintype.card (GaloisRing k d) = 2 ^ (k * d)`.
* `GaloisRing.card_galoisField`: `Fintype.card (GaloisField 2 d) = 2 ^ d`.
* `GaloisRing.residue_surjective`: the residue map is surjective.
* `GaloisRing.ker_residue`: its kernel is the ideal generated by `2`.
* `GaloisRing.two_pow_eq_zero`: `(2 : GaloisRing k d) ^ k = 0`.
* `GaloisRing.algebraMap_injective`: `ZMod (2 ^ k)` embeds into `GaloisRing k d`.
-/

@[expose] public section

set_option autoImplicit false

open Polynomial

noncomputable section

/-- The finite field `GaloisField 2 d` as a `Fintype`, through its `Finite` instance. -/
instance GaloisField.instFintypeTwo (d : ℕ) : Fintype (GaloisField 2 d) := Fintype.ofFinite _

/-- Decidable equality on `GaloisField 2 d`, classically. -/
instance GaloisField.instDecidableEqTwo (d : ℕ) : DecidableEq (GaloisField 2 d) :=
  Classical.decEq _

namespace GaloisRing

variable (k d : ℕ) [NeZero k]

instance fact_one_lt_two_pow : Fact (1 < 2 ^ k) := ⟨Nat.one_lt_two_pow (NeZero.ne k)⟩

theorem two_dvd_two_pow : 2 ∣ 2 ^ k := dvd_pow_self 2 (NeZero.ne k)

/-- Reduction modulo `2`, `ZMod (2 ^ k) →+* ZMod 2`. -/
abbrev reduce : ZMod (2 ^ k) →+* ZMod 2 := ZMod.castHom (two_dvd_two_pow k) (ZMod 2)

theorem reduce_surjective : Function.Surjective (reduce k) := ZMod.ringHom_surjective _

theorem mem_span_two_of_reduce_eq_zero {x : ZMod (2 ^ k)} (hx : reduce k x = 0) :
    x ∈ Ideal.span {(2 : ZMod (2 ^ k))} := by
  rw [ZMod.castHom_apply, ZMod.cast_eq_val, ZMod.natCast_eq_zero_iff] at hx
  obtain ⟨m, hm⟩ := hx
  rw [Ideal.mem_span_singleton']
  exact ⟨m, by rw [← ZMod.natCast_zmod_val x, hm, Nat.cast_mul, Nat.cast_ofNat, mul_comm]⟩

/-- A primitive element of `GaloisField 2 d` over `ZMod 2`. -/
def gen : GaloisField 2 d :=
  (Field.exists_primitive_element (ZMod 2) (GaloisField 2 d)).choose

theorem adjoin_gen : IntermediateField.adjoin (ZMod 2) {gen d} = ⊤ :=
  (Field.exists_primitive_element (ZMod 2) (GaloisField 2 d)).choose_spec

theorem isIntegral_gen : IsIntegral (ZMod 2) (gen d) := .of_finite _ _

theorem natDegree_minpoly_gen [NeZero d] : (minpoly (ZMod 2) (gen d)).natDegree = d := by
  rw [← IntermediateField.adjoin.finrank (isIntegral_gen d), adjoin_gen,
    IntermediateField.finrank_top', GaloisField.finrank 2 (NeZero.ne d)]

theorem exists_lift_minpoly_gen :
    ∃ q : (ZMod (2 ^ k))[X], q.map (reduce k) = minpoly (ZMod 2) (gen d) ∧
      q.degree = (minpoly (ZMod 2) (gen d)).degree ∧ q.Monic :=
  lifts_and_degree_eq_and_monic
    ((lifts_iff_coeff_lifts _).2 fun _ => reduce_surjective k _)
    (minpoly.monic (isIntegral_gen d))

/-- The modulus of `GaloisRing k d`: a monic lift to `ZMod (2 ^ k)` of the minimal polynomial
of `gen d` over `ZMod 2`. -/
def modulus : (ZMod (2 ^ k))[X] := (exists_lift_minpoly_gen k d).choose

theorem map_modulus : (modulus k d).map (reduce k) = minpoly (ZMod 2) (gen d) :=
  (exists_lift_minpoly_gen k d).choose_spec.1

theorem monic_modulus : (modulus k d).Monic :=
  (exists_lift_minpoly_gen k d).choose_spec.2.2

theorem degree_modulus : (modulus k d).degree = (minpoly (ZMod 2) (gen d)).degree :=
  (exists_lift_minpoly_gen k d).choose_spec.2.1

theorem natDegree_modulus [NeZero d] : (modulus k d).natDegree = d := by
  rw [natDegree_eq_of_degree_eq (degree_modulus k d), natDegree_minpoly_gen]

end GaloisRing

/-- The Galois ring `GR(2^k, d) = (ZMod (2 ^ k))[X] / (GaloisRing.modulus k d)`, with the
`CommRing` and `ZMod (2 ^ k)`-algebra structures of `AdjoinRoot`. -/
abbrev GaloisRing (k d : ℕ) [NeZero k] [NeZero d] : Type :=
  AdjoinRoot (GaloisRing.modulus k d)

namespace GaloisRing

variable (k d : ℕ) [NeZero k] [NeZero d]

/-- The power basis `1, root, …, root ^ (d - 1)` of `GaloisRing k d` over `ZMod (2 ^ k)`. -/
def powerBasis : PowerBasis (ZMod (2 ^ k)) (GaloisRing k d) :=
  AdjoinRoot.powerBasis' (monic_modulus k d)

theorem powerBasis_dim : (powerBasis k d).dim = d := natDegree_modulus k d

instance : Module.Finite (ZMod (2 ^ k)) (GaloisRing k d) := (powerBasis k d).finite

instance : Finite (GaloisRing k d) := Module.finite_of_finite (ZMod (2 ^ k))

instance : Fintype (GaloisRing k d) := Fintype.ofFinite _

instance : DecidableEq (GaloisRing k d) := Classical.decEq _

theorem card_eq : Fintype.card (GaloisRing k d) = 2 ^ (k * d) := by
  rw [Module.card_fintype (powerBasis k d).basis, ZMod.card, Fintype.card_fin, powerBasis_dim,
    pow_mul]

theorem card_galoisField : Fintype.card (GaloisField 2 d) = 2 ^ d := by
  rw [Fintype.card_eq_nat_card, GaloisField.card 2 d (NeZero.ne d)]

/-- The residue map `GaloisRing k d →+* GaloisField 2 d`, reducing coefficients modulo `2` and
sending the adjoined root to `gen d`. -/
def residue : GaloisRing k d →+* GaloisField 2 d :=
  AdjoinRoot.lift ((algebraMap (ZMod 2) (GaloisField 2 d)).comp (reduce k)) (gen d) (by
    rw [← eval₂_map, map_modulus, ← aeval_def, minpoly.aeval])

theorem residue_mk (p : (ZMod (2 ^ k))[X]) :
    residue k d (AdjoinRoot.mk (modulus k d) p) = aeval (gen d) (p.map (reduce k)) := by
  rw [residue, AdjoinRoot.lift_mk, aeval_def, eval₂_map]

theorem residue_surjective : Function.Surjective (residue k d) := by
  intro y
  have hy : y ∈ Algebra.adjoin (ZMod 2) {gen d} := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (isIntegral_gen d).isAlgebraic, adjoin_gen]
    trivial
  rw [Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨q, rfl⟩ := hy
  obtain ⟨p, rfl⟩ := map_surjective _ (reduce_surjective k) q
  exact ⟨AdjoinRoot.mk (modulus k d) p, residue_mk k d p⟩

theorem two_pow_eq_zero : (2 : GaloisRing k d) ^ k = 0 := by
  have h : (2 : ZMod (2 ^ k)) ^ k = 0 := by
    exact_mod_cast ZMod.natCast_self (2 ^ k)
  rw [← map_ofNat (algebraMap (ZMod (2 ^ k)) (GaloisRing k d)) 2, ← map_pow, h, map_zero]

theorem ker_residue : RingHom.ker (residue k d) = Ideal.span {(2 : GaloisRing k d)} := by
  apply le_antisymm
  · intro y hy
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective y
    have hr : AdjoinRoot.mk (modulus k d) (p %ₘ modulus k d) = AdjoinRoot.mk (modulus k d) p := by
      rw [← AdjoinRoot.modByMonicHom_mk (monic_modulus k d)]
      exact AdjoinRoot.mk_leftInverse (monic_modulus k d) _
    rw [← hr] at hy ⊢
    set r := p %ₘ modulus k d
    rw [RingHom.mem_ker, residue_mk] at hy
    have hmap : r.map (reduce k) = 0 := by
      refine eq_zero_of_dvd_of_degree_lt (minpoly.dvd _ _ hy) ?_
      calc (r.map (reduce k)).degree ≤ r.degree := degree_map_le
        _ < (modulus k d).degree := degree_modByMonic_lt _ (monic_modulus k d)
        _ = (minpoly (ZMod 2) (gen d)).degree := degree_modulus k d
    have hC : r ∈ Ideal.map C (Ideal.span {(2 : ZMod (2 ^ k))}) := by
      rw [Ideal.mem_map_C_iff]
      intro n
      apply mem_span_two_of_reduce_eq_zero
      rw [← coeff_map, hmap, coeff_zero]
    have hmk := Ideal.mem_map_of_mem (AdjoinRoot.mk (modulus k d)) hC
    rwa [Ideal.map_map, Ideal.map_span, Set.image_singleton, RingHom.comp_apply,
      map_ofNat C 2, map_ofNat] at hmk
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_ofNat]
    exact CharTwo.two_eq_zero

theorem algebraMap_injective :
    Function.Injective (algebraMap (ZMod (2 ^ k)) (GaloisRing k d)) := by
  intro r s hrs
  have hdeg (c : ZMod (2 ^ k)) : (C c).degree < (modulus k d).degree := by
    refine degree_C_le.trans_lt ?_
    rw [degree_eq_natDegree (monic_modulus k d).ne_zero, natDegree_modulus]
    exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne d)
  have h := congrArg (AdjoinRoot.modByMonicHom (monic_modulus k d)) hrs
  simp only [AdjoinRoot.algebraMap_eq, ← AdjoinRoot.mk_C, AdjoinRoot.modByMonicHom_mk] at h
  rw [(modByMonic_eq_self_iff (monic_modulus k d)).2 (hdeg r),
    (modByMonic_eq_self_iff (monic_modulus k d)).2 (hdeg s)] at h
  exact C_injective h

end GaloisRing

end
