module

public import CatCryptCore.ForMathlib.CategoryTheory.Monoidal.Traced

/-!
# Terms of a traced monoidal signature

Terms of a traced monoidal signature are built from generators by identities, sequence, tensor
and trace; they form the free traced monoidal structure on the generators. An interpretation of
the signature (hom-types with these operations and a value for each generator) extends to every
term by the fold `Term.fold`. A structural compiler sends each generator to a term of a target
signature and extends to composites by substitution `Term.bind`.

The generator theorem `compile_correct` is compiler correctness from generators: for a relation
between a source semantics and a target semantics that is closed under identities, sequence,
tensor and trace, a compiler whose image of each generator is related to the source meaning of
that generator is correct on every composite. With the relation `F f = g` for a map `F` of
hom-types that preserves the operations, `compile_map_eq` states that the compiled term means
the image under `F` of the source term's meaning.

Over a symmetric monoidal category `C`, the wiring-diagram terms `WTerm Gen` are the terms
whose generators are those of `Gen` together with the structure maps of `C` (associators,
unitors and the symmetry, `SMGen`), with every object traceable. A denotation of the
generators in a traced symmetric monoidal category gives the meaning `WTerm.den g t`, the fold
of the interpretation `WTerm.interp g`.

The syntactic category `Syn Ax` has the objects of `C` and, as morphisms, wiring-diagram terms
modulo the congruence `WTerm.PEq Ax` generated by the axioms of a traced symmetric monoidal
category and a family `Ax` of equations between terms. It is a traced symmetric monoidal
category by construction. A denotation validating `Ax` gives the strict traced symmetric
monoidal functor `Syn.functor g hAx`; it is well defined by the soundness theorem
`WTerm.PEq.sound`. With `Ax` empty, the morphisms are the terms modulo the traced symmetric
monoidal axioms alone.

Search words: free traced monoidal category, generator theorem, compiler correctness,
structural translation, logical relation, wiring diagram, compositionality, syntactic category,
soundness.

## Main definitions

* `TracedTerm.Term tens Gen Tr X Y`: terms of the traced monoidal signature with generators
  `Gen` and trace arities `Tr`.
* `TracedTerm.Interp tens Gen Tr`: an interpretation; `Term.fold A t` the meaning of `t`.
* `TracedTerm.Term.bind σ t`: the structural translation sending generator `g` to `σ g`.
* `TracedTerm.Interp.Respects A B R`: `R` is closed under identities, sequence, tensor and trace.
* `TracedTerm.SMGen Gen`: the generators `Gen` with the symmetric monoidal structure maps.
* `TracedTerm.WTerm Gen`: wiring-diagram terms; `WTerm.den g t` their denotation.
* `TracedTerm.WTerm.PEq Ax`: the traced symmetric monoidal congruence generated by `Ax`.
* `TracedTerm.Syn Ax`: the syntactic category, with `MonoidalCategory`, `SymmetricCategory`
  and `TracedCategory` instances; `TracedTerm.Syn.functor g hAx` its denotation functor, with
  `Functor.Monoidal` and `Functor.Braided` instances.

## Main results

* `TracedTerm.Term.fold_rel`: a closed relation holding on generators holds on every term.
* `TracedTerm.Term.fold_bind`: the meaning of a translated term is the fold of the composite
  interpretation.
* `TracedTerm.compile_correct`, `TracedTerm.compile_map_eq`: compiler correctness from
  generators (the generator theorem).
* `TracedTerm.WTerm.PEq.sound`, `TracedTerm.Syn.den_eq_of_eq`: soundness of the syntactic
  category for a denotation validating the equations.
* `TracedTerm.Syn.map_tensorHom`, `TracedTerm.Syn.map_trace`: the denotation functor is strict
  monoidal and traced.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Category.TracedTerm

open CategoryTheory MonoidalCategory

universe u v v' w r r'

/-- Terms of a traced monoidal signature over objects `Ob` with monoidal product `tens`:
generators `Gen X Y`, identities, sequence, tensor, and the trace along `U` for each trace arity
`Tr X Y U`. A signature without trace takes `Tr` empty. -/
inductive Term {Ob : Type u} (tens : Ob → Ob → Ob) (Gen : Ob → Ob → Type v)
    (Tr : Ob → Ob → Ob → Type w) : Ob → Ob → Type (max u v w) where
  /-- A generator. -/
  | gen {X Y : Ob} (g : Gen X Y) : Term tens Gen Tr X Y
  /-- The identity on `X`. -/
  | id (X : Ob) : Term tens Gen Tr X X
  /-- Sequential composition: `s` then `t`. -/
  | seq {X Y Z : Ob} (s : Term tens Gen Tr X Y) (t : Term tens Gen Tr Y Z) :
      Term tens Gen Tr X Z
  /-- Parallel composition. -/
  | tensor {X Y X' Y' : Ob} (s : Term tens Gen Tr X Y) (t : Term tens Gen Tr X' Y') :
      Term tens Gen Tr (tens X X') (tens Y Y')
  /-- The trace along `U`. -/
  | trace {X Y U : Ob} (τ : Tr X Y U) (s : Term tens Gen Tr (tens X U) (tens Y U)) :
      Term tens Gen Tr X Y

/-- An interpretation of a traced monoidal signature: hom-types with identities, sequence,
tensor and trace, and a value for each generator. -/
structure Interp {Ob : Type u} (tens : Ob → Ob → Ob) (Gen : Ob → Ob → Type v)
    (Tr : Ob → Ob → Ob → Type w) where
  /-- The hom-types. -/
  Hom : Ob → Ob → Type r
  /-- The value of a generator. -/
  gen : ∀ {X Y : Ob}, Gen X Y → Hom X Y
  /-- Identities. -/
  id : ∀ X : Ob, Hom X X
  /-- Sequential composition. -/
  seq : ∀ {X Y Z : Ob}, Hom X Y → Hom Y Z → Hom X Z
  /-- Parallel composition. -/
  tensor : ∀ {X Y X' Y' : Ob}, Hom X Y → Hom X' Y' → Hom (tens X X') (tens Y Y')
  /-- The trace. -/
  trace : ∀ {X Y U : Ob}, Tr X Y U → Hom (tens X U) (tens Y U) → Hom X Y

variable {Ob : Type u} {tens : Ob → Ob → Ob} {Gen : Ob → Ob → Type v}
  {Gen' : Ob → Ob → Type v'} {Tr : Ob → Ob → Ob → Type w}

namespace Term

/-- The meaning of a term in an interpretation: the extension of the generator values along
identities, sequence, tensor and trace. -/
def fold (A : Interp.{u, v, w, r} tens Gen Tr) : {X Y : Ob} → Term tens Gen Tr X Y → A.Hom X Y
  | _, _, .gen g => A.gen g
  | _, _, .id X => A.id X
  | _, _, .seq s t => A.seq (fold A s) (fold A t)
  | _, _, .tensor s t => A.tensor (fold A s) (fold A t)
  | _, _, .trace τ s => A.trace τ (fold A s)

/-- The structural translation sending each generator `g` to the term `σ g` and preserving
identities, sequence, tensor and trace. -/
def bind (σ : ∀ {X Y : Ob}, Gen X Y → Term tens Gen' Tr X Y) :
    {X Y : Ob} → Term tens Gen Tr X Y → Term tens Gen' Tr X Y
  | _, _, .gen g => σ g
  | _, _, .id X => .id X
  | _, _, .seq s t => .seq (bind σ s) (bind σ t)
  | _, _, .tensor s t => .tensor (bind σ s) (bind σ t)
  | _, _, .trace τ s => .trace τ (bind σ s)

end Term

namespace Interp

/-- The interpretation of the source signature through a translation `σ`: the operations of
`B`, and the meaning in `B` of the image of each generator. -/
def comap (B : Interp.{u, v', w, r} tens Gen' Tr)
    (σ : ∀ {X Y : Ob}, Gen X Y → Term tens Gen' Tr X Y) : Interp.{u, v, w, r} tens Gen Tr where
  Hom := B.Hom
  gen g := (σ g).fold B
  id := B.id
  seq := B.seq
  tensor := B.tensor
  trace := B.trace

/-- A relation between the hom-types of two interpretations of the same objects is closed under
identities, sequence, tensor and trace (a logical relation for the traced monoidal operations).
-/
structure Respects {Gen₁ : Ob → Ob → Type v} {Gen₂ : Ob → Ob → Type v'}
    (A : Interp.{u, v, w, r} tens Gen₁ Tr) (B : Interp.{u, v', w, r'} tens Gen₂ Tr)
    (R : ∀ {X Y : Ob}, A.Hom X Y → B.Hom X Y → Prop) : Prop where
  /-- Identities are related. -/
  id : ∀ X : Ob, R (A.id X) (B.id X)
  /-- Sequence preserves the relation. -/
  seq : ∀ {X Y Z : Ob} {f : A.Hom X Y} {f' : B.Hom X Y} {g : A.Hom Y Z} {g' : B.Hom Y Z},
    R f f' → R g g' → R (A.seq f g) (B.seq f' g')
  /-- Tensor preserves the relation. -/
  tensor : ∀ {X Y X' Y' : Ob} {f : A.Hom X Y} {f' : B.Hom X Y} {g : A.Hom X' Y'}
    {g' : B.Hom X' Y'}, R f f' → R g g' → R (A.tensor f g) (B.tensor f' g')
  /-- Trace preserves the relation. -/
  trace : ∀ {X Y U : Ob} (τ : Tr X Y U) {f : A.Hom (tens X U) (tens Y U)}
    {f' : B.Hom (tens X U) (tens Y U)}, R f f' → R (A.trace τ f) (B.trace τ f')

end Interp

namespace Term

/-- **Agreement on generators extends to every term.** A relation closed under identities,
sequence, tensor and trace that holds between the values of each generator holds between the
meanings of each term. -/
theorem fold_rel (A : Interp.{u, v, w, r} tens Gen Tr) (B : Interp.{u, v, w, r'} tens Gen Tr)
    {R : ∀ {X Y : Ob}, A.Hom X Y → B.Hom X Y → Prop} (hR : Interp.Respects A B R)
    (hgen : ∀ {X Y : Ob} (g : Gen X Y), R (A.gen g) (B.gen g)) :
    ∀ {X Y : Ob} (t : Term tens Gen Tr X Y), R (t.fold A) (t.fold B)
  | _, _, .gen g => hgen g
  | _, _, .id X => hR.id X
  | _, _, .seq s t => hR.seq (fold_rel A B hR hgen s) (fold_rel A B hR hgen t)
  | _, _, .tensor s t => hR.tensor (fold_rel A B hR hgen s) (fold_rel A B hR hgen t)
  | _, _, .trace τ s => hR.trace τ (fold_rel A B hR hgen s)

/-- The meaning of a translated term is the meaning of the source term in the interpretation
through the translation. -/
theorem fold_bind (B : Interp.{u, v', w, r} tens Gen' Tr)
    (σ : ∀ {X Y : Ob}, Gen X Y → Term tens Gen' Tr X Y) :
    ∀ {X Y : Ob} (t : Term tens Gen Tr X Y), (t.bind σ).fold B = t.fold (B.comap σ)
  | _, _, .gen _ => rfl
  | _, _, .id _ => rfl
  | _, _, .seq s t => by
    change B.seq _ _ = B.seq _ _
    rw [fold_bind B σ s, fold_bind B σ t]
  | _, _, .tensor s t => by
    change B.tensor _ _ = B.tensor _ _
    rw [fold_bind B σ s, fold_bind B σ t]
  | _, _, .trace τ s => by
    change B.trace τ _ = B.trace τ _
    rw [fold_bind B σ s]

end Term

/-- **Compiler correctness from generators.** Let `σ` be a structural compiler from the source
signature to the target signature, `A` the source semantics and `B` the target semantics, and
`R` a relation closed under identities, sequence, tensor and trace. If the compiled image of
each generator is related to its source meaning, then every compiled term is related to its
source meaning. -/
theorem compile_correct (A : Interp.{u, v, w, r} tens Gen Tr)
    (B : Interp.{u, v', w, r'} tens Gen' Tr)
    (σ : ∀ {X Y : Ob}, Gen X Y → Term tens Gen' Tr X Y)
    {R : ∀ {X Y : Ob}, A.Hom X Y → B.Hom X Y → Prop} (hR : Interp.Respects A B R)
    (hgen : ∀ {X Y : Ob} (g : Gen X Y), R (A.gen g) ((σ g).fold B))
    {X Y : Ob} (t : Term tens Gen Tr X Y) : R (t.fold A) ((t.bind σ).fold B) := by
  rw [Term.fold_bind]
  exact Term.fold_rel A (B.comap σ) ⟨hR.id, hR.seq, hR.tensor, hR.trace⟩ hgen t

/-- **Compiler correctness for a semantic functor.** If `F` maps the hom-types of the source
semantics to those of the target semantics preserving identities, sequence, tensor and trace,
and the compiled image of each generator means the image under `F` of its source meaning, then
every compiled term means the image under `F` of the source term's meaning. -/
theorem compile_map_eq (A : Interp.{u, v, w, r} tens Gen Tr)
    (B : Interp.{u, v', w, r'} tens Gen' Tr)
    (σ : ∀ {X Y : Ob}, Gen X Y → Term tens Gen' Tr X Y)
    (F : ∀ {X Y : Ob}, A.Hom X Y → B.Hom X Y)
    (hid : ∀ X : Ob, F (A.id X) = B.id X)
    (hseq : ∀ {X Y Z : Ob} (f : A.Hom X Y) (g : A.Hom Y Z), F (A.seq f g) = B.seq (F f) (F g))
    (htensor : ∀ {X Y X' Y' : Ob} (f : A.Hom X Y) (g : A.Hom X' Y'),
      F (A.tensor f g) = B.tensor (F f) (F g))
    (htrace : ∀ {X Y U : Ob} (τ : Tr X Y U) (f : A.Hom (tens X U) (tens Y U)),
      F (A.trace τ f) = B.trace τ (F f))
    (hgen : ∀ {X Y : Ob} (g : Gen X Y), F (A.gen g) = (σ g).fold B)
    {X Y : Ob} (t : Term tens Gen Tr X Y) : F (t.fold A) = (t.bind σ).fold B := by
  refine compile_correct A B σ (R := fun f g => F f = g) ⟨?_, ?_, ?_, ?_⟩ hgen t
  · exact hid
  · intro X Y Z f f' g g' hf hg
    rw [hseq, hf, hg]
  · intro X Y X' Y' f f' g g' hf hg
    rw [htensor, hf, hg]
  · intro X Y U τ f f' hf
    rw [htrace, hf]

/-! ## Wiring-diagram terms over a symmetric monoidal category -/

section Wiring

variable {C : Type u} [Category.{v} C] [MonoidalCategory C]

/-- The generators of wiring diagrams over `Gen`: the generators of `Gen` and the structure
maps of a symmetric monoidal category. -/
inductive SMGen (Gen : C → C → Type w) : C → C → Type (max u w) where
  /-- A generator of `Gen`. -/
  | gen {X Y : C} (a : Gen X Y) : SMGen Gen X Y
  /-- The associator. -/
  | assoc (X Y Z : C) : SMGen Gen ((X ⊗ Y) ⊗ Z) (X ⊗ (Y ⊗ Z))
  /-- The inverse associator. -/
  | assocInv (X Y Z : C) : SMGen Gen (X ⊗ (Y ⊗ Z)) ((X ⊗ Y) ⊗ Z)
  /-- The left unitor. -/
  | lunit (X : C) : SMGen Gen (𝟙_ C ⊗ X) X
  /-- The inverse left unitor. -/
  | lunitInv (X : C) : SMGen Gen X (𝟙_ C ⊗ X)
  /-- The right unitor. -/
  | runit (X : C) : SMGen Gen (X ⊗ 𝟙_ C) X
  /-- The inverse right unitor. -/
  | runitInv (X : C) : SMGen Gen X (X ⊗ 𝟙_ C)
  /-- The symmetry. -/
  | braid (X Y : C) : SMGen Gen (X ⊗ Y) (Y ⊗ X)

/-- Every object may be traced. -/
abbrev AnyTrace (C : Type u) : C → C → C → Type := fun _ _ _ => Unit

/-- Wiring-diagram terms over the generators `Gen`: terms of the traced monoidal signature whose
generators are those of `Gen` and the symmetric monoidal structure maps, with every object
traceable. -/
abbrev WTerm (Gen : C → C → Type w) : C → C → Type (max u w) :=
  Term (· ⊗ ·) (SMGen Gen) (AnyTrace C)

namespace WTerm

variable {Gen : C → C → Type w}

/-- The term of a generator of `Gen`. -/
abbrev ofGen {X Y : C} (a : Gen X Y) : WTerm Gen X Y :=
  .gen (.gen a)

/-- The trace term along `U`. -/
abbrev traceAlong (U : C) {X Y : C} (t : WTerm Gen (X ⊗ U) (Y ⊗ U)) : WTerm Gen X Y :=
  .trace (U := U) () t

variable [SymmetricCategory C] [TracedCategory C]

/-- The value of a wiring generator in a traced symmetric monoidal category: `g` on the
generators of `Gen`, the structure isomorphisms of `C` on the structure maps. -/
def SMGen.den (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y)) : {X Y : C} → SMGen Gen X Y → (X ⟶ Y)
  | _, _, .gen a => g a
  | _, _, .assoc X Y Z => (α_ X Y Z).hom
  | _, _, .assocInv X Y Z => (α_ X Y Z).inv
  | _, _, .lunit X => (λ_ X).hom
  | _, _, .lunitInv X => (λ_ X).inv
  | _, _, .runit X => (ρ_ X).hom
  | _, _, .runitInv X => (ρ_ X).inv
  | _, _, .braid X Y => (β_ X Y).hom

/-- The interpretation of wiring-diagram terms in the traced symmetric monoidal category `C`. -/
def interp (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y)) : Interp (· ⊗ ·) (SMGen Gen) (AnyTrace C) where
  Hom X Y := X ⟶ Y
  gen := SMGen.den g
  id X := 𝟙 X
  seq f f' := f ≫ f'
  tensor f f' := f ⊗ₘ f'
  trace {_ _ U} _ f := TracedCategory.trace U f

/-- The denotation of a wiring-diagram term: the fold of `interp g`. -/
abbrev den (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y)) {X Y : C} (t : WTerm Gen X Y) : X ⟶ Y :=
  t.fold (interp g)

variable (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y))

/-- Unfolding lemma of `den` at a generator of `Gen`. -/
@[simp] theorem den_ofGen {X Y : C} (a : Gen X Y) : den g (ofGen a) = g a := rfl

/-- Unfolding lemma of `den` at a structure map. -/
@[simp] theorem den_gen {X Y : C} (a : SMGen Gen X Y) : den g (.gen a) = SMGen.den g a := rfl

/-- Unfolding lemma of `den` at an identity. -/
@[simp] theorem den_id (X : C) : den g (.id X : WTerm Gen X X) = 𝟙 X := rfl

/-- Unfolding lemma of `den` at a sequence. -/
@[simp] theorem den_seq {X Y Z : C} (t : WTerm Gen X Y) (t' : WTerm Gen Y Z) :
    den g (.seq t t') = den g t ≫ den g t' := rfl

/-- Unfolding lemma of `den` at a tensor. -/
@[simp] theorem den_tensor {X₁ Y₁ X₂ Y₂ : C} (t₁ : WTerm Gen X₁ Y₁) (t₂ : WTerm Gen X₂ Y₂) :
    den g (.tensor t₁ t₂) = den g t₁ ⊗ₘ den g t₂ := rfl

/-- Unfolding lemma of `den` at a trace. -/
@[simp] theorem den_trace (U : C) {X Y : C} (t : WTerm Gen (X ⊗ U) (Y ⊗ U)) :
    den g (traceAlong U t) = TracedCategory.trace U (den g t) := rfl

end WTerm

end Wiring

/-! ## The syntactic traced symmetric monoidal category -/

section Syntax

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] {Gen : C → C → Type w}

namespace WTerm

/-- The associator term. -/
abbrev assocT (X Y Z : C) : WTerm Gen ((X ⊗ Y) ⊗ Z) (X ⊗ (Y ⊗ Z)) := .gen (.assoc X Y Z)

/-- The inverse associator term. -/
abbrev assocInvT (X Y Z : C) : WTerm Gen (X ⊗ (Y ⊗ Z)) ((X ⊗ Y) ⊗ Z) := .gen (.assocInv X Y Z)

/-- The left unitor term. -/
abbrev lunitT (X : C) : WTerm Gen (𝟙_ C ⊗ X) X := .gen (.lunit X)

/-- The inverse left unitor term. -/
abbrev lunitInvT (X : C) : WTerm Gen X (𝟙_ C ⊗ X) := .gen (.lunitInv X)

/-- The right unitor term. -/
abbrev runitT (X : C) : WTerm Gen (X ⊗ 𝟙_ C) X := .gen (.runit X)

/-- The inverse right unitor term. -/
abbrev runitInvT (X : C) : WTerm Gen X (X ⊗ 𝟙_ C) := .gen (.runitInv X)

/-- The symmetry term. -/
abbrev braidT (X Y : C) : WTerm Gen (X ⊗ Y) (Y ⊗ X) := .gen (.braid X Y)

/-- The traced symmetric monoidal congruence on wiring-diagram terms generated by the equations
`Ax`: the least congruence for sequence, tensor and trace that contains `Ax` and the axioms of a
traced symmetric monoidal category. A whiskering is the tensor with an identity term. -/
inductive PEq (Ax : ∀ {X Y : C}, WTerm Gen X Y → WTerm Gen X Y → Prop) :
    ∀ {X Y : C}, WTerm Gen X Y → WTerm Gen X Y → Prop where
  /-- An equation of `Ax`. -/
  | ax {X Y : C} {t t' : WTerm Gen X Y} : Ax t t' → PEq Ax t t'
  /-- Reflexivity. -/
  | refl {X Y : C} (t : WTerm Gen X Y) : PEq Ax t t
  /-- Symmetry. -/
  | symm {X Y : C} {t t' : WTerm Gen X Y} : PEq Ax t t' → PEq Ax t' t
  /-- Transitivity. -/
  | trans {X Y : C} {t t' t'' : WTerm Gen X Y} : PEq Ax t t' → PEq Ax t' t'' → PEq Ax t t''
  /-- Congruence for sequence. -/
  | seq {X Y Z : C} {s s' : WTerm Gen X Y} {t t' : WTerm Gen Y Z} :
      PEq Ax s s' → PEq Ax t t' → PEq Ax (.seq s t) (.seq s' t')
  /-- Congruence for tensor. -/
  | tensor {X₁ Y₁ X₂ Y₂ : C} {s s' : WTerm Gen X₁ Y₁} {t t' : WTerm Gen X₂ Y₂} :
      PEq Ax s s' → PEq Ax t t' → PEq Ax (.tensor s t) (.tensor s' t')
  /-- Congruence for trace. -/
  | trace (U : C) {X Y : C} {t t' : WTerm Gen (X ⊗ U) (Y ⊗ U)} :
      PEq Ax t t' → PEq Ax (traceAlong U t) (traceAlong U t')
  /-- Left identity. -/
  | id_seq {X Y : C} (t : WTerm Gen X Y) : PEq Ax (.seq (.id X) t) t
  /-- Right identity. -/
  | seq_id {X Y : C} (t : WTerm Gen X Y) : PEq Ax (.seq t (.id Y)) t
  /-- Associativity of sequence. -/
  | seq_assoc {W X Y Z : C} (t₁ : WTerm Gen W X) (t₂ : WTerm Gen X Y) (t₃ : WTerm Gen Y Z) :
      PEq Ax (.seq (.seq t₁ t₂) t₃) (.seq t₁ (.seq t₂ t₃))
  /-- The tensor of identities is the identity. -/
  | tensor_id (X Y : C) : PEq Ax (.tensor (.id X) (.id Y)) (.id (X ⊗ Y))
  /-- The interchange law. -/
  | tensor_seq {X₁ Y₁ Z₁ X₂ Y₂ Z₂ : C} (f₁ : WTerm Gen X₁ Y₁) (f₂ : WTerm Gen X₂ Y₂)
      (g₁ : WTerm Gen Y₁ Z₁) (g₂ : WTerm Gen Y₂ Z₂) :
      PEq Ax (.seq (.tensor f₁ f₂) (.tensor g₁ g₂)) (.tensor (.seq f₁ g₁) (.seq f₂ g₂))
  /-- Naturality of the associator. -/
  | assoc_nat {X₁ X₂ X₃ Y₁ Y₂ Y₃ : C} (f₁ : WTerm Gen X₁ Y₁) (f₂ : WTerm Gen X₂ Y₂)
      (f₃ : WTerm Gen X₃ Y₃) :
      PEq Ax (.seq (.tensor (.tensor f₁ f₂) f₃) (assocT Y₁ Y₂ Y₃))
        (.seq (assocT X₁ X₂ X₃) (.tensor f₁ (.tensor f₂ f₃)))
  /-- Naturality of the left unitor. -/
  | lunit_nat {X Y : C} (f : WTerm Gen X Y) :
      PEq Ax (.seq (.tensor (.id (𝟙_ C)) f) (lunitT Y)) (.seq (lunitT X) f)
  /-- Naturality of the right unitor. -/
  | runit_nat {X Y : C} (f : WTerm Gen X Y) :
      PEq Ax (.seq (.tensor f (.id (𝟙_ C))) (runitT Y)) (.seq (runitT X) f)
  /-- The associator is invertible (first composite). -/
  | assoc_hom_inv (X Y Z : C) : PEq Ax (.seq (assocT X Y Z) (assocInvT X Y Z)) (.id _)
  /-- The associator is invertible (second composite). -/
  | assoc_inv_hom (X Y Z : C) : PEq Ax (.seq (assocInvT X Y Z) (assocT X Y Z)) (.id _)
  /-- The left unitor is invertible (first composite). -/
  | lunit_hom_inv (X : C) : PEq Ax (.seq (lunitT X) (lunitInvT X)) (.id _)
  /-- The left unitor is invertible (second composite). -/
  | lunit_inv_hom (X : C) : PEq Ax (.seq (lunitInvT X) (lunitT X)) (.id _)
  /-- The right unitor is invertible (first composite). -/
  | runit_hom_inv (X : C) : PEq Ax (.seq (runitT X) (runitInvT X)) (.id _)
  /-- The right unitor is invertible (second composite). -/
  | runit_inv_hom (X : C) : PEq Ax (.seq (runitInvT X) (runitT X)) (.id _)
  /-- The pentagon. -/
  | pentagon (W X Y Z : C) :
      PEq Ax (.seq (.tensor (assocT W X Y) (.id Z))
          (.seq (assocT W (X ⊗ Y) Z) (.tensor (.id W) (assocT X Y Z))))
        (.seq (assocT (W ⊗ X) Y Z) (assocT W X (Y ⊗ Z)))
  /-- The triangle. -/
  | triangle (X Y : C) :
      PEq Ax (.seq (assocT X (𝟙_ C) Y) (.tensor (.id X) (lunitT Y)))
        (.tensor (runitT X) (.id Y))
  /-- Naturality of the symmetry. -/
  | braid_nat {X₁ Y₁ X₂ Y₂ : C} (f : WTerm Gen X₁ Y₁) (g : WTerm Gen X₂ Y₂) :
      PEq Ax (.seq (.tensor f g) (braidT Y₁ Y₂)) (.seq (braidT X₁ X₂) (.tensor g f))
  /-- The first hexagon. -/
  | hexagon_forward (X Y Z : C) :
      PEq Ax (.seq (assocT X Y Z) (.seq (braidT X (Y ⊗ Z)) (assocT Y Z X)))
        (.seq (.tensor (braidT X Y) (.id Z)) (.seq (assocT Y X Z) (.tensor (.id Y) (braidT X Z))))
  /-- The second hexagon. -/
  | hexagon_reverse (X Y Z : C) :
      PEq Ax (.seq (assocInvT X Y Z) (.seq (braidT (X ⊗ Y) Z) (assocInvT Z X Y)))
        (.seq (.tensor (.id X) (braidT Y Z))
          (.seq (assocInvT X Z Y) (.tensor (braidT X Z) (.id Y))))
  /-- The symmetry is involutive. -/
  | symmetry (X Y : C) : PEq Ax (.seq (braidT X Y) (braidT Y X)) (.id _)
  /-- Tightening in the source. -/
  | trace_wr_seq (U : C) {X X' Y : C} (g : WTerm Gen X' X) (f : WTerm Gen (X ⊗ U) (Y ⊗ U)) :
      PEq Ax (traceAlong U (.seq (.tensor g (.id U)) f)) (.seq g (traceAlong U f))
  /-- Tightening in the target. -/
  | trace_seq_wr (U : C) {X Y Y' : C} (f : WTerm Gen (X ⊗ U) (Y ⊗ U)) (h : WTerm Gen Y Y') :
      PEq Ax (traceAlong U (.seq f (.tensor h (.id U)))) (.seq (traceAlong U f) h)
  /-- Sliding. -/
  | trace_wl_seq {U U' X Y : C} (g : WTerm Gen U U') (f : WTerm Gen (X ⊗ U') (Y ⊗ U)) :
      PEq Ax (traceAlong U (.seq (.tensor (.id X) g) f))
        (traceAlong U' (.seq f (.tensor (.id Y) g)))
  /-- Vanishing for the unit. -/
  | trace_unit {X Y : C} (f : WTerm Gen (X ⊗ 𝟙_ C) (Y ⊗ 𝟙_ C)) :
      PEq Ax (traceAlong (𝟙_ C) f) (.seq (runitInvT X) (.seq f (runitT Y)))
  /-- Vanishing for a tensor product. -/
  | trace_tensor (U V : C) {X Y : C} (f : WTerm Gen (X ⊗ (U ⊗ V)) (Y ⊗ (U ⊗ V))) :
      PEq Ax (traceAlong (U ⊗ V) f)
        (traceAlong U (traceAlong V (.seq (assocT X U V) (.seq f (assocInvT Y U V)))))
  /-- Superposing. -/
  | wl_trace (W U : C) {X Y : C} (f : WTerm Gen (X ⊗ U) (Y ⊗ U)) :
      PEq Ax (.tensor (.id W) (traceAlong U f))
        (traceAlong U (.seq (assocT W X U) (.seq (.tensor (.id W) f) (assocInvT W Y U))))
  /-- Yanking. -/
  | yank (U : C) : PEq Ax (traceAlong U (braidT U U)) (.id U)

/-- The congruence `PEq Ax` as a setoid on terms. -/
def setoidP (Ax : ∀ {X Y : C}, WTerm Gen X Y → WTerm Gen X Y → Prop) (X Y : C) :
    Setoid (WTerm Gen X Y) :=
  ⟨PEq Ax, ⟨PEq.refl, PEq.symm, PEq.trans⟩⟩

variable [SymmetricCategory C] [TracedCategory C]

/-- The denotation `g` validates the equations `Ax`. -/
def Sound (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y))
    (Ax : ∀ {X Y : C}, WTerm Gen X Y → WTerm Gen X Y → Prop) : Prop :=
  ∀ {X Y : C} {t t' : WTerm Gen X Y}, Ax t t' → den g t = den g t'

/-- **Soundness.** If the denotation `g` validates the equations `Ax`, then terms related by the
congruence `PEq Ax` have equal denotations. -/
theorem PEq.sound (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y))
    {Ax : ∀ {X Y : C}, WTerm Gen X Y → WTerm Gen X Y → Prop} (hAx : Sound g Ax)
    {X Y : C} {t t' : WTerm Gen X Y} (h : PEq Ax t t') : den g t = den g t' := by
  induction h with
  | ax h => exact hAx h
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | seq _ _ ih₁ ih₂ => simp only [den_seq, ih₁, ih₂]
  | tensor _ _ ih₁ ih₂ => simp only [den_tensor, ih₁, ih₂]
  | trace U _ ih => simp only [den_trace, ih]
  | id_seq => simp
  | seq_id => simp
  | seq_assoc => simp
  | tensor_id => simp
  | tensor_seq => simp
  | assoc_nat => simp [SMGen.den]
  | lunit_nat => simp [SMGen.den]
  | runit_nat => simp [SMGen.den]
  | assoc_hom_inv => simp [SMGen.den]
  | assoc_inv_hom => simp [SMGen.den]
  | lunit_hom_inv => simp [SMGen.den]
  | lunit_inv_hom => simp [SMGen.den]
  | runit_hom_inv => simp [SMGen.den]
  | runit_inv_hom => simp [SMGen.den]
  | pentagon => simp [SMGen.den]
  | triangle => simp [SMGen.den]
  | braid_nat => simp [SMGen.den]
  | hexagon_forward => simp [SMGen.den]
  | hexagon_reverse => simp [SMGen.den]
  | symmetry => simp [SMGen.den]
  | trace_wr_seq => simp [TracedCategory.trace_whiskerRight_comp]
  | trace_seq_wr => simp [TracedCategory.trace_comp_whiskerRight]
  | trace_wl_seq => simp [TracedCategory.trace_whiskerLeft_comp]
  | trace_unit => simp [SMGen.den]
  | trace_tensor => simp [SMGen.den, TracedCategory.trace_tensor]
  | wl_trace => simp [SMGen.den, TracedCategory.whiskerLeft_trace]
  | yank => simp [SMGen.den]

end WTerm

/-- The objects of the syntactic category over the equations `Ax`: the objects of `C`. -/
structure Syn (Ax : ∀ {X Y : C}, WTerm Gen X Y → WTerm Gen X Y → Prop) : Type u where
  /-- The object of `C`. -/
  obj : C

namespace Syn

variable {Ax : ∀ {X Y : C}, WTerm Gen X Y → WTerm Gen X Y → Prop}

/-- **The syntactic category**: a morphism is a term modulo the traced symmetric monoidal
congruence generated by `Ax`; composition is sequence and the identity is the identity term. -/
instance category : Category.{max u w} (Syn Ax) where
  Hom X Y := Quotient (WTerm.setoidP Ax X.obj Y.obj)
  id X := ⟦.id X.obj⟧
  comp := Quotient.map₂ Term.seq fun _ _ h₁ _ _ h₂ => WTerm.PEq.seq h₁ h₂
  id_comp := by
    rintro X Y ⟨t⟩
    exact Quotient.sound (WTerm.PEq.id_seq t)
  comp_id := by
    rintro X Y ⟨t⟩
    exact Quotient.sound (WTerm.PEq.seq_id t)
  assoc := by
    rintro W X Y Z ⟨t₁⟩ ⟨t₂⟩ ⟨t₃⟩
    exact Quotient.sound (WTerm.PEq.seq_assoc t₁ t₂ t₃)

/-- The tensor product of morphisms: the tensor of terms. -/
def tensorHom {X₁ Y₁ X₂ Y₂ : Syn Ax} (f₁ : X₁ ⟶ Y₁) (f₂ : X₂ ⟶ Y₂) :
    (⟨X₁.obj ⊗ X₂.obj⟩ : Syn Ax) ⟶ ⟨Y₁.obj ⊗ Y₂.obj⟩ :=
  Quotient.map₂ Term.tensor (fun _ _ h₁ _ _ h₂ => WTerm.PEq.tensor h₁ h₂) f₁ f₂

/-- The isomorphism given by two terms whose composites are congruent to identities. -/
def isoMk {X Y : Syn Ax} (t : WTerm Gen X.obj Y.obj) (t' : WTerm Gen Y.obj X.obj)
    (h : WTerm.PEq Ax (.seq t t') (.id _)) (h' : WTerm.PEq Ax (.seq t' t) (.id _)) : X ≅ Y where
  hom := ⟦t⟧
  inv := ⟦t'⟧
  hom_inv_id := Quotient.sound h
  inv_hom_id := Quotient.sound h'

/-- The monoidal data: the tensor of `C` on objects, the tensor of terms, the unit of `C` and
the structure-map terms. -/
instance monoidalCategoryStruct : MonoidalCategoryStruct (Syn Ax) where
  tensorObj X Y := ⟨X.obj ⊗ Y.obj⟩
  tensorHom := tensorHom
  whiskerLeft X _ _ f := tensorHom (𝟙 X) f
  whiskerRight f Y := tensorHom f (𝟙 Y)
  tensorUnit := ⟨𝟙_ C⟩
  associator X Y Z := isoMk (WTerm.assocT _ _ _) (WTerm.assocInvT _ _ _)
    (.assoc_hom_inv X.obj Y.obj Z.obj) (.assoc_inv_hom X.obj Y.obj Z.obj)
  leftUnitor X := isoMk (WTerm.lunitT _) (WTerm.lunitInvT _)
    (.lunit_hom_inv X.obj) (.lunit_inv_hom X.obj)
  rightUnitor X := isoMk (WTerm.runitT _) (WTerm.runitInvT _)
    (.runit_hom_inv X.obj) (.runit_inv_hom X.obj)

/-- Unfolding lemma of the tensor product of objects. -/
@[simp] theorem tensorObj_obj (X Y : Syn Ax) : (X ⊗ Y).obj = X.obj ⊗ Y.obj :=
  rfl

/-- Unfolding lemma of the unit object. -/
@[simp] theorem tensorUnit_obj : (𝟙_ (Syn Ax)).obj = 𝟙_ C :=
  rfl

/-- The syntactic category is monoidal; each law is a generating equation. -/
instance monoidalCategory : MonoidalCategory (Syn Ax) where
  tensorHom_def f₁ f₂ := by
    induction f₁ using Quotient.inductionOn
    induction f₂ using Quotient.inductionOn
    exact Quotient.sound
      (.symm (.trans (.tensor_seq _ _ _ _) (.tensor (.seq_id _) (.id_seq _))))
  id_tensorHom_id X Y := Quotient.sound (.tensor_id X.obj Y.obj)
  tensorHom_comp_tensorHom f₁ f₂ g₁ g₂ := by
    induction f₁ using Quotient.inductionOn
    induction f₂ using Quotient.inductionOn
    induction g₁ using Quotient.inductionOn
    induction g₂ using Quotient.inductionOn
    exact Quotient.sound (.tensor_seq _ _ _ _)
  whiskerLeft_id X Y := Quotient.sound (.tensor_id X.obj Y.obj)
  id_whiskerRight X Y := Quotient.sound (.tensor_id X.obj Y.obj)
  associator_naturality f₁ f₂ f₃ := by
    induction f₁ using Quotient.inductionOn
    induction f₂ using Quotient.inductionOn
    induction f₃ using Quotient.inductionOn
    exact Quotient.sound (.assoc_nat _ _ _)
  leftUnitor_naturality f := by
    induction f using Quotient.inductionOn
    exact Quotient.sound (.lunit_nat _)
  rightUnitor_naturality f := by
    induction f using Quotient.inductionOn
    exact Quotient.sound (.runit_nat _)
  pentagon W X Y Z := Quotient.sound (.pentagon W.obj X.obj Y.obj Z.obj)
  triangle X Y := Quotient.sound (.triangle X.obj Y.obj)

/-- The symmetry of the syntactic category: the symmetry term. -/
def braiding (X Y : Syn Ax) : X ⊗ Y ≅ Y ⊗ X :=
  isoMk (X := X ⊗ Y) (Y := Y ⊗ X) (WTerm.braidT _ _) (WTerm.braidT _ _)
    (.symmetry X.obj Y.obj) (.symmetry Y.obj X.obj)

/-- The syntactic category is symmetric monoidal. -/
instance symmetricCategory : SymmetricCategory (Syn Ax) where
  braiding := braiding
  braiding_naturality_right X Y Z f := by
    induction f using Quotient.inductionOn
    exact Quotient.sound (.braid_nat _ _)
  braiding_naturality_left f Z := by
    induction f using Quotient.inductionOn
    exact Quotient.sound (.braid_nat _ _)
  hexagon_forward X Y Z := Quotient.sound (.hexagon_forward X.obj Y.obj Z.obj)
  hexagon_reverse X Y Z := Quotient.sound (.hexagon_reverse X.obj Y.obj Z.obj)
  symmetry X Y := Quotient.sound (.symmetry X.obj Y.obj)

/-- The trace of the syntactic category: the trace term. -/
def trace (U : Syn Ax) {X Y : Syn Ax} (f : X ⊗ U ⟶ Y ⊗ U) : X ⟶ Y :=
  Quotient.map (WTerm.traceAlong U.obj) (fun _ _ h => WTerm.PEq.trace U.obj h) f

/-- The syntactic category is traced; each axiom is a generating equation. -/
instance tracedCategory : TracedCategory (Syn Ax) where
  trace := trace
  trace_whiskerRight_comp U _ _ _ g f := by
    induction g using Quotient.inductionOn
    induction f using Quotient.inductionOn
    exact Quotient.sound (.trace_wr_seq _ _ _)
  trace_comp_whiskerRight U _ _ _ f h := by
    induction f using Quotient.inductionOn
    induction h using Quotient.inductionOn
    exact Quotient.sound (.trace_seq_wr _ _ _)
  trace_whiskerLeft_comp g f := by
    induction g using Quotient.inductionOn
    induction f using Quotient.inductionOn
    exact Quotient.sound (.trace_wl_seq _ _)
  trace_tensorUnit f := by
    induction f using Quotient.inductionOn
    exact Quotient.sound (.trace_unit _)
  trace_tensor U V _ _ f := by
    induction f using Quotient.inductionOn
    exact Quotient.sound (.trace_tensor _ _ _)
  whiskerLeft_trace W U _ _ f := by
    induction f using Quotient.inductionOn
    exact Quotient.sound (.wl_trace _ _ _)
  trace_braiding U := Quotient.sound (.yank U.obj)

section Functor

variable [SymmetricCategory C] [TracedCategory C] (g : ∀ {X Y : C}, Gen X Y → (X ⟶ Y))
  (hAx : WTerm.Sound g Ax)

/-- **The denotation functor** of the syntactic category: a class of terms is sent to the
denotation of any representative, which is well defined by soundness (`WTerm.PEq.sound`). -/
def functor : Syn Ax ⥤ C where
  obj X := X.obj
  map f := Quotient.lift (WTerm.den g) (fun _ _ h => WTerm.PEq.sound g hAx h) f
  map_id _ := rfl
  map_comp := by
    rintro X Y Z ⟨t⟩ ⟨t'⟩
    rfl

/-- Unfolding lemma of the denotation functor on objects. -/
@[simp] theorem functor_obj (X : Syn Ax) : (functor g hAx).obj X = X.obj :=
  rfl

/-- Unfolding lemma of the denotation functor on a class of terms. -/
@[simp] theorem functor_map_mk {X Y : Syn Ax} (t : WTerm Gen X.obj Y.obj) :
    (functor g hAx).map (⟦t⟧ : X ⟶ Y) = WTerm.den g t :=
  rfl

include hAx in
/-- **Soundness of the syntactic category.** Terms equal in the syntactic category have equal
denotations. -/
theorem den_eq_of_eq {X Y : Syn Ax} {t t' : WTerm Gen X.obj Y.obj}
    (h : (⟦t⟧ : X ⟶ Y) = ⟦t'⟧) : WTerm.den g t = WTerm.den g t' :=
  congrArg (functor g hAx).map h

/-- **Strictness on the tensor.** The denotation of a tensor product is the tensor product. -/
@[simp] theorem map_tensorHom {X₁ Y₁ X₂ Y₂ : Syn Ax} (f₁ : X₁ ⟶ Y₁) (f₂ : X₂ ⟶ Y₂) :
    (functor g hAx).map (f₁ ⊗ₘ f₂) = (functor g hAx).map f₁ ⊗ₘ (functor g hAx).map f₂ := by
  induction f₁ using Quotient.inductionOn
  induction f₂ using Quotient.inductionOn
  rfl

/-- The denotation of a left whiskering. -/
@[simp] theorem map_whiskerLeft (X : Syn Ax) {Y Z : Syn Ax} (f : Y ⟶ Z) :
    (functor g hAx).map (X ◁ f) = (functor g hAx).obj X ◁ (functor g hAx).map f := by
  induction f using Quotient.inductionOn
  exact id_tensorHom _ _

/-- The denotation of a right whiskering. -/
@[simp] theorem map_whiskerRight {X Y : Syn Ax} (f : X ⟶ Y) (Z : Syn Ax) :
    (functor g hAx).map (f ▷ Z) = (functor g hAx).map f ▷ (functor g hAx).obj Z := by
  induction f using Quotient.inductionOn
  exact tensorHom_id _ _

/-- The denotation of the associator. -/
@[simp] theorem map_associator_hom (X Y Z : Syn Ax) :
    (functor g hAx).map (α_ X Y Z).hom = (α_ X.obj Y.obj Z.obj).hom :=
  rfl

/-- The denotation of the inverse associator. -/
@[simp] theorem map_associator_inv (X Y Z : Syn Ax) :
    (functor g hAx).map (α_ X Y Z).inv = (α_ X.obj Y.obj Z.obj).inv :=
  rfl

/-- The denotation of the left unitor. -/
@[simp] theorem map_leftUnitor_hom (X : Syn Ax) :
    (functor g hAx).map (λ_ X).hom = (λ_ X.obj).hom :=
  rfl

/-- The denotation of the inverse left unitor. -/
@[simp] theorem map_leftUnitor_inv (X : Syn Ax) :
    (functor g hAx).map (λ_ X).inv = (λ_ X.obj).inv :=
  rfl

/-- The denotation of the right unitor. -/
@[simp] theorem map_rightUnitor_hom (X : Syn Ax) :
    (functor g hAx).map (ρ_ X).hom = (ρ_ X.obj).hom :=
  rfl

/-- The denotation of the inverse right unitor. -/
@[simp] theorem map_rightUnitor_inv (X : Syn Ax) :
    (functor g hAx).map (ρ_ X).inv = (ρ_ X.obj).inv :=
  rfl

/-- The denotation of the symmetry. -/
@[simp] theorem map_braiding_hom (X Y : Syn Ax) :
    (functor g hAx).map (β_ X Y).hom = (β_ X.obj Y.obj).hom :=
  rfl

/-- **Strictness on the trace.** The denotation of a trace is the trace of the denotation. -/
@[simp] theorem map_trace (U : Syn Ax) {X Y : Syn Ax} (f : X ⊗ U ⟶ Y ⊗ U) :
    (functor g hAx).map (TracedCategory.trace U f) =
      TracedCategory.trace U.obj ((functor g hAx).map f) := by
  induction f using Quotient.inductionOn
  rfl

/-- The denotation functor is strict monoidal: the tensorator and the unit are identities. -/
def functorCoreMonoidal : (functor g hAx).CoreMonoidal where
  εIso := Iso.refl _
  μIso _ _ := Iso.refl _
  μIso_hom_natural_left f X' := by simp
  μIso_hom_natural_right X' f := by simp
  associativity X Y Z := by simp
  left_unitality X := by simp
  right_unitality X := by simp

/-- The denotation functor is monoidal, with identity tensorator and unit. -/
instance functorMonoidal : (functor g hAx).Monoidal :=
  (functorCoreMonoidal g hAx).toMonoidal

/-- The tensorator of the denotation functor is the identity. -/
@[simp] theorem functor_μ (X Y : Syn Ax) :
    Functor.LaxMonoidal.μ (functor g hAx) X Y = 𝟙 (X.obj ⊗ Y.obj) :=
  rfl

/-- **The denotation functor is a strict symmetric monoidal functor.** -/
instance functorBraided : (functor g hAx).Braided where
  braided X Y := by simp

end Functor

end Syn

end Syntax

end CatCrypt.Category.TracedTerm
