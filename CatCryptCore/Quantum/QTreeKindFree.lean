module

public import CatCryptCore.Quantum.QTreeKind
public import CatCryptCore.Crypto.Party.ProgECost

/-!
# Costed quantum instruments as free monads with tick nodes

The costed instrument `QInstrT A α B` of the quantum tree kind is a costed quantum computation
`QTreeT A α`, a party program `ProgE (Costed (SubInstrument A A ℕ)) Empty Empty α`. Its image
in the free monad of the signature `QInstrT.Sig A` of party programs, generated by
`derive_free_sig ProgE`, is `QInstrT.toFreeMT`. The tick nodes of this image are the operations
`opN (Costed.tick c)`; the charge `QInstrT.tickCost` is one unit at an operation, a receive and a
send, `c` at the tick `tick c`, and nothing at a failure. A step-prefixed costed instrument
`(c, x)` has the image `QInstrT.stepToFreeMT`: the tick `c` followed by the image of `x`.

The time bound `ProgE.Bound Costed.weight x.toTree n (fun _ => True)` of a costed instrument and
the step time bound `QInstrT.StepTimeBound` of the tree kind are PolyFun's subtractive roll bound
and the bound on the worst-case charge fold of these images.

Search words: quantum tree kind, costed instrument, free monad, tick node, roll bound, charge
fold, budget.

## Main definitions

* `QInstrT.Sig`, `QInstrT.tickCost` — the signature and the charge
* `QInstrT.toFreeMT`, `QInstrT.stepToFreeMT` — the tick trees of a costed instrument and of a
  step-prefixed costed instrument

## Main results

* `QInstrT.timeBound_iff_wpFold_charge`, `QInstrT.timeBound_iff_isRollBound` — the time bound of
  a costed instrument is the bound on the charge fold and the roll bound of its tick tree
* `QInstrT.stepTimeBound_iff_wpFold_charge`, `QInstrT.stepTimeBound_iff_isRollBound` — the same
  for `StepTimeBound`
-/

@[expose] public section

set_option autoImplicit false

open PFunctor PFunctor.FreeM CatCrypt.Container CatCrypt.Crypto.Party

namespace CatCrypt.Quantum.ReactiveUC.QInstrT

open _root_.Quantum

variable {A : Type} [Fintype A] {α : Type} {B : α → Type} [∀ a, Fintype (B a)]

/-- The polynomial functor of costed instruments on `A`: the signature of party programs whose
operations are costed subinstruments on `A`, without events or outputs. -/
abbrev Sig (A : Type) [Fintype A] : PFunctor.{0, 0} :=
  ProgECost.Sig (Costed (SubInstrument A A ℕ)) Empty Empty

/-- The charge of a position of `Sig A`: the weight `Costed.weight` at an operation, one unit at
a receive and a send, nothing at a failure. -/
def tickCost : (Sig A).A → ℕ :=
  ProgECost.Op.weight Costed.weight

/-- The costed instrument `x` as a tree of `Sig A`; its ticks are the nodes
`opN (Costed.tick c)`. -/
def toFreeMT (x : QInstrT A α B) : FreeM (Sig A) α :=
  ProgECost.toFreeM x.toTree

/-- The step-prefixed costed instrument `(c, x)` as a tree of `Sig A`: the tick `c` followed by
the tick tree of `x`. -/
def stepToFreeMT (x : ℕ × QInstrT A α B) : FreeM (Sig A) α :=
  ProgECost.toFreeM (ProgE.opN (Costed.tick x.1) fun _ => x.2.toTree)

/-- The time bound of a costed computation with the trivial invariant is the bound `n` on the
worst-case charge fold of its tree. -/
theorem bound_true_iff_wpFold_charge (p : QTreeT A α) (n : ℕ) :
    ProgE.Bound Costed.weight p n (fun _ => True) ↔
      FreeM.wpFold (OpSpec.charge fun a => ((tickCost a : ℕ) : ℕ∞)) (ProgECost.toFreeM p)
        (fun _ => 0) ≤ n :=
  (ProgECost.bound_iff_cost _ _ _ _).trans (and_iff_left (wpFold_demonic_true _))

/-- The time bound of a costed instrument is the bound `n` on the worst-case charge fold of its
tick tree. -/
theorem timeBound_iff_wpFold_charge (x : QInstrT A α B) (n : ℕ) :
    ProgE.Bound Costed.weight x.toTree n (fun _ => True) ↔
      FreeM.wpFold (OpSpec.charge fun a => ((tickCost a : ℕ) : ℕ∞)) (toFreeMT x)
        (fun _ => 0) ≤ n :=
  bound_true_iff_wpFold_charge _ _

/-- The time bound of a costed instrument is the subtractive roll bound with charge `tickCost`
on its tick tree. -/
theorem timeBound_iff_isRollBound (x : QInstrT A α B) (n : ℕ) :
    ProgE.Bound Costed.weight x.toTree n (fun _ => True) ↔
      (toFreeMT x).IsRollBound n (fun a b => tickCost a ≤ b) (fun a b => b - tickCost a) := by
  rw [timeBound_iff_wpFold_charge, FreeM.isRollBound_iff_wpFold_charge]

/-- The step time bound of a step-prefixed costed instrument is the time bound of its costed
computation behind the tick of its step cost. -/
theorem stepTimeBound_iff_bound (x : ℕ × QInstrT A α B) (n : ℕ) :
    StepTimeBound x n ↔
      ProgE.Bound Costed.weight (ProgE.opN (Costed.tick x.1) fun _ => x.2.toTree) n
        (fun _ => True) := by
  simp [StepTimeBound, ProgE.Bound, Costed.weight]

/-- The step time bound of a step-prefixed costed instrument is the bound `n` on the worst-case
charge fold of its tick tree. -/
theorem stepTimeBound_iff_wpFold_charge (x : ℕ × QInstrT A α B) (n : ℕ) :
    StepTimeBound x n ↔
      FreeM.wpFold (OpSpec.charge fun a => ((tickCost a : ℕ) : ℕ∞)) (stepToFreeMT x)
        (fun _ => 0) ≤ n :=
  (stepTimeBound_iff_bound x n).trans (bound_true_iff_wpFold_charge _ _)

/-- The step time bound of a step-prefixed costed instrument is the subtractive roll bound with
charge `tickCost` on its tick tree. -/
theorem stepTimeBound_iff_isRollBound (x : ℕ × QInstrT A α B) (n : ℕ) :
    StepTimeBound x n ↔
      (stepToFreeMT x).IsRollBound n (fun a b => tickCost a ≤ b)
        (fun a b => b - tickCost a) := by
  rw [stepTimeBound_iff_wpFold_charge, FreeM.isRollBound_iff_wpFold_charge]

end CatCrypt.Quantum.ReactiveUC.QInstrT
