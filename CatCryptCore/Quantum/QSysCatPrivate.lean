module

public import CatCryptCore.Quantum.QSysCatTensor

/-!
# Quantum reactive systems with private registers

In `QSysCat R` (`CatCryptCore.Quantum.QSysCat`) every quantum reactive system acts on the shared
register `R`. This module gives each morphism its own private register. A morphism from the
ports `X` to the ports `Y` is a quantum reactive system `QRSys K τ X.P Y.P` on a finite private
register `K` of its own, finite and nonempty (`PObj`), modulo the equivalence relation
generated by placing the system in a register `K'` along an equivalence `K × N ≃ K'`, for a
nonempty finite register `N`, followed by a step map (`PObj.PrivEq`). With `N` the one-point
register this is relabelling; with an equivalence the identity it is register extension, which
relates systems on registers of different sizes. The register `N` is nonempty: extension by the
empty register would identify all systems with the same ports.

* The cascade of systems on the registers `K₁` and `K₂` runs on `K₁ × K₂`, each system framed by
  the identity on the register of the other (`QRSys.frameR`, `QRSys.frameL`); the identity is
  the forwarding system on the one-point register.
* The parallel composition `⊕` sums the ports and multiplies the registers (`QRSys.parFramed`);
  its unit is `Empty`.
* The paired activation `⊗` multiplies the ports and the registers: on the event `(e, e')` the
  first system runs on `e` and then the second on `e'` (`QRSys.both`); its unit is `Unit`. Its
  interchange law and its symmetry use that operations on different factors of a register
  commute (`OpenSystem.frame_bind_frameLeft_comm`).
* A system on `K` placed in a register `B` along a decomposition `K × C ≃ B` is `QRSys.place`;
  framing and relabelling act on placements by composing the decompositions.

`⊕` and `⊗` are the additive and multiplicative structures of a rig category of quantum
reactive systems. The distributor and the annihilator are stateless systems on the one-point
register. The distributor is natural in the two summands; it is not natural in the factor
`X` of `X ⊗ (Y ⊕ Z)`, since a morphism on `X` with internal state is used once on the left and
duplicated into two independent copies on the right. The annihilator is natural: by register
extension any two systems with no events are equivalent, so a port type with no events is
initial.

## Main definitions

* `QRSys.place`, `QRSys.extL`, `QRSys.extR`, `QRSys.both`, `QRSys.Commute`.
* `PObj E O`: a quantum reactive system with a private register; `PObj.PrivEq`, `PObj.extend`.
* `PObj.comp`, `PObj.sum`, `PObj.prod`, `PObj.ofFun`.
* `QSysPriv`, with `Category`, `MonoidalCategory` and `SymmetricCategory` instances for `⊕`.
* `QSysPrivMul`, the same category with `MonoidalCategory` and `SymmetricCategory` instances for
  `⊗`.
* `QSysPriv.distrib`, `QSysPriv.annihilator`.

## Main results

* `PObj.privEq_extend`: a system is equivalent to its extension by a nonempty finite register.
* `PObj.privEq_of_isEmpty`: two systems with no events are equivalent.
* `PObj.PrivEq.comp`, `PObj.PrivEq.sum`, `PObj.PrivEq.prod`: congruence.
* `PObj.id_comp`, `PObj.comp_id`, `PObj.comp_assoc`: the category laws.
* `PObj.sum_comp`, `PObj.prod_comp`: interchange.
* `QSysPriv.sumMonoidal`, `QSysPriv.sumSymmetric`, `QSysPrivMul.monoidalCategory`,
  `QSysPrivMul.symmetricCategory`.
* `QSysPriv.distrib_naturality`: naturality of the distributor in the summands.
* `QSysPriv.hom_ext_of_isEmpty`, `QSysPriv.annihilator_naturality`: a port type with no events
  is initial, and the annihilator is natural.
-/

@[expose] public section

set_option autoImplicit false

namespace CatCrypt.Quantum.ReactiveUC

open _root_.Quantum

/-- The subinstrument `q` on the right factor of `L × N` is `q` framed by `L` and relabelled
along the exchange of the factors. -/
theorem frameLeft_eq_relabel {N α : Type} [Fintype N] (q : SubInstrument N N α) (L : Type)
    [Fintype L] : OpenSystem.frameLeft q L = relabel (Equiv.prodComm N L) (q.frame L) :=
  DSubInstrument.ext <| funext fun _ => LinearMap.ext fun _ => rfl

namespace QRSys

variable {K C C' B B' : Type} [Fintype K] [Fintype C] [Fintype C'] [Fintype B] [Fintype B']
variable {τ τ' υ ρ E O P Q E' O' P' E'' : Type}

attribute [local simp] SubInstrument.bind_assoc SubInstrument.pure_bind

/-- The system `S` on the register `K` placed in the register `B` along a decomposition
`K × C ≃ B`: each step is framed by the identity on `C` and relabelled along the
decomposition. -/
noncomputable def place (e : K × C ≃ B) (S : QRSys K τ E O) : QRSys B τ E O :=
  (S.frameR C).relabel e

/-- Unfolding lemma of `place`: a step. -/
theorem place_step (e : K × C ≃ B) (S : QRSys K τ E O) (t : τ) (ev : E) :
    (S.place e).step t ev = ReactiveUC.relabel e ((S.step t ev).frame C) :=
  rfl

/-- Two placements of a system agree when the decompositions agree up to an equivalence of the
complements. -/
theorem place_congr (S : QRSys K τ E O) (e₁ : K × C ≃ B) (e₂ : K × C' ≃ B) (f : C ≃ C')
    (h : ∀ k c, e₂ (k, f c) = e₁ (k, c)) : S.place e₁ = S.place e₂ :=
  ext_step rfl fun _ _ => relabel_frame_eq _ e₁ e₂ f h

/-- Framing on the right is placement along the identity. -/
theorem frameR_eq_place (S : QRSys K τ E O) (N : Type) [Fintype N] :
    S.frameR N = S.place (Equiv.refl (K × N)) :=
  (relabel_refl _).symm

/-- Framing on the left is placement along the exchange of the factors. -/
theorem frameL_eq_place (S : QRSys K τ E O) (M : Type) [Fintype M] :
    S.frameL M = S.place (Equiv.prodComm K M) :=
  ext_step rfl fun _ _ => frameLeft_eq_relabel _ _

/-- Relabelling a placed system is placement along the composite decomposition. -/
theorem relabel_place (e : K × C ≃ B) (e' : B ≃ B') (S : QRSys K τ E O) :
    (S.place e).relabel e' = S.place (e.trans e') :=
  ext_step rfl fun _ _ => ReactiveUC.relabel_relabel _ _ _

/-- Placement along the one-point complement is the system itself. -/
theorem place_unit (S : QRSys K τ E O) (e : K × Unit ≃ K) (he : ∀ k, e (k, ()) = k) :
    S.place e = S :=
  ext_step rfl fun _ _ => by
    rw [place_step, frame_unit, ReactiveUC.relabel_relabel, relabel_of_forall_eq _ fun k => he k]

/-- Framing a placed system on the right is placement along the extended decomposition. -/
theorem frameR_place (e : K × C ≃ B) (S : QRSys K τ E O) (N : Type) [Fintype N] :
    (S.place e).frameR N =
      S.place ((Equiv.prodAssoc K C N).symm.trans (e.prodCongr (Equiv.refl N))) :=
  ext_step rfl fun _ _ => DSubInstrument.ext <| funext fun _ => LinearMap.ext fun _ => rfl

/-- Framing a placed system on the left is placement along the extended decomposition. -/
theorem frameL_place (e : K × C ≃ B) (S : QRSys K τ E O) (M : Type) [Fintype M] :
    (S.place e).frameL M = S.place ((Equiv.prodAssoc K C M).symm.trans
      ((e.prodCongr (Equiv.refl M)).trans (Equiv.prodComm B M))) :=
  ext_step rfl fun _ _ => DSubInstrument.ext <| funext fun _ => LinearMap.ext fun _ => rfl

/-- Placement preserves stateless systems. -/
theorem place_ofFun (e : K × C ≃ B) (f : E → O) : (ofFun f : QRSys K Unit E O).place e = ofFun f :=
  by rw [place, frameR_ofFun, relabel_ofFun]

/-- Placement commutes with the cascade. -/
theorem place_seq (e : K × C ≃ B) (S : QRSys K τ E O) (T : QRSys K υ O P) :
    (S.seq T).place e = (S.place e).seq (T.place e) := by
  rw [place, frameR_seq, relabel_seq]
  rfl

/-- Placement preserves the parallel composition. -/
theorem place_par (e : K × C ≃ B) (S : QRSys K τ E O) (T : QRSys K υ E' O') :
    (S.par T).place e = (S.place e).par (T.place e) := by
  rw [place, frameR_par, relabel_par]
  rfl

/-- A step map gives a step map of the placed systems. -/
theorem StepMap.place (e : K × C ≃ B) {S : QRSys K τ E O} {S' : QRSys K τ' E O} {f : τ → τ'}
    (h : StepMap S S' f) : StepMap (S.place e) (S'.place e) f :=
  h.frameR.relabel e

/-- Relabelling is placement along the one-point complement. -/
theorem relabel_eq_place (e : K ≃ B) (S : QRSys K τ E O) :
    S.relabel e = S.place ((Equiv.prodPUnit K).trans e) := by
  rw [← relabel_place, place_unit _ _ fun _ => rfl]

/-- Placing a placed system is placement along the composite decomposition. -/
theorem place_place (e : K × C ≃ B) (e' : B × C' ≃ B') (S : QRSys K τ E O) :
    (S.place e).place e' =
      S.place ((Equiv.prodAssoc K C C').symm.trans ((e.prodCongr (Equiv.refl C')).trans e')) := by
  change ((S.place e).frameR C').relabel e' = _
  rw [frameR_place, relabel_place]
  rfl

/-- The decomposition `(K × C) × N ≃ K' × C` that extends the left factor `K` along
`e : K × N ≃ K'`. -/
def extL {K' N : Type} (e : K × N ≃ K') (C : Type) : (K × C) × N ≃ K' × C :=
  (Equiv.prodAssoc K C N).trans (((Equiv.refl K).prodCongr (Equiv.prodComm C N)).trans
    ((Equiv.prodAssoc K N C).symm.trans (e.prodCongr (Equiv.refl C))))

/-- The decomposition `(C × K) × N ≃ C × K'` that extends the right factor `K` along
`e : K × N ≃ K'`. -/
def extR {K' N : Type} (e : K × N ≃ K') (C : Type) : (C × K) × N ≃ C × K' :=
  (Equiv.prodAssoc C K N).trans ((Equiv.refl C).prodCongr e)

section Ext

variable {K' N : Type} [Fintype K'] [Fintype N]

/-- Extending the left factor of a system framed on the right is extending the system. -/
theorem frameR_place_extL (e : K × N ≃ K') (S : QRSys K τ E O) :
    (S.frameR C).place (extL e C) = (S.place e).frameR C := by
  rw [frameR_eq_place, place_place, frameR_place]
  exact place_congr _ _ _ (Equiv.prodComm C N) fun _ _ => rfl

/-- Extending the left factor leaves a system framed on the left in place. -/
theorem frameL_place_extL (e : K × N ≃ K') (S : QRSys C τ E O) :
    (S.frameL K).place (extL e C) = S.frameL K' := by
  rw [frameL_eq_place, frameL_eq_place, place_place]
  exact place_congr _ _ _ e fun _ _ => rfl

/-- Extending the right factor leaves a system framed on the right in place. -/
theorem frameR_place_extR (e : K × N ≃ K') (S : QRSys C τ E O) :
    (S.frameR K).place (extR e C) = S.frameR K' := by
  rw [frameR_eq_place, frameR_eq_place, place_place]
  exact place_congr _ _ _ e fun _ _ => rfl

/-- Extending the right factor of a system framed on the left is extending the system. -/
theorem frameL_place_extR (e : K × N ≃ K') (S : QRSys K τ E O) :
    (S.frameL C).place (extR e C) = (S.place e).frameL C := by
  rw [frameL_eq_place, place_place, frameL_place]
  exact place_congr _ _ _ (Equiv.prodComm C N) fun _ _ => rfl

end Ext

/-! ## Commuting systems and the paired activation -/

section Both

variable {R M N : Type} [Fintype R] [Fintype M] [Fintype N] {τ₁ τ₂ υ₁ υ₂ γ : Type}

/-- The systems `S` and `T` on the same register commute: a step of `S` followed by a step of
`T` is the step of `T` followed by the step of `S`, both outcomes kept. -/
def Commute (S : QRSys R τ E O) (T : QRSys R υ E' O') : Prop :=
  ∀ t e u e', ((S.step t e).bind fun p => (T.step u e').bind fun q => SubInstrument.pure (p, q)) =
    (T.step u e').bind fun q => (S.step t e).bind fun p => SubInstrument.pure (p, q)

/-- Commuting systems commute under every continuation. -/
theorem Commute.bind_comm {S : QRSys R τ E O} {T : QRSys R υ E' O'} (h : Commute S T)
    (t : τ) (e : E) (u : υ) (e' : E') (k : τ × O → υ × O' → SubInstrument R R γ) :
    ((S.step t e).bind fun p => (T.step u e').bind fun q => k p q) =
      (T.step u e').bind fun q => (S.step t e).bind fun p => k p q := by
  have := congrArg (fun X => X.bind fun pq => k pq.1 pq.2) (h t e u e')
  simpa only [SubInstrument.bind_assoc, SubInstrument.pure_bind] using this

/-- Commutation is symmetric. -/
theorem Commute.symm {S : QRSys R τ E O} {T : QRSys R υ E' O'} (h : Commute S T) :
    Commute T S := fun t e u e' => by
  rw [h.bind_comm u e' t e fun q p => SubInstrument.pure (p, q)]

/-- A system on the left factor of a register commutes with a system on the right factor. -/
theorem commute_frameR_frameL (S : QRSys M τ E O) (T : QRSys N υ E' O') :
    Commute (S.frameR N) (T.frameL M) := fun _ _ _ _ =>
  OpenSystem.frame_bind_frameLeft_comm _ _

/-- Framing on the left preserves commutation. -/
theorem Commute.frameL {S : QRSys N τ E O} {T : QRSys N υ E' O'} (h : Commute S T) :
    Commute (S.frameL M) (T.frameL M) := fun t e u e' => by
  have := congrArg (fun X => OpenSystem.frameLeft X M) (h t e u e')
  simp only [OpenSystem.frameLeft_bind, OpenSystem.frameLeft_pure] at this
  exact this

/-- The paired activation of `S` and `T` on the same register: the event `(e, e')` runs a step
of `S` on `e` and then a step of `T` on `e'`, and the output pairs the two outputs. -/
noncomputable def both (S : QRSys R τ E O) (T : QRSys R υ E' O') :
    QRSys R (τ × υ) (E × E') (O × O') where
  init := (S.init, T.init)
  step s e := (S.step s.1 e.1).bind fun p => (T.step s.2 e.2).bind fun q =>
    SubInstrument.pure ((p.1, q.1), (p.2, q.2))

/-- Unfolding lemma of `both`: a step. -/
theorem both_step (S : QRSys R τ E O) (T : QRSys R υ E' O') (s : τ × υ) (e : E × E') :
    (S.both T).step s e = (S.step s.1 e.1).bind fun p => (T.step s.2 e.2).bind fun q =>
      SubInstrument.pure ((p.1, q.1), (p.2, q.2)) :=
  rfl

/-- Framing on the right commutes with the paired activation. -/
theorem frameR_both (S : QRSys M τ E O) (T : QRSys M υ E' O') :
    (S.both T).frameR N = (S.frameR N).both (T.frameR N) :=
  ext_step rfl fun _ _ => by
    simp only [frameR, both_step, SubInstrument.frame_bind, SubInstrument.frame_pure]

/-- Framing on the left commutes with the paired activation. -/
theorem frameL_both (S : QRSys N τ E O) (T : QRSys N υ E' O') :
    (S.both T).frameL M = (S.frameL M).both (T.frameL M) :=
  ext_step rfl fun _ _ => by
    simp only [frameL, both_step, OpenSystem.frameLeft_bind, OpenSystem.frameLeft_pure]

/-- Relabelling commutes with the paired activation. -/
theorem relabel_both (e : R ≃ B) (S : QRSys R τ E O) (T : QRSys R υ E' O') :
    (S.both T).relabel e = (S.relabel e).both (T.relabel e) :=
  ext_step rfl fun _ _ => by
    simp only [relabel_step, both_step, ReactiveUC.relabel_bind, ReactiveUC.relabel_pure]

/-- Placement commutes with the paired activation. -/
theorem place_both {C : Type} [Fintype C] (e : R × C ≃ B) (S : QRSys R τ E O)
    (T : QRSys R υ E' O') : (S.both T).place e = (S.place e).both (T.place e) := by
  rw [place, frameR_both, relabel_both]
  rfl

/-- Step maps of the two components give a step map of the paired activation. -/
theorem StepMap.both {S : QRSys R τ E O} {S' : QRSys R τ' E O} {T : QRSys R υ E' O'}
    {T' : QRSys R υ₁ E' O'} {f : τ → τ'} {g : υ → υ₁} (hS : StepMap S S' f)
    (hT : StepMap T T' g) : StepMap (S.both T) (S'.both T') (Prod.map f g) where
  init_map := by
    change (f S.init, g T.init) = (S'.init, T'.init)
    rw [hS.init_map, hT.init_map]
  step s e := by
    simp only [both_step, ← hS.step, ← hT.step,
      SubInstrument.bind_assoc, SubInstrument.pure_bind, Prod.map]

/-- The paired activation of two stateless systems is the stateless system of the product of
the functions. -/
theorem StepMap.ofFun_both (f : E → O) (g : E' → O') :
    StepMap ((ofFun f : QRSys R Unit E O).both (ofFun g)) (ofFun (Prod.map f g)) (fun _ => ()) :=
  ⟨rfl, fun _ _ => by simp [both_step, Prod.map]⟩

/-- **Interchange.** The paired activation of two cascades is the cascade of the paired
activations when the second system of the first cascade commutes with the first system of the
second cascade. -/
theorem StepMap.both_seq (S₁ : QRSys R τ₁ E O) (T₁ : QRSys R υ₁ O P) (S₂ : QRSys R τ₂ E' O')
    (T₂ : QRSys R υ₂ O' P') (h : Commute T₁ S₂) :
    StepMap ((S₁.seq T₁).both (S₂.seq T₂)) ((S₁.both S₂).seq (T₁.both T₂))
      (fun s => ((s.1.1, s.2.1), (s.1.2, s.2.2))) := by
  refine ⟨rfl, fun s e => ?_⟩
  simp only [seq_step, both_step, SubInstrument.bind_assoc, SubInstrument.pure_bind]
  congr 1
  funext a
  exact h.bind_comm _ _ _ _ _

/-- **Naturality of the associator** of the paired activation. -/
theorem StepMap.both_assoc_seq (S : QRSys R τ E O) (T : QRSys R υ E' O')
    (V : QRSys R ρ E'' P) :
    StepMap (((S.both T).both V).seq (ofFun (Equiv.prodAssoc O O' P)))
      ((ofFun (Equiv.prodAssoc E E' E'')).seq (S.both (T.both V)))
      (fun s => ((), (s.1.1.1, (s.1.1.2, s.1.2)))) :=
  ⟨rfl, fun s e => by simp [seq_step, both_step]⟩

/-- **Naturality of the left unitor** of the paired activation. -/
theorem StepMap.unit_both_seq (S : QRSys R τ E O) :
    StepMap (((ofFun (id : Unit → Unit)).both S).seq (ofFun (Equiv.punitProd O)))
      ((ofFun (Equiv.punitProd E)).seq S) (fun s => ((), s.1.2)) :=
  ⟨rfl, fun s e => by simp [seq_step, both_step]⟩

/-- **Naturality of the right unitor** of the paired activation. -/
theorem StepMap.both_unit_seq (S : QRSys R τ E O) :
    StepMap ((S.both (ofFun (id : Unit → Unit))).seq (ofFun (Equiv.prodPUnit O)))
      ((ofFun (Equiv.prodPUnit E)).seq S) (fun s => ((), s.1.1)) :=
  ⟨rfl, fun s e => by simp [seq_step, both_step]⟩

/-- **Naturality of the symmetry** of the paired activation of commuting systems. -/
theorem StepMap.both_swap_seq (S : QRSys R τ E O) (T : QRSys R υ E' O') (h : Commute S T) :
    StepMap ((S.both T).seq (ofFun (Equiv.prodComm O O')))
      ((ofFun (Equiv.prodComm E E')).seq (T.both S)) (fun s => ((), (s.1.2, s.1.1))) := by
  refine ⟨rfl, fun s e => ?_⟩
  simp only [seq_step, both_step, ofFun_step, SubInstrument.bind_assoc, SubInstrument.pure_bind]
  exact h.bind_comm _ _ _ _ _

/-- **Naturality of the distributor** in the summands: pairing the forwarding system with the
parallel composition of `S` and `T` and distributing is distributing and then pairing the
forwarding system with each summand. -/
theorem StepMap.both_par_distrib_seq {X : Type} (S : QRSys R τ E O) (T : QRSys R υ E' O') :
    StepMap (((ofFun (id : X → X)).both (S.par T)).seq (ofFun (Equiv.prodSumDistrib X O O')))
      ((ofFun (Equiv.prodSumDistrib X E E')).seq
        (((ofFun (id : X → X)).both S).par ((ofFun (id : X → X)).both T)))
      (fun s => ((), (((), s.1.2.1), ((), s.1.2.2)))) :=
  ⟨rfl, fun s e => by rcases e with ⟨x, e | e⟩ <;> simp [seq_step, both_step]⟩

end Both

end QRSys

/-! ## Systems with a private register -/

/-- A quantum reactive system with events `E` and outputs `O` on its own private register `K`,
with its classical state type bundled. -/
structure PObj (E O : Type) : Type 1 where
  /-- The private register. -/
  K : Type
  /-- The private register is finite. -/
  [fintypeK : Fintype K]
  /-- The private register is nonempty. -/
  [nonemptyK : Nonempty K]
  /-- The state type. -/
  St : Type
  /-- The system. -/
  sys : QRSys K St E O

attribute [instance] PObj.fintypeK PObj.nonemptyK

namespace PObj

open QRSys

variable {E O P Q E' O' P' Q' E'' O'' : Type}

/-- `A` is related to `B` by an extension of the private register by a nonempty finite register
`N`, a relabelling `A.K × N ≃ B.K`, and a step map. -/
def Rel (A B : PObj E O) : Prop :=
  ∃ (N : Type) (_ : Fintype N) (_ : Nonempty N) (e : A.K × N ≃ B.K) (f : A.St → B.St),
    StepMap (A.sys.place e) B.sys f

/-- Equivalence of systems with private registers: the equivalence relation generated by
extensions and relabellings of the private register followed by step maps. -/
def PrivEq : PObj E O → PObj E O → Prop :=
  Relation.EqvGen Rel

/-- A placement of `A` in the private register of `B` along `A.K × N ≃ B.K`, for a nonempty
finite register `N`, that brings `A` to a system with a step map to `B` gives the equivalence of
`A` and `B`. -/
theorem privEq_of_place {A B : PObj E O} (N : Type) [Fintype N] [Nonempty N]
    (e : A.K × N ≃ B.K) {X : QRSys B.K A.St E O} {Y : QRSys B.K B.St E O} {f : A.St → B.St}
    (hA : A.sys.place e = X) (hB : B.sys = Y) (h : StepMap X Y f) : PrivEq A B :=
  Relation.EqvGen.rel _ _ ⟨N, inferInstance, inferInstance, e, f, by rw [hA, hB]; exact h⟩

/-- A relabelling of the private register that brings `A` to a system with a step map to `B`
gives the equivalence of `A` and `B`. -/
theorem privEq_of {A B : PObj E O} (e : A.K ≃ B.K) {X : QRSys B.K A.St E O}
    {Y : QRSys B.K B.St E O} {f : A.St → B.St} (hA : A.sys.relabel e = X) (hB : B.sys = Y)
    (h : StepMap X Y f) : PrivEq A B :=
  privEq_of_place Unit ((Equiv.prodPUnit A.K).trans e) (by rw [← relabel_eq_place, hA]) hB h

/-- The system `A` with its private register extended by the register `N`. -/
noncomputable abbrev extend (A : PObj E O) (N : Type) [Fintype N] [Nonempty N] : PObj E O where
  K := A.K × N
  St := A.St
  sys := A.sys.frameR N

/-- **Register extension.** A system is equivalent to the system with its private register
extended by a nonempty finite register. -/
theorem privEq_extend (A : PObj E O) (N : Type) [Fintype N] [Nonempty N] :
    PrivEq A (A.extend N) :=
  privEq_of_place N (Equiv.refl _) (frameR_eq_place A.sys N).symm rfl (StepMap.refl _)

/-- Two systems with no events are equivalent. -/
theorem privEq_of_isEmpty [IsEmpty E] (A B : PObj E O) : PrivEq A B :=
  Relation.EqvGen.trans _ _ _ (privEq_extend A B.K) <| Relation.EqvGen.symm _ _ <|
    privEq_of_place A.K (Equiv.prodComm B.K A.K) (f := fun _ => A.sys.init) rfl rfl
      ⟨rfl, fun _ e => isEmptyElim e⟩

/-- A map of systems that sends related systems to equivalent ones preserves equivalence. -/
theorem PrivEq.map {E₂ O₂ : Type} (F : PObj E O → PObj E₂ O₂)
    (hF : ∀ A B, Rel A B → PrivEq (F A) (F B)) {A B : PObj E O} (h : PrivEq A B) :
    PrivEq (F A) (F B) := by
  induction h with
  | rel A B h => exact hF A B h
  | refl A => exact Relation.EqvGen.refl _
  | symm A B _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans A B C _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- The stateless system of a function, on the one-point register. -/
noncomputable abbrev ofFun (f : E → O) : PObj E O where
  K := Unit
  St := Unit
  sys := QRSys.ofFun f

/-- The cascade: the private register is the product of the private registers. -/
noncomputable abbrev comp (A : PObj E O) (B : PObj O P) : PObj E P where
  K := A.K × B.K
  St := A.St × B.St
  sys := (A.sys.frameR B.K).seq (B.sys.frameL A.K)

/-- The parallel composition on summed ports: the private register is the product of the
private registers. -/
noncomputable abbrev sum (A : PObj E O) (B : PObj E' O') : PObj (E ⊕ E') (O ⊕ O') where
  K := A.K × B.K
  St := A.St × B.St
  sys := A.sys.parFramed B.sys

/-- The paired activation on multiplied ports: the private register is the product of the
private registers. -/
noncomputable abbrev prod (A : PObj E O) (B : PObj E' O') : PObj (E × E') (O × O') where
  K := A.K × B.K
  St := A.St × B.St
  sys := (A.sys.frameR B.K).both (B.sys.frameL A.K)

/-! ### Laws of the cascade -/

/-- The cascade with the identity on the left. -/
theorem id_comp (A : PObj E O) : PrivEq ((ofFun id).comp A) A :=
  privEq_of (Equiv.punitProd A.K) (X := (QRSys.ofFun id).seq A.sys) (by
    rw [relabel_seq, frameR_ofFun, relabel_ofFun, frameL_eq_place, relabel_place,
      place_unit _ _ fun _ => rfl]) rfl (StepMap.id_seq A.sys)

/-- The cascade with the identity on the right. -/
theorem comp_id (A : PObj E O) : PrivEq (A.comp (ofFun id)) A :=
  privEq_of (Equiv.prodPUnit A.K) (X := A.sys.seq (QRSys.ofFun id)) (by
    rw [relabel_seq, frameL_ofFun, relabel_ofFun, frameR_eq_place, relabel_place,
      place_unit _ _ fun _ => rfl]) rfl (StepMap.seq_id A.sys)

/-- Associativity of the cascade. -/
theorem comp_assoc (A : PObj E O) (B : PObj O P) (C : PObj P Q) :
    PrivEq ((A.comp B).comp C) (A.comp (B.comp C)) :=
  privEq_of (Equiv.prodAssoc A.K B.K C.K)
    (X := ((A.sys.frameR (B.K × C.K)).seq ((B.sys.frameR C.K).frameL A.K)).seq
      ((C.sys.frameL B.K).frameL A.K))
    (by
      dsimp only
      rw [frameR_seq, relabel_seq, relabel_seq]
      congr 2)
    (by dsimp only; rw [frameL_seq]) (StepMap.seq_assoc _ _ _)

/-! ### Congruence -/

/-- Relabelling the register of the left factor of a product along `e` and framing on the left
is framing on the left by the relabelled register. -/
theorem relabel_frameL_prodCongr {K M M' τ : Type} [Fintype K] [Fintype M] [Fintype M']
    (e : M ≃ M') (S : QRSys K τ E O) :
    (S.frameL M).relabel (e.prodCongr (Equiv.refl K)) = S.frameL M' := by
  rw [frameL_eq_place, frameL_eq_place, relabel_place]
  exact place_congr _ _ _ e fun _ _ => rfl

/-- Relabelling the register of the right factor of a product along `e` and framing on the
right is framing on the right by the relabelled register. -/
theorem relabel_frameR_prodCongr {K N N' τ : Type} [Fintype K] [Fintype N] [Fintype N']
    (e : N ≃ N') (S : QRSys K τ E O) :
    (S.frameR N).relabel ((Equiv.refl K).prodCongr e) = S.frameR N' := by
  rw [frameR_eq_place, frameR_eq_place, relabel_place]
  exact place_congr _ _ _ e fun _ _ => rfl

/-- The cascade respects relatedness of the first system. -/
theorem comp_left {A A' : PObj E O} (B : PObj O P) (h : Rel A A') :
    PrivEq (A.comp B) (A'.comp B) := by
  obtain ⟨N, _, _, e, f, h⟩ := h
  exact privEq_of_place N (extL e B.K)
    (by dsimp only; rw [place_seq, frameR_place_extL, frameL_place_extL]) rfl
    (h.frameR.seq (StepMap.refl _))

/-- The cascade respects relatedness of the second system. -/
theorem comp_right (A : PObj E O) {B B' : PObj O P} (h : Rel B B') :
    PrivEq (A.comp B) (A.comp B') := by
  obtain ⟨N, _, _, e, f, h⟩ := h
  exact privEq_of_place N (extR e A.K)
    (by dsimp only; rw [place_seq, frameR_place_extR, frameL_place_extR]) rfl
    ((StepMap.refl _).seq h.frameL)

/-- The parallel composition respects relatedness of the first system. -/
theorem sum_left {A A' : PObj E O} (B : PObj E' O') (h : Rel A A') :
    PrivEq (A.sum B) (A'.sum B) := by
  obtain ⟨N, _, _, e, f, h⟩ := h
  exact privEq_of_place N (extL e B.K)
    (by dsimp only; rw [parFramed, place_par, frameR_place_extL, frameL_place_extL]) rfl
    (h.frameR.par (StepMap.refl _))

/-- The parallel composition respects relatedness of the second system. -/
theorem sum_right (A : PObj E O) {B B' : PObj E' O'} (h : Rel B B') :
    PrivEq (A.sum B) (A.sum B') := by
  obtain ⟨N, _, _, e, f, h⟩ := h
  exact privEq_of_place N (extR e A.K)
    (by dsimp only; rw [parFramed, place_par, frameR_place_extR, frameL_place_extR]) rfl
    ((StepMap.refl _).par h.frameL)

/-- The paired activation respects relatedness of the first system. -/
theorem prod_left {A A' : PObj E O} (B : PObj E' O') (h : Rel A A') :
    PrivEq (A.prod B) (A'.prod B) := by
  obtain ⟨N, _, _, e, f, h⟩ := h
  exact privEq_of_place N (extL e B.K)
    (by dsimp only; rw [place_both, frameR_place_extL, frameL_place_extL]) rfl
    (h.frameR.both (StepMap.refl _))

/-- The paired activation respects relatedness of the second system. -/
theorem prod_right (A : PObj E O) {B B' : PObj E' O'} (h : Rel B B') :
    PrivEq (A.prod B) (A.prod B') := by
  obtain ⟨N, _, _, e, f, h⟩ := h
  exact privEq_of_place N (extR e A.K)
    (by dsimp only; rw [place_both, frameR_place_extR, frameL_place_extR]) rfl
    ((StepMap.refl _).both h.frameL)

/-- Equivalence is a congruence for the cascade. -/
theorem PrivEq.comp {A A' : PObj E O} {B B' : PObj O P} (hA : PrivEq A A') (hB : PrivEq B B') :
    PrivEq (A.comp B) (A'.comp B') :=
  Relation.EqvGen.trans _ (A'.comp B) _ (PrivEq.map (·.comp B) (fun _ _ h => comp_left B h) hA)
    (PrivEq.map (A'.comp ·) (fun _ _ h => comp_right A' h) hB)

/-- Equivalence is a congruence for the parallel composition. -/
theorem PrivEq.sum {A A' : PObj E O} {B B' : PObj E' O'} (hA : PrivEq A A')
    (hB : PrivEq B B') : PrivEq (A.sum B) (A'.sum B') :=
  Relation.EqvGen.trans _ (A'.sum B) _ (PrivEq.map (·.sum B) (fun _ _ h => sum_left B h) hA)
    (PrivEq.map (A'.sum ·) (fun _ _ h => sum_right A' h) hB)

/-- Equivalence is a congruence for the paired activation. -/
theorem PrivEq.prod {A A' : PObj E O} {B B' : PObj E' O'} (hA : PrivEq A A')
    (hB : PrivEq B B') : PrivEq (A.prod B) (A'.prod B') :=
  Relation.EqvGen.trans _ (A'.prod B) _ (PrivEq.map (·.prod B) (fun _ _ h => prod_left B h) hA)
    (PrivEq.map (A'.prod ·) (fun _ _ h => prod_right A' h) hB)

/-! ### Stateless systems -/

/-- The cascade of stateless systems is the stateless system of the composite function. -/
theorem ofFun_comp (f : E → O) (g : O → P) :
    PrivEq ((ofFun f).comp (ofFun g)) (ofFun (g ∘ f)) :=
  privEq_of (Equiv.prodPUnit Unit) (by
    dsimp only
    rw [frameR_ofFun, frameL_ofFun, relabel_seq, relabel_ofFun, relabel_ofFun]) rfl
    (StepMap.ofFun_seq f g)

/-- The parallel composition of stateless systems is the stateless system of the sum of the
functions. -/
theorem ofFun_sum (f : E → O) (g : E' → O') :
    PrivEq ((ofFun f).sum (ofFun g)) (ofFun (Sum.map f g)) :=
  privEq_of (Equiv.prodPUnit Unit) (by
    dsimp only
    rw [parFramed, frameR_ofFun, frameL_ofFun, relabel_par, relabel_ofFun, relabel_ofFun]) rfl
    (StepMap.ofFun_par f g)

/-- The paired activation of stateless systems is the stateless system of the product of the
functions. -/
theorem ofFun_prod (f : E → O) (g : E' → O') :
    PrivEq ((ofFun f).prod (ofFun g)) (ofFun (Prod.map f g)) :=
  privEq_of (Equiv.prodPUnit Unit) (by
    dsimp only
    rw [frameR_ofFun, frameL_ofFun, relabel_both, relabel_ofFun, relabel_ofFun]) rfl
    (StepMap.ofFun_both f g)

/-! ### Laws of the parallel composition -/

/-- **Interchange** of the parallel composition with the cascade. -/
theorem sum_comp {E₁ O₁ P₁ E₂ O₂ P₂ : Type} (A₁ : PObj E₁ O₁) (B₁ : PObj O₁ P₁)
    (A₂ : PObj E₂ O₂) (B₂ : PObj O₂ P₂) :
    PrivEq ((A₁.comp B₁).sum (A₂.comp B₂)) ((A₁.sum A₂).comp (B₁.sum B₂)) :=
  privEq_of (Equiv.prodProdProdComm A₁.K B₁.K A₂.K B₂.K)
    (by
      dsimp only
      rw [parFramed, frameR_seq, frameL_seq, relabel_par, relabel_seq, relabel_seq]
      rfl)
    (by simp only [parFramed, frameR_par, frameL_par])
    (StepMap.seq_par ((A₁.sys.frameR A₂.K).frameR (B₁.K × B₂.K))
      ((B₁.sys.frameR B₂.K).frameL (A₁.K × A₂.K)) ((A₂.sys.frameL A₁.K).frameR (B₁.K × B₂.K))
      ((B₂.sys.frameL B₁.K).frameL (A₁.K × A₂.K)))

/-- **Naturality of the associator** of the parallel composition. -/
theorem sum_assoc_comp (A : PObj E O) (B : PObj E' O') (C : PObj E'' P) :
    PrivEq (((A.sum B).sum C).comp (ofFun (Equiv.sumAssoc O O' P)))
      ((ofFun (Equiv.sumAssoc E E' E'')).comp (A.sum (B.sum C))) :=
  privEq_of ((Equiv.prodPUnit _).trans ((Equiv.prodAssoc _ _ _).trans (Equiv.punitProd _).symm))
    (by
      simp only [parFramed, frameR_par, frameL_ofFun, relabel_seq, relabel_par, relabel_ofFun]
      rfl)
    (by simp only [parFramed, frameL_par, frameR_ofFun])
    (StepMap.par_assoc_seq ((A.sys.frameR (B.K × C.K)).frameL Unit)
      (((B.sys.frameR C.K).frameL A.K).frameL Unit) (((C.sys.frameL B.K).frameL A.K).frameL Unit))

/-- **Naturality of the left unitor** of the parallel composition. -/
theorem empty_sum_comp (A : PObj E O) :
    PrivEq (((ofFun (id : Empty → Empty)).sum A).comp (ofFun (Equiv.emptySum Empty O)))
      ((ofFun (Equiv.emptySum Empty E)).comp A) :=
  privEq_of (Equiv.prodPUnit _)
    (by
      simp only [parFramed, frameR_par, frameR_ofFun, frameL_ofFun, relabel_seq, relabel_par,
        relabel_ofFun]
      rfl)
    (by simp only [frameR_ofFun])
    (StepMap.empty_par_seq (A.sys.frameL Unit))

/-- **Naturality of the right unitor** of the parallel composition. -/
theorem sum_empty_comp (A : PObj E O) :
    PrivEq ((A.sum (ofFun (id : Empty → Empty))).comp (ofFun (Equiv.sumEmpty O Empty)))
      ((ofFun (Equiv.sumEmpty E Empty)).comp A) :=
  privEq_of ((Equiv.prodPUnit _).trans (Equiv.prodComm _ _))
    (by
      simp only [parFramed, frameR_par, frameR_ofFun, frameL_ofFun, relabel_seq, relabel_par,
        relabel_ofFun]
      rfl)
    (by simp only [frameR_ofFun])
    (StepMap.par_empty_seq (A.sys.frameL Unit))

/-- **Naturality of the symmetry** of the parallel composition. -/
theorem sum_swap_comp (A : PObj E O) (B : PObj E' O') :
    PrivEq ((A.sum B).comp (ofFun (Equiv.sumComm O O')))
      ((ofFun (Equiv.sumComm E E')).comp (B.sum A)) :=
  privEq_of ((Equiv.prodPUnit _).trans ((Equiv.prodComm _ _).trans (Equiv.punitProd _).symm))
    (by
      simp only [parFramed, frameR_par, frameL_ofFun, relabel_seq, relabel_par, relabel_ofFun]
      rfl)
    (by simp only [parFramed, frameL_par, frameR_ofFun])
    (StepMap.par_swap_seq ((A.sys.frameL B.K).frameL Unit) ((B.sys.frameR A.K).frameL Unit))

/-! ### Laws of the paired activation -/

/-- **Interchange** of the paired activation with the cascade. -/
theorem prod_comp {E₁ O₁ P₁ E₂ O₂ P₂ : Type} (A₁ : PObj E₁ O₁) (B₁ : PObj O₁ P₁)
    (A₂ : PObj E₂ O₂) (B₂ : PObj O₂ P₂) :
    PrivEq ((A₁.comp B₁).prod (A₂.comp B₂)) ((A₁.prod A₂).comp (B₁.prod B₂)) :=
  privEq_of (Equiv.prodProdProdComm A₁.K B₁.K A₂.K B₂.K)
    (by
      dsimp only
      rw [frameR_seq, frameL_seq, relabel_both, relabel_seq, relabel_seq]
      rfl)
    (by simp only [frameR_both, frameL_both])
    (StepMap.both_seq ((A₁.sys.frameR A₂.K).frameR (B₁.K × B₂.K))
      ((B₁.sys.frameR B₂.K).frameL (A₁.K × A₂.K)) ((A₂.sys.frameL A₁.K).frameR (B₁.K × B₂.K))
      ((B₂.sys.frameL B₁.K).frameL (A₁.K × A₂.K)) (commute_frameR_frameL _ _).symm)

/-- **Naturality of the associator** of the paired activation. -/
theorem prod_assoc_comp (A : PObj E O) (B : PObj E' O') (C : PObj E'' P) :
    PrivEq (((A.prod B).prod C).comp (ofFun (Equiv.prodAssoc O O' P)))
      ((ofFun (Equiv.prodAssoc E E' E'')).comp (A.prod (B.prod C))) :=
  privEq_of ((Equiv.prodPUnit _).trans ((Equiv.prodAssoc _ _ _).trans (Equiv.punitProd _).symm))
    (by
      simp only [frameR_both, frameL_ofFun, relabel_seq, relabel_both, relabel_ofFun]
      rfl)
    (by simp only [frameL_both, frameR_ofFun])
    (StepMap.both_assoc_seq ((A.sys.frameR (B.K × C.K)).frameL Unit)
      (((B.sys.frameR C.K).frameL A.K).frameL Unit) (((C.sys.frameL B.K).frameL A.K).frameL Unit))

/-- **Naturality of the left unitor** of the paired activation. -/
theorem unit_prod_comp (A : PObj E O) :
    PrivEq (((ofFun (id : Unit → Unit)).prod A).comp (ofFun (Equiv.punitProd O)))
      ((ofFun (Equiv.punitProd E)).comp A) :=
  privEq_of (Equiv.prodPUnit _)
    (by
      simp only [frameR_both, frameR_ofFun, frameL_ofFun, relabel_seq, relabel_both,
        relabel_ofFun]
      rfl)
    (by simp only [frameR_ofFun])
    (StepMap.unit_both_seq (A.sys.frameL Unit))

/-- **Naturality of the right unitor** of the paired activation. -/
theorem prod_unit_comp (A : PObj E O) :
    PrivEq ((A.prod (ofFun (id : Unit → Unit))).comp (ofFun (Equiv.prodPUnit O)))
      ((ofFun (Equiv.prodPUnit E)).comp A) :=
  privEq_of ((Equiv.prodPUnit _).trans (Equiv.prodComm _ _))
    (by
      simp only [frameR_both, frameR_ofFun, frameL_ofFun, relabel_seq, relabel_both,
        relabel_ofFun]
      rfl)
    (by simp only [frameR_ofFun])
    (StepMap.both_unit_seq (A.sys.frameL Unit))

/-- **Naturality of the symmetry** of the paired activation. -/
theorem prod_swap_comp (A : PObj E O) (B : PObj E' O') :
    PrivEq ((A.prod B).comp (ofFun (Equiv.prodComm O O')))
      ((ofFun (Equiv.prodComm E E')).comp (B.prod A)) :=
  privEq_of ((Equiv.prodPUnit _).trans ((Equiv.prodComm _ _).trans (Equiv.punitProd _).symm))
    (by
      simp only [frameR_both, frameL_ofFun, relabel_seq, relabel_both, relabel_ofFun]
      rfl)
    (by simp only [frameL_both, frameR_ofFun])
    (StepMap.both_swap_seq ((A.sys.frameL B.K).frameL Unit) ((B.sys.frameR A.K).frameL Unit)
      ((commute_frameR_frameL B.sys A.sys).symm.frameL))

/-! ### Distributivity -/

/-- The register equivalence that matches the distributed composite with the composite of the
distributor. -/
def distribReg (KB KC : Type) :
    (Unit × (KB × KC)) × Unit ≃ Unit × ((Unit × KB) × (Unit × KC)) where
  toFun x := ((), (((), x.1.2.1), ((), x.1.2.2)))
  invFun y := (((), (y.2.1.2, y.2.2.2)), ())
  left_inv _ := rfl
  right_inv _ := rfl

/-- **Naturality of the distributor** in the summands. -/
theorem prod_sum_distrib_comp {X : Type} (B : PObj E O) (C : PObj E' O') :
    PrivEq (((ofFun (id : X → X)).prod (B.sum C)).comp (ofFun (Equiv.prodSumDistrib X O O')))
      ((ofFun (Equiv.prodSumDistrib X E E')).comp
        (((ofFun (id : X → X)).prod B).sum ((ofFun (id : X → X)).prod C))) :=
  privEq_of (distribReg B.K C.K)
    (by
      simp only [parFramed, frameR_ofFun, frameL_ofFun, frameR_both, frameL_par, frameR_par,
        relabel_seq, relabel_both, relabel_par, relabel_ofFun]
      rfl)
    (by
      simp only [parFramed, frameR_ofFun, frameL_ofFun, frameR_both, frameL_both, frameL_par])
    (StepMap.both_par_distrib_seq (((B.sys.frameL Unit).frameR (Unit × C.K)).frameL Unit)
      (((C.sys.frameL Unit).frameL (Unit × B.K)).frameL Unit))

end PObj

/-- Equivalence of systems with private registers as a setoid. -/
instance PObj.setoid (E O : Type) : Setoid (PObj E O) :=
  ⟨PObj.PrivEq, Relation.EqvGen.is_equivalence _⟩

/-! ## The category -/

/-- A type of ports of quantum reactive systems with private registers. -/
structure QSysPriv : Type 1 where
  /-- The ports. -/
  P : Type

namespace QSysPriv

open CategoryTheory MonoidalCategory

/-- The category of port types: a morphism from `X` to `Y` is a quantum reactive system with
events `X.P`, outputs `Y.P` and its own private register, modulo relabelling of the register
and step equivalence; composition is the cascade on the product of the registers and the
identity is the forwarding system on the one-point register. -/
noncomputable instance category : Category.{1} QSysPriv where
  Hom X Y := Quotient (PObj.setoid X.P Y.P)
  id X := ⟦PObj.ofFun id⟧
  comp := Quotient.map₂ PObj.comp fun _ _ h₁ _ _ h₂ => PObj.PrivEq.comp h₁ h₂
  id_comp := by
    rintro X Y ⟨A⟩
    exact Quotient.sound (PObj.id_comp A)
  comp_id := by
    rintro X Y ⟨A⟩
    exact Quotient.sound (PObj.comp_id A)
  assoc := by
    rintro W X Y Z ⟨A⟩ ⟨B⟩ ⟨C⟩
    exact Quotient.sound (PObj.comp_assoc A B C)

/-- The morphism given by a function of ports: the class of the stateless system. -/
noncomputable def homOfFun {X Y : QSysPriv} (f : X.P → Y.P) : X ⟶ Y :=
  ⟦PObj.ofFun f⟧

/-- Unfolding lemma of the identity: the morphism of the identity function. -/
theorem id_eq_homOfFun (X : QSysPriv) : 𝟙 X = homOfFun id :=
  rfl

/-- Composition of morphisms given by functions is composition of the functions. -/
theorem homOfFun_comp {X Y Z : QSysPriv} (f : X.P → Y.P) (g : Y.P → Z.P) :
    homOfFun f ≫ homOfFun g = homOfFun (g ∘ f) :=
  Quotient.sound (PObj.ofFun_comp f g)

/-- The isomorphism of port types given by an equivalence of the ports. -/
noncomputable def isoOfEquiv {X Y : QSysPriv} (e : X.P ≃ Y.P) : X ≅ Y where
  hom := homOfFun e
  inv := homOfFun e.symm
  hom_inv_id := by
    rw [homOfFun_comp, e.symm_comp_self]
    rfl
  inv_hom_id := by
    rw [homOfFun_comp, e.self_comp_symm]
    rfl

/-- Unfolding lemma of `isoOfEquiv`: the forward morphism. -/
theorem isoOfEquiv_hom {X Y : QSysPriv} (e : X.P ≃ Y.P) : (isoOfEquiv e).hom = homOfFun e :=
  rfl

/-- Unfolding lemma of `isoOfEquiv`: the backward morphism. -/
theorem isoOfEquiv_inv {X Y : QSysPriv} (e : X.P ≃ Y.P) :
    (isoOfEquiv e).inv = homOfFun e.symm :=
  rfl

/-! ### The additive structure: the parallel composition -/

/-- The parallel composition of morphisms, on summed ports. -/
noncomputable def sumHom {X₁ Y₁ X₂ Y₂ : QSysPriv} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    (⟨X₁.P ⊕ X₂.P⟩ : QSysPriv) ⟶ ⟨Y₁.P ⊕ Y₂.P⟩ :=
  Quotient.map₂ PObj.sum (fun _ _ h₁ _ _ h₂ => PObj.PrivEq.sum h₁ h₂) f g

/-- **Interchange** of the parallel composition with composition. -/
theorem sumHom_comp {X₁ Y₁ Z₁ X₂ Y₂ Z₂ : QSysPriv} (f₁ : X₁ ⟶ Y₁) (f₂ : X₂ ⟶ Y₂)
    (g₁ : Y₁ ⟶ Z₁) (g₂ : Y₂ ⟶ Z₂) :
    sumHom f₁ f₂ ≫ sumHom g₁ g₂ = sumHom (f₁ ≫ g₁) (f₂ ≫ g₂) := by
  induction f₁ using Quotient.inductionOn
  induction f₂ using Quotient.inductionOn
  induction g₁ using Quotient.inductionOn
  induction g₂ using Quotient.inductionOn
  exact (Quotient.sound (PObj.sum_comp _ _ _ _)).symm

/-- The parallel composition of morphisms given by functions is given by the sum of the
functions. -/
theorem homOfFun_sumHom {X₁ Y₁ X₂ Y₂ : QSysPriv} (f : X₁.P → Y₁.P) (g : X₂.P → Y₂.P) :
    sumHom (homOfFun f) (homOfFun g) =
      homOfFun (X := ⟨X₁.P ⊕ X₂.P⟩) (Y := ⟨Y₁.P ⊕ Y₂.P⟩) (Sum.map f g) :=
  Quotient.sound (PObj.ofFun_sum f g)

/-- The monoidal data of the parallel composition: sums of ports, the unit `Empty`, and the
structure isomorphisms of the sum equivalences. -/
noncomputable instance sumMonoidalStruct : MonoidalCategoryStruct QSysPriv where
  tensorObj X Y := ⟨X.P ⊕ Y.P⟩
  tensorHom := sumHom
  whiskerLeft X _ _ g := sumHom (𝟙 X) g
  whiskerRight f Y := sumHom f (𝟙 Y)
  tensorUnit := ⟨Empty⟩
  associator X Y Z := isoOfEquiv (Equiv.sumAssoc X.P Y.P Z.P)
  leftUnitor X := isoOfEquiv (Equiv.emptySum Empty X.P)
  rightUnitor X := isoOfEquiv (Equiv.sumEmpty X.P Empty)

/-- Unfolding lemma of the associator of the parallel composition. -/
theorem sum_associator_def (X Y Z : QSysPriv) :
    α_ X Y Z = isoOfEquiv (X := (X ⊗ Y) ⊗ Z) (Y := X ⊗ (Y ⊗ Z)) (Equiv.sumAssoc X.P Y.P Z.P) :=
  rfl

/-- Unfolding lemma of the left unitor of the parallel composition. -/
theorem sum_leftUnitor_def (X : QSysPriv) :
    λ_ X = isoOfEquiv (X := 𝟙_ QSysPriv ⊗ X) (Y := X) (Equiv.emptySum Empty X.P) :=
  rfl

/-- Unfolding lemma of the right unitor of the parallel composition. -/
theorem sum_rightUnitor_def (X : QSysPriv) :
    ρ_ X = isoOfEquiv (X := X ⊗ 𝟙_ QSysPriv) (Y := X) (Equiv.sumEmpty X.P Empty) :=
  rfl

/-- Whiskering a morphism given by a function on the left, for the parallel composition. -/
theorem sum_whiskerLeft_homOfFun (X : QSysPriv) {Y Z : QSysPriv} (g : Y.P → Z.P) :
    X ◁ homOfFun g = homOfFun (X := X ⊗ Y) (Y := X ⊗ Z) (Sum.map id g) :=
  homOfFun_sumHom id g

/-- Whiskering a morphism given by a function on the right, for the parallel composition. -/
theorem sum_whiskerRight_homOfFun {X Y : QSysPriv} (f : X.P → Y.P) (Z : QSysPriv) :
    homOfFun f ▷ Z = homOfFun (X := X ⊗ Z) (Y := Y ⊗ Z) (Sum.map f id) :=
  homOfFun_sumHom f id

/-- The parallel composition makes `QSysPriv` a monoidal category: the additive structure of
the rig. -/
noncomputable instance sumMonoidal : MonoidalCategory QSysPriv where
  toMonoidalCategoryStruct := sumMonoidalStruct
  tensorHom_def f g := by
    change sumHom f g = sumHom f (𝟙 _) ≫ sumHom (𝟙 _) g
    rw [sumHom_comp, Category.comp_id, Category.id_comp]
  id_tensorHom_id _ _ := by
    change sumHom (homOfFun id) (homOfFun id) = homOfFun id
    rw [homOfFun_sumHom, Sum.map_id_id]
  tensorHom_comp_tensorHom := sumHom_comp
  whiskerLeft_id _ _ := by
    change sumHom (homOfFun id) (homOfFun id) = homOfFun id
    rw [homOfFun_sumHom, Sum.map_id_id]
  id_whiskerRight _ _ := by
    change sumHom (homOfFun id) (homOfFun id) = homOfFun id
    rw [homOfFun_sumHom, Sum.map_id_id]
  associator_naturality := by
    rintro _ _ _ _ _ _ ⟨A⟩ ⟨B⟩ ⟨C⟩
    exact Quotient.sound (PObj.sum_assoc_comp A B C)
  leftUnitor_naturality := by
    rintro _ _ ⟨A⟩
    exact Quotient.sound (PObj.empty_sum_comp A)
  rightUnitor_naturality := by
    rintro _ _ ⟨A⟩
    exact Quotient.sound (PObj.sum_empty_comp A)
  pentagon _ _ _ _ := by
    simp only [sum_associator_def, isoOfEquiv_hom, sum_whiskerLeft_homOfFun,
      sum_whiskerRight_homOfFun, homOfFun_comp]
    congr 1
    funext e
    rcases e with ((e | e) | e) | e <;> rfl
  triangle _ _ := by
    simp only [sum_associator_def, sum_leftUnitor_def, sum_rightUnitor_def, isoOfEquiv_hom,
      sum_whiskerLeft_homOfFun, sum_whiskerRight_homOfFun, homOfFun_comp]
    congr 1
    funext e
    rcases e with (e | e) | e
    · rfl
    · exact e.elim
    · rfl

/-- The parallel composition makes `QSysPriv` a symmetric monoidal category; the symmetry swaps
the summands. -/
noncomputable instance sumSymmetric : SymmetricCategory QSysPriv where
  braiding X Y := isoOfEquiv (X := ⟨X.P ⊕ Y.P⟩) (Y := ⟨Y.P ⊕ X.P⟩) (Equiv.sumComm X.P Y.P)
  braiding_naturality_right := by
    rintro _ _ _ ⟨A⟩
    exact Quotient.sound (PObj.sum_swap_comp (PObj.ofFun id) A)
  braiding_naturality_left := by
    rintro _ _ ⟨A⟩ _
    exact Quotient.sound (PObj.sum_swap_comp A (PObj.ofFun id))
  hexagon_forward _ _ _ := by
    simp only [sum_associator_def, isoOfEquiv_hom, sum_whiskerLeft_homOfFun,
      sum_whiskerRight_homOfFun, homOfFun_comp]
    congr 1
    funext e
    rcases e with (e | e) | e <;> rfl
  hexagon_reverse _ _ _ := by
    simp only [sum_associator_def, isoOfEquiv_hom, isoOfEquiv_inv, sum_whiskerLeft_homOfFun,
      sum_whiskerRight_homOfFun, homOfFun_comp]
    congr 1
    funext e
    rcases e with e | e | e <;> rfl
  symmetry _ _ := by
    simp only [isoOfEquiv_hom, homOfFun_comp, id_eq_homOfFun]
    congr 1
    funext e
    rcases e with e | e <;> rfl

/-! ### The multiplicative structure: the paired activation -/

/-- The paired activation of morphisms, on multiplied ports. -/
noncomputable def prodHom {X₁ Y₁ X₂ Y₂ : QSysPriv} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    (⟨X₁.P × X₂.P⟩ : QSysPriv) ⟶ ⟨Y₁.P × Y₂.P⟩ :=
  Quotient.map₂ PObj.prod (fun _ _ h₁ _ _ h₂ => PObj.PrivEq.prod h₁ h₂) f g

/-- **Interchange** of the paired activation with composition. -/
theorem prodHom_comp {X₁ Y₁ Z₁ X₂ Y₂ Z₂ : QSysPriv} (f₁ : X₁ ⟶ Y₁) (f₂ : X₂ ⟶ Y₂)
    (g₁ : Y₁ ⟶ Z₁) (g₂ : Y₂ ⟶ Z₂) :
    prodHom f₁ f₂ ≫ prodHom g₁ g₂ = prodHom (f₁ ≫ g₁) (f₂ ≫ g₂) := by
  induction f₁ using Quotient.inductionOn
  induction f₂ using Quotient.inductionOn
  induction g₁ using Quotient.inductionOn
  induction g₂ using Quotient.inductionOn
  exact (Quotient.sound (PObj.prod_comp _ _ _ _)).symm

/-- The paired activation of morphisms given by functions is given by the product of the
functions. -/
theorem homOfFun_prodHom {X₁ Y₁ X₂ Y₂ : QSysPriv} (f : X₁.P → Y₁.P) (g : X₂.P → Y₂.P) :
    prodHom (homOfFun f) (homOfFun g) =
      homOfFun (X := ⟨X₁.P × X₂.P⟩) (Y := ⟨Y₁.P × Y₂.P⟩) (Prod.map f g) :=
  Quotient.sound (PObj.ofFun_prod f g)

/-! ### The distributor and the annihilator -/

/-- The distributor `X ⊗ (Y ⊕ Z) ≅ (X ⊗ Y) ⊕ (X ⊗ Z)`: the stateless system on the one-point
register of the distributivity equivalence of ports. -/
noncomputable def distrib (X Y Z : QSysPriv) :
    (⟨X.P × (Y.P ⊕ Z.P)⟩ : QSysPriv) ≅ ⟨(X.P × Y.P) ⊕ (X.P × Z.P)⟩ :=
  isoOfEquiv (Equiv.prodSumDistrib X.P Y.P Z.P)

/-- **Naturality of the distributor** in the two summands. -/
theorem distrib_naturality (X : QSysPriv) {Y Y' Z Z' : QSysPriv} (g : Y ⟶ Y') (h : Z ⟶ Z') :
    prodHom (𝟙 X) (sumHom g h) ≫ (distrib X Y' Z').hom =
      (distrib X Y Z).hom ≫ sumHom (prodHom (𝟙 X) g) (prodHom (𝟙 X) h) := by
  induction g using Quotient.inductionOn
  induction h using Quotient.inductionOn
  exact Quotient.sound (PObj.prod_sum_distrib_comp _ _)

/-- The annihilator `X ⊗ 0 ≅ 0`: the stateless system on the one-point register with no
events. -/
noncomputable def annihilator (X : QSysPriv) : (⟨X.P × Empty⟩ : QSysPriv) ≅ ⟨Empty⟩ :=
  isoOfEquiv (Equiv.prodEmpty X.P)

/-- Two morphisms out of a port type with no events are equal. -/
theorem hom_ext_of_isEmpty {X Y : QSysPriv} [IsEmpty X.P] (f g : X ⟶ Y) : f = g := by
  induction f using Quotient.inductionOn
  induction g using Quotient.inductionOn
  exact Quotient.sound (PObj.privEq_of_isEmpty _ _)

/-- **Naturality of the annihilator** `X ⊗ 0 ≅ 0`. -/
theorem annihilator_naturality {X Y : QSysPriv} (f : X ⟶ Y) :
    prodHom f (𝟙 (⟨Empty⟩ : QSysPriv)) ≫ (annihilator Y).hom =
      (annihilator X).hom ≫ 𝟙 (⟨Empty⟩ : QSysPriv) :=
  hom_ext_of_isEmpty (X := ⟨X.P × Empty⟩) _ _

end QSysPriv

/-- The category `QSysPriv` with the paired activation as monoidal product: the multiplicative
structure of the rig. -/
def QSysPrivMul : Type 1 :=
  QSysPriv

namespace QSysPrivMul

open CategoryTheory MonoidalCategory

/-- The ports of an object. -/
abbrev P (X : QSysPrivMul) : Type :=
  QSysPriv.P X

/-- The object with ports `P`. -/
abbrev mk (P : Type) : QSysPrivMul :=
  (⟨P⟩ : QSysPriv)

/-- The category structure of `QSysPriv`. -/
noncomputable instance category : Category.{1} QSysPrivMul :=
  QSysPriv.category

/-- The morphism given by a function of ports. -/
noncomputable def homOfFun {X Y : QSysPrivMul} (f : X.P → Y.P) : X ⟶ Y :=
  QSysPriv.homOfFun (X := X) (Y := Y) f

/-- Unfolding lemma of the identity: the morphism of the identity function. -/
theorem id_eq_homOfFun (X : QSysPrivMul) : 𝟙 X = homOfFun id :=
  rfl

/-- Composition of morphisms given by functions is composition of the functions. -/
theorem homOfFun_comp {X Y Z : QSysPrivMul} (f : X.P → Y.P) (g : Y.P → Z.P) :
    homOfFun f ≫ homOfFun g = homOfFun (g ∘ f) :=
  QSysPriv.homOfFun_comp (X := X) (Y := Y) (Z := Z) f g

/-- The isomorphism of port types given by an equivalence of the ports. -/
noncomputable def isoOfEquiv {X Y : QSysPrivMul} (e : X.P ≃ Y.P) : X ≅ Y :=
  QSysPriv.isoOfEquiv (X := X) (Y := Y) e

/-- Unfolding lemma of `isoOfEquiv`: the forward morphism. -/
theorem isoOfEquiv_hom {X Y : QSysPrivMul} (e : X.P ≃ Y.P) : (isoOfEquiv e).hom = homOfFun e :=
  rfl

/-- Unfolding lemma of `isoOfEquiv`: the backward morphism. -/
theorem isoOfEquiv_inv {X Y : QSysPrivMul} (e : X.P ≃ Y.P) :
    (isoOfEquiv e).inv = homOfFun e.symm :=
  rfl

/-- The paired activation of morphisms. -/
noncomputable def tensorHom {X₁ Y₁ X₂ Y₂ : QSysPrivMul} (f : X₁ ⟶ Y₁) (g : X₂ ⟶ Y₂) :
    mk (X₁.P × X₂.P) ⟶ mk (Y₁.P × Y₂.P) :=
  QSysPriv.prodHom (X₁ := X₁) (Y₁ := Y₁) (X₂ := X₂) (Y₂ := Y₂) f g

/-- **Interchange.** -/
theorem tensorHom_comp {X₁ Y₁ Z₁ X₂ Y₂ Z₂ : QSysPrivMul} (f₁ : X₁ ⟶ Y₁) (f₂ : X₂ ⟶ Y₂)
    (g₁ : Y₁ ⟶ Z₁) (g₂ : Y₂ ⟶ Z₂) :
    tensorHom f₁ f₂ ≫ tensorHom g₁ g₂ = tensorHom (f₁ ≫ g₁) (f₂ ≫ g₂) :=
  QSysPriv.prodHom_comp (X₁ := X₁) (Y₁ := Y₁) (Z₁ := Z₁) (X₂ := X₂) (Y₂ := Y₂) (Z₂ := Z₂)
    f₁ f₂ g₁ g₂

/-- The paired activation of morphisms given by functions. -/
theorem homOfFun_tensorHom {X₁ Y₁ X₂ Y₂ : QSysPrivMul} (f : X₁.P → Y₁.P) (g : X₂.P → Y₂.P) :
    tensorHom (homOfFun f) (homOfFun g) =
      homOfFun (X := mk (X₁.P × X₂.P)) (Y := mk (Y₁.P × Y₂.P)) (Prod.map f g) :=
  QSysPriv.homOfFun_prodHom (X₁ := X₁) (Y₁ := Y₁) (X₂ := X₂) (Y₂ := Y₂) f g

/-- The monoidal data of the paired activation: products of ports, the unit `Unit`, and the
structure isomorphisms of the product equivalences. -/
noncomputable instance monoidalCategoryStruct : MonoidalCategoryStruct QSysPrivMul where
  tensorObj X Y := mk (X.P × Y.P)
  tensorHom := tensorHom
  whiskerLeft X _ _ g := tensorHom (𝟙 X) g
  whiskerRight f Y := tensorHom f (𝟙 Y)
  tensorUnit := mk Unit
  associator X Y Z := isoOfEquiv (Equiv.prodAssoc X.P Y.P Z.P)
  leftUnitor X := isoOfEquiv (Equiv.punitProd X.P)
  rightUnitor X := isoOfEquiv (Equiv.prodPUnit X.P)

/-- Unfolding lemma of the associator. -/
theorem associator_def (X Y Z : QSysPrivMul) :
    α_ X Y Z = isoOfEquiv (X := (X ⊗ Y) ⊗ Z) (Y := X ⊗ (Y ⊗ Z)) (Equiv.prodAssoc X.P Y.P Z.P) :=
  rfl

/-- Unfolding lemma of the left unitor. -/
theorem leftUnitor_def (X : QSysPrivMul) :
    λ_ X = isoOfEquiv (X := 𝟙_ QSysPrivMul ⊗ X) (Y := X) (Equiv.punitProd X.P) :=
  rfl

/-- Unfolding lemma of the right unitor. -/
theorem rightUnitor_def (X : QSysPrivMul) :
    ρ_ X = isoOfEquiv (X := X ⊗ 𝟙_ QSysPrivMul) (Y := X) (Equiv.prodPUnit X.P) :=
  rfl

/-- Whiskering a morphism given by a function on the left. -/
theorem whiskerLeft_homOfFun (X : QSysPrivMul) {Y Z : QSysPrivMul} (g : Y.P → Z.P) :
    X ◁ homOfFun g = homOfFun (X := X ⊗ Y) (Y := X ⊗ Z) (Prod.map id g) :=
  homOfFun_tensorHom id g

/-- Whiskering a morphism given by a function on the right. -/
theorem whiskerRight_homOfFun {X Y : QSysPrivMul} (f : X.P → Y.P) (Z : QSysPrivMul) :
    homOfFun f ▷ Z = homOfFun (X := X ⊗ Z) (Y := Y ⊗ Z) (Prod.map f id) :=
  homOfFun_tensorHom f id

/-- The paired activation makes `QSysPrivMul` a monoidal category. -/
noncomputable instance monoidalCategory : MonoidalCategory QSysPrivMul where
  toMonoidalCategoryStruct := monoidalCategoryStruct
  tensorHom_def f g := by
    change tensorHom f g = tensorHom f (𝟙 _) ≫ tensorHom (𝟙 _) g
    rw [tensorHom_comp, Category.comp_id, Category.id_comp]
  id_tensorHom_id _ _ := by
    change tensorHom (homOfFun id) (homOfFun id) = homOfFun id
    rw [homOfFun_tensorHom, Prod.map_id]
  tensorHom_comp_tensorHom := tensorHom_comp
  whiskerLeft_id _ _ := by
    change tensorHom (homOfFun id) (homOfFun id) = homOfFun id
    rw [homOfFun_tensorHom, Prod.map_id]
  id_whiskerRight _ _ := by
    change tensorHom (homOfFun id) (homOfFun id) = homOfFun id
    rw [homOfFun_tensorHom, Prod.map_id]
  associator_naturality := by
    rintro _ _ _ _ _ _ ⟨A⟩ ⟨B⟩ ⟨C⟩
    exact Quotient.sound (PObj.prod_assoc_comp A B C)
  leftUnitor_naturality := by
    rintro _ _ ⟨A⟩
    exact Quotient.sound (PObj.unit_prod_comp A)
  rightUnitor_naturality := by
    rintro _ _ ⟨A⟩
    exact Quotient.sound (PObj.prod_unit_comp A)
  pentagon _ _ _ _ := by
    simp only [associator_def, isoOfEquiv_hom, whiskerLeft_homOfFun, whiskerRight_homOfFun,
      homOfFun_comp]
    rfl
  triangle _ _ := by
    simp only [associator_def, leftUnitor_def, rightUnitor_def, isoOfEquiv_hom,
      whiskerLeft_homOfFun, whiskerRight_homOfFun, homOfFun_comp]
    rfl

/-- The paired activation makes `QSysPrivMul` a symmetric monoidal category; the symmetry
swaps the factors. Systems on different private registers commute, which gives the
naturality of the symmetry. -/
noncomputable instance symmetricCategory : SymmetricCategory QSysPrivMul where
  braiding X Y := isoOfEquiv (X := mk (X.P × Y.P)) (Y := mk (Y.P × X.P)) (Equiv.prodComm X.P Y.P)
  braiding_naturality_right := by
    rintro _ _ _ ⟨A⟩
    exact Quotient.sound (PObj.prod_swap_comp (PObj.ofFun id) A)
  braiding_naturality_left := by
    rintro _ _ ⟨A⟩ _
    exact Quotient.sound (PObj.prod_swap_comp A (PObj.ofFun id))
  hexagon_forward _ _ _ := by
    simp only [associator_def, isoOfEquiv_hom, whiskerLeft_homOfFun, whiskerRight_homOfFun,
      homOfFun_comp]
    rfl
  hexagon_reverse _ _ _ := by
    simp only [associator_def, isoOfEquiv_hom, isoOfEquiv_inv, whiskerLeft_homOfFun,
      whiskerRight_homOfFun, homOfFun_comp]
    rfl
  symmetry _ _ := by
    simp only [isoOfEquiv_hom, homOfFun_comp, id_eq_homOfFun]
    rfl

end QSysPrivMul

